---
// Zeitstrahl als Linie mit Stationen, im Stil schlichter Netzpläne und Git-Graphen (Marc, 02.11.2026: „minimal branching
// timeline … inspiriert von minimal metro maps“). Die Hauptlinie im Logoverlauf führt von Station zu Station; eine
// Abzweigung (z. B. Express) zweigt an der ersten Station ab und mündet an der letzten wieder ein, gestrichelt und
// gedämpft, damit sie als Nebenweg liest (Marc, 02.11.2026). Mit href ist das Schild selbst ein Knopf mit Pfeil, kein
// zweiter Link daneben. Handy: senkrecht, die Abzweigung läuft rechts neben der Hauptlinie.
// Genutzt von Tempo.astro (Startseite, Hochzeit, Indoor) und LandingSite.astro (Vorlauf). Beim Erscheinen zieht die
// Linie, die Stationen leuchten nacheinander auf (data-reveal-group).
import ProcessList from './ProcessList.astro';
import Icon from './Icon.astro';
import { forPath } from '../i18n/server';
interface Mark { value: string | import('../content/business-facts.mjs').BusinessRef; label: string; text?: string }
interface Branch { value: string | import('../content/business-facts.mjs').BusinessRef; label: string; text?: string; href?: string }
interface Props { marks: Mark[]; branch?: Branch }
const { marks, branch } = Astro.props;
const { localHref } = forPath(Astro.url.pathname);
---
<div class:list={['metro', { 'has-branch': branch }]} style={`--n:${marks.length}`}>
  {branch && <span class="metro-branch" aria-hidden="true"></span>}
  {branch && (branch.href
    ? <a class="metro-sign" href={localHref(branch.href)}><b>{branch.value}</b><span class="mono">{branch.label}</span><Icon name="arrow-right" size={16} /></a>
    : <p class="metro-sign"><b>{branch.value}</b><span class="mono">{branch.label}</span></p>)}
  <ProcessList items={marks} variant="metro" />
  {branch?.text && <p class="metro-note"><span class="metro-sign-key" aria-hidden="true"></span>{branch.text}</p>}
</div>

<style is:global>
  /* Netzplan-Zeitstrahl: Hauptlinie mit Stationen (.ruler, ProcessList.astro), Abzweigung gestrichelt von der ersten zur
     letzten Station, Schild mittig darauf. --n: Zahl der Stationen. Geometrie nur über die Schienen-Variablen der .ruler
     (--dot, --rail, --dot-x, --rail-y, --ruler-pad, --ruler-gap), nie über left/top einzelner Punkte */
  .metro { --branch: rgb(var(--rgb-amber) / 0.6); position: relative; }
  .metro .ruler { --rail: 0.1875rem; }
  .metro .dot { border-width: 0.1875rem; }
  /* Umsteigestationen: nur größer, der Mittelpunkt bleibt auf der Schiene */
  .metro .ruler li:is(:first-child, :last-child) { --dot: 1.25rem; }
  /* waagerecht endet die Linie im Mittelpunkt der letzten Station */
  .metro .ruler::before, .metro .ruler::after { right: calc(100% / var(--n) - var(--dot-x)); }
  .metro.has-branch { padding-top: 4.25rem; }
  .metro-branch { position: absolute; left: 0.4375rem; top: 1rem; height: 3.75rem; width: calc(100% / var(--n) * (var(--n) - 1)); border: 1.5px dashed var(--branch); border-bottom: 0; border-radius: 1.75rem 1.75rem 0 0; transition: opacity var(--dur-image) var(--ease-default) var(--dur-record); }
  .reveal .metro:has(.ruler:not(.is-in)) .metro-branch, .reveal .metro:has(.ruler:not(.is-in)) .metro-sign { opacity: 0; }
  .metro-sign { position: absolute; z-index: 1; top: 0; left: calc(0.4375rem + 100% / var(--n) * (var(--n) - 1) / 2); transform: translateX(-50%); margin: 0; display: inline-flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: var(--space-1) var(--space-3); padding: var(--space-1-25) var(--space-4); border-radius: var(--radius-pill); border: 1.5px dashed var(--branch); background: var(--surface); color: inherit; text-decoration: none; white-space: nowrap; transition: opacity var(--dur-image) var(--ease-default) var(--dur-branch), border-color var(--dur-control) var(--ease-default), background-color var(--dur-control) var(--ease-default); }
  .metro-sign b { font: 500 var(--text-copy)/1.3 var(--display); color: var(--head); letter-spacing: -0.01em; }
  .metro-sign .mono { color: var(--accent); }
  .metro-sign .ico { align-self: center; color: var(--accent); transition: transform var(--dur-control) var(--ease-default); }
  a.metro-sign:hover { border-style: solid; border-color: var(--accent); background: var(--surface-2); }
  a.metro-sign:hover .ico { transform: translateX(0.1875rem); }
  a.metro-sign:focus-visible { outline: 0.1875rem solid var(--cyan); outline-offset: 0.1875rem; }
  .metro-note { display: flex; gap: var(--space-2-5); align-items: baseline; margin: var(--space-7-5) 0 0; color: var(--faint); font-size: var(--text-sm); max-width: 70ch; }
  .metro-sign-key { flex: none; width: 1.375rem; border-top: 1.5px dashed var(--branch); transform: translateY(-0.25rem); }
  @media (--timeline-stacked) {
    /* senkrecht: Hauptlinie links, Abzweigung als Bogen rechts daneben (in der breiteren Einrückung), Schild über der Liste */
    .metro.has-branch { padding-top: 0; }
    .metro.has-branch .ruler { --ruler-pad: 3.875rem; }
    .metro-branch { display: none; }
    .metro.has-branch .ruler li::after { content: ""; position: absolute; left: var(--dot-x); width: 1.625rem; top: 0; bottom: calc(-1 * var(--ruler-gap)); border-right: 1.5px dashed var(--branch); }
    .metro.has-branch .ruler li:first-child::after { top: var(--rail-y); border-top: 1.5px dashed var(--branch); border-top-right-radius: 1.375rem; }
    .metro.has-branch .ruler li:last-child::after { top: 0; bottom: auto; height: var(--rail-y); border-bottom: 1.5px dashed var(--branch); border-bottom-right-radius: 1.375rem; }
    .metro-sign { position: static; transform: none; white-space: normal; justify-content: flex-start; margin: 0 0 var(--space-7); padding: var(--space-3) var(--space-4); border-radius: var(--radius-14); }
  }
  @media (prefers-reduced-motion: reduce) { .metro-branch, .metro-sign { transition: none; } }
</style>
