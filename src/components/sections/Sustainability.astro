---
import Styles from '../Styles.astro';
import ownerStyle0 from './Sustainability.css?url';
import {field} from 'astro-frontend-editor/markers';
import {SUSTAINABILITY_PILLARS,localizedBlock} from '../../content/shared-blocks.mjs';
import {forPath} from '../../i18n/server';
const {locale}=forPath(Astro.url.pathname);
import IconFeature from '../IconFeature.astro';
import SectionHead from '../SectionHead.astro';
import FactList from '../FactList.astro';
// Nachhaltigkeit als Scrollstory aus dem Vercel-Prototyp (Marc, 31.10.2026: „das Scrollytelling finde ich ganz nice,
// das kann bleiben“): Die Bühne bleibt stehen, vier Zahlen übernehmen nacheinander den Bildschirm, im Hintergrund fliegt
// die Flotte eine passende Figur (Schallwelle, Null, geparkte Flotte, Blitz). Ohne JS, bei reduzierter Bewegung und auf
// Wunsch pausiert: dieselben Zahlen als ruhige Liste. Aussagen nur über die Show vor Ort (EmpCo).
// Headline: jeder Satz eine Zeile, der letzte im Logoverlauf (gezielter Einsatz statt drei Titelschnitte).
import type { Section } from '../../content.config';
import { optimizedLogo } from '../../lib/media';
import Icon from '../Icon.astro';
const PICON = { eu: 'eu', repair: 'wrench', ev: 'e-car', campaign: 'megaphone', leaf: 'leaf' } as const;
type Props = Extract<Section, { type: 'sustainability' }> & { index: number };
const { headline, text, id = 'nachhaltigkeit', facts = [], points = [], pillarsRef, proofImage, proofText, campaign, index, kicker } = Astro.props;
const pillars=pillarsRef?localizedBlock(SUSTAINABILITY_PILLARS,locale).pillars:[];
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
const lines = headline.split(/(?<=\.)\s+/).filter(Boolean);
const parts = (point: string) => point.split(/(\S+-\S+)/).filter(Boolean);
const proof = proofImage ? await optimizedLogo(proofImage.src, 60) : undefined;
---
<Styles href={ownerStyle0} id="components/sections/Sustainability.css" />
<section class="eco-sec" id={id} aria-labelledby={headingId}>
  <SectionHead variant="display" class="eco-head" titleClass="eco-title" revealTitle kicker={kicker} headline={headline} text={text} id={headingId} level={H}>
    <Fragment slot="title">{lines.map((line, i) => <span data-reveal style={`--i:${i}`} class:list={{ grad: i === lines.length - 1 && lines.length > 1, o: lines.length > 2 && i === 1 }}>{line} </span>)}</Fragment>
  </SectionHead>
  {facts.length > 0 && <div class="eco-scrolly" data-scrolly><div class="eco-pin">
    <canvas class="eco-canvas" aria-hidden="true"></canvas>
    <FactList items={facts} variant="eco" />
    <ol class="eco-steps mono" aria-hidden="true">{facts.map((fact, i) => <li style={`--k:${i}`}>{fact.label}</li>)}</ol>
  </div></div>}
  {pillars.length > 0 && <ul {...field({collection:"sustainabilityPillars",id:"configuration"},[locale,"pillars"],{mode:"panel"})} class="eco-pillars">{pillars.map((p) => <IconFeature as="li" icon={PICON[p.icon]} title={p.title} text={p.text} />)}</ul>}
  {(points.length > 0 || campaign || proofText) && <div class="eco-proof">
    {proofImage && proof && <img src={proof.src} width={proof.width / 2} height={proof.height / 2} alt={proofImage.alt} loading="lazy" decoding="async" />}
    {points.length > 0 && <ul class="eco-points">{points.map((point) => <li><span>{parts(point.value).map((part) => part.includes('-') ? <span class="nowrap">{part}</span> : part)}</span></li>)}</ul>}
    {(proofText || campaign) && <p>{proofText}{campaign && <> <b>#Böllerciao:</b> {campaign}</>}</p>}
  </div>}
</section>
<script>
  import { whenNear } from '../../scripts/when-near.mjs';
  import { prepareEcoScrolly, resetEcoScrolly } from '../../scripts/effects/eco-scrolly-setup.mjs';
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    for (const el of document.querySelectorAll<HTMLElement>('[data-scrolly]')) {
      // Keep later anchors and document height stable while the engine is still deferred.
      prepareEcoScrolly(el);
      const load = whenNear(el, async () => {
        try {
          const { ecoScrolly } = await import('../../scripts/effects/eco-scrolly.js');
          ecoScrolly(el);
        } catch (error) {
          resetEcoScrolly(el); // The original fact list remains readable if the chunk fails.
          throw error;
        }
      });
      if (location.hash) void load().catch((error: unknown) => console.warn('Scrollstory could not load', error));
    }
  }
</script>
