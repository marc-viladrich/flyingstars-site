{
  "$comment": "Das unveränderte 1-MB-Nicht-Media-Budget und die ausschließlich freigegebene Hero-Video-Ausnahme prüft scripts/check-lighthouse-payload.mjs nach autorun. Begründung und offene Entscheidung Marc: lighthouse-payload-budgets.json.",
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/index.html", "http://localhost/kontakt/index.html", "http://localhost/blog/index.html"],
      "numberOfRuns": 2,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "unused-javascript": ["warn", { "maxNumericValue": 50000 }],
        "uses-responsive-images": "error",
        "uses-optimized-images": "error"
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
