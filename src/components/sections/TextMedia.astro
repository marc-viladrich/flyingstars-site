---
import {field,editorBuild} from 'astro-frontend-editor/markers';
import ImageFrame from '../ImageFrame.astro';
import Gallery from '../gallery/Gallery.astro';
import SectionHead from '../SectionHead.astro';
import {contactText} from '../../content/contact.mjs';
import { marked } from 'marked';
import { forPath } from '../../i18n/server';
const { localHref } = forPath(Astro.url.pathname);
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'textMedia' }> & { index: number };
const { headline, body, image, mediaSide, index, id: anchor, kicker, cta, headAbove, gallery } = Astro.props;
// Projected contact facts must be edited as their source template, never materialized from the visible DOM.
const editorFieldOptions={mode:body.includes('{{contact.')?'panel':'inline',format:'markdown'} as const;
const id = `${anchor ?? `s${index}`}-h`;
const H = index === 0 ? 'h1' : 'h2';
const html = await marked.parse(contactText(body));
---
{gallery ? <section class="section text-media has-gallery" id={anchor} aria-labelledby={id}>
  {/* Galerie (Werbung #marketing): Kopf über Text und Bildleiter; unter dem Kopf steht der Text (Überschrift → Text) */}
  <Gallery set={gallery}>
    {headAbove && <SectionHead slot="head" next="text" kicker={kicker} headline={headline} id={id} level={H} class="tm-head" />}
    <div class="prose">
      {!headAbove && <SectionHead variant="embedded" next="text" kicker={kicker} headline={headline} id={id} level={H} />}
      {editorBuild() && (Astro.props as any).__afe?.body ? <div {...field((Astro.props as any).__afe.body,editorFieldOptions)} set:html={html} /> : <Fragment set:html={html} />}
      {cta && <p class="tm-more"><a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a></p>}
    </div>
  </Gallery>
</section> : <section class:list={['section', 'text-media', { 'has-media': image, 'media-left': image && mediaSide === 'left', 'head-above': headAbove }]} id={anchor} aria-labelledby={id}>
  {/* Kopf über beiden Spalten (Werbung #marketing): rechts neben dem Kopf bleibt Luft, darunter Text und Bild im Split */}
  {headAbove && <SectionHead kicker={kicker} headline={headline} id={id} level={H} class="tm-head" />}
  <div class="prose">
    {!headAbove && <SectionHead variant="embedded" next="text" kicker={kicker} headline={headline} id={id} level={H} />}
    {editorBuild() && (Astro.props as any).__afe?.body ? <div {...field((Astro.props as any).__afe.body,editorFieldOptions)} set:html={html} /> : <Fragment set:html={html} />}
    {cta && <p class="tm-more"><a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a></p>}
  </div>
  {image && <ImageFrame class="tm-media" image={image} />}
</section>}

<style>
  /* Grundraster und Fließtext (aus global.css hierher, Audit 2, C2) */
  .text-media { display: grid; gap: clamp(var(--space-7), 5vw, var(--space-18)); align-items: start; }
  .text-media.has-media { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  /* h1 im Fließtext (Seitenkopf der Rechtstexte): Größe hier, den Abstand besitzt SectionHead. Der frühere Rand von 0.6em
     griff nie (SectionHead gewann, Markdown-h1 kommen im Fließtext nicht vor) und entfällt */
  .text-media .prose :global(h1) { font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1.02; letter-spacing: -0.035em; }
  .text-media .prose :global(p), .text-media .prose :global(li) { color: var(--muted); }
  .text-media .prose :global(a) { color: var(--text); border-bottom: 1px solid var(--line-strong); }
  @media (--nav-collapsed) { .text-media.has-media { grid-template-columns: 1fr; } }
  /* wie .more unter Raster und Listen */
  .tm-more { margin-top: var(--head-gap-cta); }
  .text-media.head-above.has-media { align-items: center; }
  .text-media.head-above { row-gap: var(--head-gap-content); }
  .text-media.head-above :global(.tm-head) { grid-column: 1 / -1; margin-bottom: 0; }
  /* Kopf im Fließtext: zum ersten Absatz derselbe Abstand wie Überschrift → Text in jedem Kopf */
  .text-media .prose > :global(.section-head) + :global(*) { margin-top: var(--head-gap-text); }
  .text-media .prose :global(p) { max-width: 60ch; }
  .text-media.has-gallery { display: block; }
  .text-media.media-left :global(.tm-media) { order: -1; }
  /* Hervorhebung im Fließtext (Startseite #warum-drohnen: spektakulärer, emotionaler, einzigartiger): Display-Schnitt,
     Farbe aus .prose strong in global.css (Marken-Orange, kein Verlauf im Fließtext) */
  .text-media .prose :global(strong) { font: 600 1.18em/1 var(--display); letter-spacing: -0.01em; }
  .text-media .prose .tm-more a { border-bottom: 0; color: var(--accent); }
  .text-media .prose .tm-more a:hover { color: var(--amber-light); }
  /* Aufzählungen wie .facts (Punkte in Amber) statt Browser-Standard */
  .text-media .prose :global(ul) { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  .text-media .prose :global(li) { display: grid; grid-template-columns: 0.875rem minmax(0, 1fr); gap: var(--space-2-5); align-items: baseline; }
  .text-media .prose :global(li)::before { content: ""; width: 0.375rem; height: 0.375rem; border-radius: var(--radius-round); background: var(--amber); transform: translateY(-0.125rem); }
</style>
