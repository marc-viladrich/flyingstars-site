---
import Chopper from '../Chopper.astro';
import {teamMember} from '../../content/people.mjs';
import {field} from 'astro-frontend-editor/markers';
import { forPath } from '../../i18n/server';
const { localHref, locale } = forPath(Astro.url.pathname);
// Team: große Porträts mit Vorhang-Reveal (CSS, html.reveal) und Lichtpunkt-Hover; kein Foto-Zoom. Ohne Porträt stehen
// nur die Initialen da, kein sichtbarer Platzhalter wie „Foto folgt“ (17.11.2026).
import type { Section } from '../../content.config';
import { optimizedImage } from '../../lib/media';
import Accent from '../Accent.astro';
import SectionHead from '../SectionHead.astro';
type Props = Extract<Section, { type: 'team' }> & { index: number };
const { headline, text, members, memberTexts = [], note, cta, secondary, id = `s${Astro.props.index}`, index, kicker } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
const Name = index === 0 ? 'h2' : 'h3';
const initials = (name: string) => name.trim().split(/\s+/).filter((_,i,a)=>i===0||i===a.length-1).map(part=>part[0]).join('').toUpperCase();
// Spalten ohne Waisen: bis 5 Karten in einer Reihe, 6 → 3 × 2, sonst 4 oder 3, je nachdem, was aufgeht
const n = members.length;
const cols = n <= 5 ? n : n % 4 === 0 ? 4 : n % 3 === 0 ? 3 : 4;
// Seitenspezifische Rolle/Bio (memberTexts) gehen vor; dann zeigt der Editor-Marker auf die Seite statt auf die Person.
const own = (personId: string) => memberTexts.find((entry) => entry.personId === personId);
const crew = await Promise.all(members.map(async item => {const member=teamMember(item,undefined,locale);const page=own(item.personId);return {...member, role: page?.role ?? member.role, bio: page?.bio ?? member.bio, ownRole: Boolean(page?.role), ownBio: Boolean(page?.bio), media: member.image ? await optimizedImage(member.image.src, 640) : undefined};}));
---
<section class="team-sec" id={id} aria-labelledby={headingId}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={headingId} level={H} />
  <ul class="crew" style={`--cols:${cols}`} data-odd={n % 2 === 1 ? '' : undefined}>{crew.map((member,i) => <li class="member" style={`--i:${i}`} data-dot-host>
    <div {...field({collection:"people",id:member.personId},["image"],{mode:"panel"})} class="portrait" data-dot-img={member.media ? '' : undefined} data-step="6">{member.image && member.media ? <img src={member.media.src} width={member.media.width} height={member.media.height} alt={member.image.alt} loading="lazy" decoding="async" /> : member.personId === "chopper" ? <Chopper mood="happy" class="portrait-chopper" /> : <span class="ini" aria-hidden="true">{initials(member.name)}</span>}</div>
    <span {...(member.ownRole ? {} : field({collection:"people",id:member.personId},["role",locale]))} class="role mono">{member.role}</span><Name {...field({collection:"people",id:member.personId},["name"])}>{member.name}</Name>{member.bio && <p {...(member.ownBio ? {} : field({collection:"people",id:member.personId},["bio",locale]))}>{member.bio}</p>}
  </li>)}</ul>
  {(note || cta || secondary) && <p class="crew-note">{note && <span>{note}</span>}{(cta || secondary) && <span class="crew-links">{cta && <a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a>}{secondary && <a class="link" href={localHref(secondary.href)}>{secondary.label} <span aria-hidden="true">→</span></a>}</span>}</p>}
</section>

<style>
  .crew-links { display: flex; flex-wrap: wrap; gap: var(--space-3-5) var(--space-7); }
</style>
