---
import {localeFromPath} from '../../lib/localized-routes';
const locale=Astro.props._locale ?? localeFromPath(Astro.url.pathname);
import InlineText from '../InlineText.astro';
import {sectionField,sectionBlock,sectionMedia} from "../../lib/editor-markers";
import Picture from '../Picture.astro';
import {markdownHtml} from '../../lib/markdown-policy.mjs';
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'textMedia' }> & { index: number; locale?:string; _locale?:string };
const { headline, body, image, mediaSide, showImage=true, index } = Astro.props;
const id = `s${index}-h`;
const H = index === 0 ? 'h1' : 'h2';
const visibleImage=showImage?image:undefined;
const html = await markdownHtml(body,locale);
---
<section {...sectionBlock(Astro.props)} class="section text-media" aria-labelledby={id}>
  <div class:list={['wrap', { 'grid-2': visibleImage, 'grid-2--media-left': visibleImage && mediaSide === 'left' }]}>
    <div class="prose">
      <H id={id} {...sectionField(Astro.props,["headline"])}><InlineText value={headline} /></H>
      <div {...sectionField(Astro.props,["body"])} set:html={html} />
    </div>
    {visibleImage && <Picture sizes="(max-width: 760px) calc(100vw - 48px), 46vw" {...visibleImage} {...sectionMedia(Astro.props,["image"])} />}
  </div>
</section>
<style>
  .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: clamp(24px, 4vw, 64px); }
  .grid-2 > .prose { min-width: 0; max-width: none; }
  .grid-2--media-left > .prose { order: 2; }
  .grid-2--media-left > :global(picture) { order: 1; }
  @media (max-width: 760px) {
    .grid-2 { grid-template-columns: 1fr; }
    .grid-2--media-left > .prose, .grid-2--media-left > :global(picture) { order: initial; }
  }
</style>
