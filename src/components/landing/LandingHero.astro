---
import MediaFrame from '../MediaFrame.astro';
import FactList from '../FactList.astro';
import { forPath } from '../../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
// Seitenkopf der Anlass-Landingpages (Marc, 31.10.2026: „in der Hero Section … so ein kleines Showreel, gerne in einer
// kleineren Variante, so ähnlich wie wir jetzt ein Hero-Bild haben“). Links Kicker, Headline, Satz, Aktionen und bis zu
// vier Eckdaten; rechts ein Bildrahmen mit stummem Loop. Startet erst, wenn der Rahmen im Bild ist: oberhalb der mobilen em-Grenze von selbst,
// auf dem Handy per Knopf (Datenvolumen). Hält an bei globaler Pause (html.motion-paused), reduzierter Bewegung,
// Datensparmodus und außerhalb des Bildes. Quelle nur aus src/lib/videos.ts, als kleine Vorschau über videoPath() auf derselben Origin.
import type { Section } from '../../content.config';
import Accent from '../Accent.astro';
import Icon from '../Icon.astro';
import { optimizedImage } from '../../lib/media';
import { videos, videoPath } from '../../lib/videos';
type Props = Extract<Section, { type: 'landingHero' }> & { index: number };
const { kicker, headline, text, cta, secondary, video, videoLabel = t('common.showreel'), poster, facts } = Astro.props;
const still = await optimizedImage(poster.src, 960);
const src = videoPath(videos[video], 'preview');
---
<section class="lh" aria-labelledby="hero-h">
  <div class="lh-copy">
    {kicker && <span class="kicker mono">{kicker}</span>}
    <h1 id="hero-h"><Accent text={headline} /></h1>
    <p class="lead">{text}</p>
    <div class="actions"><a class="btn primary" href={localHref(cta.href)}>{cta.label}</a>{secondary && <a class="btn" href={localHref(secondary.href)}>{secondary.label}</a>}</div>
    {facts.length > 0 && <FactList items={facts} variant="hero" />}
  </div>
  <MediaFrame class="lh-media" corners="inset" data-lh-reel>
    <img src={still.src} width={still.width} height={still.height} alt={poster.alt} loading="eager" fetchpriority="high" decoding="async" />
    <video data-src={src} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
    <span class="lh-rec mono" aria-hidden="true">{videoLabel}</span>
    <button class="lh-toggle mono" type="button" data-lh-toggle aria-pressed="false" hidden>
      <Icon name="play" size={16} class="g i-play" /><Icon name="pause" size={16} class="g i-pause" />
      <span data-lh-label>{t('landinghero.playVideo')}</span>
    </button>
  </MediaFrame>
</section>

<script>
  import { t } from '../../i18n/ui.mjs';
  import { createVideoController, VIDEO_MOBILE_QUERY } from '../../scripts/video-controller';
  document.querySelectorAll<HTMLElement>('[data-lh-reel]').forEach((host) => {
    const v = host.querySelector('video')!;
    const btn = host.querySelector<HTMLButtonElement>('[data-lh-toggle]')!;
    const label = host.querySelector<HTMLElement>('[data-lh-label]')!;
    const show = (on: boolean) => {
      btn.setAttribute('aria-pressed', String(on));
      label.textContent = on ? t('landinghero.pauseVideo') : t('landinghero.playVideo');
      btn.setAttribute('aria-label', label.textContent);
      host.classList.toggle('is-on', on);
      // einmal gelaufen: angehalten bleibt das Bild des Videos stehen, das Standbild kommt nicht zurück
      if (on) host.classList.add('has-played');
      host.classList.add('ready');
    };
    const controller = createVideoController(v, { host, trigger: 'manual', visibilityThreshold: 0.25, autoMediaQuery: `not all and ${VIDEO_MOBILE_QUERY}`, onState: show,
      onError: () => { host.classList.remove('is-on', 'can-toggle'); btn.hidden = true; } });
    btn.hidden = false;
    btn.addEventListener('click', () => controller.setChoice(!host.classList.contains('is-on')));
    // Klick irgendwo aufs Video schaltet wie der Knopf (Marc, 02.11.2026); der Knopf bleibt das Ziel für Tastatur und Screenreader
    host.addEventListener('click', (event) => { if (!btn.hidden && !btn.contains(event.target as Node)) btn.click(); });
    host.classList.add('can-toggle');

  });
</script>

<style>
  .lh { position: relative; display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; padding: clamp(2.25rem, 6vw, 5.5rem) var(--gutter) clamp(3.5rem, 7vw, 7rem); overflow: hidden; }
  /* ruhiges Leuchten hinter dem Rahmen, wie Restlicht einer Show */
  .lh::before { content: ""; position: absolute; right: -10%; top: 0; width: 70%; height: 100%; background: radial-gradient(closest-side, rgba(219, 100, 232, 0.12), rgba(51, 237, 242, 0.04) 60%, transparent); pointer-events: none; }
  /* Text oben am Bild, damit die erste Zeile auf jeder Seite auf --hero-top steht, auch wenn das Bild höher ist (Runde 18) */
  .lh-copy { position: relative; display: grid; gap: 1.375rem; justify-items: start; align-self: start; }
  .lh-copy .kicker { margin: 0 0 -0.625rem; }
  .lh h1 { font-size: var(--text-page); line-height: 1; letter-spacing: -0.035em; max-width: 16ch; }
  .lh .lead { max-width: 48ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  /* Rahmen wie im Startseiten-Hero (Vercel-Prototyp): Label und Knopf rasten innen in den Ecken ein, mittig auf Höhe des
     Schenkelendes und 14 px neben dem senkrechten Schenkel. --c-in: Abstand der Ecken vom Rand, --c-arm: Schenkellänge */
  /* Knopf (Marc, 02.11.2026): läuft das Video, sitzt „Video anhalten“ unten rechts in der Ecke. Angehalten (oder noch nicht
     gestartet) wandert er weich in die Mitte, verliert die Beschriftung und wird zum großen Play-Knopf; das Bild des
     Videos bleibt stehen. Lage über left/top/transform, damit sich die Bewegung überblenden lässt. */
  @media (max-width: 56.25em) {
    .lh { grid-template-columns: 1fr; }
    .lh::before { width: 120%; right: -40%; top: 40%; height: 60%; }
  }
  @media (max-width: 37.5em) {
    /* Handy: Eckdaten als gleich breite Spalten, damit nichts einzeln umbricht */
  }
</style>
