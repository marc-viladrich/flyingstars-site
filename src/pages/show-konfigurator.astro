---
// The configurator moved into the pricing page as its live preview (30.10.2026). This route stays as a redirect so
// old links keep working; direct links (?anlass=&paket=&motiv=) are passed on.
const target = '/drohnenshow-preise/#vorschau';
const canonical = new URL('/drohnenshow-preise/', Astro.site);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Live-Vorschau der Show | FlyingStars</title>
    <meta name="description" content="Die Live-Vorschau der Drohnenshow nach Anlass und Paket ist jetzt Teil der Preisseite von FlyingStars." />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <script is:inline>location.replace('/drohnenshow-preise/' + location.search + '#vorschau');</script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <style>body { margin: 0; padding: 15vh 24px; background: #0b0a0a; color: #f3eee6; font: 17px/1.6 system-ui, sans-serif; } a { color: inherit; }</style>
  </head>
  <body>
    <main>
      <h1>Die Live-Vorschau ist umgezogen.</h1>
      <p><a href={target}>Zur Live-Vorschau auf der Preisseite</a></p>
    </main>
  </body>
</html>
