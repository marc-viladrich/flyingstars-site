---
// Pricing page (variant A of Marc's concept, 30.10.2026): short head with the three package cards, directly below
// the live preview (occasion × package), then what every package pays for, the full comparison, extras, price
// questions and a closing invitation. Prices only from show-packages.ts, texts from package-details.ts.
import Base from '../layouts/Base.astro';
import Packages from '../components/sections/Packages.astro';
import ShowPreview from '../components/sections/ShowPreview.astro';
import '../styles/pricing.css';
import { SHOW_PACKAGES, PACKAGE_NAMES } from '../content/show-packages';
import { COMPARISON, COMPARISON_NOTE, INCLUDED, EXTRAS, PRICE_FAQ } from '../content/package-details';
const money = (v: number) => `ab ${v.toLocaleString('de-DE')} €`;
const faqLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: PRICE_FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') } })),
});
---
<Base title="Drohnenshow Preise: drei Pakete ab 7.900 €" description="Drei Drohnenshow-Pakete ab 7.900 € netto zzgl. Anfahrt, mit Live-Vorschau je Anlass. Design, Genehmigung und Team vor Ort sind immer enthalten.">
  <Packages
    type="packages"
    index={0}
    id="pakete"
    headline="Was eine Drohnenshow kostet."
    text="Drei Pakete ab 7.900 € netto zzgl. Anfahrt. Design, Genehmigung und das Team vor Ort sind in jedem Paket enthalten."
    compact={false}
  />

  <ShowPreview
    type="showPreview"
    index={1}
    id="vorschau"
    headline="Dasselbe Motiv, drei Pakete."
    text="Wählt einen Anlass und ein Paket. Die Vorschau zeigt, wie aus einem Bild in 2D ein Objekt in 3D und schließlich eine kleine Geschichte wird."
    anlass="hochzeit"
    paket="HORIZON"
  />

  <section class="section" aria-labelledby="incl-h">
    <div class="sec-head">
      <h2 id="incl-h">Wofür ihr bei jedem Paket bezahlt.</h2>
      <p>Der größte Teil der Arbeit steckt in Design, Genehmigung und einem sicheren Ablauf. Das ist immer dabei:</p>
    </div>
    <ul class="pr-incl">
      {INCLUDED.map((item) => <li><h3>{item.title}</h3><p>{item.text}</p></li>)}
    </ul>
  </section>

  <section class="section" id="leistungen" aria-labelledby="table-h">
    <div class="sec-head">
      <h2 id="table-h">Alle Leistungen im Vergleich.</h2>
    </div>
    <div class="pr-table-wrap" role="region" aria-labelledby="table-h" tabindex="0">
      <table class="pr-table">
        <caption class="sr-only">Leistungen der Pakete SPARK, HORIZON und ODYSSEY</caption>
        <colgroup><col class="k" /><col /><col /><col /></colgroup>
        <thead>
          <tr><td></td>{PACKAGE_NAMES.map((name) => <th scope="col"><b>{name}</b><span>{money(SHOW_PACKAGES[name].price)}</span></th>)}</tr>
        </thead>
        <tbody>
          {COMPARISON.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.all ? <td class="all" colspan="3">{row.all}</td> : row.cells!.map((cell) => cell === null
                ? <td class="no"><span aria-hidden="true">–</span><span class="sr-only">nicht enthalten</span></td>
                : <td>{cell}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="pr-fine">{COMPARISON_NOTE} Alle Preise netto zzgl. Anfahrt.</p>
  </section>

  <section class="section" id="zusaetze" aria-labelledby="extras-h">
    <div class="sec-head">
      <h2 id="extras-h">Zusätze.</h2>
      <p>Jedes Paket lässt sich erweitern. Was ein Zusatz kostet, steht vorab im Angebot.</p>
    </div>
    <ul class="pr-extras">
      {EXTRAS.map((x) => (
        <li>
          <h3>{x.title}</h3>
          <span class="price">{x.price}</span>
          <p>{x.text}</p>
          {x.link && <a class="link" href={x.link.href}>{x.link.label}</a>}
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-h">
    <div class="pr-faq">
      <div class="sec-head">
        <h2 id="faq-h">Fragen zum Preis.</h2>
        <p>Was in den meisten Gesprächen zum Preis gefragt wird.</p>
      </div>
      <div class="faq">
        {PRICE_FAQ.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <div class="answer">
              {f.a.map((p) => <p>{p}</p>)}
              {f.link && <a href={f.link.href} rel={f.link.href.startsWith('http') ? 'noopener' : undefined} target={f.link.href.startsWith('http') ? '_blank' : undefined}>{f.link.label}</a>}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="close-h">
    <div class="pr-close">
      <h2 id="close-h">Noch unsicher, welches Paket?</h2>
      <p>Schickt uns Datum und Ort, wir schlagen euch eins vor.</p>
      <a class="btn primary" href="/kontakt/?paket=beraten">Paket vorschlagen lassen</a>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={faqLd} />
</Base>
