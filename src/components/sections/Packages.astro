---
import { forPath } from '../../i18n/server';
const { t, localHref, formatLocale } = forPath(Astro.url.pathname);
import SectionHead from '../SectionHead.astro';
// Die drei Pakete im Prototyp-Look. Preis, Drohnenzahl und Farbe kommen nur aus src/content/show-packages.ts,
// die Texte aus dem YAML. compact: Karten wie auf der Startseite (Punktfigur, Name, Preis, eine Zeile);
// sonst ausführlich wie im Vercel-Prototyp: Kurzbeschreibung, Gruppen mit Punkten in der Paketfarbe (PACKAGE_FEATURES).
import type { Section } from '../../content.config';
import { SHOW_PACKAGES } from '../../content/show-packages';
import PackageCard from '../PackageCard.astro';
import MobileTabs from '../MobileTabs.astro';
type Props = Extract<Section, { type: 'packages' }> & { index: number };
const { headline, text, note, cta, compact, items, id = 'pakete', index, kicker } = Astro.props;
const H = index === 0 ? 'h1' : 'h2';
const C = index === 0 ? 'h2' : 'h3';
---
<section class="section alt" id={id} aria-labelledby={`${id}-h`}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} level={H} />
  {compact ? <div class="packs">{items.map((p) => <PackageCard packageId={p.name} variant="summary" headingId={`${id}-${p.name}`} level={C} highlight={p.highlight} badge={p.badge} label={p.label} sky={p.sky} pointsOverride={p.points?.map(item => item.value)} />)}</div> : (
    <div data-mtabs>
      <MobileTabs name={`${id}-tab`} label={t('mobileTabs.choosePackage')} initial={Math.max(0, items.findIndex((p) => p.highlight))} tabs={items.map((p) => ({ label: p.name, color: `rgb(${SHOW_PACKAGES[p.name].color.join(',')})` }))} />
      <div class="tiers-grid">{items.map((p, i) => <PackageCard packageId={p.name} variant="detailed" headingId={`${id}-${p.name}`} level={C} highlight={p.highlight} badge={p.badge} tabIndex={i} />)}</div>
    </div>
  )}
  {(note || cta) && <div class="pack-note">{note && <span class="mono">{note}</span>}{cta && <a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a>}</div>}
</section>
