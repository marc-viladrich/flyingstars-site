---
// Breites Bild als Bühne: Orte (Werbung) oder Einsatzarten (Indoor) liegen als Markierungen auf dem Bild, darunter
// Einträge (z. B. Referenzen mit Datum) links und Kennzahlen rechts. Bild mit Vorhang-Reveal, ohne Hover-Effekt.
import type { Section } from '../../content.config';
import SectionHead from '../SectionHead.astro';
import { optimizedImage } from '../../lib/media';
type Props = Extract<Section, { type: 'landingSpotlight' }> & { index: number };
const { kicker, headline, text, image, tags, entries, facts, id = `s${Astro.props.index}`, index } = Astro.props;
const H = index === 0 ? 'h1' : 'h2';
const T = index === 0 ? 'h2' : 'h3';
const wide = await optimizedImage(image.src, 960, 480);
const narrow = await optimizedImage(image.src, 640, 480);
---
<section class="section alt sp" id={id} aria-labelledby={`${id}-h`}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} level={H} />
  <figure class="sp-stage">
    <div class="sp-img" data-curtain>
      <picture>
        <source media="(max-width: 700px)" srcset={narrow.src} width={narrow.width} height={narrow.height} />
        <img src={wide.src} width={wide.width} height={wide.height} alt={image.alt} loading="lazy" decoding="async" />
      </picture>
    </div>
    {tags.length > 0 && <ul class="sp-tags" data-reveal-group>{tags.map((t, i) => <li class="mono" data-reveal style={`--i:${i}`}><span class="sp-pin" aria-hidden="true"></span>{t}</li>)}</ul>}
  </figure>
  {(entries.length > 0 || facts.length > 0) && (
    <div class="sp-below">
      {entries.length > 0 && <div class="sp-entries">{entries.map((e) => <article><span class="kicker mono">{e.kicker}</span><T>{e.title}</T>{e.text && <p>{e.text}</p>}</article>)}</div>}
      {facts.length > 0 && <dl class="sp-facts">{facts.map((f) => <div><dt class="mono">{f.label}</dt><dd>{f.value}</dd></div>)}</dl>}
    </div>
  )}
</section>

<style>
  .sp-stage { position: relative; margin: 0; }
  .sp-img { aspect-ratio: 2 / 1; border-radius: var(--radius); overflow: hidden; background: #0a0908; --curtain-r: var(--radius); }
  .sp-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sp-stage::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius); background: linear-gradient(0deg, rgba(15, 13, 12, 0.82), transparent 55%); pointer-events: none; }
  .sp-tags { position: absolute; z-index: 2; left: clamp(16px, 3vw, 40px); right: clamp(16px, 3vw, 40px); bottom: clamp(16px, 3vw, 36px); list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .sp-tags li { display: inline-flex; align-items: center; gap: 9px; padding: 9px 14px 9px 11px; border-radius: 999px; background: rgba(15, 13, 12, 0.7); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border: 1px solid rgba(246, 241, 232, 0.18); color: var(--text); letter-spacing: 0.06em; }
  .sp-pin { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); flex: none; }
  .sp-below { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 80px); margin-top: clamp(32px, 4vw, 56px); align-items: start; }
  .sp-entries { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: clamp(20px, 3vw, 40px); }
  .sp-entries article { display: grid; gap: 10px; align-content: start; padding-top: 18px; border-top: 1px solid var(--line); }
  .sp-entries .kicker { margin: 0; }
  .sp-entries h2, .sp-entries h3 { font-size: clamp(21px, 1.7vw, 25px); }
  .sp-entries p { margin: 0; color: var(--muted); max-width: 44ch; }
  .sp-facts { margin: 0; display: grid; gap: 0; }
  .sp-facts > div { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 16px; padding: 16px 0; border-top: 1px solid var(--line); }
  .sp-facts > div:last-child { border-bottom: 1px solid var(--line); }
  .sp-facts dt { color: var(--faint); }
  .sp-facts dd { margin: 0; font: 500 clamp(22px, 2vw, 30px)/1.1 var(--display); letter-spacing: -0.02em; color: var(--head); text-align: right; }
  @media (max-width: 900px) { .sp-below { grid-template-columns: 1fr; } }
  @media (max-width: 700px) {
    .sp-img { aspect-ratio: 4 / 3; }
    .sp-tags { position: static; margin-top: 14px; }
    .sp-stage::after { display: none; }
    .sp-tags li { background: var(--surface-2); }
  }
</style>
