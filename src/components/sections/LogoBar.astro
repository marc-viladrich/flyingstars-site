---
import IconFeature from '../IconFeature.astro';
import SectionHead from '../SectionHead.astro';
import { forPath } from '../../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
// Kund:innen als Laufband (ohne Hover-Effekt), darunter optional Presse und „Qualität und Sicherheit“
// (docs/DESIGN.md, Studie 6 der Designsprache-Probe). Logos liegen unter public/brand/logos/.
// Presse- und Partnerlogos erscheinen nur mit `cleared: true` (schriftliche Freigabe), sonst Text bzw. Verlaufs-Icon.
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import type { Section } from '../../content.config';
import { optimizedLogo } from '../../lib/media';
type Props = Extract<Section, { type: 'logoBar' }> & { index: number };
import Icon from '../Icon.astro';
const QICON = { permit: 'file-badge', sound: 'audio-lines', shield: 'shield-check', leaf: 'leaf' } as const;
const { headline, logos, pressHeadline = t('logoBar.pressHeadline'), pressItems, qualityHeadline = t('logoBar.qualityHeadline'), quality, kicker, id = `s${Astro.props.index}` } = Astro.props;

const file = (path: string) => join(process.cwd(), 'public', path);
const has = (path?: string) => Boolean(path && existsSync(file(path)));
// optische Größe: breite Wortmarken flacher, runde Bildmarken höher, damit alle gleich schwer wirken
const optical = (ratio: number) => Math.round(Math.min(46, Math.max(22, 30 * Math.sqrt(3 / ratio))));
// SVGs bekommen 4 % Luft um den viewBox (sonst wirken runde Marken angeschnitten). Statt den viewBox umzuschreiben
// (dann müsste das SVG inline in die Seite) wird die Luft als Innenabstand gesetzt: die Datei bleibt im Browser-Cache.
const svgSize = (path: string) => {
  const m = readFileSync(file(path), 'utf8').match(/viewBox="([\d.\s,-]+)"/);
  if (!m) return undefined;
  const [, , w, h] = m[1].trim().split(/[\s,]+/).map(Number);
  return { w, h };
};
const pngSize = (path: string) => { const b = readFileSync(file(path)); return { w: b.readUInt32BE(16), h: b.readUInt32BE(20) }; };
type Mark = { name: string; src: string; width: number; height: number; pad: string; detail: boolean; href?: string };
const marks = (await Promise.all(logos.map(async (logo): Promise<Mark | null> => {
  try {
    if (logo.file && has(logo.file)) {
      const size = logo.file.endsWith('.svg') ? svgSize(logo.file) : pngSize(logo.file);
      if (!size) return null;
      const p = logo.file.endsWith('.svg') ? Math.max(size.w, size.h) * 0.04 : 0;
      const ratio = (size.w + 2 * p) / (size.h + 2 * p), height = optical(ratio), width = Math.round(height * ratio);
      // Bildkoordinaten und intrinsische Maße bleiben unverändert; nur CSS-Ausgaben werden durch 16 geteilt.
      const pad = `${Number((p / (size.h + 2 * p) * height).toFixed(1)) / 16}rem ${Number((p / (size.w + 2 * p) * width).toFixed(1)) / 16}rem`;
      return { name: logo.name, src: logo.file, width, height, pad, detail: logo.detail, href: logo.href };
    }
    if (logo.image) {
      const img = await optimizedLogo(logo.image.src, 92), ratio = img.width / img.height, height = optical(ratio);
      return { name: logo.name, src: img.src, width: Math.round(height * ratio), height, pad: '0rem', detail: logo.detail, href: logo.href };
    }
  } catch {}
  return null;
}))).filter((m): m is Mark => Boolean(m));
// Presselogos im Raster wie „Qualität und Sicherheit“ (Marc 31.10.: die Kästen wirkten „out of whack“), optisch gleich
// schwer: breite Wortmarken flacher, kompakte Marken höher
const pressHeight = (path?: string) => { const v = path && has(path) ? svgSize(path) : undefined; return v ? Math.round(Math.min(40, Math.max(18, 26 * Math.sqrt(2.4 / (v.w / v.h))))) : 26; };
const press = pressItems.map((p) => ({ ...p, show: p.cleared && has(p.logo), h: pressHeight(p.logo) }));
const seals = quality.filter((q) => !q.secondary).map((q) => ({ ...q, show: q.cleared && has(q.logo) }));
const minor = quality.filter((q) => q.secondary);
---
{marks.length > 0 && <div class="band" role="region" aria-label={headline ?? t('logobar.flyingstarsClients')}>
  <div class="logo-marquee">
    {[0, 1].map((copy) => <ul class="track" aria-hidden={copy === 1 ? 'true' : undefined}>{marks.map((m) => {
      const img = <img class:list={{ detail: m.detail }} src={m.src} width={m.width} height={m.height} style={`height:${m.height / 16}rem;padding:${m.pad}`} alt={copy ? '' : m.name} loading="lazy" decoding="async" />;
      return <li>{m.href && !copy ? <a href={localHref(m.href)}>{img}</a> : img}</li>;
    })}</ul>)}
  </div>
</div>}
{(press.length > 0 || seals.length > 0) && <section class="section proof" id={id} aria-label={[press.length && pressHeadline, seals.length && qualityHeadline].filter(Boolean).join(', ')}>
  {press.length > 0 && <div class="press">
    <SectionHead variant="embedded" kicker={kicker} headline={pressHeadline} id={`${id}-press-h`} titleClass="proof-h" />
    <ul>{press.map((p) => {
      const inner = <>{p.show ? <img class:list={{ knock: p.knock }} src={p.logo} alt={p.name} style={`height:${p.h / 16}rem`} loading="lazy" decoding="async" /> : <b>{p.name}</b>}</>;
      return <li>{p.href ? <a href={localHref(p.href)} rel="noopener" target="_blank" title={p.note ? `${p.name}: ${p.note}` : undefined}>{inner}</a> : <span class="noref" title={p.note}>{inner}</span>}</li>;
    })}</ul>
  </div>}
  {seals.length > 0 && <div class="quality">
    <SectionHead variant="embedded" kicker={press.length ? undefined : kicker} headline={qualityHeadline} id={`${id}-quality-h`} titleClass="proof-h" />
    <ul>{seals.map((q) => <IconFeature as="li" icon={QICON[q.icon]} logo={q.show ? q.logo : undefined} title={q.title} text={q.text} />)}</ul>
    {minor.length > 0 && <ul class="q-minor">{minor.map((q) => <IconFeature as="li" variant="compact" icon={QICON[q.icon]} title={q.title} text={q.text} />)}</ul>}
  </div>}
</section>}
