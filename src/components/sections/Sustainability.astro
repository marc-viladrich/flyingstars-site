---
import type { Section } from '../../content.config';
import { optimizedLogo } from '../../lib/media';
type Props = Extract<Section, { type: 'sustainability' }> & { index: number };
const { headline, text, points = [], campaign, proofImage, id = 'nachhaltigkeit', index } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
// Compounds like "E-Transportern" must not break at their hyphen in the large type.
const parts = (point: string) => point.split(/(\S+-\S+)/).filter(Boolean);
const proof = proofImage ? await optimizedLogo(proofImage.src, 44) : undefined;
---
<section class="section" id={id} aria-labelledby={headingId}>
  <div class="sec-head"><H id={headingId}>{headline}</H><p>{text}</p></div>
  {points.length > 0 && <ul class="eco-points" role="list">{points.map(point => <li>{parts(point).map(part => part.includes('-') ? <span class="nowrap">{part}</span> : part)}</li>)}</ul>}
  {(campaign || proof) && <div class="eco-foot">
    {proofImage && proof && <img src={proof.src} width={proof.width} height={proof.height} alt={proofImage.alt} loading="lazy" decoding="async" />}
    {campaign && <p>{campaign}</p>}
  </div>}
</section>
