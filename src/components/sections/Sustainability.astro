---
// Nachhaltigkeit in 2D (docs/DESIGN.md: keine Scrollstory): Kopf, bis zu vier Kennzahlen als ruhiges Raster,
// optional kurze Sätze und ein Beleg. lines und tone sind Altlasten der früheren Scrollstory und werden ignoriert.
import type { Section } from '../../content.config';
import { optimizedLogo } from '../../lib/media';
import Accent from '../Accent.astro';
type Props = Extract<Section, { type: 'sustainability' }> & { index: number };
const { headline, text, id = 'nachhaltigkeit', facts = [], points = [], proofImage, proofText, campaign, index } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
// Komposita wie „E-Transportern“ nicht am Bindestrich umbrechen
const parts = (point: string) => point.split(/(\S+-\S+)/).filter(Boolean);
const proof = proofImage ? await optimizedLogo(proofImage.src, 60) : undefined;
---
<section class="eco-sec" id={id} aria-labelledby={headingId}>
  <div class="sec-head"><H id={headingId}><Accent text={headline} /></H>{text && <p>{text}</p>}</div>
  {facts.length > 0 && <dl class="eco-facts">{facts.map((fact, i) => <div class="eco-fact"><dt class="fk mono">{String(i + 1).padStart(2, '0')} · {fact.label}</dt><dd class="fn">{fact.value}{fact.unit && <small>{fact.unit}</small>}</dd><dd><p>{fact.text}</p></dd></div>)}</dl>}
  {points.length > 0 && <ul class="eco-points">{points.map((point) => <li><span>{parts(point).map((part) => part.includes('-') ? <span class="nowrap">{part}</span> : part)}</span></li>)}</ul>}
  {(proofText || campaign || proof) && <div class="eco-proof">
    {proofImage && proof && <img src={proof.src} width={proof.width / 2} height={proof.height / 2} alt={proofImage.alt} loading="lazy" decoding="async" />}
    <p>{proofText}{campaign && <> <b>#Böllerciao:</b> {campaign}</>}</p>
  </div>}
</section>
