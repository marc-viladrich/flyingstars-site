---
import { forPath } from '../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
import Chopper from './Chopper.astro';
// 404 nach Moritz (Runde 4, 18.11.2026): „Error 404“, Chopper hat sich verlaufen und ist traurig, ein Weg zurück.
// Kicker und Schlagzeile bilden zusammen die h1 (Konvention aus SectionHead). Eingebettet (level h2) bleibt die Seite
// bei einer h1.
interface Props { level?: 'h1' | 'h2'; }
const { level = 'h1' } = Astro.props;
const H = level;
---
{/* Der Seitenrahmen gehört zur Komponente, damit DE und EN/NL nicht auseinanderlaufen (Runde 22) */}
<div class="page-404">
  <div class="chopper">
    <div class="chopper-stage"><Chopper mood="sad" /></div>
    <div class="chopper-copy">
      <H class="chopper-h"><span class="kicker mono">{t('404.kicker')}</span> <span class="head-line">{t('404.headline')}</span></H>
      <p>{t('404.text')}</p>
      <a class="btn primary" href={localHref('/')}>{t('404.cta')}</a>
    </div>
  </div>
</div>

<style>
  /* Kein Karton um Chopper: nur ein schwacher Lichtschein am Boden, der Hund ist das dominante Element */
  .chopper-stage { aspect-ratio: auto; background: radial-gradient(48% 22% at 50% 78%, rgb(var(--rgb-logo-amber) / 0.07), transparent 70%); border-radius: 0; }
  .chopper-h .kicker { display: block; margin: 0 0 var(--space-3-5); }
  .chopper-h .head-line { display: block; }
  .chopper-copy .btn { margin-top: var(--space-2); }
</style>
