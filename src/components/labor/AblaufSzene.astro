---
// Labor Blogbilder, „Im Artikel“: die Schrägansicht der Standortgrafik (components/landing/site-scene.ts, outdoorScene)
// als Prozessgrafik im Artikeltext. Je Schritt ein anderer Ausschnitt und eine andere Hervorhebung: 1 Startfeld (nah,
// Drohnen gehen nacheinander an), 2 Aufstieg (Flugbereich, Drohnen steigen als Raster), 3 Formation (ganze Szene, das
// Raster formt ein Herz). Läuft einmal, wenn die Grafik ins Bild kommt; bei reduzierter Bewegung steht der Endzustand.
import { SCENE_COLORS, ABLAUF_ZONES } from '../blog/scene-palette';
import { outdoorScene } from '../landing/site-scene';
interface Props { step: 1 | 2 | 3; label: string }
const { step, label } = Astro.props;
const colors = SCENE_COLORS;
const zoneColor: Record<string, string> = ABLAUF_ZONES;
const scene = outdoorScene({ colors, horizontal: '', detail: '', motif: 'heart' });
// Ausschnitt je Schritt: Rahmen um die Punkte, die der Schritt zeigt, auf 16:9 erweitert
const box = (pts: number[][], pad: number) => {
  const xs = pts.map((p) => p[0]), ys = pts.map((p) => p[1]);
  let x0 = Math.min(...xs) - pad, x1 = Math.max(...xs) + pad, y0 = Math.min(...ys) - pad, y1 = Math.max(...ys) + pad;
  const w = x1 - x0, h = y1 - y0;
  if (w / h < 16 / 9) { const d = (h * 16 / 9 - w) / 2; x0 -= d; x1 += d; } else { const d = (w * 9 / 16 - h) / 2; y0 -= d; y1 += d; }
  return [x0, y0, x1 - x0, y1 - y0].map((v) => Math.round(v * 10) / 10);
};
const vb = step === 1 ? box(scene.drones.map((d) => d.g), 90) : step === 2 ? box(scene.drones.flatMap((d) => [d.g, d.l]), 80) : scene.vb;
const focus = step === 1 ? 'start' : step === 2 ? 'drones' : '';
const from = step === 1 ? 'off' : step === 2 ? 'grid' : 'lift';
const to = step === 1 ? 'grid' : step === 2 ? 'lift' : 'motif';
---
<div class="as-fig" data-as-fig data-phase={to} data-from={from} data-to={to} data-focus={focus || undefined} data-step={step}>
  <svg viewBox={vb.join(' ')} role="img" aria-label={label}>
    {scene.layers.map((layer) => layer.key === 'drones'
      ? <g class="as-drones" aria-hidden="true">{scene.drones.map((d) => <g class="dr" style={`--gx: ${d.g[0]}px; --gy: ${d.g[1]}px; --lx: ${d.l[0]}px; --ly: ${d.l[1]}px; --mx: ${d.m[0]}px; --my: ${d.m[1]}px; --c: ${d.c}; --k: ${d.k}`}><circle class="halo" r={step === 1 ? 3 : 4.4} /><circle class="core" r={step === 1 ? 1.2 : 2} /></g>)}</g>
      : <g aria-hidden="true">
          {layer.groups.map((g) => {
            const shapes = g.items.map((it) => it.t === 'circle' ? <circle class={it.cls} cx={it.cx} cy={it.cy} r={it.r} /> : <path class={it.cls} d={it.d} />);
            return g.zone ? <g class="zone" data-zone={g.zone} style={`--zc: ${zoneColor[g.zone]}`}>{shapes}</g> : <g>{shapes}</g>;
          })}
          {layer.key === scene.crowd.layer && <g class="zone" data-zone="guests" style={`--zc: ${zoneColor.guests}`}>{scene.crowd.people.map((q) => <g transform={`translate(${q.h[0]} ${q.h[1]})`}>{q.items.map((it) => it.t === 'circle' ? <circle class={it.cls} cx={it.cx} cy={it.cy} r={it.r} /> : <path class={it.cls} d={it.d} />)}</g>)}</g>}
        </g>)}
  </svg>
</div>

<script>
  // Einmal je Grafik: steht sie zur Hälfte im Bild, läuft der Schritt von seinem Anfangs- in den Endzustand. Grafiken,
  // die beim Laden schon zu sehen sind, bleiben im Endzustand (kein Sprung zurück).
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-as-fig]').forEach((fig) => {
    if (still || !('IntersectionObserver' in window)) return;
    const r = fig.getBoundingClientRect();
    if (r.top < innerHeight && r.bottom > 0) return;
    fig.dataset.phase = fig.dataset.from;
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      requestAnimationFrame(() => requestAnimationFrame(() => { fig.dataset.phase = fig.dataset.to; }));
    }, { threshold: 0.55 });
    io.observe(fig);
  });
</script>

<style>
  .as-fig { --ground: var(--media-ground); border-radius: var(--radius-14); background: var(--media-ground); overflow: hidden; }
  .as-fig svg { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }
  .ground { fill: rgb(var(--rgb-head) / 2.5%); stroke: rgb(var(--rgb-head) / 8%); stroke-width: 0.6; }
  .road { fill: rgb(var(--rgb-head) / 5%); }
  .park { fill: rgb(var(--rgb-good) / 6%); }
  .tree { fill: rgb(var(--rgb-good) / 16%); }
  .house-front { fill: rgb(var(--rgb-head) / 7%); stroke: rgb(var(--rgb-head) / 9%); stroke-width: 0.5; }
  .house-side { fill: rgb(var(--rgb-head) / 4.5%); stroke: rgb(var(--rgb-head) / 9%); stroke-width: 0.5; }
  .house-top { fill: rgb(var(--rgb-head) / 10%); stroke: rgb(var(--rgb-head) / 12%); stroke-width: 0.5; }
  .zplate { fill: color-mix(in srgb, var(--zc) 16%, var(--ground)); stroke: color-mix(in srgb, var(--zc) 75%, transparent); stroke-width: 1.2; }
  .zplate-edge { fill: color-mix(in srgb, var(--zc) 34%, var(--ground)); }
  .pad { fill: color-mix(in srgb, var(--zc) 20%, var(--ground)); stroke: color-mix(in srgb, var(--zc) 80%, transparent); stroke-width: 1; }
  .pad-edge { fill: color-mix(in srgb, var(--zc) 45%, var(--ground)); }
  .guest-dot { fill: var(--zc); }
  .view { fill: none; stroke: var(--zc); stroke-width: 1; stroke-dasharray: 3 4; opacity: 0.8; }
  .guide { fill: none; stroke: rgb(var(--rgb-head) / 22%); stroke-width: 0.8; stroke-dasharray: 1.5 3.5; }

  /* Hervorhebung: die Zone des Schritts in voller Farbe, der Rest tritt zurück */
  .zone { transition: opacity var(--dur-glide) var(--ease-default); }
  [data-focus] .zone:not([data-zone="start"]):not([data-zone="drones"]) { opacity: 0.3; }
  [data-focus="start"] .zone[data-zone="drones"] { opacity: 0.45; }
  [data-focus="drones"] .zone[data-zone="start"] { opacity: 0.6; }
  [data-focus] .zone[data-zone] :is(.zplate, .pad) { stroke-width: 1.6; }
  [data-step="3"] .zone { opacity: 0.55; }

  /* Drohnen: Startraster → Aufstieg → Motiv, zeitversetzt wie in der Standortgrafik */
  .dr { transform: translate(var(--mx), var(--my)); transition: transform var(--dur-slow) var(--ease-scene) calc(var(--k) * var(--dur-stagger) / 2), opacity var(--dur-fade) var(--ease-out) calc(var(--k) * var(--dur-stagger)); }
  :is([data-phase="grid"], [data-phase="off"]) .dr { transform: translate(var(--gx), var(--gy)); }
  [data-phase="lift"] .dr { transform: translate(var(--lx), var(--ly)); transition-delay: calc(var(--k) * var(--dur-stagger) / 8); }
  [data-phase="off"] .dr { opacity: 0.15; }
  .dr .core { fill: var(--c); transition: fill var(--dur-slow) var(--ease-default); }
  .dr .halo { fill: var(--c); opacity: 0.18; transition: opacity var(--dur-slow) var(--ease-default); }
  :is([data-phase="grid"], [data-phase="lift"], [data-phase="off"]) .dr .core { fill: var(--head); }
  :is([data-phase="grid"], [data-phase="off"]) .dr .halo { opacity: 0.1; }
  @media (prefers-reduced-motion: reduce) { .dr, .dr *, .zone { transition: none !important; } }
</style>
