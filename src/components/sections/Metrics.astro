---
import Styles from '../Styles.astro';
import ownerStyle0 from './Metrics.css?url';
import FactList from '../FactList.astro';
import { forPath } from '../../i18n/server';
const { localHref } = forPath(Astro.url.pathname);
import type { Section } from '../../content.config';
import Accent from '../Accent.astro';
import SectionHead from '../SectionHead.astro';
type Props = Extract<Section, { type: 'metrics' }> & { index: number };
const { headline, text, id = 'warum', items, cta, index, kicker } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
---
<Styles href={ownerStyle0} id="components/sections/Metrics.css" />
<section class="section alt" id={id} aria-labelledby={headingId}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={headingId} level={H} />
  <FactList items={items} variant="metrics" />
  {cta && <div class="more"><a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a></div>}
</section>
