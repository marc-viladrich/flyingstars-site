---
import Styles from './Styles.astro';
import ownerStyle0 from './MediaCard.css?url';
// Titel im Unterstrich-Effekt (.hover-line, Runde 20c). WebKit wendet text-wrap: balance nicht auf Text in einem
// Inline-Element an; deshalb verbindet joinLastWords die letzten zwei Wörter (sonst Einzelwort in der letzten Zeile).
import { joinLastWords } from '../lib/no-orphans';
// Die Fachadapter liefern Bild und Inhalte; Rahmen, Badge und Hover-Ziel gehören dieser Karte.
interface Props { variant?: 'reference' | 'editorial' | 'story' | 'occasion'; href?: string; title: string; level?: 'h2' | 'h3' | 'h4'; summary?: string; kicker?: string; badge?: string; badgeAttributes?: Record<string,unknown>; i?: number; hasMedia?: boolean; dot?: boolean; loop?: 'auto' | 'hover'; season?: string; class?: string; [key: string]: unknown }
const { variant = 'reference', href, title, level: H = 'h3', summary, kicker, badge, badgeAttributes = {}, i = 0, hasMedia = true, dot = true, loop, season, class: cls, ...rest } = Astro.props;
const titleHtml = joinLastWords(title.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'));
if (href && Astro.slots.has('actions')) throw new Error('Eine verlinkte MediaCard darf keine weiteren Aktionslinks enthalten.');
const Tag = href ? 'a' : 'article';
const root = variant === 'occasion' ? 'occ' : variant === 'story' ? 'ls-card' : 'proj';
const mediaClass = variant === 'story' ? 'ls-img' : 'img';
const bodyClass = variant === 'occasion' ? 'body' : variant === 'story' ? 'ls-body' : 'media-card-body';
const kickerClass = variant === 'occasion' ? 'cat mono' : variant === 'story' ? 'kicker mono' : 'kick mono';
---
<Styles href={ownerStyle0} id="components/MediaCard.css" />
<Tag class:list={[root, cls]} href={href} data-dot-host={dot ? '' : undefined} data-loop-host={loop} data-season={season} {...rest}>
  {hasMedia && <div class={mediaClass} data-curtain data-dot-img={dot ? '' : undefined} style={`--i:${i}`}>
    <slot name="media" />
    {badge && <span {...badgeAttributes} class:list={['mono', variant === 'story' ? 'ls-badge' : 'count']}>{badge}</span>}
  </div>}
  <div class={bodyClass}>
    <slot name="meta">{kicker && <span class={kickerClass}>{kicker}</span>}</slot>
    <H><span class="hover-line" set:html={titleHtml} /></H>{summary && <p>{summary}</p>}
    <slot name="facts" /><slot name="actions" />
  </div>
</Tag>
