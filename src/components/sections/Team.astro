---
import Styles from '../Styles.astro';
import portraitStyles from '../Portrait.css?url';
import ownerStyle0 from './Team.css?url';
import {teamMember} from '../../content/people.mjs';
import {field} from 'astro-frontend-editor/markers';
import { forPath } from '../../i18n/server';
const { t, localHref, locale } = forPath(Astro.url.pathname);
// Team: große Porträts mit Vorhang-Reveal (CSS, html.reveal) und Lichtpunkt-Hover; kein Foto-Zoom.
import type { Section } from '../../content.config';
import { optimizedImage } from '../../lib/media';
import Accent from '../Accent.astro';
import SectionHead from '../SectionHead.astro';
type Props = Extract<Section, { type: 'team' }> & { index: number };
const { headline, text, members, note, cta, id = `s${Astro.props.index}`, index, kicker } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
const Name = index === 0 ? 'h2' : 'h3';
const initials = (name: string) => name.trim().split(/\s+/).filter((_,i,a)=>i===0||i===a.length-1).map(part=>part[0]).join('').toUpperCase();
// Spalten ohne Waisen: bis 5 Karten in einer Reihe, 6 → 3 × 2, sonst 4 oder 3, je nachdem, was aufgeht
const n = members.length;
const cols = n <= 5 ? n : n % 4 === 0 ? 4 : n % 3 === 0 ? 3 : 4;
const crew = await Promise.all(members.map(async item => {const member=teamMember(item,undefined,locale);return {...member, media: member.image ? await optimizedImage(member.image.src, 640) : undefined};}));
---
<Styles href={ownerStyle0} id="components/sections/Team.css" />
<Styles href={portraitStyles} id="components/Portrait.css" />
<section class="team-sec" id={id} aria-labelledby={headingId}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={headingId} level={H} />
  <ul class="crew" style={`--cols:${cols}`} data-odd={n % 2 === 1 ? '' : undefined}>{crew.map((member,i) => <li class="member" style={`--i:${i}`} data-dot-host>
    <div {...field({collection:"people",id:member.personId},["image"],{mode:"panel"})} class="portrait" data-dot-img={member.media ? '' : undefined} data-step="6">{member.image && member.media ? <img src={member.media.src} width={member.media.width} height={member.media.height} alt={member.image.alt} loading="lazy" decoding="async" /> : <><span class="ini" aria-hidden="true">{initials(member.name)}</span><span class="soon mono">{t('team.photoComingSoon')}</span></>}</div>
    <span {...field({collection:"people",id:member.personId},["role",locale])} class="role mono">{member.role}</span><Name {...field({collection:"people",id:member.personId},["name"])}>{member.name}</Name>{member.bio && <p {...field({collection:"people",id:member.personId},["bio",locale])}>{member.bio}</p>}
  </li>)}</ul>
  {(note || cta) && <p class="crew-note">{note && <span>{note}</span>}{cta && <a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a>}</p>}
</section>
