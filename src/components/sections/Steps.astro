---
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'steps' }> & { index: number };
const { headline, text, steps, id = `s${Astro.props.index}`, index } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
---
<section class="section" id={id} aria-labelledby={headingId}>
  <div class="sec-head"><H id={headingId}>{headline}</H>{text && <p>{text}</p>}</div>
  <ol class="steps" data-count={steps.length}>{steps.map((step, i) => <li><span class="step-n num" aria-hidden="true">{i + 1}</span><h3>{step.title}</h3><p>{step.text}</p>{step.duration && <span class="step-meta">{step.duration}</span>}</li>)}</ol>
</section>
