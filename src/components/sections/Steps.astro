---
import type { Section } from '../../content.config';
import Accent from '../Accent.astro';
import SectionHead from '../SectionHead.astro';
type Props = Extract<Section, { type: 'steps' }> & { index: number };
const { headline, text, steps, id = `s${Astro.props.index}`, index, kicker } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
---
<section class="section" id={id} aria-labelledby={headingId}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={headingId} level={H} />
  <ol class="steps">{steps.map(step => <li><h3>{step.title}</h3><p>{step.text}</p>{step.duration && <span class="t mono">{step.duration}</span>}</li>)}</ol>
</section>
