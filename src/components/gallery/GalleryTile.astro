---
// Eine Kachel der Galerie (Gallery.astro): Link zur Referenzseite oder figure. Stile stehen in Gallery.astro (global
// unter .gal), damit beide Layouts (Treppe breit, Mauerwerk schmal) sie steuern.
interface Props { href?: string; alt: string; caption: string; src: string; width: number; height: number; avif: string; webp: string; style: string }
const { href, alt, caption, src, width, height, avif, webp, style } = Astro.props;
const Tag = href ? 'a' : 'figure';
const Cap = href ? 'span' : 'figcaption';
const sizes = '(min-width: 68.8125em) min(17vw, 21rem), (min-width: 44em) 30vw, 45vw';
---
<Tag class="g-tile" href={href} style={style}>
  <div class="g-media" data-curtain>
    <picture>
      <source type="image/avif" srcset={avif} sizes={sizes} />
      <source type="image/webp" srcset={webp} sizes={sizes} />
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    </picture>
  </div>
  {caption && <Cap class="g-cap mono">{caption}</Cap>}
</Tag>
