---
import Cornerstone from './Cornerstone.astro';
import FormationFinale from './FormationFinale.astro';
import { checkPlan, splitSections, withoutStaticLogo, type CornerstoneArticle, type CornerstoneBlock } from './cornerstone/types';
import type { Story } from './story-scene';

interface Props { postId: string; article?: CornerstoneArticle; preserveImages?: boolean }
const { postId, article, preserveImages } = Astro.props;
// Use Astro's rendered Markdown so original images keep their optimized sources and dimensions.
const rendered = await Astro.slots.render('default');
const html = preserveImages ? rendered : withoutStaticLogo(rendered);
const sections = article ? splitSections(html, article.layout !== 'basic' && article.dropBodyImages) : [];
const stories = new Map<CornerstoneBlock, Story>();
if (article && article.layout !== 'basic') {
  for (const block of article.blocks) if (block.kind === 'story') stories.set(block, block.scene());
}
const problem = article && article.layout !== 'basic' ? checkPlan(article, sections, stories) : undefined;
if (problem) console.warn(`[cornerstone] ${postId}: ${problem} – normales Blogformat`);
---
{article && !problem
  ? <Cornerstone article={article} sections={sections} stories={stories} />
  : <div class="post-body" set:html={html} />}
{!preserveImages && (!article || problem || article.layout === 'basic') && <FormationFinale visualOnly />}
