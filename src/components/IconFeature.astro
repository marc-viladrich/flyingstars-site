---
import Icon from './Icon.astro';
import LocalImage from './LocalImage.astro';
interface Props { icon?: string; logo?: string; title: string; text?: string; level?: 'h2' | 'h3'; class?: string; as?: 'div' | 'li' | 'label'; variant?: 'default' | 'compact'; textId?: string; iconClass?: string }
const { icon, logo, title, text, level: H = 'h3', as: Tag = 'div', variant = 'default', class: cls, textId, iconClass, ...rest } = Astro.props;
---
<Tag class:list={['icon-feature', { 'icon-feature-compact': variant === 'compact' }, cls]} {...rest}>
  <slot name="before" />
  {logo ? <LocalImage class="q-logo" mono src={logo} alt="" loading="lazy" decoding="async" /> : icon && <Icon name={icon} size={variant === 'compact' ? 18 : 36} class={`g ic-ico ${iconClass ?? ''}`} />}
  <H class="ic-h"><slot name="title">{title}</slot></H><slot name="sub" />{text && <p id={textId}>{text}</p>}
  <slot />
</Tag>
<style is:global>
  .icon-feature { display: grid; gap: var(--space-2-5); align-content: start; justify-items: start; }
  .icon-feature > .ico { width: 2.25rem; height: 2.25rem; }
  .icon-feature > p { margin: 0; color: var(--muted); font-size: var(--text-control); }
  .icon-feature-compact { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--space-1-5); }
  .icon-feature-compact > .ico { width: 1.125rem; height: 1.125rem; align-self: center; margin: 0 var(--space-1) 0 0; }
  .icon-feature-compact > .ic-h, .icon-feature-compact > p { font: inherit; color: inherit; }
  /* Handy (Marc, 21.11.2026: „on mobile sollten solche Icons in line mit dem Text sein, sonst isses awkward“): Icon links
     neben der Überschrift statt darüber, alles Weitere (Untertitel, Text, Preis, Links) darunter über die volle Breite.
     Gilt für jede Icon-Zelle mit Icon (nicht für Logos und die kompakte Zeile). Wächter: tests/icon-inline.spec.ts */
  @media (--compact) {
    .icon-feature:not(.icon-feature-compact):has(> .ico) { grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-3); align-items: center; }
    .icon-feature:not(.icon-feature-compact):has(> .ico) > * { grid-column: 1 / -1; }
    .icon-feature:not(.icon-feature-compact):has(> .ico) > .ico { grid-column: 1; width: 1.75rem; height: 1.75rem; margin: 0; }
    .icon-feature:not(.icon-feature-compact):has(> .ico) > .ic-h { grid-column: 2; }
  }
</style>
