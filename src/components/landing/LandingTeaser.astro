---
// Konfigurator-Teaser auf den Anlass-Seiten (Marc, 31.10.2026: „mindestens so ein Konfigurator-Teaser, damit man
// unterschiedliche Motive sieht“). Kopf wie jede Section, Ziel und Knopf je Anlass. Der Teaser selbst
// (src/components/configurator/ConfiguratorTeaser.astro) gehört dem Konfigurator; hier nur die Props id, href, cta.
import type { Section } from '../../content.config';
import TeaserSection from '../TeaserSection.astro';
import ConfiguratorTeaser from '../configurator/ConfiguratorTeaser.astro';
type Props = Extract<Section, { type: 'landingTeaser' }> & { index: number };
// `loop` (marke | hochzeit | start): anlassspezifischer Ablauf des Teasers (Runde 9, Prop `reel` am Teaser)
const { kicker, headline, text, href, cta, loop, id = 'motive', index } = Astro.props;
---
<TeaserSection __afe={(Astro.props as any).__afe} type={Astro.props.type} id={id} index={index} kicker={kicker} headline={headline} text={text}>
  <ConfiguratorTeaser id={`${id}-cft`} href={href} cta={cta} reel={loop} />
</TeaserSection>
