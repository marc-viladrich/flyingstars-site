---
import Base from '../layouts/Base.astro';
import { OCCASIONS, STEPS } from '../content/show-configurator.js';
import { SHOW_PACKAGES } from '../content/show-packages';

// Prototype for FlyingStars: not linked in the navigation and not indexed until FlyingStars approves the mapping.
// Two choices: Anlass (two motifs to look at) and Aufwand (one step per package, so the price follows the slider).
// Every motif has one version per package; the motif tabs under the picture switch between the two motifs.
const list = OCCASIONS;
const start = 1;
const money = (v: number) => `ab ${v.toLocaleString('de-DE')} €`;
const startPkg = STEPS[start].pkg as keyof typeof SHOW_PACKAGES;
const first = SHOW_PACKAGES[startPkg];
const firstCaption = list[0].motifs[0].tiers[startPkg].caption;
---
<Base title="Show-Konfigurator (Prototyp)" description="Prototyp: Show nach Anlass und Aufwand zusammenstellen. Paket, Drohnenzahl und Preis ergeben sich aus den beiden Angaben." noindex fullBleed>
  <section class="cfg" aria-labelledby="cfg-h">
    <div class="cfg-stage" aria-label="Vorschau der Show">
      <canvas id="cfg-field" aria-hidden="true"></canvas>
      <div class="cfg-caption"><em id="cfg-new">{STEPS[start].pkg}</em><span id="cfg-scene">{firstCaption}</span></div>
      <span class="cfg-count mono" id="cfg-count">{first.base} Drohnen</span>
      <div class="cfg-motifs" id="cfg-motifs" role="group" aria-label="Motiv">{list[0].motifs.map((m, i) => <button type="button" data-motif={i} aria-pressed={i === 0 ? 'true' : 'false'}>{m.label}</button>)}</div>
    </div>

    <form class="cfg-panel" id="cfg">
      <h1 id="cfg-h" class="cfg-h">Was soll am Himmel passieren?</h1>

      <fieldset class="cfg-block">
        <legend>Anlass</legend>
        <div class="cfg-occasions">
          {list.map((o, i) => <label><input type="radio" name="occasion" value={o.id} checked={i === 0} /><span>{o.label}</span></label>)}
        </div>
      </fieldset>

      <div class="cfg-block">
        <label for="cfg-step">Wie aufwendig? <b id="cfg-step-label">{STEPS[start].label}</b></label>
        <input class="range" id="cfg-step" type="range" min="0" max={STEPS.length - 1} step="1" value={start} />
        <div class="cfg-stops mono" aria-hidden="true">{STEPS.map((s, i) => <span data-stop={i} class:list={{ on: i === start }}>{s.pkg}</span>)}</div>
      </div>

      <div class="cfg-result" aria-live="polite">
        <div class="cfg-price"><b id="cfg-pkg">{STEPS[start].pkg}</b><span id="cfg-price">{money(first.price)}</span></div>
        <p class="cfg-meta mono" id="cfg-meta">{first.base} Drohnen · {first.dur} · netto zzgl. Anfahrt</p>
        <p class="cfg-includes" id="cfg-includes">Enthalten: {STEPS[start].includes}.</p>
      </div>
      <a class="btn primary cfg-cta" id="cfg-cta" href="/#anfrage">Mit dieser Show anfragen</a>
      <p class="cfg-note">Prototyp: Die Vorschau zeigt Beispiele, den Ablauf eurer Show entwickeln wir gemeinsam. Die Zuordnung zu den Paketen ist aus den Paketbeschreibungen abgeleitet und noch nicht von FlyingStars bestätigt. Alle Preise sind Einstiegspreise.</p>
    </form>

    <div class="cfg-bar" aria-hidden="true"><span><b id="cfg-bar-pkg">{STEPS[start].pkg}</b> <span id="cfg-bar-price">{money(first.price)}</span></span><a class="btn small primary" href="/#anfrage" id="cfg-bar-cta" tabindex="-1">Anfragen</a></div>
  </section>
  <noscript><p class="section">Der Show-Konfigurator benötigt JavaScript. Die Pakete findest du unter <a href="/drohnenshow-preise/">Preise</a>.</p></noscript>
</Base>

<script>
  import '../scripts/show-configurator.js';
</script>

<style>
  .cfg { display: grid; grid-template-columns: minmax(320px, 0.62fr) minmax(0, 1.38fr); gap: clamp(24px, 4vw, 56px); padding: 92px var(--pad) var(--section); align-items: start; }
  .cfg-stage { order: 2; position: sticky; top: 92px; height: calc(100svh - 116px); min-height: 460px; border-radius: var(--radius); background: radial-gradient(ellipse at 50% 120%, rgba(51, 237, 242, 0.06), transparent 60%), #0a0908; border: 1px solid var(--line); overflow: hidden; }
  .cfg-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cfg-caption { position: absolute; left: 20px; top: 18px; right: 140px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 14px; color: var(--muted); }
  .cfg-caption em { font: 500 11px/1 var(--mono); font-style: normal; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ground); background: var(--pkg, var(--amber)); padding: 5px 8px; border-radius: 4px; }
  .cfg-count { position: absolute; right: 20px; top: 20px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text); }
  .cfg-motifs { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); display: flex; gap: 4px; padding: 4px; border: 1px solid var(--line); border-radius: 999px; background: rgba(15, 13, 12, 0.72); }
  .cfg-motifs :global(button) { min-height: 40px; padding: 0 18px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font: 500 14px/1 var(--body); cursor: pointer; }
  .cfg-motifs :global(button[aria-pressed="true"]) { background: var(--text); color: var(--ground); }
  .cfg-motifs :global(button:focus-visible) { outline: 3px solid var(--cyan); outline-offset: 2px; }
  .cfg-panel { order: 1; display: grid; gap: 22px; }
  .cfg-h { font-size: clamp(30px, 3vw, 46px); line-height: 1.04; letter-spacing: -0.03em; }
  .cfg-block { display: grid; gap: 12px; border: 0; margin: 0; padding: 0; min-width: 0; }
  .cfg-block > label, .cfg-block legend { font-size: 15px; color: var(--text); padding: 0; margin-bottom: 10px; }
  .cfg-block > label b { margin-left: 8px; color: var(--amber); font-weight: 500; }
  .cfg-occasions { display: flex; flex-wrap: wrap; gap: 8px; }
  .cfg-occasions label { position: relative; cursor: pointer; }
  .cfg-occasions input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
  .cfg-occasions span { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 999px; border: 1px solid var(--line-strong); font-size: 15px; color: var(--muted); }
  .cfg-occasions input:checked + span { color: var(--ground); background: var(--text); border-color: var(--text); }
  .cfg-occasions input:focus-visible + span { outline: 3px solid var(--cyan); outline-offset: 2px; }
  .cfg-stops { display: flex; justify-content: space-between; font-size: 11px; letter-spacing: 0.08em; color: var(--faint); margin-top: -4px; }
  .cfg-stops span.on { color: var(--text); }
  .cfg-result { display: grid; gap: 6px; padding-top: 18px; border-top: 1px solid var(--line); }
  .cfg-price { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
  .cfg-price b { font: 600 clamp(24px, 2.2vw, 30px)/1 var(--display); letter-spacing: 0.02em; }
  .cfg-price span { font: 500 clamp(24px, 2.2vw, 30px)/1 var(--display); color: var(--text); }
  .cfg-meta { margin: 0; font-size: 12px; letter-spacing: 0.06em; color: var(--muted); text-transform: uppercase; }
  .cfg-includes { margin: 6px 0 0; color: var(--muted); font-size: 15px; }
  .cfg-cta { justify-self: start; }
  .cfg-note { margin: 0; font-size: 12.5px; color: var(--faint); line-height: 1.5; }
  .cfg-bar { display: none; }
  @media (max-width: 1000px) {
    .cfg { grid-template-columns: 1fr; padding-top: 64px; gap: 22px; padding-bottom: 120px; }
    .cfg-stage { order: 0; top: 64px; z-index: 5; height: 46svh; min-height: 290px; margin: 0 calc(var(--pad) * -1); border-radius: 0; border-left: 0; border-right: 0; }
    .cfg-h { font-size: clamp(26px, 7vw, 36px); }
    .cfg-panel { gap: 22px; }
    .cfg-caption { font-size: 13px; right: 110px; }
    /* price and inquiry stay in reach while the visitor slides */
    .cfg-bar { position: fixed; z-index: 15; inset: auto 0 0 0; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px var(--pad) calc(12px + env(safe-area-inset-bottom, 0px)); background: rgba(15, 13, 12, 0.94); border-top: 1px solid var(--line); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); font-size: 15px; }
    .cfg-bar b { letter-spacing: 0.06em; margin-right: 6px; }
  }
</style>
