---
import {formOccasions} from '../../content/occasions.mjs';
import {PACKAGE_NAMES,packageLabel} from '../../content/package-identity.mjs';
import {CONTACT} from '../people';
import SectionHead from '../SectionHead.astro';
import { forPath } from '../../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
import { SHOW_PACKAGES } from '../../content/show-packages';
import { getPackageDetails } from '../../content/package-details';
const { EXTRAS } = getPackageDetails(forPath(Astro.url.pathname).locale);
// Anfrage wie in der Designsprache-Probe (Studie 8): Headline oben bündig mit dem Formular, darunter Satz, Gesichter
// und Kontaktwege; Formular in genau zwei Schritten. Versand, Honeypot und Vorbelegung: src/scripts/contact.ts.
import { site } from '../../site.config';
import Accent from '../Accent.astro';
import Faces from '../Faces.astro';
import ContactWays from '../ContactWays.astro';
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'contactForm' }> & { index?: number };
const { headline, text, people, index = 0, kicker } = Astro.props;
const H = index === 0 ? 'h1' : 'h2';
const occasions = formOccasions(t);
const packs: [string,string,string][] = [...PACKAGE_NAMES.map(name=>[name,name,packageLabel(name,t,{form:true})] as [string,string,string]),['offen',t('contactform.notSureYet'),'']];
const sources = [['Google', 'Google'], ['Empfehlung', t('contactform.recommendation')], ['Social Media', 'Social Media'], ['Presse', t('casestudy.press')], ['Eine Show gesehen', t('contactform.sawAShow')], ['Sonstiges', t('contactform.other')]];
---
<section aria-labelledby="anfrage-h" class="section alt" id="anfrage">
  <div class="inquiry">
    <SectionHead variant="embedded" class="intro" kicker={kicker} headline={headline} text={text} textClass="lead" id="anfrage-h" level={H}>
      <Faces people={people} />
      <ContactWays />
    </SectionHead>
    <form action={site.formEndpoint} aria-labelledby="anfrage-h" class="ask" id="inquiry-form" method="post">
      <input type="hidden" name="locale" value={forPath(Astro.url.pathname).locale} />
      <div class="ask-steps" aria-hidden="true" hidden><span class="on">{t('contactform.1YourShow')}</span><span>{t('contactform.2AboutYou')}</span><i></i></div>
      <p class="sr-only" data-step-label aria-live="polite"></p>
      <fieldset class="step" data-step>
        <legend class="sr-only">{t('contactform.step1Of2YourShow')}</legend>
        <div class="field">
          <span class="lbl" id="occasion-label">{t('contactform.whatSTheOccasion')}</span>
          <div aria-labelledby="occasion-label" class="chips" role="radiogroup">
            {occasions.map(([value, label], i) => <label><input name="anlass" required={i === 0} type="radio" value={value} /><span>{label}</span></label>)}
          </div>
          <span class="err" data-err-for="anlass" role="alert"></span>
        </div>
        <div class="row2">
          <div class="field">
            <label class="lbl" for="f-ort">{t('contactform.whereWillItTakePlace')}</label>
            <input autocomplete="address-level2" id="f-ort" maxlength="200" name="ort" required type="text" aria-describedby="f-ort-hint" data-msg={t('contactform.whereWillTheShowTakePlaceATownOrPostcode')} />
            <span class="hint" id="f-ort-hint">{t('contactform.townOrPostcodePlusCountryForShowsAbroad')}</span>
            <span class="err" data-err-for="ort" role="alert"></span>
          </div>
          <div class="field">
            <label class="lbl" for="f-datum">{t('contactform.whenShouldItFly')}</label>
            <input id="f-datum" name="datum" type="date" data-msg={t('contactform.pleaseChooseADateOrSelectNotDecidedYet')} />
            <label class="hint check"><input type="checkbox" name="datum-offen" value="ja" data-date-open /> {t('contactform.notDecidedYet')}</label>
            <span class="err" data-err-for="datum" role="alert"></span>
          </div>
        </div>
        <div class="field">
          <span class="lbl" id="paket-label">{t('contactform.whichPackage')} <em>{t('contactform.optional')}</em></span>
          <div aria-labelledby="paket-label" aria-describedby="paket-hint" class="chips" role="radiogroup">
            {packs.map(([value, label, line]) => <label title={line || undefined} style={value in SHOW_PACKAGES ? `--c: rgb(${SHOW_PACKAGES[value as keyof typeof SHOW_PACKAGES].color.join(",")})` : undefined}><input name="paket" type="radio" value={value} /><span>{label}</span></label>)}
          </div>
          <span class="hint" id="paket-hint">{t('contactform.sparkClassic2dHorizon3dInMotionOdyssey3dStorytelling')}</span>
        </div>
        {/* Extras von der Preisseite (?extras=express,film): erscheint nur, wenn dort welche gewählt wurden, damit der erste
             Schritt sonst kurz bleibt; dann abwählbar und ergänzbar (Marc, 01.11.2026) */}
        <div class="field" data-extras-field hidden>
          <span class="lbl" id="extras-label">Extras <em>{t('contactform.optional')}</em></span>
          <div aria-labelledby="extras-label" class="chips" role="group">
            {EXTRAS.map((x) => <label><input name="extras" type="checkbox" value={x.id} /><span>{x.short}</span></label>)}
          </div>
        </div>
        <button class="btn primary" data-next type="button" hidden>{t('contactform.next')}</button>
      </fieldset>
      <fieldset class="step" data-step>
        <legend class="sr-only">{t('contactform.step2Of2AboutYou')}</legend>
        <div class="row2">
          <div class="field"><label class="lbl" for="f-name">{t('contactform.yourName')}</label><input autocomplete="name" data-msg={t('contactform.whatShouldWeCallYou')} id="f-name" maxlength="120" name="name" required type="text" /><span class="err" data-err-for="name" role="alert"></span></div>
          <div class="field"><label class="lbl" for="f-mail">{t('contactform.yourEmailAddress')}</label><input autocomplete="email" data-msg={t('contactform.whereCanWeReply')} id="f-mail" maxlength="200" name="email" required type="email" /><span class="err" data-err-for="email" role="alert"></span></div>
        </div>
        {/* Optionale Angaben treten zurück (Marc, 02.11.2026: „aus dem Weg räumen, skippable“): eine Zeile kleiner
             Knöpfe, jeder blendet sein Feld weich ein. Vorbelegte Felder sind offen; ohne JavaScript ist alles sichtbar. */}
        <div class="opt-add" data-opt-bar hidden><span class="opt-add-l">{t('contactform.addOptional')}</span>
          {[['tel', t('contactform.addPhone')], ['firma', t('contactform.addCompany')], ['msg', t('contactform.addMessage')], ['quelle', t('contactform.addSource')]].map(([key, label]) => <button class="opt-chip" type="button" data-opt-add={key} aria-controls={`opt-${key}`} aria-expanded="false"><span aria-hidden="true">+</span> {label}</button>)}
        </div>
        <div class="opt" id="opt-tel" data-opt="tel"><div><div class="field"><label class="lbl" for="f-tel">{t('contactform.yourPhoneNumber')} <em>{t('contactform.optional')}</em></label><input autocomplete="tel" id="f-tel" maxlength="200" name="telefon" type="tel" aria-describedby="f-tel-hint" /><span class="hint" id="f-tel-hint">{t('contactform.forACallBackIfYouDLike')}</span></div></div></div>
        <div class="opt" id="opt-firma" data-opt="firma"><div><div class="field"><label class="lbl" for="f-firma">{t('contactform.companyOrOrganisation')} <em>{t('contactform.optional')}</em></label><input autocomplete="organization" id="f-firma" maxlength="200" name="firma" type="text" /></div></div></div>
        {/* Freitext erst am Ende (Marc, 31.10.2026: im ersten Schritt ist das zu viel auf einmal) */}
        <div class="opt" id="opt-msg" data-opt="msg"><div><div class="field"><label class="lbl" for="f-msg">{t('contactform.anythingElseYouDLikeToTellUs')} <em>{t('contactform.optional')}</em></label><textarea id="f-msg" maxlength="5000" name="message" rows="3"></textarea></div></div></div>
        <div class="opt" id="opt-quelle" data-opt="quelle"><div><div class="field"><label class="lbl" for="f-quelle">{t('contactform.howDidYouHearAboutUs')} <em>{t('contactform.optional')}</em></label><select class="native-select" id="f-quelle" name="quelle"><option value="">{t('contactform.pleaseSelect')}</option>{sources.map(([value, label]) => <option value={value}>{label}</option>)}</select></div></div></div>
        <div class="actions"><button class="btn primary" type="submit">{t('contactform.sendEnquiry')}</button><button class="btn" data-back type="button">{t('contactform.back')}</button></div>
        <p class="hint">{t('contactform.processingNotice')} <a href={localHref("/datenschutz/")}>{t('contactform.privacyPolicy')}</a>.</p>
        <div aria-hidden="true" class="honeypot"><label>Website<input autocomplete="off" name="website" tabindex="-1" /></label></div>
      </fieldset>
      <p class="form-status" data-form-status data-load-error={t('contact.valuePleaseTryAgainLaterOrEmailTeamFlyingstarsArt', { email:CONTACT.email, v0: t('contact.deliveryFailed') })} role="status" tabindex="-1"></p>
    </form>
  </div>
</section>
<script>
  import { whenNear } from '../../scripts/when-near.mjs';
  import { deferredForm } from '../../scripts/deferred-form.mjs';
  const form = document.querySelector<HTMLFormElement>('#inquiry-form');
  if (form) {
    const enhance = deferredForm(form, () => import('../../scripts/contact'));
    const load = whenNear(form, enhance);
    const start = () => { void load().catch((error: unknown) => console.warn('Form enhancement could not load', error)); };
    // Prefill and remove private draft text from the address immediately on arrival.
    if (location.search || location.hash || form.contains(document.activeElement)) start();
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-pick-paket]')) {
      link.addEventListener('pointerenter', start, { once: true });
      link.addEventListener('focus', start, { once: true });
      link.addEventListener('click', async (event) => {
        event.preventDefault();
        try { (await load()).pickPackage(link.dataset.pickPaket!); }
        catch { location.href = link.href; }
      });
    }
  }
</script>
