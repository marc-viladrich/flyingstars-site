---
import {startingPrice} from '../../lib/price.mjs';
import {record,field} from 'astro-frontend-editor/markers';
import {durationValues} from '../../content/show-duration.mjs';
import configuratorStyles from '../../styles/show-configurator.css?url';
import SectionHead from '../SectionHead.astro';
import { forPath } from '../../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
// Show-Konfigurator als einbettbare Komponente (sechzehnte Fassung, Marc 31.10.2026: „Auf der Preisseite sollte der
// Konfigurator auf jeden Fall direkt angezeigt werden“). Vorher war er die eigene Seite /show-konfigurator/ (jetzt eine
// Weiterleitung auf /drohnenshow-preise/#konfigurator). Die Komponente rendert ihre eigene <section> im normalen
// Seitenfluss und richtet den Inhalt an der globalen Inhaltsbreite aus (--gutter, Rückfall --pad).
// Zwei Entscheidungen: Anlass (eine Folge von Motiven, die wie eine kleine Show läuft) und Aufwand (Paket und
// Drohnenzahl, die einzigen Preistreiber). Die inneren IDs bleiben cfg-*: Der Konfigurator steht höchstens einmal auf
// einer Seite (der Teaser für die Startseite nutzt eigene IDs, ConfiguratorTeaser.astro).
// Direktlinks lesen Query-Parameter: /drohnenshow-preise/?anlass=launch&paket=ODYSSEY&drohnen=450&motiv=mond#konfigurator
import { getConfiguratorContent, bySeason } from '../../content/show-configurator.js';
const { OCCASIONS, STEPS } = getConfiguratorContent(forPath(Astro.url.pathname).locale);
import { SHOW_PACKAGES, DRONE_RANGES, DRONES_MIN, DRONES_MAX, DRONE_STEP } from '../../content/show-packages';

interface Props {
  /** Anker der Section (Sprungziel, z. B. /drohnenshow-preise/#konfigurator) */
  id?: string;
  /** Ebene der Überschrift: 1 auf einer eigenen Seite, 2 eingebettet */
  headingLevel?: 1 | 2;
  /** Text der Überschrift */
  heading?: string;
  /** Kicker in Orange über der Überschrift (docs/DESIGN.md, Section-Köpfe) */
  kicker?: string;
}
const { id = 'konfigurator', headingLevel = 2, heading = t('showconfigurator.whatShouldHappenInTheSky'), kicker } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';

// Runde 11: Anlässe in der Ordnung der Startseiten-Karten, Saison vorn (bySeason). Der Build kennt nur seinen eigenen
// Monat; das Skript ordnet beim Laden mit dem Monat des Besuchs neu und wählt den ersten Anlass (show-configurator.js)
const list = bySeason(OCCASIONS);
const start = 1;
const money = (v: number) => startingPrice(v,forPath(Astro.url.pathname).locale);
const startPkg = STEPS[start].pkg as keyof typeof SHOW_PACKAGES;
const first = SHOW_PACKAGES[startPkg];
const firstCaption = list[0].motifs[0].tiers[startPkg]?.caption ?? '';
// Drohnenregler (zwölfte Fassung): die Spur zeigt die Bereiche der Pakete in ihrer Farbe. Seit der dreizehnten Fassung
// schließen die Bereiche lückenlos aneinander an (eine Lücke bliebe hier leer)
const at = (n: number) => ((n - DRONES_MIN) / (DRONES_MAX - DRONES_MIN)) * 100;
const rgb = (k: keyof typeof SHOW_PACKAGES) => `rgb(${SHOW_PACKAGES[k].color.join(',')})`;
const rangeTrack = `linear-gradient(90deg, ${(Object.keys(DRONE_RANGES) as (keyof typeof SHOW_PACKAGES)[]).map((k, i, all) => {
  const r = DRONE_RANGES[k], next = all[i + 1] ? DRONE_RANGES[all[i + 1]].min : null;
  return [`${rgb(k)} ${at(r.min)}%`, `${rgb(k)} ${at(r.max)}%`, ...(next !== null && next - r.max > DRONE_STEP ? [`transparent ${at(r.max)}%`, `transparent ${at(next)}%`] : [])].join(', ');
}).join(', ')})`;
const ticks = [DRONES_MIN, ...Object.values(DRONE_RANGES).slice(1).map((r) => r.min), DRONES_MAX];
---
{/* Explicit URL: the catch-all route imports the pricing template on every page.
     Keep its namespaced styles on pages that actually render the configurator. */}
<link rel="stylesheet" href={configuratorStyles} />
<section class="cfg" id={id} aria-labelledby="cfg-h" style={`--pkg0: ${rgb(startPkg)}`}>
    <div class="cfg-stage" aria-label={t('showconfigurator.showPreview')} aria-describedby="cfg-scene" data-bleed>
      <canvas id="cfg-field" aria-hidden="true"></canvas>
      {/* vierzehnte Fassung: ein Klick irgendwo auf die Bühne hält die Vorführung an oder lässt sie weiterlaufen (wie bei
           YouTube); als echter Knopf erreichbar, Leertaste und Eingabe schalten um */}
      <button type="button" class="cfg-hit" id="cfg-hit" aria-label={t('showconfigurator.pauseThePreview')} aria-pressed="false"></button>
      <span class="cfg-flash" id="cfg-flash" aria-hidden="true"><svg class="i-pause" viewBox="0 0 16 16"><rect x="4" y="3" width="2.6" height="10" rx="1"/><rect x="9.4" y="3" width="2.6" height="10" rx="1"/></svg><svg class="i-play" viewBox="0 0 16 16"><path d="M5 3.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L5.9 2.7a.6.6 0 0 0-.9.5z"/></svg></span>
      <div class="cfg-caption"><em id="cfg-new">{STEPS[start].pkg}</em></div>
      <div class="cfg-drop" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4m0 0-5 5m5-5 5 5M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg><span>{t('showconfigurator.dragYourLogoHere')}</span><small>{t('showconfigurator.svgPngOrJpg')}</small></div>
      <span class="sr-only" id="cfg-scene">{firstCaption}</span>
      <p class="cfg-toast" id="cfg-toast" role="status"></p>
      {/* Runde 27 (Logo-Modus): flache Ansicht zum Entfernen von Teilen des eigenen Logos, über der Bühne (logo-mode.js) */}
      <div class="cfg-edit" id="cfg-edit" role="dialog" aria-label={t('logoMode.edit')} hidden>
        <canvas id="cfg-edit-canvas" aria-label={t('logoMode.editHint')}></canvas>
        <div class="cfg-edit-band" id="cfg-edit-band" hidden></div>
        <div class="cfg-edit-bar">
          <span id="cfg-edit-text"></span>
          <button type="button" id="cfg-edit-remove" hidden>{t('logoMode.remove')}</button>
          <button type="button" id="cfg-edit-restore" hidden>{t('logoMode.restore')}</button>
          <button type="button" id="cfg-edit-clear" hidden>{t('logoMode.clear')}</button>
          <button type="button" id="cfg-edit-all" hidden>{t('logoMode.restoreAll')}</button>
          <button type="button" class="cfg-edit-done" id="cfg-edit-close">{t('logoMode.done')}</button>
        </div>
      </div>
      <p class="cfg-error" id="cfg-error" role="status" hidden>{t('showconfigurator.thePreviewIsCurrentlyUnavailableYouCanStillChooseA')}</p>
      <div class="cfg-player" id="cfg-player" role="group" aria-label={t('showconfigurator.previewPlayback')}>
        <button type="button" class="cfg-play" id="cfg-play" aria-label={t('showconfigurator.pauseThePreview2')} data-paused="false">
          <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="4" y="3" width="2.6" height="10" rx="1"/><rect x="9.4" y="3" width="2.6" height="10" rx="1"/></svg>
          <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L5.9 2.7a.6.6 0 0 0-.9.5z"/></svg>
        </button>
        <button type="button" class="cfg-stepbtn" id="cfg-prev" aria-label={t('showconfigurator.previousScene')}>‹</button>
        <div class="cfg-track" id="cfg-track" role="slider" tabindex="0" aria-label={t('showconfigurator.showScene')} aria-valuemin="1" aria-valuemax="1" aria-valuenow="1" aria-describedby="cfg-tip">
          <div class="cfg-marks" id="cfg-marks" aria-hidden="true"></div>
        </div>
        {/* sechzehnte Fassung: Motive, die erst mit mehr Drohnen spielen, als ungeleuchtete Lichtpunkte (show-configurator.js) */}
        <div class="cfg-locks" id="cfg-locks" role="group" aria-label={t('showconfigurator.motifsUnlockedWithMoreDrones')} hidden></div>
        <span class="cfg-tip" id="cfg-tip" role="tooltip"><b>{list[0].motifs[0].label}</b> {t('showconfigurator.from')} {DRONE_RANGES[startPkg].min} {t('configuratorteaser.drones')}</span>
        <button type="button" class="cfg-stepbtn" id="cfg-next" aria-label={t('showconfigurator.nextScene')}>›</button>
        <div class="cfg-rate" role="group" aria-label={t('showconfigurator.speed')}>
          {[['0.5', '0,5×'], ['1', '1×'], ['2', '2×']].map(([v, l]) => <button type="button" data-rate={v} aria-pressed={v === '1' ? 'true' : 'false'}>{l}</button>)}
        </div>
      </div>
    </div>

    <form class="cfg-panel" id="cfg">
      <SectionHead variant="contents" headline={heading} kicker={kicker} id="cfg-h" level={Heading} titleClass="cfg-h" kickerClass="cfg-kicker" />

      {/* Runde 22 (Marc, 04.11.2026, für die Demo: „mit einem Klick weniger durchklicken“): Anlass wieder als Pills, eine
           Radio-Gruppe mit der gemeinsamen .chips-Komponente. Nicht gewählte Anlässe gedämpft, beim Zeigen voll
           (Variante .chips-quiet der gemeinsamen Pills, global.css). Reihenfolge nach Saison ordnet das Skript beim Laden neu. */}
      <fieldset class="cfg-block cfg-occasion">
        <legend>{t('showconfigurator.occasion')}</legend>
        <div class="chips chips-quiet cfg-occasions" id="cfg-occasion">
          {list.map((o, i) => <label data-occasion={o.id}><input type="radio" name="occasion" value={o.id} checked={i === 0} /><span>{o.label}</span></label>)}
          {/* Runde 27 (Marc 12.11.: der Logo-Modus als Schalter war nicht verständlich genug): „Euer Logo“ als Anlass mit
               Verlaufsrahmen; Kundenlogos als Formation, bis ein eigenes Logo da ist */}
          <label data-occasion="logo" class="cfg-occ-logo"><input type="radio" name="occasion" value="logo" /><span>{t('logoMode.occasion')}</span></label>
        </div>
      </fieldset>

      <fieldset class="cfg-block">
        <legend>{t('showconfigurator.howComplex')}</legend>
        {/* Runde 11: ein gleitender Rahmen statt harter Wechsel. .cfg-ind-sel zeigt das gewählte Paket und gleitet beim
             Wechsel (Klick, Tastatur, Regler) dorthin; .cfg-ind-hover gleitet gedämpft zum Paket unter der Maus. Position
             und Farbe kommen allein aus CSS (:has), also folgt der Rahmen jeder Änderung des Radios */}
        <div class="cfg-pkgs" style={STEPS.map((s, i) => `--c${i}: ${rgb(s.pkg as keyof typeof SHOW_PACKAGES)}`).join('; ')}>
          {STEPS.map((s, i) => <label style={`--c: var(--c${i})`}><input type="radio" name="pkg" value={i} checked={i === start} /><span><b>{s.pkg}</b><small>{s.label}</small></span></label>)}
          <span class="cfg-ind cfg-ind-hover" aria-hidden="true"></span>
          <span class="cfg-ind cfg-ind-sel" aria-hidden="true"></span>
        </div>
      </fieldset>

      <div class="cfg-block cfg-drones">
        <div class="cfg-drones-head"><label for="cfg-drones">{t('configuratorteaser.drones')}</label><span class="cfg-need-label mono" id="cfg-need-label" hidden></span><output id="cfg-dronecount" for="cfg-drones">{first.base}</output></div>
        {/* Runde 27: braucht das eigene Logo mehr Drohnen als gewählt, zeigt die Spur den Bedarf als Band bis zu einer Marke */}
        <div class="cfg-need" id="cfg-need" aria-hidden="true" hidden><span class="cfg-need-band"></span><span class="cfg-need-mark"></span></div>
        <input class="cfg-range" id="cfg-drones" {...record({collection:'previewPolicy',id:'configuration'})} type="range" min={DRONES_MIN} max={DRONES_MAX} step={DRONE_STEP} value={first.base} style={`--track: ${rangeTrack}`} />
        <div class="cfg-ticks mono" aria-hidden="true">{ticks.map((n) => <span style={`--p: ${at(n) / 100}`}>{n}</span>)}</div>
      </div>

      {/* vierzehnte Fassung: eigener Text und eigenes Logo bei den Auswahlen, nicht mehr unter der Anfrage */}
      <div class="cfg-own-wrap">
      <fieldset class="cfg-block cfg-own">
        <legend>{t('showconfigurator.yourTextYourLogo')} <span class="cfg-opt">{t('showconfigurator.optional')}</span><button type="button" class="cfg-info" id="cfg-info" aria-label={t('showconfigurator.aboutLogoUploads')} aria-expanded="false" aria-controls="cfg-legal" aria-describedby="cfg-legal"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5"/><path d="M8 7.2v4M8 4.9v.1"/></svg></button></legend>
        <div class="cfg-own-row">
          <input class="cfg-text" id="cfg-text" name="text" type="text" maxlength="24" autocomplete="off" placeholder={t('showconfigurator.eGAnnaBen')} aria-label={t('showconfigurator.yourText')} />
          <label class="cfg-upload" id="cfg-upload"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0-5 5m5-5 5 5M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg><span>{t('showConfigurator.yourLogo')}</span><input id="cfg-file" type="file" accept="image/svg+xml,image/png,image/jpeg,image/webp" aria-describedby="cfg-legal" /></label>
          <button type="button" class="cfg-logo-off" id="cfg-logo-off" aria-label={t('showconfigurator.removeLogo')} hidden><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg></button>
        </div>
        {/* Runde 27: Logo-Modus. Die Bühne zeigt Kundenlogos als Formation (nur die, die in die Drohnenzahl passen), ein
             eigenes Logo kommt per Ziehen oder Datei; erst dann erscheinen Detailgrad, Budget-Flexibilität und Teile entfernen */}
        <div class="cfg-logo-tools" id="cfg-logo-tools" hidden>
          {/* Marc 12.11.: ein Regler statt zwei. Die Zonen der Spur sind die Budget-Flexibilität (wie die Paketfarben am
               Drohnenregler), die Stelle in der Zone die Liniendichte (rechts lockerere Linien, mehr Formen) */}
          <div class="cfg-tool">
            <div class="cfg-tool-head"><label for="cfg-detail">{t('logoMode.detail')}</label><button type="button" class="cfg-auto" id="cfg-detail-auto" aria-pressed="true">{t('logoMode.auto')}</button></div>
            <input class="cfg-range cfg-range-zones" id="cfg-detail" type="range" min="0" max="100" step="1" value="83" aria-describedby="cfg-detail-help" />
            <div class="cfg-zones mono" aria-hidden="true"><span>{t('logoMode.flexStrict')}</span><span>{t('logoMode.flexMedium')}</span><span>{t('logoMode.flexFlexible')}</span></div>
            <p class="cfg-tool-help" id="cfg-detail-help">{t('logoMode.flexHelp')}</p>
          </div>
          <button type="button" class="btn small cfg-logo-edit" id="cfg-logo-edit">{t('logoMode.edit')}</button>
          <p class="cfg-logo-over" id="cfg-logo-over" hidden><span id="cfg-logo-over-text"></span> <a href={localHref("/#anfrage")} id="cfg-logo-over-cta">{t('logoMode.overCta')}</a></p>
        </div>
        <div class="chips cfg-styles" id="cfg-styles" hidden>
          {[['script', t('showconfigurator.handwriting')], ['print', t('showconfigurator.printLettering')], ['initials', t('showconfigurator.initials')]].map(([v, l], i) => <label><input type="radio" name="textstyle" value={v} checked={i === 0} /><span>{l}</span></label>)}
        </div>
        {/* Runde 9 (Marc: „ein bisschen zu viel Text“): der Hinweis steht hinter dem Info-Zeichen an der Überschrift, Klick, Fokus
             oder Zeigen öffnet, Esc schließt; die Logo-Auswahl verweist weiter darauf (aria-describedby) */}
        {/* Runde 24: Zeichen und Drohnenbedarf des eigenen Textes (Regel des FlyingStars-Katalogs, show-configurator.js) */}
        <p class="cfg-text-budget mono" id="cfg-text-budget" role="status" hidden></p>
        <p class="cfg-logo-status" id="cfg-logo-status" role="status"></p>
      </fieldset>
      {/* außerhalb des fieldset: dessen Positionierungs-Bezug liegt unter der Legende, nicht an der Kante */}
        <p class="cfg-legal" id="cfg-legal" role="tooltip">{t('showconfigurator.onlyUploadLogosYouHavePermissionToUseSuchAs')}</p>
      </div>


      {/* Runde 11 (Marc: „crampt“): Paket, Preis, Dauer und Anfrage als eigene, geschlossene Fläche mit Abstand zur
           Bedienung. Darunter nur noch die Einordnung der Motive. PLATZHALTER, bewusst nicht mehr sichtbar: Drohnenbereiche
           und Aufpreise (DRONE_RANGES_PLACEHOLDER, SPARK_EXTRA in content/show-packages.ts) und die Freischalt-Leiter
           (LADDER in content/show-configurator.js) sind nicht mit FlyingStars abgestimmt. */}
      <div class="cfg-sum">
        <div class="cfg-result" aria-live="polite">
          <div class="cfg-price"><b id="cfg-pkg">{STEPS[start].pkg}</b><span id="cfg-price">{money(first.price)}</span></div>
          <p class="cfg-meta mono" id="cfg-meta" {...field({collection:'showDuration',id:'configuration'},['outdoor','min'],{mode:'panel'})}>{t('packageDetails.showtimeLine',durationValues())} {t('showconfigurator.excludingVatAndTravel')}</p>
        </div>
        <a class="btn primary cfg-cta" id="cfg-cta" href={localHref("/#anfrage")}>{t('showconfigurator.enquireAboutThisShow')}</a>
        <p class="cfg-note" id="cfg-note">{t('showconfigurator.allMotifsShownHereAreExamplesWeCreateOriginalDesigns')}</p>
      </div>
    </form>

    <div class="cfg-bar" aria-hidden="true"><span><b id="cfg-bar-pkg">{STEPS[start].pkg}</b> <span id="cfg-bar-price">{money(first.price)}</span></span><a class="btn small primary" href={localHref("/#anfrage")} id="cfg-bar-cta" tabindex="-1">{t('showconfigurator.sendAnEnquiry')}</a></div>
  </section>

<noscript><p class="cfg-noscript">{t('showconfigurator.theShowConfiguratorRequiresJavascriptFindOurPackagesAndPrices')} <a href={localHref("/drohnenshow-preise/#pakete")}>{t('showconfigurator.packages')}</a>.</p></noscript>

<script>
  import { whenNear } from '../../scripts/when-near.mjs';
  const root = document.querySelector<HTMLElement>('.cfg');
  if (root) {
    const load = whenNear(root, () => import('../../scripts/show-configurator.js'));
    if (location.hash || root.contains(document.activeElement)) void load().catch((error: unknown) => console.warn('Configurator could not load', error));
  }
</script>
