---
import {localeFromPath} from '../lib/localized-routes';
import {resolveMedia} from '../lib/content';
import {responsiveImage} from '../lib/media';
const locale = Astro.props.locale ?? Astro.props._locale ?? localeFromPath(Astro.url.pathname);
const {src,alt,sizes,loading='lazy',class:cls}=resolveMedia(Astro.props,locale);
if (!sizes) throw new Error('Picture benötigt sizes vom darstellenden Layout.');
const image = await responsiveImage(src,sizes);
const markers=Object.fromEntries(Object.entries(Astro.props).filter(([key])=>key.startsWith('data-native-')));
const imageClass=['content-image',cls].filter(Boolean).join(' ');
---
<img {...markers} src={image.src} {...image.attributes} alt={alt} loading={loading} class={imageClass} decoding="async"/>
<style>.content-image { display:block;max-width:100%;height:auto; }</style>
