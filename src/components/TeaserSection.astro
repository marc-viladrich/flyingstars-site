---
// Gemeinsame Hülle; die beiden Adapter besitzen ihre fachlichen Teaser-Props weiter.
import SectionHead from './SectionHead.astro';
interface Props { id: string; index: number; kicker?: string; headline: string; text?: string }
const {id,index,kicker,headline,text}=Astro.props;
const H=index===0?'h1':'h2';
---
<section class="section" id={id} aria-labelledby={`${id}-h`}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} level={H} />
  <slot />
</section>
