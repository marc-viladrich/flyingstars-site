---
// Preisseite (30.10.2026): drei Pakete, deutlicher Weg in den Show-Konfigurator, was immer enthalten ist, alle Leistungen
// im Vergleich, Zusätze, Fragen zum Preis (FAQ-Collection, Tag `preise`) und Abschluss. Ohne Kicker und ohne den alten
// Preisrechner: Der Konfigurator ersetzt ihn (src/components/pricing/ bleibt unverändert im Repo, ist hier nicht mehr
// eingebunden). Preise und Drohnenzahlen nur aus show-packages.ts, Texte aus package-details.ts (Elevate, Fragebogen 21.10.).
import Base from '../layouts/Base.astro';
import Packages from '../components/sections/Packages.astro';
import Cta from '../components/sections/Cta.astro';
import Metrics from '../components/sections/Metrics.astro';
import Faq from '../components/sections/Faq.astro';
import { SHOW_PACKAGES, PACKAGE_NAMES } from '../content/show-packages';
import { PACKAGE_DETAILS, COMPARISON, COMPARISON_NOTE, INCLUDED, EXTRAS, SHOW_DURATION } from '../content/package-details';
const money = (v: number) => `ab ${v.toLocaleString('de-DE')} €`;
const items = PACKAGE_NAMES.map((name) => ({ name, ...PACKAGE_DETAILS[name], badge: PACKAGE_DETAILS[name].often, highlight: Boolean(PACKAGE_DETAILS[name].often) }));
const featured = PACKAGE_NAMES.findIndex((name) => PACKAGE_DETAILS[name].often);
---
<Base title="Drohnenshow Preise: drei Pakete ab 7.900 €" description="Drei Drohnenshow-Pakete ab 7.900 € netto zzgl. Anfahrt. Design, Genehmigung und Team vor Ort sind immer enthalten. Mit Show-Konfigurator.">
  <Packages
    type="packages"
    index={0}
    id="pakete"
    headline="Was eine Drohnenshow kostet."
    text="Drei Pakete ab 7.900 € netto zzgl. Anfahrt. Design, Genehmigung und das Team vor Ort sind in jedem Paket enthalten."
    note={`Alle Preise netto zzgl. Anfahrt. ${SHOW_DURATION}`}
    compact={false}
    items={items}
  />

  <Cta
    type="cta"
    index={1}
    headline="Stellt eure Show *selbst* zusammen."
    text="Im Show-Konfigurator wählt ihr Anlass und Paket, stellt die Drohnenzahl ein und seht Beispielmotive mit Preis. Mit eurer Auswahl fragt ihr direkt an."
    button={{ label: 'Zum Show-Konfigurator', href: '/show-konfigurator/' }}
    secondary={{ label: 'Indoor-Shows', href: '/drohnenshow-indoor/' }}
  />

  <Metrics
    type="metrics"
    index={2}
    id="inklusive"
    headline="Wofür ihr bei jedem Paket bezahlt."
    text="Der größte Teil der Arbeit steckt in Design, Genehmigung und einem sicheren Ablauf."
    items={INCLUDED.map((item) => ({ label: item.title, text: item.text }))}
  />

  <section class="section" id="leistungen" aria-labelledby="leistungen-h">
    <div class="sec-head"><h2 id="leistungen-h">Alle Leistungen im Vergleich.</h2></div>
    <div class="table-wrap" role="region" aria-label="Alle Leistungen im Vergleich (Tabelle, horizontal scrollbar)" tabindex="0">
      <!-- position:relative hält die visuell versteckten Texte („nicht enthalten“) im Scrollbereich der Tabelle -->
      <table style="position:relative">
        <caption class="sr-only">Leistungen der Pakete SPARK, HORIZON und ODYSSEY</caption>
        <thead>
          <tr><th scope="col">Leistung</th>{PACKAGE_NAMES.map((name, i) => <th scope="col" class:list={{ us: i === featured }}>{name}<br /><span class="mono">{money(SHOW_PACKAGES[name].price)}</span></th>)}</tr>
        </thead>
        <tbody>
          {COMPARISON.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.all ? <td colspan="3">{row.all}</td> : row.cells!.map((cell, i) => cell === null
                ? <td class:list={{ us: i === featured }}><span aria-hidden="true">–</span><span class="sr-only">nicht enthalten</span></td>
                : <td class:list={{ us: i === featured }}>{cell}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="fine mono">{COMPARISON_NOTE} Alle Preise netto zzgl. Anfahrt.</p>
  </section>

  <section class="section alt" id="zusaetze" aria-labelledby="zusaetze-h">
    <div class="sec-head"><h2 id="zusaetze-h">Was zusätzlich möglich ist.</h2><p>Was ein Zusatz kostet, steht vorab im Angebot.</p></div>
    <div class="extras">
      {EXTRAS.map((x) => (
        <div class="extra">
          <h3>{x.title}</h3>
          <p>{x.text}</p>
          <span class="price mono">{x.price}</span>
          {x.link && <a class="link" href={x.link.href}>{x.link.label} <span aria-hidden="true">→</span></a>}
        </div>
      ))}
    </div>
  </section>

  <Faq
    type="faq"
    index={5}
    id="preisfragen"
    headline="Fragen zum Preis."
    text="Was in Gesprächen über das Budget am häufigsten gefragt wird."
    cta={{ label: 'Alle Fragen', href: '/faq/' }}
    openFirst={true}
    tags={['preise']}
  />

  <Cta
    type="cta"
    index={6}
    headline="Noch unsicher, welches Paket?"
    text="Schickt uns Datum und Ort. Wenn ihr kein Paket auswählt, schlagen wir euch eins vor."
    button={{ label: 'Show anfragen', href: '/kontakt/' }}
    secondary={{ label: 'Videocall vereinbaren', href: 'https://calendly.com/team-flyingstars/beratung' }}
  />
</Base>
