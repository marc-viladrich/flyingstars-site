---
import {record,field} from 'astro-frontend-editor/markers';
import {CONTACT_OWNER} from '../content/contact.mjs';
import { forPath } from '../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
// Kontaktwege mit Icons in Orange (E-Mail, Telefon, Videocall, WhatsApp), Lucide über Icon.astro.
import { CONTACT } from './people';
import Icon from './Icon.astro';
---
<ul class="ways" {...record(CONTACT_OWNER)}>
  <li><a {...field(CONTACT_OWNER,['email'],{mode:'panel'})} href={localHref(`mailto:${CONTACT.email}`)}><Icon name="mail" class="g" /><span class="hover-line">{CONTACT.email}</span></a></li>
  <li><a {...field(CONTACT_OWNER,['phone'],{mode:'panel'})} href={localHref(CONTACT.phone.href)}><Icon name="phone" class="g" /><span class="hover-line">{CONTACT.phone.label}</span></a></li>
  <li><a {...field(CONTACT_OWNER,['video', 'href'],{mode:'panel'})} href={localHref(CONTACT.video.href)} rel="noopener" target="_blank"><Icon name="video" class="g" /><span class="hover-line">{t(CONTACT.video.labelKey)}</span></a></li>
  <li><a {...field(CONTACT_OWNER,['mobile'],{mode:'panel'})} href={localHref(CONTACT.whatsapp.href)} rel="noopener" target="_blank"><Icon name="whatsapp" class="g" /><span class="hover-line">{CONTACT.whatsapp.label}</span></a></li>
</ul>

<style>
  /* Kontaktwege mit Verlaufs-Icons (aus global.css hierher, Audit 2, C2) */
  .ways { list-style: none; padding: 0; margin: var(--space-2) 0 0; display: grid; }
  .ways a { display: flex; gap: var(--space-3-5); align-items: center; padding: var(--space-3-5) 0; border-bottom: 1px solid var(--line); color: var(--text); transition: color var(--dur-control); }
  .ways li:first-child a { border-top: 1px solid var(--line); }
  .ways a:hover { color: var(--amber); }
  /* Gestapelte Anfrage auf Tabletbreite: zwei Spalten statt vier Zeilen über die volle Fläche (Audit 3, V8);
     auf dem Handy bleibt die Liste einspaltig */
  @media (--nav-collapsed) and (min-width: 40.0625em) {
    .ways { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--card-grid-gap); }
    .ways li:nth-child(2) a { border-top: 1px solid var(--line); }
  }
</style>
