---
import { SHOW_PACKAGES } from '../../content/show-packages';
import { EXTRAS } from '../../content/package-details';
// Anfrage wie in der Designsprache-Probe (Studie 8): Headline oben bündig mit dem Formular, darunter Satz, Gesichter
// und Kontaktwege; Formular in genau zwei Schritten. Versand, Honeypot und Vorbelegung: src/scripts/contact.ts.
import { site } from '../../site.config';
import Accent from '../Accent.astro';
import Faces from '../Faces.astro';
import ContactWays from '../ContactWays.astro';
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'contactForm' }> & { index?: number };
const { headline, text, people, index = 0, kicker } = Astro.props;
const H = index === 0 ? 'h1' : 'h2';
const occasions: [string, string][] = [['firma', 'Firmenevent'], ['stadt', 'Stadt & Festival'], ['agentur', 'Agentur'], ['privat', 'Hochzeit & Privat'], ['indoor', 'Indoor'], ['sonstiges', 'Sonstiges']];
const packs: [string, string, string][] = [['SPARK', 'SPARK', 'klassisch in 2D'], ['HORIZON', 'HORIZON', '3D in Bewegung'], ['ODYSSEY', 'ODYSSEY', 'erzählte 3D-Show'], ['', 'Weiß ich noch nicht', '']];
const sources = ['Google', 'Empfehlung', 'Social Media', 'Presse', 'Eine Show gesehen', 'Sonstiges'];
---
<section aria-labelledby="anfrage-h" class="section alt" id="anfrage">
  <div class="inquiry">
    <div class="intro">
      {kicker && <span class="kicker mono">{kicker}</span>}
      <H id="anfrage-h"><Accent text={headline} /></H>
      {text && <p class="lead">{text}</p>}
      <Faces people={people} />
      <ContactWays />
    </div>
    <form action={site.formEndpoint} aria-labelledby="anfrage-h" class="ask" id="inquiry-form" method="post">
      <div class="ask-steps" aria-hidden="true" hidden><span class="on">1 Deine Show</span><span>2 Du</span><i></i></div>
      <p class="sr-only" data-step-label aria-live="polite"></p>
      <fieldset class="step" data-step>
        <legend class="sr-only">Schritt 1 von 2: Deine Show</legend>
        <div class="field">
          <span class="lbl" id="occasion-label">Wofür ist die Show?</span>
          <div aria-labelledby="occasion-label" class="chips" role="radiogroup">
            {occasions.map(([value, label], i) => <label><input name="anlass" required={i === 0} type="radio" value={value} /><span>{label}</span></label>)}
          </div>
          <span class="err" data-err-for="anlass" role="alert"></span>
        </div>
        <div class="row2">
          <div class="field">
            <label class="lbl" for="f-ort">Wo soll sie stattfinden?</label>
            <input autocomplete="address-level2" id="f-ort" maxlength="200" name="ort" required type="text" aria-describedby="f-ort-hint" data-msg="Wo soll die Show stattfinden? Ort oder PLZ reicht." />
            <span class="hint" id="f-ort-hint">Ort oder PLZ, bei Shows im Ausland mit Land</span>
            <span class="err" data-err-for="ort" role="alert"></span>
          </div>
          <div class="field">
            <label class="lbl" for="f-datum">Wann soll sie fliegen?</label>
            <input id="f-datum" name="datum" type="date" data-msg="Bitte ein Datum wählen oder „Noch nicht festgelegt“ ankreuzen." />
            <label class="hint check"><input type="checkbox" name="datum-offen" value="ja" data-date-open /> Noch nicht festgelegt</label>
            <span class="err" data-err-for="datum" role="alert"></span>
          </div>
        </div>
        <div class="field">
          <span class="lbl" id="paket-label">Welches Paket? <em>optional</em></span>
          <div aria-labelledby="paket-label" aria-describedby="paket-hint" class="chips" role="radiogroup">
            {packs.map(([value, label, line]) => <label title={line || undefined} style={value ? `--c: rgb(${SHOW_PACKAGES[value as keyof typeof SHOW_PACKAGES].color.join(',')})` : undefined}><input name="paket" type="radio" value={value} /><span>{label}</span></label>)}
          </div>
          <span class="hint" id="paket-hint">SPARK klassisch in 2D · HORIZON 3D in Bewegung · ODYSSEY erzählte 3D-Show</span>
        </div>
        <!-- Extras von der Preisseite (?extras=express,film): erscheint nur, wenn dort welche gewählt wurden, damit der erste
             Schritt sonst kurz bleibt; dann abwählbar und ergänzbar (Marc, 01.11.2026) -->
        <div class="field" data-extras-field hidden>
          <span class="lbl" id="extras-label">Extras <em>optional</em></span>
          <div aria-labelledby="extras-label" class="chips" role="group">
            {EXTRAS.map((x) => <label><input name="extras" type="checkbox" value={x.id} /><span>{x.short}</span></label>)}
          </div>
        </div>
        <button class="btn primary" data-next type="button">Weiter</button>
      </fieldset>
      <fieldset class="step" data-step>
        <legend class="sr-only">Schritt 2 von 2: Du</legend>
        <div class="row2">
          <div class="field"><label class="lbl" for="f-name">Dein Name</label><input autocomplete="name" data-msg="Wie dürfen wir dich ansprechen?" id="f-name" maxlength="120" name="name" required type="text" /><span class="err" data-err-for="name" role="alert"></span></div>
          <div class="field"><label class="lbl" for="f-mail">Deine E-Mail-Adresse</label><input autocomplete="email" data-msg="Wohin dürfen wir antworten?" id="f-mail" maxlength="200" name="email" required type="email" /><span class="err" data-err-for="email" role="alert"></span></div>
        </div>
        <div class="row2">
          <div class="field"><label class="lbl" for="f-tel">Deine Telefonnummer <em>optional</em></label><input autocomplete="tel" id="f-tel" maxlength="200" name="telefon" type="tel" aria-describedby="f-tel-hint" /><span class="hint" id="f-tel-hint">Für einen Rückruf, wenn du magst</span></div>
          <div class="field"><label class="lbl" for="f-firma">Firma oder Organisation <em>optional</em></label><input autocomplete="organization" id="f-firma" maxlength="200" name="firma" type="text" /></div>
        </div>
        <div class="field"><label class="lbl" for="f-quelle">Wie hast du von uns erfahren? <em>optional</em></label><select id="f-quelle" name="quelle"><option value="">Bitte wählen</option>{sources.map((s) => <option>{s}</option>)}</select></div>
        <!-- Freitext erst am Ende (Marc, 31.10.2026: im ersten Schritt ist das zu viel auf einmal) -->
        <div class="field"><label class="lbl" for="f-msg">Möchtest du uns noch etwas mitteilen? <em>optional</em></label><textarea id="f-msg" maxlength="5000" name="message" rows="3"></textarea></div>
        <p class="hint">Mit dem Absenden werden deine Angaben zur Bearbeitung der Anfrage verwendet. Mehr dazu in der <a href="/datenschutz/">Datenschutzerklärung</a>.</p>
        <div class="actions"><button class="btn" data-back type="button">Zurück</button><button class="btn primary" type="submit">Anfrage senden</button></div>
        <div aria-hidden="true" class="honeypot"><label>Website<input autocomplete="off" name="website" tabindex="-1" /></label></div>
      </fieldset>
      <p class="form-status" data-form-status role="status" tabindex="-1"></p>
    </form>
  </div>
</section>
<script>import '../../scripts/contact';</script>
