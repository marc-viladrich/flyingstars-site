{
  "name": "astro-site-template",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "rm -f .astro/data-store.json && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test 'scripts/*.test.mjs' 'src/scripts/effects/*.test.mjs' && playwright test",
    "test:effects": "node --test 'src/scripts/effects/*.test.mjs'",
    "audit:layout": "node scripts/layout-audit.mjs",
    "gates": "astro check && astro build && npm test"
  },
  "dependencies": {
    "@lucide/astro": "^1.66.0",
    "astro": "^7.3.6",
    "marked": "^18.1.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
