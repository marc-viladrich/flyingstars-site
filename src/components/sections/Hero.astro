---
// Seitenkopf für Unterseiten: große Headline, ein Satz, Aktionen; optional ein Bild mit Vorhang-Reveal.
import Picture from '../Picture.astro';
import Accent from '../Accent.astro';
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'hero' }>;
const { headline, text, image, cta, secondary, kicker } = Astro.props;
---
<section class:list={['page-hero', { 'has-media': image }]} aria-labelledby="hero-h">
  <div class="page-hero-copy">
    {kicker && <span class="kicker mono">{kicker}</span>}
    <h1 id="hero-h"><Accent text={headline} /></h1>
    {text && <p class="lead">{text}</p>}
    {(cta || secondary) && (
      <div class="actions">
        {cta && <a class="btn primary" href={cta.href}>{cta.label}</a>}
        {secondary && <a class="btn" href={secondary.href}>{secondary.label}</a>}
      </div>
    )}
  </div>
  {image && <figure class="page-hero-media" data-curtain><Picture {...image} loading="eager" sizes="(min-width: 64rem) 50vw, 100vw" /></figure>}
</section>
