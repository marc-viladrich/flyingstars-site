---
// Raster für Blogkarten: drei Spalten ab 1100 px, darunter zwei, auf dem Handy eine.
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
interface Props { posts: CollectionEntry<'posts'>[]; level?: 'h2' | 'h3' }
const { posts, level = 'h2' } = Astro.props;
---
<div class="post-grid">{posts.map((post, i) => <PostCard post={post} i={i} level={level} />)}</div>

<style>
  .post-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(32px, 3vw, 48px) clamp(16px, 2vw, 28px); }
  @media (max-width: 1100px) { .post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .post-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
