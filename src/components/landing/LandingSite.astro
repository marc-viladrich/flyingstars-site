---
import {field} from 'astro-frontend-editor/markers';
import {landingSiteContent} from '../../content/shared-blocks.mjs';
import {factText} from '../../content/show-extras.mjs';
import IconFeature from '../IconFeature.astro';
import { forPath } from '../../i18n/server';
const { t, localHref, locale } = forPath(Astro.url.pathname);
// Ein Schema für alle Standort- und Sicherheitsabschnitte. Maßangaben sind Content,
// die Geometrie ist bewusst schematisch. Belege: docs/sicherheitskonzept-quellen.md.
// Kompakt (Marc, 17.11.2026: „deutlich kleiner“): links Kicker, Schlagzeile, Text und Punkte, rechts nur die Karte. Die
// Zonen erklären sich über Popover an der Karte (Zeigen, Fokus, Tippen; Esc schließt), keine Liste und keine
// Zuständigkeitstabelle mehr daneben. Die Popover positioniert JavaScript klassisch (Safari 18 kann kein CSS Anchor
// Positioning). Ohne JavaScript stehen die Zonen als nummerierte Legende unter der Karte. Darunter Zulassungs-Logos.
import type { Section } from '../../content.config';
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { indoorScene, outdoorScene } from './site-scene';
type Props = Extract<Section, { type: 'landingSite' }> & { index: number };
const { kicker, headline, text, variant, diagram, items, safeguards, download, points, cta, quality, id = 'location', index } = landingSiteContent(Astro.props,locale);
// Zulassungen als Logo-Reihe unter Text und Karte (LBA, EASA, naturstrom nur mit Freigabe und vorhandener Datei, sonst
// Verlaufs-Icon). Nachrangige Belege (secondary) stehen nicht mehr in der kompakten Section.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
const QICON = { permit: 'file-badge', sound: 'audio-lines', shield: 'shield-check', leaf: 'leaf' } as const;
const seals = (quality ?? []).filter((q) => !q.secondary).map((q) => ({ ...q, show: Boolean(q.cleared && q.logo && existsSync(join(process.cwd(), 'public', q.logo))) }));
const sharedField=(key:string)=>Astro.props.safetyRef?field({collection:'safetyConcept',id:'configuration'},[locale,key],{mode:'panel'}):{};
const H = index === 0 ? 'h1' : 'h2';
const T = index === 0 ? 'h2' : 'h3';
const numbers = Object.fromEntries(items.map((item, i) => [item.zone, i + 1]));
const colors = ['#ff9e29', '#f58a5a', '#ec7f95', '#db64e8', '#b88bec', '#8aa9ee', '#6fc8ef', '#33edf2'];
// Zonenfarben wie im Technik-Datenblatt von FlyingStars (Marc, 03.11.2026: „die Darstellung … sieht deutlich nicer aus“):
// Rot = äußerer, Gelb = innerer Sicherheitsbereich, Grün = Flugbereich, Blau = Start und Landung, Violett = Publikum,
// Drohnen im Logo-Verlauf. Für dunklen Grund aufgehellt; Nummern und Popover tragen dieselbe Farbe.
const zoneColor: Record<string, string> = { safety: '#ff7a6e', operative: '#f5b43c', drones: '#6fdc98', start: '#6aa8ff', guests: '#c49bf2', ceiling: '#f5b43c', floor: '#6aa8ff', kit: '#ff9e29' };
// Schrägansicht als Explosionsansicht (Runde 4, 18.11.2026), Geometrie in site-scene.ts
const scene = variant === 'outdoor'
  ? outdoorScene({ colors, horizontal: factText(diagram.horizontalLabel, locale), detail: factText(diagram.detailLabel, locale) })
  : indoorScene({ colors, vertical: factText(diagram.verticalLabel, locale), horizontal: factText(diagram.horizontalLabel, locale) });
const hotspots = scene.spots.filter((s) => numbers[s.zone]).sort((a, b) => numbers[a.zone] - numbers[b.zone]);
const itemOf = Object.fromEntries(items.map((item, i) => [item.zone, { ...item, n: i + 1 }]));
---
<section class="section ls-site" id={id} aria-labelledby={`${id}-h`}>
  <div class:list={['st', `st-${variant}`]}>
    <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} level={H} class="st-copy">
      {points && points.length > 0 && <ul class="st-points">{points.map((point) => <li><Icon name="check" size={20} class="g" /><span>{point.value}</span></li>)}</ul>}
      {(cta || download) && <p class="st-more">
        {cta && <a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a>}
        {download && <a {...sharedField("download")} class="link st-download" href={localHref(download.href)} type="application/pdf" target="_blank" rel="noopener">{download.label}<Icon name="download" size={18} class="g" /></a>}
      </p>}
    </SectionHead>
    <figure {...sharedField("diagram")} class="st-fig">
      <div class:list={['st-map', `st-map-${variant}`]} data-st-map data-grid-zone={scene.gridZone}>
        <div class="st-stage">
        <svg viewBox={scene.vb.join(' ')} role="img" aria-labelledby={`${id}-diagram-title ${id}-diagram-desc`}>
          <title id={`${id}-diagram-title`}>{variant === 'outdoor' ? t('landingsite.outdoorTitle') : t('landingsite.indoorTitle')}</title>
          <desc id={`${id}-diagram-desc`}>{factText(diagram.description,locale)} {t('landingsite.numberedList')} {factText(diagram.caption,locale)}</desc>
          {scene.layers.map((layer, li) => layer.key === 'drones'
            ? <g class="ly ly-drones" data-zone="drones" aria-hidden="true" style={`--from: 0px; --li: ${li}`}>{scene.drones.map((d) => <g class="dr" style={`--gx: ${d.g[0]}px; --gy: ${d.g[1]}px; --lx: ${d.l[0]}px; --ly: ${d.l[1]}px; --mx: ${d.m[0]}px; --my: ${d.m[1]}px; --c: ${d.c}; --k: ${d.k}`}><circle class="halo" r="5" /><circle class="core" r="2.3" /></g>)}</g>
            : <g class="ly" data-ly={layer.key} style={`--from: ${layer.from}px; --li: ${li}`} aria-hidden="true">
                {layer.groups.map((g) => {
                  const shapes = g.items.map((it) => it.t === 'circle' ? <circle class={it.cls} cx={it.cx} cy={it.cy} r={it.r} /> : <path class={it.cls} d={it.d} />);
                  return g.zone ? <g class="zone" data-zone={g.zone} data-pick={g.zone} style={`--zc: ${zoneColor[g.zone]}`}>{shapes}</g> : <g>{shapes}</g>;
                })}
              </g>)}
        </svg>
        {scene.labels.map((l) => <span class:list={['st-lbl', { 'st-lbl-turn': l.turn }]} data-zone={l.zone} aria-hidden="true" style={`--x: ${l.x}%; --y: ${l.y}%; --zc: ${zoneColor[l.zone]}`}>{l.text}</span>)}
        {hotspots.map((h) => <button type="button" class="st-hot" data-zone={h.zone} data-hot={h.zone} style={`--x: ${h.x}%; --y: ${h.y}%; --zc: ${zoneColor[h.zone]}; --n: ${numbers[h.zone]}`} aria-expanded="false" aria-controls={`${id}-z${h.zone}`}><span class="st-num" aria-hidden="true">{numbers[h.zone]}</span><span class="sr-only">{itemOf[h.zone].n}. {itemOf[h.zone].title}</span></button>)}
        </div>
        <ol {...sharedField("items")} class="st-tips">
          {items.map((item, i) => <li id={`${id}-z${item.zone}`} data-tip={item.zone} style={`--zc: ${zoneColor[item.zone]}`}>
            <span class="st-n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <T class="st-t">{item.title}</T>
            {item.value && <span class="st-value">{factText(item.value,locale)}</span>}
            <p>{factText(item.text,locale)}</p>
          </li>)}
        </ol>
      </div>
      {/* Bildunterschrift nur für Screenreader (Marc, 18.11.2026: „figcaption … zumindest visually komplett rauslassen“) */}
      <figcaption class="sr-only">{t('landingsite.tapHint')} {factText(diagram.flightLabel,locale)}. {factText(diagram.caption,locale)}</figcaption>
    </figure>
  </div>
  {safeguards && <div class="st-safeguards">
    {safeguards.map((item) => <IconFeature icon={item.icon} title={item.title} text={factText(item.text,locale)} level={T} />)}
  </div>}
  {seals.length > 0 && <div class="proof st-proof"><div class="quality">
    <ul>{seals.map((q) => <IconFeature as="li" icon={QICON[q.icon]} logo={q.show ? q.logo : undefined} title={q.title} text={q.text} level={T} />)}</ul>
  </div></div>}
</section>


<script>
  import { REVEAL_MARGIN } from '../../scripts/reveal-point.js';
  // Popover an der Karte: Zeigen (Maus) auf Nummer oder Zone, Fokus oder Tippen öffnet die Erklärung der Zone neben der
  // Nummer. Esc, Tippen daneben oder Verlassen der Karte mit der Maus schließt. Positionierung klassisch per JavaScript,
  // innerhalb der Kartenbreite geklemmt (kein seitliches Scrollen auf dem Handy).
  // Eintritt (Runde 4): erst wenn die Karte ins Bild kommt, einmalig: Ebenen fahren auseinander, Drohnen stehen im
  // Startraster, heben als Raster ab und formen das Motiv (ca. 3 s), danach pulsen die Nummern einmal. Ohne
  // IntersectionObserver oder bei reduzierter Bewegung steht sofort der Endzustand. Keine Dauerschleife.
  document.querySelectorAll<HTMLElement>('.ls-site [data-st-map]').forEach((map) => {
    const fig = map.closest('.st-fig') as HTMLElement;
    const hots = [...map.querySelectorAll<HTMLButtonElement>('[data-hot]')];
    const tips = [...map.querySelectorAll<HTMLElement>('[data-tip]')];
    const gridZone = map.dataset.gridZone;
    let current = '';
    let running = false;
    let timers: number[] = [];
    const phase = (p: string) => { map.dataset.phase = p; };
    const settle = () => { timers.forEach(clearTimeout); timers = []; running = false; map.classList.remove('is-pre'); map.classList.add('is-ready'); };
    const place = (zone: string) => {
      const hot = hots.find((b) => b.dataset.hot === zone), tip = tips.find((el) => el.dataset.tip === zone);
      if (!hot || !tip || getComputedStyle(tip).position !== 'absolute') return;
      const m = map.getBoundingClientRect(), b = hot.getBoundingClientRect(), gap = 2;
      const w = tip.offsetWidth, h = tip.offsetHeight;
      const cx = b.left + b.width / 2 - m.left;
      const left = Math.max(0, Math.min(m.width - w, cx - w / 2));
      const below = b.bottom - m.top + gap, above = b.top - m.top - h - gap;
      const top = below + h <= m.height || above < 0 ? below : above;
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      tip.style.left = `${(left / rem).toFixed(3)}rem`; tip.style.top = `${(top / rem).toFixed(3)}rem`;
    };
    const show = (zone: string) => {
      if (running) settle();
      current = zone;
      fig.classList.toggle('has-on', Boolean(zone));
      // Start- und Landefläche gewählt: die Drohnen stehen wieder im Startraster, sonst zeigen sie das Motiv
      phase(zone && zone === gridZone ? 'grid' : 'motif');
      map.querySelectorAll<SVGElement | HTMLElement>('[data-zone], [data-tip]').forEach((el) => el.classList.toggle('on', (el.dataset.zone ?? el.dataset.tip) === zone));
      hots.forEach((b) => b.setAttribute('aria-expanded', String(b.dataset.hot === zone)));
      if (zone) place(zone);
    };
    // Zeigen wählt nur bei echter Mausbewegung, nicht wenn sich der Inhalt unter dem stehenden Zeiger verschiebt
    let last = { x: -1, y: -1 };
    map.addEventListener('pointermove', (e) => { last = { x: e.clientX, y: e.clientY }; });
    map.querySelectorAll<HTMLElement | SVGElement>('[data-pick], [data-hot]').forEach((el) => {
      const zone = (el as HTMLElement).dataset.pick ?? (el as HTMLElement).dataset.hot!;
      el.addEventListener('pointerenter', (e) => {
        const p = e as PointerEvent;
        if (p.pointerType === 'mouse' && (p.clientX !== last.x || p.clientY !== last.y)) show(zone);
      });
      el.addEventListener('click', (e) => { e.stopPropagation(); show(zone); });
    });
    let restoring = false; // Esc gibt den Fokus an die Nummer zurück, ohne das Popover wieder zu öffnen
    hots.forEach((b) => b.addEventListener('focus', () => { if (!restoring) show(b.dataset.hot!); }));
    map.addEventListener('focusout', (e) => { if (!map.contains(e.relatedTarget as Node)) show(''); });
    map.addEventListener('pointerleave', (e) => { if ((e as PointerEvent).pointerType === 'mouse' && !map.contains(document.activeElement)) show(''); });
    map.addEventListener('keydown', (e) => { if (e.key === 'Escape' && current) { const hot = hots.find((b) => b.dataset.hot === current); show(''); restoring = true; hot?.focus({ preventScroll: true }); restoring = false; } });
    document.addEventListener('click', (e) => { if (current && !map.contains(e.target as Node)) show(''); });
    addEventListener('resize', () => { if (current) place(current); }, { passive: true });
    fig.classList.add('is-live');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) { map.classList.add('is-ready'); return; }
    running = true;
    map.classList.add('is-pre');
    phase('grid');
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (!running) return;
        map.classList.remove('is-pre');
        timers.push(window.setTimeout(() => phase('lift'), 1250));
        timers.push(window.setTimeout(() => phase('motif'), 1950));
        timers.push(window.setTimeout(() => { running = false; map.classList.add('is-ready'); }, 2800));
      }));
    }, { rootMargin: REVEAL_MARGIN });
    io.observe(map);
  });
</script>

<style>
  /* Text links, Zeichnung rechts. Die Zeichnung wächst mit der Breite bis 50rem (Marc, 18.11.2026) und endet an der
     rechten Content-Kante; die Textspalte behält ihre Lesebreite, der Abstand dazwischen bleibt klein. */
  .st { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, min(50rem, 54%)); gap: clamp(var(--space-6), 3.5vw, var(--space-12)); align-items: center; }
  .st :global(.st-copy) { margin: 0; }
  .st-fig { margin: 0; min-width: 0; }
  .st-map, .st-stage { position: relative; width: 100%; }
  .st-map svg { width: 100%; height: auto; display: block; overflow: visible; }

  /* Ebenen der Explosionsansicht: beim Eintritt aus der zusammengeschobenen Lage (--from) an ihren Platz */
  .ly { transition: transform var(--dur-slow-long) var(--ease-scene) calc(var(--li) * var(--dur-stagger-reveal)), opacity var(--dur-fade) var(--ease-out) calc(var(--li) * var(--dur-stagger-reveal)); }
  .is-pre .ly { transform: translateY(var(--from)); opacity: 0; }
  .ly-drones { transition: opacity var(--dur-fade) var(--ease-out) var(--dur-slow-long); }
  .is-pre .ly-drones, .is-pre .dr { opacity: 0; transition: none; }

  /* Boden, Raster, Publikum (innen) */
  .slab { fill: rgb(var(--rgb-head) / 3.5%); stroke: rgb(var(--rgb-head) / 14%); stroke-width: 0.8; }
  .slab-side { fill: rgb(var(--rgb-head) / 7%); stroke: rgb(var(--rgb-head) / 12%); stroke-width: 0.6; }
  .floor-line { fill: none; stroke: rgb(var(--rgb-head) / 5%); stroke-width: 0.6; }
  .footprint { fill: color-mix(in srgb, var(--zc) 7%, transparent); stroke: color-mix(in srgb, var(--zc) 55%, transparent); stroke-width: 1; stroke-dasharray: 4 4; }
  .pad { fill: color-mix(in srgb, var(--zc) 20%, var(--ground)); stroke: color-mix(in srgb, var(--zc) 80%, transparent); stroke-width: 1; }
  .pad-edge { fill: color-mix(in srgb, var(--zc) 45%, var(--ground)); }
  .seed-ring { fill: none; stroke: color-mix(in srgb, var(--zc) 60%, transparent); stroke-width: 0.8; }
  .mast { fill: none; stroke: color-mix(in srgb, var(--zc) 75%, transparent); stroke-width: 1.3; }
  .mast-glow { fill: var(--zc); opacity: 0.18; }
  .mast-tip { fill: var(--zc); }
  .person { fill: color-mix(in srgb, var(--zc) 18%, var(--ground)); stroke: color-mix(in srgb, var(--zc) 70%, transparent); stroke-width: 0.8; }
  .person-head { fill: color-mix(in srgb, var(--zc) 80%, transparent); }
  .keepout { fill: none; stroke: var(--zc); stroke-width: 1.2; stroke-dasharray: 2 3; opacity: 0.85; }
  /* Flugvolumen als Glasquader */
  .glass-floor, .glass-back { fill: color-mix(in srgb, var(--zc) 4%, transparent); }
  .glass-hidden { fill: none; stroke: color-mix(in srgb, var(--zc) 35%, transparent); stroke-width: 0.8; stroke-dasharray: 3 4; }
  .glass, .glass-top { fill: color-mix(in srgb, var(--zc) 6%, transparent); }
  .glass-edge { fill: none; stroke: color-mix(in srgb, var(--zc) 70%, transparent); stroke-width: 1.1; }
  .guide { fill: none; stroke: rgb(var(--rgb-head) / 22%); stroke-width: 0.8; stroke-dasharray: 1.5 3.5; }
  /* Decke */
  .ceil-under { fill: none; }
  .ceil { fill: color-mix(in srgb, var(--zc) 2.5%, transparent); stroke: color-mix(in srgb, var(--zc) 45%, transparent); stroke-width: 0.8; }
  .ceil-side { fill: color-mix(in srgb, var(--zc) 14%, transparent); stroke: color-mix(in srgb, var(--zc) 45%, transparent); stroke-width: 0.6; }
  .hatch { fill: none; stroke: color-mix(in srgb, var(--zc) 55%, transparent); stroke-width: 0.7; }
  .dim { fill: none; stroke: var(--faint); stroke-width: 1; }
  /* Draußen: Lageplan als ruhiger Grund, Zonen als gestaffelte Platten */
  .ground { fill: rgb(var(--rgb-head) / 2.5%); stroke: rgb(var(--rgb-head) / 8%); stroke-width: 0.6; }
  .road { fill: rgb(var(--rgb-head) / 5%); }
  .park { fill: rgb(var(--rgb-good) / 6%); }
  .tree { fill: rgb(var(--rgb-good) / 16%); }
  .house-front { fill: rgb(var(--rgb-head) / 7%); stroke: rgb(var(--rgb-head) / 9%); stroke-width: 0.5; }
  .house-side { fill: rgb(var(--rgb-head) / 4.5%); stroke: rgb(var(--rgb-head) / 9%); stroke-width: 0.5; }
  .house-top { fill: rgb(var(--rgb-head) / 10%); stroke: rgb(var(--rgb-head) / 12%); stroke-width: 0.5; }
  .zplate { fill: color-mix(in srgb, var(--zc) 16%, var(--ground)); stroke: color-mix(in srgb, var(--zc) 75%, transparent); stroke-width: 1.2; }
  .zplate-edge { fill: color-mix(in srgb, var(--zc) 34%, var(--ground)); }
  .guest-dot { fill: var(--zc); }
  .view { fill: none; stroke: var(--zc); stroke-width: 1; stroke-dasharray: 3 4; opacity: 0.8; }

  /* Drohnen: Startraster → Abheben als Raster → Motiv im Logo-Verlauf */
  .dr { transform: translate(var(--mx), var(--my)); transition: transform var(--dur-slow) var(--ease-scene) calc(var(--k) * var(--dur-stagger) / 2); }
  [data-phase="grid"] .dr { transform: translate(var(--gx), var(--gy)); }
  [data-phase="lift"] .dr { transform: translate(var(--lx), var(--ly)); transition-delay: calc(var(--k) * var(--dur-stagger) / 8); }
  .dr .core { fill: var(--c); transition: fill var(--dur-slow) var(--ease-default); }
  .dr .halo { fill: var(--c); opacity: 0.16; transition: opacity var(--dur-slow) var(--ease-default); }
  :is([data-phase="grid"], [data-phase="lift"]) .dr .core { fill: var(--head); }
  [data-phase="grid"] .dr .halo { opacity: 0; }

  /* Gewählte Zone: die anderen treten zurück, die gewählte bekommt die laufende Kontur */
  .zone { cursor: pointer; }
  .is-live .zone, .is-ready .ly-drones { transition: opacity var(--dur-glide) var(--ease-default); }
  .has-on .zone:not(.on) { opacity: 0.32; }
  .has-on [data-phase="motif"] .ly-drones:not(.on) { opacity: 0.35; }
  .has-on .zone.on :is(.zplate, .glass-edge, .footprint, .pad, .ceil, .keepout) { stroke: var(--zc); stroke-width: 2; stroke-dasharray: 7 5; animation: st-march var(--dur-ambient) var(--ease-linear) infinite; }
  .has-on .ly-drones.on .core { animation: st-twinkle var(--dur-branch) var(--ease-ambient) infinite; animation-delay: calc(var(--k) * var(--dur-stagger) * 2); }
  @keyframes st-march { to { stroke-dashoffset: -24; } }
  @keyframes st-twinkle { 50% { fill: var(--head); } }

  /* Maße als kleine Pillen in HTML, damit sie auf jeder Breite lesbar bleiben */
  .st-lbl { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%); padding: var(--space-1) var(--space-2-5); border-radius: var(--radius-pill); background: var(--ground); border: 1px solid var(--line-strong); color: var(--head); font: 500 var(--text-xs)/1.2 var(--display); white-space: nowrap; pointer-events: none; transition: opacity var(--dur-fade) var(--ease-default); }
  .has-on .st-lbl:not(.on) { opacity: 0.35; }
  /* Nummern: sichtbar in HTML (feste Größe), Tippfläche 44 px */
  .st-hot { position: absolute; left: var(--x); top: var(--y); width: 2.75rem; height: 2.75rem; margin: -1.375rem 0 0 -1.375rem; padding: 0; border: 0; border-radius: var(--radius-round); background: transparent; cursor: pointer; display: grid; place-items: center; z-index: 2; }
  .st-num { width: 1.875rem; height: 1.875rem; border-radius: var(--radius-round); display: grid; place-items: center; background: var(--ground); border: 1.5px solid var(--zc); color: var(--zc); font: 600 var(--text-sm)/1 var(--display); transition: background var(--dur-standard) var(--ease-default), color var(--dur-standard) var(--ease-default), transform var(--dur-control) var(--ease-default); }
  .st-hot:hover .st-num { transform: scale(1.08); }
  .st-hot[aria-expanded="true"] .st-num { background: var(--zc); color: var(--ground); }
  .st-hot:focus-visible { outline: none; }
  .st-hot:focus-visible .st-num { outline: 2px solid var(--zc); outline-offset: 3px; }
  .is-live .st-map:not(.is-ready) :is(.st-hot, .st-lbl) { opacity: 0; pointer-events: none; }
  /* Nach dem Eintritt pulsen die Nummern einmal sanft: hier kann man tippen */
  .is-ready .st-num { animation: st-pulse var(--dur-record) var(--ease-out) calc(var(--n) * var(--dur-stagger-reveal)) 1 backwards; }
  @keyframes st-pulse {
    0% { transform: scale(0.6); opacity: 0; box-shadow: 0 0 0 0 color-mix(in srgb, var(--zc) 60%, transparent); }
    25% { transform: scale(1); opacity: 1; }
    100% { box-shadow: 0 0 0 0.875rem color-mix(in srgb, var(--zc) 0%, transparent); }
  }

  /* Ohne JavaScript: nummerierte Legende unter der Karte. Mit JavaScript: je Zone ein Popover an ihrer Nummer. */
  .st-tips { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; gap: var(--space-3); }
  .st-tips li { display: grid; grid-template-columns: 1.75rem minmax(0, 1fr); column-gap: var(--space-1-5); align-items: baseline; font-size: var(--text-sm); }
  .st-tips li > :not(.st-n) { grid-column: 2; }
  .st-n { color: var(--zc, var(--accent)); grid-row: span 3; }
  .st-tips .st-t { font: 500 var(--text-base)/1.3 var(--display); color: var(--head); }
