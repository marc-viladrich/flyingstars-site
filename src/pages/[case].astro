---
import {getProjects} from '../lib/content';
import View from '../components/pages/ShowcasePage.astro';
export async function getStaticPaths() {return (await getProjects()).filter(project=>project.data.showcase).map(project=>({params:{case:project.data.showcase.route},props:{project}}));}
---
<View {...Astro.props} locale="de" />
