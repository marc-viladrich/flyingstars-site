---
import { forPath } from '../../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
// Startseiten-Teaser des Show-Konfigurators, zweite Fassung (Marc, 31.10.2026): kein interaktiver Mini-Konfigurator,
// sondern ein sich selbst abspielendes Mockup, „wie so ein Quick-Showreel“. Links die Bühne mit denselben Motiven und
// Lichtern wie im Konfigurator, im schnellen Durchlauf durch die „Greatest Hits“ von SPARK bis ODYSSEY, dazwischen die
// lebendige Wolke, mittendrin ein Beispiel-Logo („Das könnte euer Logo sein“). Rechts ein reduziertes Wireframe des
// Konfigurators im Stil einer Motion-Grafik: Anlass-Chip, Paketknopf und Regler wechseln synchron zur Bühne. Das
// Wireframe ist reine Dekoration (aria-hidden, keine Formularelemente); bedienbar ist nur der Knopf in den Konfigurator.
// Runde 8 (Marc): das Wireframe stark reduziert und größer: unbeschriftete Anlass-Pills, die drei Paketknöpfe in ihren
// Farben, der Regler mit „N Drohnen“ und der Preis als Euro-Zeichen (€ bis €€€€€€), keine Platzhalterbalken mehr.
// Runde 9 (Marc): Anlass-Pills raus, „Paket“ über den Paketknöpfen, acht Euro-Stufen; drei Abläufe über die Prop
// `reel` (start, marke, hochzeit); beim Zeigen auf die Bühne ein dezenter Hinweis „Eigene Show zusammenstellen →“, die
// Bühne ist dann ein Link auf denselben Konfigurator (ohne eigenen Tab-Stopp, den Weg per Tastatur trägt der Knopf).
// Kein Section-Kopf und kein Section-Abstand: Kicker und Headline baut die Seite drumherum. Skript, Motive und Ablauf:
// src/scripts/show-teaser.js. Leistung: lädt erst, wenn der Block auf 300 px an den Viewport herankommt; zeichnet nur,
// solange die Bühne sichtbar ist; bei globaler Pause oder reduzierter Bewegung steht ein Motiv in Ruhe.
// Runde 11 (Marc): Knopf „Zum Show-Konfigurator“; der Paketrahmen gleitet wie im Konfigurator zum neuen Paket
// (.cft-ind, reines CSS über .is-on, das show-teaser.js setzt).
import { SHOW_PACKAGES, DRONE_RANGES, DRONES_MIN, DRONES_MAX } from '../../content/show-packages';

interface Props {
  /** Präfix für die IDs */
  id?: string;
  /** Ablauf: „start“ (Startseite), „marke“ (Werbung, corporate Motive), „hochzeit“ (Initialen, Herz, Ringe …) */
  reel?: 'start' | 'marke' | 'hochzeit';
  /** ohne Wirkung seit der Showreel-Fassung (der Ablauf ist fest), bleibt für bestehende Einbindungen */
  occasion?: string;
  /** ohne Wirkung seit der Showreel-Fassung, bleibt für bestehende Einbindungen */
  drones?: number;
  /** Ziel des Knopfs */
  href?: string;
  /** Beschriftung des Knopfs */
  cta?: string;
}
const { id = 'cft', reel = 'start', href = '/drohnenshow-preise/#konfigurator', cta = t('configuratorteaser.openTheShowConfigurator') } = Astro.props;
type Pkg = keyof typeof SHOW_PACKAGES;
const rgb = (k: Pkg) => `rgb(${SHOW_PACKAGES[k].color.join(',')})`;
const at = (n: number) => ((n - DRONES_MIN) / (DRONES_MAX - DRONES_MIN)) * 100;
const rangeTrack = `linear-gradient(90deg, ${(Object.keys(DRONE_RANGES) as Pkg[]).map((k) => `${rgb(k)} ${at(DRONE_RANGES[k].min)}%, ${rgb(k)} ${at(DRONE_RANGES[k].max)}%`).join(', ')})`;
// Startzustand wie das erste Bild des Showreels (SPARK, 100 Drohnen, Hochzeit), damit vor dem Laden nichts springt
const start = { pkg: 'SPARK' as Pkg, drones: 100 };
// Textalternative je Ablauf (dieselbe Beschreibung wie REELS[…].label in show-teaser.js)
const labels = {
  start: t('configuratorteaser.theFlyingstarsLogoBecomingSharperWithMoreDronesAHeart'),
  marke: t('configuratorteaser.aLogoBecomingSharperWithMoreDronesALightBulb'),
  hochzeit: t('configuratorteaser.initialsInsideAHeartAHeartIn2dAsA'),
};
---
<div class="cft" id={id} data-cft-root data-reel={reel} style={`--pkg: ${rgb(start.pkg)}`}>
  <div class="cft-stage">
    <div class="cft-view" role="img" aria-label={t('configuratorteaser.sampleDroneShowPreviewValue', { v0: labels[reel] ?? labels.start })}>
      <canvas data-cft="field" aria-hidden="true"></canvas>
    </div>
    <p class="cft-note" data-cft="note" aria-hidden="true"></p>
    <!-- die Bühne als Link (Runde 9): beim Zeigen ein dezenter Hinweis; kein eigener Tab-Stopp, per Tastatur führt der Knopf
         dorthin (hat er den Fokus, erscheint der Hinweis auch hier) -->
    <a class="cft-hit" href={localHref(href)} tabindex="-1" aria-hidden="true"><span>{t('configuratorteaser.createYourOwnShow')} <i>→</i></span></a>
    <p class="cft-error" data-cft="error" hidden>{t('configuratorteaser.thePreviewIsCurrentlyUnavailable')}</p>
  </div>

  <div class="cft-side">
    <!-- Wireframe des Konfigurators: reine Dekoration, folgt der Bühne (show-teaser.js) -->
    <div class="cft-mock" aria-hidden="true">
      <div class="cft-group">
        <p class="cft-label">{t('configuratorteaser.package')}</p>
        <div class="cft-pkgs" style={(Object.keys(SHOW_PACKAGES) as Pkg[]).map((k, i) => `--c${i}: ${rgb(k)}`).join('; ')}>
          {(Object.keys(SHOW_PACKAGES) as Pkg[]).map((k) => <span class:list={['cft-pkg', { 'is-on': k === start.pkg }]} data-cft="pkg" data-id={k} style={`--c: ${rgb(k)}`}>{k}</span>)}
          <span class="cft-ind"></span>
        </div>
      </div>
      <div class="cft-drones">
        <p class="cft-count"><b data-cft="count">{start.drones}</b> {t('configuratorteaser.drones')}</p>
        <div class="cft-slider" style={`--track: ${rangeTrack}`}>
          <span class="cft-fill" data-cft="fill" style={`--at: ${at(start.drones) / 100}`}></span>
          <span class="cft-thumb" data-cft="thumb" style={`--at: ${at(start.drones) / 100}`}></span>
        </div>
      </div>
      <p class="cft-price">{[1, 2, 3, 4, 5, 6, 7, 8].map((k) => <span class:list={['cft-euro', { 'is-on': k <= 1 }]} data-cft="euro">€</span>)}</p>
    </div>
    <a class="btn primary cft-cta" href={localHref(href)}>{cta}</a>
  </div>
</div>

<script>
  // Engine und Motive erst laden, wenn der Block in die Nähe des Viewports kommt (300 px vorher)
  for (const root of document.querySelectorAll<HTMLElement>('[data-cft-root]')) {
    const go = () => import('../../scripts/show-teaser.js').then((m) => m.initTeaser(root));
    if (!('IntersectionObserver' in window)) { go(); continue; }
    const io = new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting)) { io.disconnect(); go(); } }, { rootMargin: '300px 0px' });
    io.observe(root);
  }
</script>

<style>
  /* Bühne links, Wireframe-Spalte rechts (Runde 8: Wireframe größer, Bühne etwas schmaler); auf dem Handy Bühne oben,
     darunter nur Paketknöpfe und Regler */
  .cft { display: grid; grid-template-columns: minmax(0, 1fr) clamp(20rem, 31vw, 28.75rem); gap: clamp(1.25rem, 3vw, 3.5rem); align-items: stretch; }
  .cft-stage { position: relative; min-height: clamp(25rem, 62vh, 45rem); border-radius: var(--radius); background: radial-gradient(ellipse at 50% 120%, rgba(51, 237, 242, 0.06), transparent 60%), #0a0908; border: 1px solid var(--line); overflow: hidden; }
  .cft-view, .cft-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cft-error { position: absolute; inset: auto 1.25rem 1.25rem; margin: 0; color: var(--muted); font-size: var(--text-sm); }
  /* „Euer Logo wird mit mehr Drohnen schärfer“ (Entwurf): nur während des Logos, unten auf der Bühne, der Kern im Verlauf */
  .cft-note { position: absolute; z-index: 2; left: 0; right: 0; bottom: clamp(1rem, 4%, 2rem); margin: 0 auto; width: fit-content; max-width: calc(100% - 2rem); font: 400 var(--text-sm)/1.3 var(--display); color: var(--muted); text-align: center; opacity: 0; transform: translateY(0.375rem); transition: opacity 0.5s ease, transform 0.5s ease; }
  .cft-note b { font: 600 var(--text-copy)/1.2 var(--display); background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cft-note.is-on { opacity: 1; transform: none; }

  /* die Bühne als Link: beim Zeigen (und wenn der Knopf den Fokus hat) ein dezenter Schleier mit Hinweis, leiser als die
     Dropzone im Konfigurator */
  .cft-hit { position: absolute; inset: 0; z-index: 3; display: grid; place-items: center; border-radius: inherit; color: var(--text); text-decoration: none; background: radial-gradient(ellipse at 50% 55%, rgba(10, 9, 8, 0.38), rgba(10, 9, 8, 0.12) 70%); opacity: 0; transition: opacity 0.25s ease; }
  .cft-hit span { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5625rem 1rem; border: 1px solid rgba(246, 241, 232, 0.22); border-radius: 62.4375rem; background: rgba(15, 13, 12, 0.6); -webkit-backdrop-filter: blur(0.25rem); backdrop-filter: blur(0.25rem); font: 500 var(--text-control)/1 var(--display); transform: translateY(0.25rem); transition: transform 0.25s ease; }
  .cft-hit i { font-style: normal; transition: transform 0.25s ease; }
  .cft-hit:hover, .cft:has(.cft-cta:focus) .cft-hit { opacity: 1; }
  .cft-hit:hover span, .cft:has(.cft-cta:focus) .cft-hit span { transform: none; }
  .cft-hit:hover i { transform: translateX(0.1875rem); }
  @media (hover: none) { .cft-hit { display: none; } }
  .cft-side { display: grid; align-content: center; gap: 1.5rem; }
  .cft-mock { display: grid; gap: 1.625rem; padding: clamp(1.375rem, 2.2vw, 2rem); border: 1px solid var(--line); border-radius: var(--radius); background: rgba(246, 241, 232, 0.02); pointer-events: none; user-select: none; }
  .cft-group { display: grid; gap: 0.625rem; }
  .cft-label { margin: 0; font-size: var(--text-control); color: var(--muted); }
  /* Paketknöpfe in ihren Farben (amber, orchid, cyan); Runde 10: die nicht gewählten in ihrer Farbe gedämpft (40 % Farbe,
     60 % --faint): auf der Karte 6,7:1 / 5,6:1 / 7,7:1, also über AA */
  .cft-pkgs { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.25rem; padding: 0.25rem; border: 1px solid var(--line); border-radius: 0.75rem; }
  .cft-pkg { position: relative; z-index: 1; display: grid; place-items: center; min-height: 3.25rem; border-radius: 0.5625rem; font: 600 var(--text-label)/1 var(--mono); letter-spacing: 0.08em; color: color-mix(in srgb, var(--c) 40%, var(--faint)); transition: color 0.35s ease; }
  .cft-pkg.is-on { color: var(--c); }
  /* Runde 11: ein Rahmen, der zum gewählten Paket gleitet (wie .cfg-ind im Konfigurator), Farbe des Pakets */
  .cft-pkgs { --i: 0; --sc: var(--c0); }
  .cft-pkgs:has([data-id=HORIZON].is-on) { --i: 1; --sc: var(--c1); }
  .cft-pkgs:has([data-id=ODYSSEY].is-on) { --i: 2; --sc: var(--c2); }
  .cft-ind { position: absolute; z-index: 0; top: 0.25rem; bottom: 0.25rem; left: 0.25rem; width: calc((100% - 1rem) / 3); box-sizing: border-box; border-radius: 0.5625rem; border: 1px solid var(--sc); background: color-mix(in srgb, var(--sc) 16%, transparent); transform: translateX(calc(var(--i) * (100% + 0.25rem))); transition: transform 0.55s cubic-bezier(0.3, 0.7, 0.2, 1), border-color 0.55s ease, background-color 0.55s ease; }
  /* Regler mit „N Drohnen“ */
  .cft-drones { display: grid; gap: 0.75rem; }
  .cft-count { margin: 0; font: 400 var(--text-base)/1 var(--display); color: var(--muted); }
  .cft-count b { font: 600 1.625rem/1 var(--display); color: var(--text); font-variant-numeric: tabular-nums; margin-right: 0.25rem; }
  .cft-slider { position: relative; height: 1.375rem; }
  .cft-slider::before { content: ""; position: absolute; left: 0; right: 0; top: 0.5625rem; height: 0.25rem; border-radius: 0.125rem; background: var(--track); opacity: 0.25; }
  .cft-fill { position: absolute; left: 0; top: 0.5625rem; height: 0.25rem; width: calc(var(--at) * 100%); border-radius: 0.125rem; background: var(--track); background-size: calc(100% / max(var(--at), 0.001)) 100%; transition: width 0.7s cubic-bezier(0.45, 0, 0.2, 1); }
  .cft-thumb { position: absolute; top: 0; left: calc(var(--at) * (100% - 1.375rem)); width: 1.375rem; height: 1.375rem; border-radius: 50%; background: var(--text); border: 0.3125rem solid var(--pkg, var(--amber)); box-shadow: 0 0 0 0.25rem rgba(15, 13, 12, 0.9), 0 0 1rem 2px color-mix(in srgb, var(--pkg, var(--amber)) 45%, transparent); transition: left 0.7s cubic-bezier(0.45, 0, 0.2, 1), border-color 0.4s ease, box-shadow 0.4s ease; }
  /* Preis ohne Zahlen: sechs Euro-Zeichen, die erreichten hell */
  .cft-price { margin: 0; padding-top: 1.125rem; border-top: 1px solid var(--line); font: 600 1.5rem/1 var(--display); letter-spacing: 0.04em; white-space: nowrap; }
  .cft-euro { color: rgba(246, 241, 232, 0.16); transition: color 0.35s ease; }
  .cft-euro.is-on { color: var(--text); }
  /* kurzer Druck, wo der Zustand wechselt (statt eines sichtbaren Cursors) */
  .cft-pkg.is-press { animation: cft-press 0.45s ease-out; }
  @keyframes cft-press { 0% { transform: scale(1); } 35% { transform: scale(0.94); } 100% { transform: scale(1); } }
  .cft-cta { justify-self: start; }
  @media (prefers-reduced-motion: reduce) {
    .cft-pkg.is-press { animation: none; }
    .cft-fill, .cft-thumb, .cft-note, .cft-hit, .cft-hit span, .cft-hit i, .cft-ind, .cft-pkg { transition: none; }
  }
  :global(html.motion-paused) .cft-pkg.is-press { animation: none; }
  @media (max-width: 53.75em) {
    .cft { grid-template-columns: 1fr; gap: 1rem; }
    .cft-stage { align-self: start; min-height: 21.25rem; aspect-ratio: 1 / 1.05; }
    .cft-side { gap: 1.125rem; }
    /* auf dem Handy nur Paketknöpfe und Regler */
    .cft-mock { padding: 1rem; gap: 1rem; }
    .cft-price { display: none; }
    .cft-pkg { min-height: 2.75rem; font-size: var(--text-xs); }
    .cft-count b { font-size: 1.375rem; }
  }
</style>
