---
import {forPath} from '../i18n/server';
const {locale}=forPath(Astro.url.pathname);
import {factText} from '../content/show-extras.mjs';
import { factColumns } from '../lib/lists';
interface Fact { label: string; value?: string | number | import('../content/business-facts.mjs').BusinessRef; unit?: string; text?: string; count?: number }
interface Props { items: Fact[]; variant?: 'metrics' | 'tempo' | 'numbers' | 'credits' | 'hero' | 'story' | 'spotlight' | 'eco' | 'spec'; label?: string }
const { items, variant = 'metrics', label } = Astro.props;
const root = { metrics: 'sheet', tempo: 'tempo-facts', numbers: 'c-numbers', credits: 'c-credits mono', hero: 'lh-facts', story: 'ls-facts', spotlight: 'sp-facts', eco: 'eco-facts', spec: 'spec mono' }[variant];
const itemClass = variant === 'metrics' ? 'cell' : variant === 'numbers' ? 'c-num' : variant === 'eco' ? 'fact' : undefined;
const labelClass = variant === 'metrics' ? 'k mono' : variant === 'eco' ? 'fk mono' : ['tempo', 'hero', 'story', 'spotlight'].includes(variant) ? 'mono' : undefined;
---
<dl class:list={['fact-list', root]} aria-label={label} data-columns={items.length} style={`--fact-columns:${factColumns(items.length)}`}>
  {items.map((item, i) => <div class={itemClass}>
    <dt class={labelClass}>{item.label}</dt>
    {item.value !== undefined && item.value !== '' && <dd class:list={['fact-value', { v: variant === 'metrics' || variant === 'tempo', fn: variant === 'eco', g: variant === 'eco' && item.unit === '%', o: variant === 'eco' && i === 1 && items.length > 2 }]} data-count={item.count}>
      {variant === 'spec' ? <b>{factText(item.value,locale)}</b> : variant === 'eco' && item.unit === '%' ? <span data-to={factText(item.value,locale)}>{factText(item.value,locale)}</span> : factText(item.value,locale)}{item.unit && <small>{item.unit}</small>}
    </dd>}
    {item.text && <dd class:list={['fact-text', { ft: variant === 'eco', t: variant === 'tempo' }]}><p>{item.text}</p></dd>}
  </div>)}
</dl>
