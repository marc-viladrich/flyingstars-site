---
import MediaFrame from '../MediaFrame.astro';
import FactList from '../FactList.astro';
import { forPath } from '../../i18n/server';
const { t, localHref, fact } = forPath(Astro.url.pathname);
// Seitenkopf der Anlass-Landingpages (Marc, 31.10.2026: „in der Hero Section … so ein kleines Showreel, gerne in einer
// kleineren Variante, so ähnlich wie wir jetzt ein Hero-Bild haben“). Links Kicker, Headline, Satz, Aktionen und bis zu
// vier Eckdaten; rechts ein Bildrahmen mit stummem Loop. Startet von selbst, sobald der Rahmen im Bild ist, auch auf dem
// Handy (Marc, 21.11.2026: „wie bei der Startseite oben und autoplay … aber halt auch 480p für geringe Datenmengen“): dort
// steht der Rahmen über der Überschrift und lädt die 480p-Fassung. Hält an bei globaler Pause (html.motion-paused),
// reduzierter Bewegung, Datensparmodus und außerhalb des Bildes; dann startet der Knopf. Quelle nur aus src/lib/videos.ts
// (Vorschau 960 px bzw. Handyfassung 480p über videoPath()) auf derselben Origin.
import type { Section } from '../../content.config';
import Accent from '../Accent.astro';
import Icon from '../Icon.astro';
import { optimizedImage } from '../../lib/media';
import { videos, videoPath } from '../../lib/videos';
type Props = Extract<Section, { type: 'landingHero' }> & { index: number };
// Runde 14 (Marc und Moritz, 21.11.2026, Hochzeit): statt `video` kann `show` stehen, dann zeigt der Rahmen Formationen aus
// dem Show-Konfigurator (src/scripts/hero-show.js, Ablauf in show-teaser.js). Gleicher Platz, gleiche Größe, gleicher
// Rahmen; das Standbild bleibt LCP und steht, bis die ersten Drohnen fliegen, bei reduzierter Bewegung und ohne JavaScript.
// Die Engine lädt erst nach dem Laden der Seite, in Stufen und im Leerlauf. Genau eins von beiden.
const { kicker, headline, text, cta, secondary, video, show, videoLabel = t('common.showreel'), poster, facts } = Astro.props;
if (Boolean(video) === Boolean(show)) throw new Error('landingHero braucht genau eins von video und show');
const still = await optimizedImage(poster.src, 960);
const src = video && videoPath(videos[video], 'preview');
const small = video && videoPath(videos[video], 'mobile');
// Telefon-Knopf mit Lucide-Telefon (Runde 16, Marc: Porträts im Seitenkopf „passen so nicht“)
const tel = Boolean(secondary && localHref(secondary.href).startsWith('tel:'));
const showLabels = { hochzeitHero: t('landinghero.weddingShowLabel') };
---
<section class="lh" aria-labelledby="hero-h">
  <div class="lh-copy">
    <h1 id="hero-h">{kicker && <><span class="kicker mono">{kicker}</span>{' '}</>}<Accent text={headline} /></h1>
    <p class="lead">{text}</p>
    <div class="actions"><a class="btn primary" href={localHref(cta.href)}>{fact(cta.label)}</a>{secondary && (tel ? <a class="btn" href={localHref(secondary.href)}><Icon name="phone" size={16} class="call-ico" />{fact(secondary.label).replace(/^\u260E\uFE0E?\s*/, '')}</a> : <a class="btn" href={localHref(secondary.href)}>{fact(secondary.label)}</a>)}</div>
    {facts.length > 0 && <FactList items={facts} variant="hero" />}
  </div>
  {show ? <MediaFrame class="lh-media lh-show" corners="inset" data-lh-show={show} data-lh-label={showLabels[show]}>
    <img src={still.src} width={still.width} height={still.height} alt={poster.alt} loading="eager" fetchpriority="high" decoding="async" />
    <canvas data-lh-field aria-hidden="true"></canvas>
    <span class="lh-rec lh-art mono" aria-hidden="true" data-lh-art></span>
  </MediaFrame> : <MediaFrame class="lh-media" corners="inset" data-lh-reel>
    <img src={still.src} width={still.width} height={still.height} alt={poster.alt} loading="eager" fetchpriority="high" decoding="async" />
    <video data-src={src} data-src-small={small} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
    <span class="lh-rec mono" aria-hidden="true">{videoLabel}</span>
    <button class="lh-toggle mono" type="button" data-lh-toggle aria-pressed="false" hidden>
      <Icon name="play" size={16} class="g i-play" /><Icon name="pause" size={16} class="g i-pause" />
      <span data-lh-label>{t('landinghero.playVideo')}</span>
    </button>
  </MediaFrame>}
</section>

<script>
  import { t } from '../../i18n/ui.mjs';
  import { createVideoController } from '../../scripts/video-controller';
  document.querySelectorAll<HTMLElement>('[data-lh-reel]').forEach((host) => {
    const v = host.querySelector('video')!;
    const btn = host.querySelector<HTMLButtonElement>('[data-lh-toggle]')!;
    const label = host.querySelector<HTMLElement>('[data-lh-label]')!;
    const show = (on: boolean) => {
      btn.setAttribute('aria-pressed', String(on));
      label.textContent = on ? t('landinghero.pauseVideo') : t('landinghero.playVideo');
      btn.setAttribute('aria-label', label.textContent);
      host.classList.toggle('is-on', on);
      // einmal gelaufen: angehalten bleibt das Bild des Videos stehen, das Standbild kommt nicht zurück
      if (on) host.classList.add('has-played');
      host.classList.add('ready');
    };
    const controller = createVideoController(v, { host, trigger: 'manual', visibilityThreshold: 0.25, autoMediaQuery: 'all', onState: show,
      onError: () => { host.classList.remove('is-on', 'can-toggle'); btn.hidden = true; } });
    btn.hidden = false;
    btn.addEventListener('click', () => controller.setChoice(!host.classList.contains('is-on')));
    // Klick irgendwo aufs Video schaltet wie der Knopf (Marc, 02.11.2026); der Knopf bleibt das Ziel für Tastatur und Screenreader
    host.addEventListener('click', (event) => { if (!btn.hidden && !btn.contains(event.target as Node)) btn.click(); });
    host.classList.add('can-toggle');

  });
</script>

<script>
  import { importInStages, afterHeroPaint } from '../../scripts/when-near.mjs';
  // Formationen statt Video (Runde 14): erst nach dem Laden der Seite und im Leerlauf, damit vor dem LCP weder Szenen noch
  // Katalogdaten laden (tools/himmel/perf-start.mjs); die Modulkette in Stufen wie beim Konfigurator-Teaser. Reduzierte
  // Bewegung: das Standbild bleibt, die Engine lädt nicht. Globale Pause: lädt erst, wenn die Pause aufgehoben wird.
  const hosts = document.querySelectorAll<HTMLElement>('[data-lh-show]');
  const idle = () => new Promise<void>((res) => ('requestIdleCallback' in window ? requestIdleCallback(() => res(), { timeout: 1200 }) : setTimeout(res, 200)));
  const paused = () => document.documentElement.classList.contains('motion-paused');
  // der Pause-Knopf der Kopfzeile meldet jeden Wechsel (src/scripts/site.ts)
  const whenPlaying = () => new Promise<void>((res) => {
    if (!paused()) return res();
    const resume = () => { if (!paused()) { document.removeEventListener('flyingstars:motion-change', resume); res(); } };
    document.addEventListener('flyingstars:motion-change', resume);
  });
  if (hosts.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    afterHeroPaint().then(idle).then(whenPlaying).then(() => importInStages(
      () => import('../../scripts/show-field.js'),
      () => import('../../scripts/show-scenes.js'),
      () => import('../../scripts/scenes/index.js'),
      () => import('../../content/show-configurator.js'),
      () => import('../../scripts/formation/index.js'),
      () => import('../../scripts/show-teaser.js'),
      () => import('../../scripts/hero-show.js'),
    )).then((m) => Promise.all([...hosts].map((host) => m.initHeroShow(host).then(() => {
      // jetzt beschreibt die Bühne, was zu sehen ist; das ausgeblendete Standbild tritt zurück
      const canvas = host.querySelector('canvas')!;
      canvas.setAttribute('role', 'img'); canvas.setAttribute('aria-label', host.dataset.lhLabel ?? ''); canvas.removeAttribute('aria-hidden');
      host.querySelector('img')?.setAttribute('aria-hidden', 'true');
    })))).catch((error) => console.warn('Hero-Show konnte nicht laden', error));
  }
</script>

<style>
  .lh { position: relative; display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); gap: clamp(var(--space-8), 5vw, var(--space-20)); align-items: center; padding: clamp(var(--space-9), 6vw, var(--space-22)) var(--gutter) clamp(var(--space-14), 7vw, var(--space-28)); overflow: hidden; }
  /* ruhiges Leuchten hinter dem Rahmen, wie Restlicht einer Show */
  .lh::before { content: ""; position: absolute; right: -10%; top: 0; width: 70%; height: 100%; background: radial-gradient(closest-side, rgb(var(--rgb-logo-orchid) / 0.12), rgb(var(--rgb-cyan) / 0.04) 60%, transparent); pointer-events: none; }
  /* Text und Bild vertikal mittig zueinander (Runde 20f, Marc 22.11.2026, löst Runde 18 „Text oben“ ab): ist das Bild höher
     als der Text (ab etwa 1920 px), beginnt die erste Zeile tiefer als --hero-top; layout-audit prüft dann die Mitte */
  .lh-copy { position: relative; display: grid; gap: var(--space-5-5); justify-items: start; }
  /* Kicker in der h1 (Moritz' Keyword-Zeile), Abstand wie vorher außerhalb */
  .lh-copy h1 > .kicker { margin: 0 0 var(--space-3); }
  /* Unter 400 px folgt die Größe der Zeilenbreite (10vw), sonst setzt die Mindestgröße lange Komposita einzeln
     („Produkt-“ | „botschafter“, Audit 4, V2); ab 400 px gilt --text-page unverändert */
  .lh h1 { font-size: min(var(--text-page), 10vw); line-height: 1; letter-spacing: -0.035em; max-width: 16ch; }
  .lh .lead { max-width: 48ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  /* Rahmen wie im Startseiten-Hero (Vercel-Prototyp): Label und Knopf rasten innen in den Ecken ein, mittig auf Höhe des
     Schenkelendes und 14 px neben dem senkrechten Schenkel. --c-in: Abstand der Ecken vom Rand, --c-arm: Schenkellänge */
  /* Knopf (Marc, 02.11.2026): läuft das Video, sitzt „Video anhalten“ unten rechts in der Ecke. Angehalten (oder noch nicht
     gestartet) wandert er weich in die Mitte, verliert die Beschriftung und wird zum großen Play-Knopf; das Bild des
     Videos bleibt stehen. Lage über left/top/transform, damit sich die Bewegung überblenden lässt. */
  /* Das Video blendet über das Standbild (LCP) und bleibt 1 px kleiner, damit sein erstes Bild kein neues, späteres
     LCP-Element wird (gleiche Lösung wie im Startseiten-Hero, docs/himmel.md → Performance) */
  .lh :global(.lh-media video) { clip-path: inset(var(--space-0-25)); }
  /* Formationen statt Video (Runde 14): Nachthimmel wie die Bühne des Konfigurator-Teasers; das Standbild blendet aus, sobald
     die ersten Drohnen fliegen. Die Ecke links oben nennt die Art der Show (2D, 3D, 3D+), ohne Aufnahmepunkt. */
  .lh :global(.lh-show) { background: radial-gradient(ellipse at 50% 120%, var(--fill-cyan), transparent 60%), var(--media-ground); }
  .lh :global(.lh-show canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .lh :global(.lh-show img) { transition: opacity var(--dur-image) var(--ease-default); }
  .lh :global(.lh-show.is-live img) { opacity: 0; }
  .lh :global(.lh-art) { opacity: 0; transition: opacity var(--dur-standard) var(--ease-default); }
  .lh :global(.lh-show.is-live .lh-art) { opacity: 1; }
  .lh :global(.lh-art::before) { display: none; }
  @media (--timeline-stacked) {
    .lh { grid-template-columns: 1fr; }
    /* gestapelt steht der Rahmen oben, wie das Showreel auf der Startseite (Marc, 21.11.2026) */
    .lh :global(.lh-media) { order: -1; }
    .lh::before { width: 120%; right: -40%; top: 40%; height: 60%; }
  }
  @media (--small-facts) {
    /* Handy: Eckdaten als gleich breite Spalten, damit nichts einzeln umbricht */
  }
</style>
