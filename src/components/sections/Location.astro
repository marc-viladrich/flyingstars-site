---
// Standort als Punktkarte (Über uns, 17.11.2026). Es gibt kein Gebäudefoto; die Karte trägt den Abschnitt: Nordrhein-
// Westfalen aus Lichtpunkten wie ein Drohnenfeld (public/media/standort-nrw.svg, zum Ruhrgebiet hin heller, Generator
// tools/standort/nrw-punkte.mjs), die Orte leuchten in Farben des Logoverlaufs. Keine Beschriftung auf der Karte selbst
// (nahe Orte würden sich überdecken).
// 18.11.2026 (Marc: „we need the individual addresses nicely displayed with icons and in multiple rows below the text“):
// unter dem Text je Ort ein Adressblock, Icon in der Farbe seines Kartenpunkts, Anschrift mehrzeilig aus den Kontaktdaten,
// Route über OpenStreetMap (keine Google-Karte) und der passende Kontaktweg. Zeigen oder Fokus auf einem Block lässt
// seinen Punkt aufleuchten und umgekehrt; die Blöcke ersetzen die frühere Legende unter der Karte.
import {record,field} from 'astro-frontend-editor/markers';
import type { Section } from '../../content.config';
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { nrwPosition, NRW_MAP } from '../../lib/nrw-map.mjs';
import { contact as CONTACT, CONTACT_OWNER } from '../../content/contact.mjs';
import { forPath } from '../../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
type Props = Extract<Section, { type: 'location' }> & { index: number };
const { kicker, headline, text, places, note, cta, surface, id = `s${Astro.props.index}`, index } = Astro.props;
const H = index === 0 ? 'h1' : 'h2';
const Item = index === 0 ? 'h2' : 'h3';
const TONES = ['amber', 'cyan', 'orchid', 'amber'] as const;
// Kontaktweg je Anschrift: am Büro das Telefon, an der Post die E-Mail
const reach = {
  visit: { icon: 'phone', label: CONTACT.phone.label, href: CONTACT.phone.href, path: ['phone'] },
  post: { icon: 'mail', label: CONTACT.email, href: `mailto:${CONTACT.email}`, path: ['email'] },
} as const;
// Runde 5 (Marc: „den Abstand zwischen dem Büro und dem Hauptsitz künstlich ein bisschen höher machen, sonst ist es schwer,
// die direkt zu treffen“): Liegen die Orte auf der Karte enger als MIN_GAP (Prozent der Kartenbreite, echte Seitenverhältnisse),
// rücken sie entlang ihrer echten Verbindung vom gemeinsamen Mittelpunkt auseinander, bis der Abstand MIN_GAP erreicht.
const MIN_GAP = 4.6, ASPECT = NRW_MAP.height / NRW_MAP.width;
const raw = places.map((place) => nrwPosition(place.lat, place.lon));
const cx = raw.reduce((a, p) => a + p.x, 0) / raw.length, cy = raw.reduce((a, p) => a + p.y, 0) / raw.length;
const gap = raw.length > 1 ? Math.min(...raw.flatMap((p, i) => raw.slice(i + 1).map((q) => Math.hypot(p.x - q.x, (p.y - q.y) * ASPECT)))) : Infinity;
const spread = gap < MIN_GAP ? MIN_GAP / gap : 1;
const spot = raw.map((p) => ({ x: cx + (p.x - cx) * spread, y: cy + (p.y - cy) * spread }));
const pins = places.map((place, i) => ({
  ...place, tone: TONES[i], ...spot[i],
  lines: place.address ? CONTACT[place.address] : undefined,
  route: `https://www.openstreetmap.org/directions?route=%3B${place.lat}%2C${place.lon}#map=15/${place.lat}/${place.lon}`,
  reach: place.address ? reach[place.address] : undefined,
}));
const withAddress = pins.some((pin) => pin.lines);
---
<section class:list={['section loc', { alt: surface === 'alt' }]} id={id} aria-labelledby={`${id}-h`} data-loc>
  <div class="loc-grid">
    <div class="loc-copy">
      <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} level={H} variant="embedded" />
      {withAddress && <ul class="loc-places" role="list" {...record(CONTACT_OWNER)}>
        {pins.map((pin, i) => {
          // The projected contact values have explicit markers from CONTACT_OWNER.
          const { lines, reach: contactWay } = pin;
          return <li class:list={['loc-place', pin.tone]} data-pin={i}>
            <span class="loc-ico" aria-hidden="true"><Icon name={pin.icon ?? 'map-pin'} size={20} /></span>
            <div class="loc-body">
              <Item class="loc-name"><span class="loc-label mono">{pin.label}</span>{pin.role && <span class="loc-role">{pin.role}</span>}</Item>
              {lines && <address>{lines.map((line, n) => <span {...field(CONTACT_OWNER, [pin.address!, n], { mode: 'panel' })}>{line}</span>)}</address>}
              <p class="loc-links">
                <a class="hover-line" href={pin.route} target="_blank" rel="noopener" aria-label={t('location.routeLabel', { v0: lines?.slice(-2).join(', ') ?? pin.label })}><Icon name="route" size={16} />{t('location.route')}</a>
                {contactWay && <a class="hover-line" href={localHref(contactWay.href)} {...field(CONTACT_OWNER, [...contactWay.path], { mode: 'panel' })}><Icon name={contactWay.icon} size={16} />{contactWay.label}</a>}
              </p>
            </div>
          </li>;
        })}
      </ul>}
      {cta && <p class="loc-more"><a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a></p>}
    </div>
    <figure class="loc-map">
      <div class="loc-stage">
        <img src="/media/standort-nrw.svg" width={NRW_MAP.width} height={NRW_MAP.height} alt="" loading="lazy" decoding="async" />
        {/* Wandernder Lichtkegel (Runde 9): die Punkte im Lichtkreis leuchten amberfarben, zum Rand weich auslaufend. Runde 15: Lage
             aus der Zeigerposition per Skript, mit kurzer Trägheit. Runde 16 (Marc: in Safari „very much non-pleasant“): statt
             einer Verbundmaske (Punktkarte × Kreisverlauf), die WebKit bei jeder Lageänderung über die ganze Fläche neu rastert,
             zeichnet ein Canvas nur die Punkte im Kreis, gleicher Look. */}
        <canvas class="loc-lit" aria-hidden="true"></canvas>
        {pins.map((pin, i) => <span class:list={['loc-pin', pin.tone]} data-pin={i} style={`left:${pin.x.toFixed(2)}%;top:${pin.y.toFixed(2)}%`} aria-hidden="true"></span>)}
      </div>
      <figcaption>
        {!withAddress && <ul class="loc-legend">{pins.map((pin) => <li><span class:list={['loc-key', pin.tone]} aria-hidden="true"></span>{pin.label}</li>)}</ul>}
        {note && <p class="loc-note mono">{note}</p>}
      </figcaption>
    </figure>
  </div>
</section>

<script>
  // Lichtkegel als Canvas (Runde 16). Gezeichnet werden nur die Punkte der Karte im Kreis um die Lichtmitte, je Punkt mit der
  // Deckkraft, die früher der Kreisverlauf der Maske gab (voll bis 30 % des Radius, dann linear bis 0). Die Punkte liest das
  // Skript einmal aus derselben SVG, die das Bild zeigt (liegt dann schon im Cache). Die Mitte folgt dem Zeiger mit
  // exponentieller Glättung über --dur-follow; steht sie, hält die Schleife an und schreibt --sx/--sy an das Canvas.
  type Dot = [x: number, y: number];
  type DotMap = { w: number; h: number; r: number; dots: Dot[] };
  const LIGHT_RADIUS_REM = 8.5, CORE = 0.3, LEVELS = 24;
  const cssTime = (name: string) => { const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim(); return parseFloat(v) * (v.endsWith('ms') ? 1 : 1000) || 0; };
  const mapDots = new Map<string, Promise<DotMap>>();
  const loadDots = (src: string) => {
    if (!mapDots.has(src)) mapDots.set(src, fetch(src).then((r) => r.text()).then((svg) => {
      const [, w, h] = svg.match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/)!;
      const dots = [...svg.matchAll(/cx="([\d.]+)" cy="([\d.]+)"/g)].map((m): Dot => [+m[1], +m[2]]);
      return { w: +w, h: +h, r: +(svg.match(/ r="([\d.]+)"/)?.[1] ?? 3.4), dots };
    }));
    return mapDots.get(src)!;
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-loc]')) {
    const stage = root.querySelector<HTMLElement>('.loc-stage')!;
    const img = stage.querySelector('img')!;
    const canvas = stage.querySelector<HTMLCanvasElement>('.loc-lit')!;
    const ctx = canvas.getContext('2d');
    let map: DotMap | undefined;
    // Maße und Werte aus CSS nur bei Größenänderung lesen, nicht je Bild
    let size = { w: 0, h: 0, dpr: 1 }, radius = 0, tau = 0;
    const pos = { x: 0, y: 0 }, goal = { x: 0, y: 0 };
    let frame = 0, lastTime = 0, drawn: [number, number, number, number] | undefined;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2), w = canvas.clientWidth, h = canvas.clientHeight;
      if (!w || (w === size.w && h === size.h && dpr === size.dpr)) return;
      size = { w, h, dpr };
      radius = LIGHT_RADIUS_REM * parseFloat(getComputedStyle(document.documentElement).fontSize);
      tau = cssTime('--dur-follow') / 3;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      if (ctx) ctx.fillStyle = getComputedStyle(canvas).color;
      drawn = undefined;
      draw();
    };
    const draw = () => {
      if (!ctx || !map || !size.w) return;
      const { w, h, dpr } = size, sx = w / map.w, sy = h / map.h;
      const R = radius, dot = map.r * sx;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (drawn) ctx.clearRect(...drawn); else ctx.clearRect(0, 0, w, h);
      const cx = pos.x * w, cy = pos.y * h, pad = dot + 2;
      drawn = [cx - R - pad, cy - R - pad, 2 * (R + pad), 2 * (R + pad)];
      // Punkte nach Deckkraftstufe bündeln: ein Pfad je Stufe statt eines Füllaufrufs je Punkt
      const paths: (Path2D | undefined)[] = [];
      for (const [px, py] of map.dots) {
        const x = px * sx, y = py * sy, d = Math.hypot(x - cx, y - cy);
        if (d >= R) continue;
        const a = d <= CORE * R ? 1 : 1 - (d - CORE * R) / ((1 - CORE) * R);
        const level = Math.round(a * LEVELS);
        if (!level) continue;
        const path = (paths[level] ??= new Path2D());
        path.moveTo(x + dot, y); path.arc(x, y, dot, 0, Math.PI * 2);
      }
      paths.forEach((path, level) => { if (path) { ctx.globalAlpha = level / LEVELS; ctx.fill(path); } });
      ctx.globalAlpha = 1;
    };
    const settle = () => {
      canvas.style.setProperty('--sx', `${(pos.x * 100).toFixed(2)}%`);
      canvas.style.setProperty('--sy', `${(pos.y * 100).toFixed(2)}%`);
    };
    const tick = (now: number) => {
      const dt = lastTime ? now - lastTime : 16.7;
      lastTime = now;
      const k = tau > 0 ? 1 - Math.exp(-dt / tau) : 1;
      pos.x += (goal.x - pos.x) * k; pos.y += (goal.y - pos.y) * k;
      const done = Math.hypot((goal.x - pos.x) * size.w, (goal.y - pos.y) * size.h) < 0.25;
      if (done) Object.assign(pos, goal);
      draw();
      if (done) { frame = 0; lastTime = 0; settle(); } else frame = requestAnimationFrame(tick);
    };
    // jump: ohne Trägheit (Touch, erstes Aufleuchten), sonst gleitet die Mitte zum Ziel
    const aim = (x: number, y: number, jump: boolean) => {
      goal.x = x; goal.y = y;
      if (!canvas.offsetWidth) return; // reduzierte Bewegung oder Pause: Canvas ist ausgeblendet
      if (!map) {
        Object.assign(pos, goal);
        loadDots(img.currentSrc || img.src).then((m) => { map = m; resize(); Object.assign(pos, goal); draw(); settle(); });
        return;
      }
      resize();
      if (jump) {
        cancelAnimationFrame(frame); frame = 0; lastTime = 0;
        Object.assign(pos, goal); draw(); settle();
      } else if (!frame) frame = requestAnimationFrame(tick);
    };
    new ResizeObserver(resize).observe(canvas);
    let hotPin: string | undefined;
    let touchId: number | undefined;
    let releaseLight: number | undefined;

    const setPin = (id: string | undefined, state: 'is-hot' | 'is-focused', on: boolean) => {
      if (id === undefined) return;
      for (const el of root.querySelectorAll(`[data-pin="${id}"]`)) el.classList.toggle(state, on);
    };
    const highlightPin = (id?: string) => {
      if (id === hotPin) return;
      setPin(hotPin, 'is-hot', false);
      setPin(id, 'is-hot', true);
      hotPin = id;
    };
    for (const el of root.querySelectorAll<HTMLElement>('[data-pin]')) {
      const id = el.dataset.pin;
      el.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'touch') highlightPin(id);
      });
      el.addEventListener('pointerleave', (event) => {
        if (event.pointerType !== 'touch' && hotPin === id) highlightPin();
      });
      el.addEventListener('focusin', () => setPin(id, 'is-focused', true));
      el.addEventListener('focusout', (event) => {
        if (!el.contains(event.relatedTarget as Node | null)) setPin(id, 'is-focused', false);
      });
    }

    const hideLight = () => {
      window.clearTimeout(releaseLight);
      stage.classList.remove('is-lit');
    };
    const moveLight = (event: PointerEvent) => {
      const touch = event.pointerType === 'touch';
      const { left, top, width, height } = stage.getBoundingClientRect();
      const x = event.clientX - left, y = event.clientY - top;
      if (touch) {
        // Touch behält das ursprüngliche Event-Ziel durch implizites Pointer Capture.
        const hit = document.elementFromPoint(event.clientX, event.clientY)?.closest<HTMLElement>('.loc-pin');
        highlightPin(hit && stage.contains(hit) ? hit.dataset.pin : undefined);
      }
      if (x < 0 || y < 0 || x >= width || y >= height) {
        hideLight();
        return;
      }
      window.clearTimeout(releaseLight);
      aim(x / width, y / height, touch || !stage.classList.contains('is-lit'));
      stage.classList.toggle('is-touch', touch);
      stage.classList.add('is-lit');
    };
    stage.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'touch' && touchId === undefined) moveLight(event);
    });
    stage.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch' ? event.pointerId === touchId : touchId === undefined) moveLight(event);
    });
    stage.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'touch' && touchId === undefined) hideLight();
    });
    stage.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'touch' || !event.isPrimary) return;
      touchId = event.pointerId;
      moveLight(event);
    });
    const stopTouch = (event: PointerEvent) => {
      if (event.pointerId !== touchId) return;
      touchId = undefined;
      highlightPin();
      // Auch ein kurzes Tippen soll sichtbar sein. Scrollen bricht den Effekt sofort ab.
      if (event.type === 'pointerup') releaseLight = window.setTimeout(hideLight, 120);
      else hideLight();
    };
    stage.addEventListener('pointerup', stopTouch);
    stage.addEventListener('pointercancel', stopTouch);
    stage.addEventListener('lostpointercapture', stopTouch);
    window.addEventListener('blur', () => {
      touchId = undefined;
      highlightPin();
      hideLight();
    });
  }
</script>

<style>
  .loc-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(var(--space-8), 6vw, var(--space-20)); align-items: center; }
  /* Kopf wie .sec-head (Abstand und Farbe), aber ohne dessen unteren Rand: Text und Karte stehen nebeneinander */
  .loc-copy :global(.section-head) { justify-items: start; }
  .loc-copy :global(.section-head > p) { color: var(--muted); font-size: var(--text-lead); max-width: 46ch; }
  .loc-more { margin-top: var(--head-gap-cta); }
  .loc-map { margin: 0; justify-self: center; width: min(100%, 40rem); }
  .loc-stage { position: relative; }
  .loc-stage img { display: block; width: 100%; height: auto; pointer-events: none; }
  /* Markierung wie eine leuchtende Drohne: heller Kern (::before), weicher Schein; die Markierung selbst ist die größere,
     unsichtbare Zeigefläche (1,75 rem, berührt die Nachbarin dank MIN_GAP nicht). Zeigen/Fokus: Kern wächst, ein Lichthof
     blendet weich ein; animiert werden nur transform und opacity. */
  .loc-pin { position: absolute; width: 1.75rem; height: 1.75rem; margin: -0.875rem 0 0 -0.875rem; border-radius: var(--radius-round); cursor: default; }
  .loc-pin::before, .loc-pin::after { content: ""; position: absolute; left: 50%; top: 50%; border-radius: var(--radius-round); pointer-events: none; }
  .loc-pin::before { width: 0.5rem; height: 0.5rem; margin: -0.25rem 0 0 -0.25rem; background: var(--pin); box-shadow: 0 0 0.375rem var(--pin), 0 0 1.75rem 0.5rem rgb(var(--pin-rgb) / 0.35); transition: transform var(--dur-standard) var(--ease-default); }
  .loc-pin::after { width: 4rem; height: 4rem; margin: -2rem 0 0 -2rem; background: radial-gradient(circle, rgb(var(--pin-rgb) / 0.32), transparent 70%); opacity: 0; transform: scale(0.6); transition: opacity var(--dur-standard) var(--ease-default), transform var(--dur-standard) var(--ease-default); }
  .loc-pin:is(.is-hot, .is-focused) { z-index: 1; }
  .loc-pin:is(.is-hot, .is-focused)::before { transform: scale(1.75); }
  .loc-pin:is(.is-hot, .is-focused)::after { opacity: 1; transform: scale(1); }
  .amber { --pin: var(--amber); --pin-rgb: var(--rgb-amber); }
  .cyan { --pin: var(--cyan); --pin-rgb: var(--rgb-cyan); }
  .orchid { --pin: var(--orchid); --pin-rgb: var(--rgb-orchid); }
  .loc-map figcaption { margin-top: clamp(var(--space-5), 2.5vw, var(--space-7)); display: grid; gap: var(--space-3); }
  .loc-legend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-7); color: var(--text); font-size: var(--text-sm); }
  .loc-legend li { display: inline-flex; align-items: center; gap: var(--space-2-5); }
  .loc-key { flex: none; width: 0.5rem; height: 0.5rem; border-radius: var(--radius-round); background: var(--pin); box-shadow: 0 0 0.5rem var(--pin); }
  .loc-note { margin: 0; color: var(--faint); }

  /* Anschriften: zwei Blöcke nebeneinander unter dem Text, je eine Haarlinie in der Punktfarbe oben */
  .loc-places { list-style: none; margin: var(--head-gap-content) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14.5rem), 1fr)); gap: var(--space-8) clamp(var(--space-6), 3vw, var(--space-10)); }
  .loc-place { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-4); align-items: start; padding-top: var(--space-5); border-top: 1px solid var(--line); }
  /* Haarlinie in Punktfarbe: kurz im Ruhezustand, beim Zeigen läuft sie über die ganze Breite (scaleX statt width) */
  .loc-place::before { content: ""; position: absolute; left: 0; bottom: 100%; width: 100%; border-top: 1px solid var(--pin); transform: scaleX(0.16); transform-origin: left; transition: transform var(--dur-reveal) var(--ease-default); }
  .loc-place:is(.is-hot, .is-focused)::before { transform: scaleX(1); }
  .loc-ico { position: relative; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: var(--radius-round); color: var(--pin); background: rgb(var(--pin-rgb) / 0.1); box-shadow: inset 0 0 0 1px rgb(var(--pin-rgb) / 0.35); }
  .loc-ico::after { content: ""; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgb(var(--pin-rgb) / 0.75); opacity: 0; transition: opacity var(--dur-standard) var(--ease-default); }
  .loc-place:is(.is-hot, .is-focused) .loc-ico::after { opacity: 1; }
  .loc-body { display: grid; gap: var(--space-3); min-width: 0; }
  .loc-name { margin: 0; display: grid; gap: var(--space-1); font: 500 var(--text-copy)/1.3 var(--body); color: var(--head); }
  .loc-label { font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--pin); font-weight: 400; }
  address { font-style: normal; font-size: var(--text-copy); line-height: 1.5; color: var(--muted); }
  address span { display: block; text-wrap: balance; }
  .loc-links { margin: var(--space-1) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); font-size: var(--text-sm); }
  .loc-links a { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--text); }
  .loc-links a :global(.ico) { flex: none; color: var(--pin); }
  @media (prefers-reduced-motion: reduce) { .loc-pin::before, .loc-pin::after, .loc-place::before, .loc-ico::after { transition: none; } }

  /* Lichtkegel (Runde 16: Canvas statt Verbundmaske, siehe Skript). Farbe über color, Deckkraft und Ein-/Ausblenden wie
     bisher in CSS; die Trägheit der Lage rechnet das Skript aus --dur-follow. */
  .loc-lit { display: none; position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0; color: var(--amber);
    transition: opacity var(--dur-standard) var(--ease-default); }
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.motion-paused)) .loc-stage { touch-action: pan-y pinch-zoom; }
    :global(html:not(.motion-paused)) .loc-lit { display: block; }
    .loc-stage.is-lit .loc-lit { opacity: 0.85; }
  }
  @media (--grid-stacked) { .loc-grid { grid-template-columns: 1fr; } .loc-map { justify-self: start; } }
</style>
