---
import {startingPrice} from '../lib/price.mjs';
import { forPath } from '../i18n/server';
const { t, locale } = forPath(Astro.url.pathname);
// Preisseite nach Moritz' Preistext (17.11.2026, mit Marc abgestimmt): Abschnittsfolge, Überschriften und Wortlaut von
// Moritz, durchgehend in Ihr-Form; das Layout je Abschnitt aus den Bestandskomponenten (docs/DESIGN.md, „Neue Texte in
// bestehende Komponenten“). Der Konfigurator ist der Hauptabschnitt direkt nach dem Kopf, ohne Paketwahl. Die drei Pakete
// sind feste Beispiele mit Festpreis: anfragen (Formular unten, Paket vorbelegt) oder anpassen (Konfigurator startet mit
// dem Paket, nach der ersten Änderung „Individuelles Paket“). Flächen wechseln ab dem Konfigurator: Preisversprechen hell,
// Pakete auf Grund, Leistungen hell, Upgrades auf Grund, Anfrage hell, FAQ auf Grund. Texte unter preise.* im UI-Wörterbuch.
// Entfallen gegenüber der Fassung vom 31.10.: Leistungsvergleich (Tabelle mit Aufpreisen je Paket, passt nicht mehr zu
// festen Paketen) und der Abschluss „Noch unsicher, welches Paket?“ (das Formular steht jetzt auf der Seite).
import Base from '../layouts/Base.astro';
import Packages from '../components/sections/Packages.astro';
import Faq from '../components/sections/Faq.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import SectionHead from '../components/SectionHead.astro';
import FactList from '../components/FactList.astro';
import ShowConfigurator from '../components/configurator/ShowConfigurator.astro';
import Extras from '../components/pricing/Extras.astro';
import Included from '../components/pricing/Included.astro';
import CtaBox from '../components/CtaBox.astro';
import { SHOW_PACKAGES, PACKAGE_NAMES, DRONES_MIN, DRONES_MAX } from '../content/show-packages';
import { durationValues } from '../content/show-duration.mjs';
import { getPackageDetails } from '../content/package-details';
const { PACKAGE_DETAILS, PRICE_NOTE } = getPackageDetails(locale);
const items = PACKAGE_NAMES.map((name) => ({ name, ...PACKAGE_DETAILS[name], badge: PACKAGE_DETAILS[name].often, highlight: Boolean(PACKAGE_DETAILS[name].often) }));
const number = (n: number) => n.toLocaleString(locale === 'en' ? 'en-GB' : locale === 'nl' ? 'nl-NL' : 'de-DE');
const d = durationValues();
const included = [
  ['design', 'pen-tool', t('preise.inc.design'), t('preise.incItem.design')],
  ['tech', 'cpu', t('preise.inc.tech'), t('preise.incItem.tech')],
  ['permit', 'stamp', t('preise.inc.permit'), t('preise.incItem.permit')],
  ['safety', 'shield-check', t('preise.inc.safety'), t('preise.incItem.safety')],
  ['insurance', 'umbrella', t('preise.inc.insurance'), t('preise.incItem.insurance')],
  ['crew', 'users', t('preise.inc.crew'), t('preise.incItem.crew')],
  ['flight', 'timer', t('preise.incItem.flightTitle'), t('preise.incItem.flight', d)],
].map(([, icon, title, text]) => ({ icon, title, text }));
const facts = [
  { value: startingPrice(SHOW_PACKAGES.SPARK.price, locale), label: t('preise.factNet') },
  { value: `${number(DRONES_MIN)}–${number(DRONES_MAX)}`, label: t('preise.factDrones') },
  { value: '10 %', label: t('preise.factEarly') },
];
const promises = [['lock', t('preise.promise1')], ['scale', t('preise.promise2')], ['calendar-check', t('preise.promise3')]].map(([icon, text]) => ({ icon, text }));
---
<Base title={t('preise.metaTitle')} description={t('preise.metaDescription')}>

  {/* Marc, 18.11.2026 („For the Preise page we should open with the configurator, as Moritz mentioned“): die Seite beginnt
       mit dem Konfigurator. Moritz' H1, Einleitung und Eckdaten sind sein Kopf, die Live-Vorschau ist das Bild des ersten
       Bildschirms; das Showreel entfällt hier. Ab Desktop steht die H1 über der Bedienung, Einleitung und Eckdaten über
       der Vorschau; auf dem Handy H1 und Eckdaten, dann Vorschau und Regler, die Einleitung nach dem Konfigurator. */}
  <ShowConfigurator id="konfigurator" end="tight">
    <SectionHead slot="head" variant="embedded" kicker={t('preise.heroKicker')} headline={t('preise.heroHeadline')} id="cfg-h" level="h1" />
    <FactList slot="facts" variant="hero" items={facts} />
    <p slot="intro" class="pp-intro">{t('preise.heroText')}</p>
  </ShowConfigurator>

  {/* Preisversprechen direkt unter dem Konfigurator (Moritz' H3; als H2 gesetzt, weil es der erste Abschnitt nach der H1
       ist): der gemeinsame Abschluss-Kasten in der Listenvariante, die drei Zusagen als Zeilen mit Icon, ein Knopf */}
  <section class="section alt promise-sec" aria-labelledby="versprechen-h">
    <CtaBox headline={t('preise.promiseHeadline')} items={promises} button={{ label: t('preise.promiseCta'), href: '/kontakt/?anliegen=vergleich' }} id="versprechen-h" level="h2" />
  </section>

  <Packages
    type="packages"
    index={2}
    id="pakete"
    kicker={t('preise.pkgKicker')}
    headline={t('preise.pkgHeadline')}
    text={t('preise.pkgText')}
    note={PRICE_NOTE}
    compact={false}
    items={items}
    surface="plain"
  />

  <Included
    kicker={t('preise.incKicker')}
    headline={t('preise.incHeadline')}
    text={t('preise.incText')}
    items={included}
    note={t('preise.incNote')}
  />

  <Extras surface="plain" />

  <ContactForm
    type="contactForm"
    index={5}
    kicker={t('preise.contactKicker')}
    headline={t('preise.contactHeadline')}
    text={t('preise.contactText')}
  />

  <Faq
    type="faq"
    index={6}
    id="preisfragen"
    kicker={t('preise.faqKicker')}
    headline={t('preise.faqHeadline')}
    cta={{ label: t('pricingpage.allQuestions'), href: '/faq/' }}
    openFirst={true}
    tags={['preise-moritz']}
  />
</Base>

<style>
  /* Preisversprechen: eng unter dem Konfigurator (Marc, Runde 5: „oben und unten etwas weniger Abstand, aktuell floatet es
     sehr im Nichts“). Der Konfigurator endet dafür mit --section-tight (Prop end="tight"), die Section selbst hat knappe
     Innenabstände; keine Überlappung, die Farbkante liegt an der Section-Oberkante */
  .promise-sec { padding-block: clamp(var(--space-8), 3.5vw, var(--space-14)); }
  .pp-intro { margin: 0; max-width: 64ch; color: var(--muted); font-size: var(--text-copy); line-height: 1.6; text-wrap: pretty; }
</style>
