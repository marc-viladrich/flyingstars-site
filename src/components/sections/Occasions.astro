---
import Styles from '../Styles.astro';
import ownerStyle0 from '../MediaCard.css?url';
import {factText} from '../../content/show-extras.mjs';
import MediaCard from '../MediaCard.astro';
import { forPath } from '../../i18n/server';
const { t, localHref, locale } = forPath(Astro.url.pathname);
import type { Section } from '../../content.config';
import { optimizedImage } from '../../lib/media';
import Accent from '../Accent.astro';
import SectionHead from '../SectionHead.astro';
import SliderNav from '../SliderNav.astro';
type Props = Extract<Section, { type: 'occasions' }> & { index: number };
const { headline, text, id = 'anlaesse', cards, index, kicker } = Astro.props;
const headingId = `${id}-h`;
// Mehr als vier Karten: Slider, die vier wichtigsten sichtbar, der Rest läuft rechts aus dem Bild (Marc, 31.10.2026)
const slider = cards.length > 4;
const H = index === 0 ? 'h1' : 'h2';
const items = await Promise.all(cards.map(async card => ({ ...card, media: await optimizedImage(card.image.src, 640, 480), small: await optimizedImage(card.image.src, 320, 240) })));
---
<Styles href={ownerStyle0} id="components/MediaCard.css" />
<section class="section" id={id} aria-labelledby={headingId}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={headingId} level={H} />
  <div class:list={['occasions', { 'occ-slider': slider }]} data-count={items.length} role={slider ? 'region' : undefined} aria-label={slider ? t('occasions.occasionsScrollHorizontally') : undefined} tabindex={slider ? 0 : undefined}>
    {items.map((card, i) => <MediaCard variant="occasion" title={card.title} summary={factText(card.text,locale)} kicker={card.category} season={card.season?.join(',')} i={i}>
      <img slot="media" src={card.media.src} srcset={`${card.small.src} 320w, ${card.media.src} 640w`} sizes="(max-width: 40em) calc(100vw - 3rem), (max-width: 68.75em) 45vw, 23vw" width={card.media.width} height={card.media.height} alt={card.image.alt} loading="lazy" decoding="async" />
      <Fragment slot="facts">{card.facts && card.facts.length > 0 && <ul class="facts">{card.facts.map(fact => <li>{factText(fact.value,locale)}</li>)}</ul>}</Fragment>
      <Fragment slot="actions"><a class="link" href={localHref(card.cta.href)}>{card.cta.label} <span aria-hidden="true">→</span></a>{card.download && <a class="dl mono" href={localHref(card.download.href)} type="application/pdf" target="_blank" rel="noopener">{card.download.label} <span aria-hidden="true">↓</span></a>}</Fragment>
    </MediaCard>)}
  </div>
  {slider && <SliderNav />}
</section>

<script>
  // Saisonkarten nach vorn (z. B. Silvester im November und Dezember); Pfeile und Ausblendung rechts: SliderNav.astro
  document.querySelectorAll<HTMLElement>('.occ-slider').forEach((track) => {
    const month = new Date().getMonth() + 1;
    [...track.querySelectorAll<HTMLElement>('[data-season]')].reverse().forEach((card) => {
      if (card.dataset.season!.split(',').map(Number).includes(month)) track.prepend(card);
    });
    // Scroll-Snap hält sonst die bisher erste Karte fest, die vorgezogene Saisonkarte lag links außerhalb (03.11.2026)
    track.scrollTo({ left: 0, behavior: 'instant' });
    const edge = () => track.classList.toggle('at-end', track.scrollLeft + track.clientWidth >= track.scrollWidth - 4);
    track.addEventListener('scroll', edge, { passive: true }); edge();
  });
</script>
