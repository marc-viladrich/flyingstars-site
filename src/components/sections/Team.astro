---
import type { Section } from '../../content.config';
import { optimizedImage } from '../../lib/media';
type Props = Extract<Section, { type: 'team' }> & { index: number };
const { headline, text, members, note, cta, id = `s${Astro.props.index}`, index } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
const Name = index === 0 ? 'h2' : 'h3';
const initials = (name: string) => name.trim().split(/\s+/).filter((_,i,a)=>i===0||i===a.length-1).map(part=>part[0]).join('').toUpperCase();
const crew = await Promise.all(members.map(async member => ({...member, media: member.image ? await optimizedImage(member.image.src, 640) : undefined})));
---
<section class="section" id={id} aria-labelledby={headingId}>
  <div class="sec-head"><H id={headingId}>{headline}</H>{text && <p>{text}</p>}</div>
  <ul class="crew" role="list">{crew.map(member => <li class="member">
    <div class="portrait">{member.image && member.media ? <img src={member.media.src} width={member.media.width} height={member.media.height} alt={member.image.alt} loading="lazy" decoding="async" /> : <span class="ini" aria-hidden="true">{initials(member.name)}</span>}</div>
    <Name>{member.name}</Name><p class="role">{member.role}</p>{member.bio && <p class="bio">{member.bio}</p>}
  </li>)}</ul>
  {(note || cta) && <div class="crew-note">{note && <p>{note}</p>}{cta && <a class="link" href={cta.href}>{cta.label}</a>}</div>}
</section>
