---
import {nativeField,nativeSection} from "../../lib/native-editor";
import type { Section } from '../../content.config';
import { SHOW_PACKAGES, type ShowPackage } from '../../content/show-packages';
type Props = Extract<Section, { type: 'pricing' }> & { index: number };
const { headline, text, tiers, note, cta, kicker, columns='three', id = `s${Astro.props.index}`, index } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
const money = new Intl.NumberFormat('de-DE', { maximumFractionDigits: 0 });
const editor = process.env.FLYINGSTARS_EDITOR === '1';
const native = (name: ShowPackage, path: Array<string | number>, derived = false) => editor ? {
  'data-native-record': `package/${name.toLowerCase()}`,
  [derived ? 'data-native-derived' : 'data-native-path']: JSON.stringify(path),
} : {};
---
<section {...nativeSection(Astro.props)} class="section alt" id={id} aria-labelledby={headingId}>
  <div class="sec-head"><div>{kicker && <span class="kicker mono" {...nativeField(Astro.props,["kicker"])}>{kicker}</span>}<H id={headingId} {...nativeField(Astro.props,["headline"])}>{headline}</H></div>{text && <p {...nativeField(Astro.props,["text"])}>{text}</p>}</div>
  <div class:list={["packs",{'packs--two':columns==='two','packs--one':columns==='one'}]}>{tiers.map((tier,i) => {
    const Card = tier.cta ? 'a' : 'article';
    const name = tier.name as ShowPackage;
    const pkg = tier.orb && Object.hasOwn(SHOW_PACKAGES, tier.name) ? SHOW_PACKAGES[name] : null;
    const price = pkg ? `ab ${money.format(pkg.price)} €` : tier.price;
    const unit = pkg ? `${pkg.base}${name === 'ODYSSEY' ? '+' : ''} Drohnen · ${pkg.dur}` : tier.unit;
    return <Card class:list={['pack',{featured:tier.highlight}]} href={tier.cta?.href}>
      {tier.orb && tier.showOrb!==false && <canvas data-orb={pkg?.orbShape ?? tier.orb.shape} data-color={pkg?.color.join(',') ?? tier.orb.color} data-n={pkg?.base ?? tier.orb.count} aria-hidden="true"></canvas>}
      <div><div class="name"><h3 {...(pkg ? native(name, ['displayName']) : {})}>{pkg?.displayName ?? tier.name}</h3>{tier.badge && <span class="chip" {...nativeField(Astro.props,["tiers",i,"badge"])}>{tier.badge}</span>}</div><div class="price" {...(pkg ? native(name, ['price'], true) : {})}>{price}</div>{unit && <div class="meta mono" {...(pkg ? native(name, ['base'], true) : {})}>{unit}</div>}{tier.description && <p {...nativeField(Astro.props,["tiers",i,"description"])}>{tier.description}</p>}{tier.features.length>0 && <ul class="facts">{tier.features.map((feature,j) => <li {...nativeField(Astro.props,["tiers",i,"features",j])}>{feature}</li>)}</ul>}</div>
    </Card>;
  })}</div>
  {(note || cta) && <div class="pack-note">{note && <span class="mono" {...nativeField(Astro.props,["note"])}>{note}</span>}{cta && <a class="link" href={cta.href}><span {...nativeField(Astro.props,["cta","label"])}>{cta.label}</span> <span aria-hidden="true">→</span></a>}</div>}
</section>

<style>.packs--two{grid-template-columns:repeat(2,minmax(0,1fr))}.packs--one{grid-template-columns:1fr}@media(max-width:640px){.packs--two{grid-template-columns:1fr}}</style>
