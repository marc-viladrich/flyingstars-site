---
import { SHOW_PACKAGES, PACKAGE_NAMES, type ShowPackage } from "../../content/show-packages";
const money = (value: number) => value.toLocaleString("de-DE");
const editor = process.env.FLYINGSTARS_EDITOR === '1';
const native = (name: ShowPackage, path: Array<string | number>, derived = false) => editor ? {
  'data-native-record': `package/${name.toLowerCase()}`,
  [derived ? 'data-native-derived' : 'data-native-path']: JSON.stringify(path),
} : {};
const dot = (color: number[]) => '#' + color.map(value => value.toString(16).padStart(2, '0')).join('');
---

<section class="section alt" id="pakete" aria-labelledby="pakete-h">
  <div class="sec-head">
    <div><span class="kicker mono">Pakete</span><h2 id="pakete-h">Drei Pakete. Die Preise rechnen mit.</h2></div>
    <p>Die Preise unten gelten für die Drohnenzahl, die du oben eingestellt hast. Jedes Paket lässt sich mit mehr Drohnen und Extras erweitern.</p>
  </div>
  <div class="tiers-grid">
    {PACKAGE_NAMES.map(name => {
      const pkg = SHOW_PACKAGES[name];
      return <article class:list={['tier', {'is-rec': pkg.highlight}]} data-card={name} style={`--dot:${dot(pkg.color)}`}>
        <canvas data-orb={pkg.orbShape} data-n={pkg.base} data-color={pkg.color.join(',')} aria-hidden="true"></canvas>
        <div class="head"><h3 {...native(name, ['name'])}>{pkg.name}</h3><span class="badge" {...native(name, ['badge'], true)}>{pkg.badge}</span></div>
        <p class="tag" {...native(name, ['description'])}>{pkg.description}</p>
        <div class="p" data-live {...native(name,["price"],true)}><b {...native(name, ['price'], true)}>ab {money(pkg.price)} €</b><span class="mono" {...native(name, ['base'], true)}>für {pkg.base} Drohnen · {pkg.dur}</span></div>
        {pkg.inheritsText && <span class="plus" {...native(name, ['inheritsText'])}>{pkg.inheritsText}</span>}
        {pkg.featureGroups.map((group, groupIndex) => <>
          <h4 {...native(name, ['featureGroups', groupIndex, 'title'])}>{group.title}</h4>
          <ul>{group.items.map((item, itemIndex) => <li {...native(name, ['featureGroups', groupIndex, 'items', itemIndex])}>{item}</li>)}</ul>
        </>)}
        <span class="scale-note mono" {...native(name, ['add'], true)}>+{money(pkg.add)} € je {pkg.step} Drohnen{Number.isFinite(pkg.max) ? ` · bis ${pkg.max} Drohnen` : ''}</span>
        <a class:list={['btn', {primary: pkg.highlight}]} href={`/?paket=${name}#anfrage`} {...native(name, ['name'], true)}>{pkg.name} anfragen</a>
      </article>;
    })}
  </div>
</section>
