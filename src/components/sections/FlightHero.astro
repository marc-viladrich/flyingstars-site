---
import type { Section } from '../../content.config';
import Video from '../Video.astro';
// eyebrow, words and stats stay in the schema for old content but are no longer rendered: the show is the hero.
const { headline, text, cta, secondary, poster, video } = Astro.props as Extract<Section, { type: 'showreelHero' }>;
---
<section class="hero" aria-labelledby="hero-h">
  <Video src={video} poster={poster.src} label="Showreel ansehen" hero class="hero-media" />
  <div class="shade" aria-hidden="true"></div>
  <div class="hero-copy">
    <h1 id="hero-h">{headline}</h1>
    <p class="lead">{text}</p>
    <div class="actions"><a class="btn primary" href={cta.href}>{cta.label}</a>{secondary && <a class="btn" href={secondary.href}>{secondary.label}</a>}</div>
  </div>
</section>
