---
import { forPath } from '../i18n/server';
import { trackingConfig } from '../lib/consent.mjs';
const { t, localHref } = forPath(Astro.url.pathname);
interface Props { config: ReturnType<typeof trackingConfig>; }
const { config } = Astro.props;
// Pass only this locale's consent copy to the optional browser chunk.
const names = ['title', 'summary', 'optional', 'gaSummary', 'adsSummary', 'transfer', 'privacy', 'necessary', 'necessaryTitle', 'analytics', 'analyticsDetail', 'ads', 'adsDetail', 'retention', 'reject', 'accept', 'settings', 'save', 'close', 'revision', 'categoryLabel', 'storageError'];
const copy = Object.fromEntries(names.map((name) => [name, t(`consent.${name}`)]));
---
<div id="consent-config" hidden data-config={JSON.stringify(config)} data-copy={JSON.stringify(copy)} data-privacy={localHref('/datenschutz/')}></div>
<script>
  // No IDs means no component, no import and no consent CSS/library download.
  if (document.querySelector('#consent-config')) import('../scripts/consent');
</script>
