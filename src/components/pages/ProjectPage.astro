---
import {localeFromPath} from '../../lib/localized-routes';
import {getClients} from '../../lib/content';
const clients=await getClients();
import {renderBody} from '../../lib/content';
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
import {recordField,recordMedia,recordBody} from '../../lib/editor-markers';
import SectionRenderer from '../SectionRenderer.astro';
import Base from '../../layouts/Base.astro';
import Picture from '../Picture.astro';
import CaseStudy from '../projects/CaseStudy.astro';
const { project } = Astro.props;
const {Content,html,lang}=await renderBody(project);
---
<Base locale={locale} title={project.data.title} description={project.data.summary} canonicalPath={project.data.showcase ? `/${project.data.showcase.route}/` : undefined}>
  {project.data.showcase ? <CaseStudy locale={locale} project={project} /> : <article class="section"><div class="wrap">
    <div class="prose">
      <h1 {...recordField(`project/${project.id}`,["title"])}>{project.data.title}</h1>
      <p class="muted">{[clients.find(client=>client.id===project.data.client?.id)?.name, project.data.location, project.data.date.getFullYear()].filter(Boolean).join(' · ')}</p>
      {project.data.cover && <Picture {...project.data.cover} {...recordMedia(`project/${project.id}`,["cover"])} loading="eager" sizes="(min-width: 48rem) 40rem, 100vw" />}
      <div {...recordBody(`project/${project.id}`)} lang={lang}>{Content ? <Content /> : <Fragment set:html={html} />}</div>
    </div>
  </div></article>}
{!project.data.showcase&&<SectionRenderer locale={locale} localization={project.localization} sections={project.data.sections} recordId={`project/${project.id}`} headingOffset={1} />}
</Base>
