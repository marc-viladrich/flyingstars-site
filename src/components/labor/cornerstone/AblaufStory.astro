---
// Scroll-Geschichte „Ablauf einer Drohnenshow“ (Labor, Runde 18, 22.11.2026) für den Artikel „Wie funktioniert eine
// Drohnenshow?“. Eigene Komponente nach dem Muster von blog/StoryScene.astro (Layout, Bühne, Schrittleiste, Leselinie und
// Stil 1:1 übernommen), damit die geteilte Komponente unangetastet bleibt, während sie parallel in die echte Seite wandert.
// Unterschiede zur Vorlage: eigene Szene (ablauf-scene.ts), eine Schrittgruppe, Zwischenhalte der Drohnen (synchrones
// Abheben, Sinken über den Startpunkt), Herzschlag als einzige Schleife, im HTML die Formation (Schritt 2) als Standbild.
// SEO und Barrierefreiheit wie die Vorlage: Text vollständig im HTML, Inline-SVG mit aussagekräftigem Zustand, feste
// Bühnenhöhe aus CSS, reduzierte Bewegung zeigt jeden Schritt ohne Übergang und ohne Schleife.
import { pathD, frameCam, type Piece } from '../../blog/story-scene';
import { ablaufScene } from './ablauf-scene';
interface Block { html: string; step?: number; title?: string; group?: string }
interface Props { blocks: Block[]; caption: string; label: string; group: { name: string; short: string } }
const { blocks, caption, label, group } = Astro.props;
const colors = ['#ff9e29', '#f58a5a', '#ec7f95', '#db64e8', '#b88bec', '#8aa9ee', '#6fc8ef', '#33edf2'];
const zone = { field: '#e8dccb', sky: '#c49bf2' };
const story = ablaufScene({ colors, zone });
// Im HTML (Suche, Vorschau, ohne JavaScript): die Formation am Himmel über dem Feld, der Moment, um den es geht
const SHOW = 2;
const VW = 1000, VH = 470;
const cam = frameCam(story.frames[SHOW], VW, VH);
const stateOf = (p: Piece, s: number) => {
  if (p.steps.includes(s)) return { t: 'translate(0px, 0px)', o: p.dim?.includes(s) ? 0.32 : 1 };
  const h = p.hide || { s: [0.04, 0.04] as [number, number] };
  return { t: `translate(0px, ${h.dy ?? 0}px) scale(${h.s[0]}, ${h.s[1]})`, o: 0 };
};
const steps = blocks.filter((b) => b.step !== undefined);
const head = blocks[0]?.step === undefined ? blocks[0] : undefined;
const body = head ? blocks.slice(1) : blocks;
const drawn = (cls: string) => cls === 'lift';
const noteStyle = (n: { x: number; y: number }) => `--x: ${((n.x * cam.k + cam.tx) / VW * 100).toFixed(2)}%; --y: ${((n.y * cam.k + cam.ty) / VH * 100).toFixed(2)}%`;
const shown = steps.find((b) => b.step === SHOW);
---
<section class="ss" aria-label={label} data-ss>
  {head && <div class="ss-head post-body" set:html={head.html} />}
  <figure class="ss-fig">
    <div class="ss-stage" data-stage data-step={SHOW} data-frames={JSON.stringify(story.frames)} data-beat={story.beat.join(' ')}>
      <svg viewBox={`0 0 ${VW} ${VH}`} role="img" aria-label={caption}>
        <g class="cam" data-cam style={`transform: translate(${cam.tx}px, ${cam.ty}px) scale(${cam.k})`}>
          {story.pieces.map((p) => { const st = stateOf(p, SHOW); return <g class="pc" data-key={p.key} data-steps={p.steps.join(' ')} data-dim={p.dim?.join(' ')} data-hide={p.hide ? `${p.hide.s.join(' ')} ${p.hide.dy ?? 0}` : undefined} aria-hidden="true" style={`--zc: ${p.zc}; transform-origin: ${p.origin[0]}px ${p.origin[1]}px; transform: ${st.t}; opacity: ${st.o}`}>
            {p.shapes.map((s) => s.t === 'circle' ? <circle class={s.cls} cx={s.c[0]} cy={s.c[1]} r={s.r} /> : <path class={s.cls} d={pathD(s)} pathLength={drawn(s.cls) ? 1 : undefined} />)}
          </g>; })}
          <g class="ss-drones" aria-hidden="true">
            {story.drones.map((d) => { const [x, y, a] = d.pos[SHOW]; return <g class="sd" data-pos={d.pos.map((q) => q.join(',')).join(';')} data-via={JSON.stringify(d.via)} style={`--c: ${d.c}; --k: ${d.k}; transform: translate(${x}px, ${y}px); opacity: ${a}`}><g class="sw"><circle class="halo" r="4.2" /><circle class="core" r="1.7" /></g></g>; })}
          </g>
        </g>
      </svg>
      {story.notes.map((n) => <span class:list={['sn', `sn-${n.side}`, { on: n.steps.includes(SHOW) }]} data-steps={n.steps.join(' ')} data-x={n.x} data-y={n.y} style={noteStyle(n)} aria-hidden="true"><i class="sn-dot"></i><span class="sn-pill">{n.text}</span></span>)}
    </div>
    <div class="ss-bar">
      <p class="ss-now" aria-hidden="true"><span class="ss-num mono" data-num>{String((shown?.step ?? 0) + 1).padStart(2, '0')}</span><span data-now>{shown?.title}</span></p>
      <div class="ss-track">
        <div class="ss-grp on">
          <span class="ss-glab">{group.short}</span>
          <ol aria-label={group.name}>{steps.map((b, i) => <li><button type="button" data-goto={b.step} data-n={i + 1} data-title={b.title} aria-label={`${group.name}, ${i + 1}: ${b.title}`} aria-current={b.step === SHOW ? 'step' : undefined} class:list={{ done: (b.step ?? 0) < SHOW }}><span class="ss-seg"></span></button></li>)}</ol>
        </div>
      </div>
    </div>
    <figcaption class="sr-only">{caption}</figcaption>
  </figure>
  <div class="ss-text post-body">
    {body.map((b) => <div class="ss-step" data-step={b.step} set:html={b.html} />)}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-ss]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const svg = stage.querySelector('svg')!;
    const camG = stage.querySelector<SVGGElement>('[data-cam]')!;
    const notes = [...stage.querySelectorAll<HTMLElement>('.sn')];
    const marks = [...root.querySelectorAll<HTMLElement>('.ss-text > [data-step]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-goto]')];
    const now = root.querySelector<HTMLElement>('[data-now]'), num = root.querySelector<HTMLElement>('[data-num]');
    const frames = JSON.parse(stage.dataset.frames!) as [number, number, number, number][];
    const [bx, by] = stage.dataset.beat!.split(' ').map(Number);
    const nums = (v?: string) => (v ? v.split(' ').map(Number) : []);
    const P = [...stage.querySelectorAll<SVGGElement>('.pc')].map((el) => ({ el, steps: nums(el.dataset.steps), dim: nums(el.dataset.dim), hide: nums(el.dataset.hide) }));
    const D = [...stage.querySelectorAll<SVGGElement>('.sd')].map((el, i) => ({
      el, sw: el.querySelector<SVGGElement>('.sw')!, ph: i * 1.7,
      pos: el.dataset.pos!.split(';').map((q) => q.split(',').map(Number)),
      via: JSON.parse(el.dataset.via!) as Record<string, [number, number]>,
    }));
    const N = notes.map((el) => ({ el, steps: nums(el.dataset.steps), x: Number(el.dataset.x), y: Number(el.dataset.y) }));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const held = () => reduce.matches || document.documentElement.classList.contains('motion-paused');
    // Schleifen: leises Schweben in der Formation, Herzschlag in der Animation
    const LOOP = new Set([1, 2]);

    // ---------- Kamera ----------
    let W = 1000, H = 470, step = -1, visible = false, frame = 0, t0 = 0, hop = 0;
    const camOf = (s: number) => { const [x, y, w, h] = frames[s], k = Math.min(W / w, H / h); return { k, tx: W / 2 - (x + w / 2) * k, ty: H / 2 - (y + h / 2) * k }; };
    const place = () => {
      const c = camOf(Math.max(0, step));
      camG.style.transform = `translate(${c.tx}px, ${c.ty}px) scale(${c.k})`;
      N.forEach((n) => { n.el.style.setProperty('--x', `${((n.x * c.k + c.tx) / W) * 100}%`); n.el.style.setProperty('--y', `${((n.y * c.k + c.ty) / H) * 100}%`); });
    };
    const measure = () => { const r = stage.getBoundingClientRect(); W = Math.max(1, r.width); H = Math.max(1, r.height); svg.setAttribute('viewBox', `0 0 ${W} ${H}`); };

    // ---------- Schritt ----------
    const pose = (p: (typeof P)[number], s: number) => {
      if (p.steps.includes(s)) return { t: 'translate(0px, 0px)', o: p.dim.includes(s) ? 0.32 : 1 };
      const h = p.hide.length ? p.hide : [0.04, 0.04, 0];
      return { t: `translate(0px, ${h[2] ?? 0}px) scale(${h[0]}, ${h[1]})`, o: 0 };
    };
    const fly = (s: number) => D.forEach((d) => { const [x, y, a] = d.pos[s]; d.el.style.transform = `translate(${x}px, ${y}px)`; d.el.style.opacity = String(a); });
    const set = (s: number) => {
      if (s === step) return;
      const prev = step; step = s;
      stage.dataset.step = String(s);
      P.forEach((p) => {
        const on = p.steps.includes(s), was = p.steps.includes(prev);
        p.el.style.transitionDelay = on && !was ? 'var(--ss-enter)' : '0s';
        const { t, o } = pose(p, s); p.el.style.transform = t; p.el.style.opacity = String(o);
      });
      N.forEach((n) => n.el.classList.toggle('on', n.steps.includes(s)));
      // Vorwärts in einen Schritt mit Zwischenhalt: erst alle gleichzeitig senkrecht hoch bzw. über den Startpunkt, dann weiter
      clearTimeout(hop);
      stage.classList.remove('is-via');
      if (prev === s - 1 && prev >= 0 && D[0]?.via[s] && !held()) {
        stage.classList.add('is-via');
        D.forEach((d) => { d.el.style.transform = `translate(${d.via[s][0]}px, ${d.via[s][1]}px)`; d.el.style.opacity = '1'; });
        hop = window.setTimeout(() => { stage.classList.remove('is-via'); if (step === s) fly(s); }, 950);
      } else fly(s);
      place();
      dots.forEach((d) => { const n = Number(d.dataset.goto); if (n === s) d.setAttribute('aria-current', 'step'); else d.removeAttribute('aria-current'); d.classList.toggle('done', n < s); });
      const cur = dots.find((d) => Number(d.dataset.goto) === s);
      if (cur && now) now.textContent = cur.dataset.title ?? '';
      if (cur && num) num.textContent = String(cur.dataset.n).padStart(2, '0');
      fitLater();
      run();
    };

    // ---------- Auslöser wie in der Vorlage: Querformat Leselinie in der Mitte, sonst ein Drittel unter der Bühne ----------
    const side = matchMedia('(min-aspect-ratio: 5/4) and (min-width: 60em) and (max-height: 74.99em)');
    const lineY = () => { if (side.matches) return innerHeight * 0.5; const b = stage.getBoundingClientRect().bottom; return b + (innerHeight - b) * 0.32; };
    const fig = root.querySelector<HTMLElement>('.ss-fig')!;
    const pick = () => {
      fig.classList.toggle('is-stuck', fig.getBoundingClientRect().top <= parseFloat(getComputedStyle(fig).top) + 1);
      const line = lineY();
      let s = Number(marks[0]?.dataset.step ?? 0);
      for (const m of marks) if (m.getBoundingClientRect().top < line) s = Number(m.dataset.step);
      set(s);
    };
    let ticking = false;
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; pick(); }); } }, { passive: true });

    // ---------- Annotationen, die über den Bildschirm ragen würden, stehen auf der anderen Seite ----------
    const fit = () => notes.forEach((n) => {
      n.classList.remove('sn-flip');
      const r = n.querySelector('.sn-pill')!.getBoundingClientRect();
      if (r.right > document.documentElement.clientWidth - 8 || r.left < 8) n.classList.add('sn-flip');
    });
    let fitLater = () => {};
    const relayout = () => { stage.classList.add('is-reset'); measure(); place(); void stage.getBoundingClientRect(); stage.classList.remove('is-reset'); requestAnimationFrame(fit); };

    stage.classList.add('is-reset');
    measure(); pick(); if (step < 0) set(0);
    void stage.getBoundingClientRect();
    stage.classList.remove('is-reset');
    fitLater = () => requestAnimationFrame(() => setTimeout(fit, 30));
    fit();
    if ('ResizeObserver' in window) new ResizeObserver(relayout).observe(stage); else addEventListener('resize', relayout);
    dots.forEach((d) => d.addEventListener('click', () => {
      const m = marks.find((el) => el.dataset.step === d.dataset.goto);
      if (!m) return;
      scrollTo({ top: scrollY + m.getBoundingClientRect().top - lineY() + 24, behavior: held() ? 'auto' : 'smooth' });
    }));

    // ---------- Schleifen ----------
    function still() { D.forEach((d) => { d.sw.style.transform = ''; }); }
    function loop(ms: number) {
      frame = 0;
      if (!visible || held() || document.hidden || !LOOP.has(step)) { still(); return; }
      if (!t0) t0 = ms;
      const t = (ms - t0) / 1000;
      // Herzschlag: zwei weiche Schläge, dann Ruhe (1,8 s); Weg vom Herzmittelpunkt höchstens 5 %
      const ph = (t % 1.8) / 1.8, bump = (c: number, w: number) => Math.exp(-(((ph - c) / w) ** 2));
      const beat = step === 2 ? 0.05 * bump(0.12, 0.06) + 0.03 * bump(0.32, 0.07) : 0;
      D.forEach((d) => {
        const [x, y] = d.pos[step];
        const dx = (x - bx) * beat + Math.sin(t * 1.1 + d.ph) * 0.5, dy = (y - by) * beat + Math.cos(t * 0.9 + d.ph * 1.3) * 0.5;
        d.sw.style.transform = `translate(${dx.toFixed(2)}px, ${dy.toFixed(2)}px)`;
      });
      frame = requestAnimationFrame(loop);
    }
    function run() { if (!frame && visible && !held() && !document.hidden && LOOP.has(step)) frame = requestAnimationFrame(loop); else if (!LOOP.has(step) || held()) still(); }
    new IntersectionObserver((es) => { visible = es[es.length - 1].isIntersecting; run(); }, { threshold: 0.6 }).observe(stage);
    document.addEventListener('flyingstars:motion-change', run);
    document.addEventListener('visibilitychange', run);
  });
</script>

<style>
  /* Layout, Bühne, Leiste und Annotationen wie blog/StoryScene.astro (dort die Begründungen) */
  .ss { --ss-enter: 0.38s; --ss-stage-h: clamp(11rem, 28svh, 19rem); --ss-fade: var(--space-10); width: 100%; max-width: min(var(--feature-w, 76rem), 100%); display: grid; justify-items: center; margin-block: clamp(var(--space-10), 5vw, var(--space-16)) 0; }
  .ss-head, .ss-text { width: 100%; max-width: var(--measure, 42rem); }
  .ss, .ss-fig, .ss-bar, .ss-now { min-width: 0; }
  .ss-fig { width: 100%; }
  .ss-head :global(h2) { margin-top: 0; }
  .ss-head { margin-bottom: var(--space-6); }
  .ss-fig { position: sticky; top: var(--nav-h); z-index: 3; width: 100%; margin: 0; padding-block: var(--space-3) 0; background: var(--ground); box-shadow: 0 0 0 100vmax var(--ground); clip-path: inset(0 -100vmax calc(-1 * var(--ss-fade)) -100vmax); transition: top var(--dur-standard) var(--ease-default); }
  :global(:root.nav-away) .ss-fig { top: 0; }
  .ss-fig::before, .ss-fig::after { content: ""; position: absolute; left: calc(50% - 50vw); right: calc(50% - 50vw); height: var(--ss-fade); pointer-events: none; -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
  .ss-fig::after { top: 100%; background: linear-gradient(var(--ground) 0%, color-mix(in srgb, var(--ground) 86%, transparent) 35%, transparent 100%); -webkit-mask-image: linear-gradient(#000 30%, transparent); mask-image: linear-gradient(#000 30%, transparent); }
  .ss-fig::before { display: none; bottom: 100%; background: linear-gradient(to top, var(--ground) 0%, color-mix(in srgb, var(--ground) 86%, transparent) 35%, transparent 100%); -webkit-mask-image: linear-gradient(to top, #000 30%, transparent); mask-image: linear-gradient(to top, #000 30%, transparent); }
  .ss-fig.is-stuck { clip-path: inset(calc(-1 * var(--ss-fade)) -100vmax calc(-1 * var(--ss-fade)) -100vmax); }
  .ss-fig.is-stuck::before { display: block; }
  .ss-stage { position: relative; width: 100%; height: var(--ss-stage-h); }
  .ss-stage svg { width: 100%; height: 100%; display: block; overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 4%, #000 86%, transparent), linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 4%, #000 86%, transparent), linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-composite: source-in; mask-composite: intersect; }
  .cam { transform-origin: 0 0; transition: transform 1.15s var(--ease-scene); }
  .pc { transform-box: view-box; transition: transform 1.05s var(--ease-scene), opacity 0.7s var(--ease-out); }
  /* Drohnen: leichter Versatz beim Formationswechsel und Landen; beim Abheben alle zugleich (Zwischenhalt is-via) */
  .sd { transition: transform 1.25s var(--ease-scene) calc(var(--k) * 12ms), opacity 0.6s var(--ease-out) calc(var(--k) * 12ms); }
  .is-via .sd { transition: transform 0.95s var(--ease-scene), opacity 0.4s var(--ease-out); }
  .is-reset, .is-reset * { transition: none !important; }

  /* Zeichnung: Vokabular der Vorlage (Feld, Startpunkte), dazu Raster, Abhebelinien und Spuren */
  .slab { fill: rgb(var(--rgb-head) / 3%); stroke: rgb(var(--rgb-head) / 12%); stroke-width: 0.6; }
  .slab-side { fill: rgb(var(--rgb-head) / 6%); stroke: rgb(var(--rgb-head) / 10%); stroke-width: 0.5; }
  .floor-line { fill: none; stroke: rgb(var(--rgb-head) / 4%); stroke-width: 0.5; }
  .pad { fill: rgb(var(--rgb-head) / 5%); stroke: rgb(var(--rgb-head) / 30%); stroke-width: 0.5; }
  .raster-area { fill: color-mix(in srgb, var(--zc) 5%, transparent); stroke: none; }
  .raster { fill: none; stroke: color-mix(in srgb, var(--zc) 30%, transparent); stroke-width: 0.5; stroke-dasharray: 1.5 2.5; }
  .lift { fill: none; stroke: color-mix(in srgb, var(--zc) 34%, transparent); stroke-width: 0.6; stroke-linecap: round; stroke-dasharray: 1 1; stroke-dashoffset: 0; }
  /* zeichnen sich in Flugrichtung: aufwärts beim Start, abwärts bei der Rückkehr (die Linien sind so gezeichnet) */
  :is([data-step="1"], [data-step="3"]) .lift { animation: ss-draw 1s var(--ease-scene) both; animation-delay: var(--ss-enter); }
  .ghost { fill: none; stroke: color-mix(in srgb, var(--zc) 30%, transparent); stroke-width: 0.6; stroke-dasharray: 2 3; }
  @keyframes ss-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }

  /* Drohnen: am Boden leise (LEDs aus), am Himmel warmweiß, in der Animation im Logoverlauf */
  .sd .core { fill: rgb(var(--rgb-head) / 55%); transition: fill var(--dur-slow) var(--ease-scene); }
  .sd .halo { fill: var(--c); opacity: 0; transition: opacity var(--dur-slow) var(--ease-scene); }
  [data-step="1"] .sd .core { fill: #fff3df; }
  [data-step="1"] .sd .halo { fill: #fff3df; opacity: 0.14; }
  [data-step="2"] .sd .core { fill: var(--c); }
  [data-step="2"] .sd .halo { opacity: 0.2; }

  .sn { position: absolute; left: var(--x); top: var(--y); width: 0; height: 0; opacity: 0; visibility: hidden; transition: opacity var(--dur-fade) var(--ease-out), visibility 0s var(--dur-fade); }
  .sn.on { opacity: 1; visibility: visible; transition-delay: 1.1s, 0s; }
  .sn-dot { position: absolute; left: -0.21875rem; top: -0.21875rem; width: 0.4375rem; height: 0.4375rem; border-radius: var(--radius-round); background: var(--head); box-shadow: 0 0 0 0.1875rem rgb(var(--rgb-head) / 16%); }
  .sn-pill { position: absolute; top: 0; transform: translateY(-50%); display: inline-flex; align-items: center; gap: var(--space-1-5); white-space: nowrap; padding: var(--space-1) var(--space-2-5); border-radius: var(--radius-pill); background: var(--ground); border: 1px solid var(--line-strong); color: var(--head); font: 500 var(--text-xs)/1.2 var(--display); }
  .sn-r .sn-pill { left: 1rem; }
  .sn-l .sn-pill { right: 1rem; }
  .sn-pill::before { content: ""; position: absolute; top: 50%; width: 0.75rem; border-top: 1px solid var(--line-strong); }
  .sn-r .sn-pill::before { right: 100%; }
  .sn-l .sn-pill::before { left: 100%; }
  .sn-r.sn-flip .sn-pill { left: auto; right: 1rem; }
  .sn-l.sn-flip .sn-pill { right: auto; left: 1rem; }
  .sn-r.sn-flip .sn-pill::before { right: auto; left: 100%; }
  .sn-l.sn-flip .sn-pill::before { left: auto; right: 100%; }

  .ss-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); padding-top: var(--space-2); border-top: 1px solid var(--line); margin-top: var(--space-2); }
  .ss-now { margin: 0; min-width: 0; display: flex; align-items: baseline; gap: var(--space-3); color: var(--head); font: 500 var(--text-sm)/1.3 var(--display); }
  .ss-now [data-now] { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ss-num { color: var(--faint); font-size: var(--text-xs); letter-spacing: 0.06em; }
  .ss-track { display: flex; align-items: center; gap: var(--space-6); flex: none; }
  .ss-grp { display: flex; align-items: center; gap: var(--space-2-5); }
  .ss-glab { color: var(--head); font: 500 var(--text-xs)/1 var(--display); }
  .ss-grp ol { list-style: none; display: flex; margin: 0; padding: 0; }
  .ss-grp button { width: 1.375rem; height: 2.75rem; border: 0; padding: 0; background: none; cursor: pointer; display: grid; place-items: center; }
  .ss-seg { width: 0.875rem; height: 2px; border-radius: 1px; background: rgb(var(--rgb-head) / 16%); transition: background var(--dur-control) var(--ease-default), width var(--dur-control) var(--ease-default); }
  .ss-grp button.done .ss-seg { background: rgb(var(--rgb-head) / 42%); }
  .ss-grp button[aria-current] .ss-seg { width: 1.125rem; background: var(--head); }
  .ss-grp button:hover .ss-seg { background: rgb(var(--rgb-head) / 70%); }
  .ss-grp button:focus-visible { outline: 2px solid var(--accent); outline-offset: -0.375rem; border-radius: var(--radius-4); }

  .ss-text { padding-top: var(--space-10); padding-bottom: 28svh; }
  .ss-step { padding-bottom: clamp(var(--space-12), 16svh, 9rem); }
  .ss-step > :global(:first-child) { margin-top: 0; }
  .ss-text > :global(* + *) { margin-top: 0; }
  .ss-step > :global(* + *) { margin-top: 1.1em; }

  @media (prefers-reduced-motion: reduce) { .cam, .pc, .sd, .sd *, .sn { transition: none !important; } .lift { animation: none !important; } }
