---
import { forPath } from '../../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
// Ein Schema für alle Standort- und Sicherheitsabschnitte. Maßangaben sind Content,
// die Geometrie ist bewusst schematisch. Belege: docs/sicherheitskonzept-quellen.md.
// Schrittweise (Marc, 02.11.2026: „zu viel auf einmal … erstmal nur den ersten Punkt gehighlighted, on hover werden die
// dazugehörigen Bereiche revealed“): Zeichnung und Liste zeigen eine Zone zugleich, anfangs die erste. Zeigen, Fokus oder
// Tippen auf einen Titel oder eine Nummer in der Zeichnung wechselt die Zone. Ohne JavaScript ist alles offen.
// Zuständigkeiten als Tabelle mit ✓/◐/– (Marc: „keine Akkordeons, sondern Informationsdesign“); der Vorlauf steht im
// Netzplan-Zeitstrahl der Tempo-Section, die Haftpflicht als Zeile der Tabelle.
import type { Section } from '../../content.config';
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
type Props = Extract<Section, { type: 'landingSite' }> & { index: number };
const { kicker, headline, text, variant, diagram, items, responsibilities, safeguards, download, id = 'location', index } = Astro.props;
const H = index === 0 ? 'h1' : 'h2';
const T = index === 0 ? 'h2' : 'h3';
const numbers = Object.fromEntries(items.map((item, i) => [item.zone, i + 1]));
const colors = ['#ff9e29', '#f58a5a', '#ec7f95', '#db64e8', '#b88bec', '#8aa9ee', '#6fc8ef', '#33edf2'];
const line = Array.from({ length: 21 }, (_, i) => ({ x: 110 + i * 8.5, y: 138, color: colors[Math.round(i / 20 * 7)] }));
const grid = Array.from({ length: 20 }, (_, i) => ({ x: 142 + (i % 5) * 25, y: 306 + Math.floor(i / 5) * 32 }));
const swarm = Array.from({ length: 18 }, (_, i) => ({ x: 90 + i * 9, y: 122 - Math.sin(i / 17 * Math.PI) * 40, color: colors[Math.round(i / 17 * 7)] }));
const markers = variant === 'outdoor'
  ? [{ zone: 'safety', x: 43, y: 39 }, { zone: 'operative', x: 69, y: 68 }, { zone: 'drones', x: 92, y: 100 }, { zone: 'start', x: 96, y: 223 }, { zone: 'guests', x: 313, y: 368 }]
  : [{ zone: 'ceiling', x: 49, y: 28 }, { zone: 'drones', x: 262, y: 83 }, { zone: 'floor', x: 118, y: 285 }, { zone: 'kit', x: 305, y: 442 }, { zone: 'guests', x: 350, y: 160 }];
---
<section class="section ls-site" id={id} aria-labelledby={`${id}-h`}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} level={H} />
  <div class="st">
    <figure class="st-fig">
      <svg viewBox={variant === 'outdoor' ? '0 0 400 405' : '0 0 400 490'} role="img" aria-labelledby={`${id}-diagram-title ${id}-diagram-desc`}>
        <title id={`${id}-diagram-title`}>{variant === 'outdoor' ? t('landingsite.outdoorTitle') : t('landingsite.indoorTitle')}</title>
        <desc id={`${id}-diagram-desc`}>{diagram.description} {t('landingsite.numberedList')} {diagram.caption}</desc>
        {variant === 'outdoor' ? <>
          <g class="zone" data-zone="safety"><rect class="outer" x="43" y="39" width="300" height="282" rx="16" />
          <path class="dim" d="M43 28h300M43 22v12M343 22v12M363 39v282M357 39h12M357 321h12" />
          <text class="lbl" x="193" y="18" text-anchor="middle">{diagram.horizontalLabel}</text>
          <text class="lbl" x="380" y="181" text-anchor="middle" transform="rotate(90 380 181)">{diagram.verticalLabel}</text></g>
          <g class="zone" data-zone="operative"><rect class="operative" x="69" y="68" width="248" height="226" rx="12" /></g>
          <g class="zone" data-zone="drones"><rect class="flight" x="92" y="100" width="202" height="155" rx="8" />
          {line.map((d) => <circle cx={d.x} cy={d.y} r="3.5" fill={d.color} />)}
          <path class="dim" d="M110 167h170M110 161v12M280 161v12" />
          <text class="lbl" x="195" y="193" text-anchor="middle">{diagram.detailLabel}</text></g>
          <g class="zone" data-zone="start"><rect class="pad" x="105" y="215" width="49" height="26" rx="3" />
          {Array.from({ length: 18 }, (_, i) => <circle class="seed" cx={112 + (i % 6) * 7} cy={221 + Math.floor(i / 6) * 7} r="1.3" />)}</g>
          <g class="zone" data-zone="guests"><rect class="audience" x="103" y="351" width="188" height="38" rx="8" />
          {Array.from({ length: 22 }, (_, i) => <circle class="guest" cx={118 + (i % 11) * 15} cy={363 + Math.floor(i / 11) * 14} r="2.6" />)}
          <path class="view" d="M197 343v-79m-5 8 5-8 5 8" /></g>
        </> : <>
          <path class="wall" d="M49 28h324M49 210h324" />
          <g class="zone" data-zone="ceiling">{Array.from({ length: 17 }, (_, i) => <path class="hatch" d={`M${53 + i * 19} 28l-9 -12`} />)}
          <path class="dim" d="M31 34v176M25 34h12M25 210h12" />
          <text class="lbl" x="17" y="123" text-anchor="middle" transform="rotate(-90 17 123)">{diagram.verticalLabel}</text></g>
          <g class="zone" data-zone="drones"><rect class="flight" x="73" y="53" width="211" height="155" rx="8" />
          {swarm.map((d) => <circle cx={d.x} cy={d.y} r="3.3" fill={d.color} />)}</g>
          <g class="zone" data-zone="guests">{[0, 1, 2].map((i) => <><circle class="guest" cx={312 + i * 23} cy="180" r="5" /><path class="guest-body" d={`M${304 + i * 23} 210v-13a8 8 0 0 1 16 0v13`} /></>)}</g>
          <path class="divider" d="M49 238h324" />
          <g class="zone" data-zone="floor"><rect class="pad" x="88" y="202" width="179" height="8" rx="3" />
          <path class="dim" d="M118 270h156M118 264v12M274 264v12" />
          <text class="lbl" x="196" y="261" text-anchor="middle">{diagram.horizontalLabel}</text>
          <rect class="flight" x="105" y="279" width="182" height="174" rx="6" />
          <rect class="pad" x="118" y="292" width="156" height="148" rx="4" />
          {grid.map((d) => <circle class="seed" cx={d.x} cy={d.y} r="3" />)}</g>
          <g class="zone" data-zone="kit">{[[105, 279], [287, 279], [105, 453], [287, 453]].map(([x, y]) => <circle class="antenna" cx={x} cy={y} r="5" />)}
          <text class="lbl" x="196" y="482" text-anchor="middle">{diagram.detailLabel}</text></g>
        </>}
        {markers.map((m) => <g class="marker" data-zone={m.zone} data-pick={m.zone}><circle cx={m.x} cy={m.y} r="12" /><text x={m.x} y={m.y + 4.5} text-anchor="middle">{numbers[m.zone]}</text></g>)}
      </svg>
      <p class="st-height"><Icon name="move-up" size={20} class="g" /><span>{diagram.flightLabel}</span></p>
      <figcaption>{diagram.caption}</figcaption>
    </figure>
    <ol class="st-items">
      {items.map((item, i) => <li data-zone={item.zone} data-pick={item.zone}>
        <span class="st-n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <T><button type="button" class="st-row" aria-expanded="true" aria-controls={`${id}-z${i}`}>{item.title}</button></T>
          <div class="st-body" id={`${id}-z${i}`}><div>{item.value && <span class="st-value">{item.value}</span>}<p>{item.text}</p></div></div>
        </div>
      </li>)}
    </ol>
  </div>
  {safeguards && <div class="st-safeguards">
    {safeguards.map((item) => <div><Icon name={item.icon} size={32} class="g" /><T>{item.title}</T><p>{item.text}</p></div>)}
  </div>}
  <div class="st-who">
    <T id={`${id}-who`}>{t('landingsite.more')}</T>
    <table aria-labelledby={`${id}-who`}>
      <thead><tr><th scope="col">{t('landingsite.task')}</th><th scope="col" class="c">FlyingStars</th><th scope="col" class="c">{t('landingsite.you')}</th></tr></thead>
      <tbody>{responsibilities.map((row) => <tr>
        <th scope="row">{row.task}</th>
        {[row.us, row.you].map((v) => <td class:list={['c', v]}>
          {v === 'full' && <Icon name="check" size={20} strokeWidth={2.4} class="g" label={t('landingsite.full')} />}
          {v === 'part' && <span class="half" role="img" aria-label={t('landingsite.part')}></span>}
          {v === 'none' && <span class="none" role="img" aria-label={t('landingsite.none')}>–</span>}
          {v === 'part' && row.hint && <small>{row.hint}</small>}
        </td>)}
      </tr>)}</tbody>
    </table>
    <p class="st-legend mono"><span><Icon name="check" size={14} strokeWidth={2.4} class="g" /> {t('landingsite.full')}</span><span><span class="half" aria-hidden="true"></span> {t('landingsite.part')}</span><span><span class="none" aria-hidden="true">–</span> {t('landingsite.none')}</span></p>
    {download && <a class="link st-download" href={localHref(download.href)} type="application/pdf" target="_blank" rel="noopener">{download.label}<Icon name="download" size={18} class="g" /></a>}
  </div>
</section>

<script>
  // Eine Zone zugleich: anfangs die erste; Zeigen (Maus), Fokus oder Tippen wechselt. Die Zone bleibt, bis eine andere kommt.
  document.querySelectorAll<HTMLElement>('.ls-site .st').forEach((st) => {
    const rows = [...st.querySelectorAll<HTMLButtonElement>('.st-row')];
    const show = (zone: string) => {
      st.querySelectorAll<SVGElement | HTMLElement>('[data-zone]').forEach((el) => el.classList.toggle('on', el.dataset.zone === zone));
      rows.forEach((b) => b.setAttribute('aria-expanded', String(b.closest('li')!.dataset.zone === zone)));
    };
    st.querySelectorAll<HTMLElement | SVGElement>('[data-pick]').forEach((el) => {
      const zone = el.dataset.pick!;
      el.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') show(zone); });
      el.addEventListener('click', () => show(zone));
    });
    rows.forEach((b) => b.addEventListener('focus', () => show(b.closest('li')!.dataset.zone!)));
    // Anfangszustand ohne Überblendung setzen, Übergänge erst ab dem nächsten Bild (sonst blendet die Seite beim Laden um)
    st.classList.add('is-stepped');
    show(rows[0]?.closest('li')?.dataset.zone ?? '');
    requestAnimationFrame(() => requestAnimationFrame(() => st.classList.add('is-live')));
  });
</script>

<style>
  .st { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 88px); align-items: start; }
  .st-fig { margin: 0; position: sticky; top: 96px; padding: clamp(16px, 2.4vw, 36px); border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .st-fig svg { width: 100%; max-width: 560px; height: auto; display: block; margin-inline: auto; }
  .st-fig figcaption { margin-top: 18px; color: var(--faint); font-size: 14px; }
  .st-height { display: flex; align-items: center; gap: 10px; margin: 20px 0 0; color: var(--head); font-size: 16px; }
  .st-height :global(.ico) { flex: 0 0 auto; }
  .outer { fill: rgb(245 167 60 / 3%); stroke: var(--accent); stroke-width: 1.4; stroke-dasharray: 6 5; }
  .operative { fill: rgb(245 167 60 / 5%); stroke: rgb(245 167 60 / 65%); stroke-width: 1.2; }
  .flight { fill: rgb(237 230 218 / 3%); stroke: rgb(237 230 218 / 38%); stroke-dasharray: 3 4; }
  .pad { fill: rgb(237 230 218 / 9%); stroke: var(--head); stroke-width: 1; }
  .audience { fill: rgb(237 230 218 / 4%); stroke: rgb(237 230 218 / 20%); }
  .dim, .wall, .hatch, .view { fill: none; stroke: var(--faint); stroke-width: 1; }
  .hatch, .view { opacity: 0.6; }
  .view { stroke-dasharray: 3 4; }
  .divider { stroke: var(--line); }
  .lbl { fill: var(--head); font: 400 17px var(--display); }
  .seed, .guest { fill: var(--head); }
  .guest { opacity: 0.65; }
  .guest-body { fill: none; stroke: var(--head); stroke-width: 1.5; opacity: 0.65; }
  .antenna { fill: var(--accent); stroke: var(--ground); stroke-width: 2; }
  .marker circle { fill: var(--ground); stroke: var(--accent); stroke-width: 1.4; }
  .marker text { fill: var(--accent); font: 500 14px var(--display); }
  .st-items { list-style: none; margin: 0; padding: 0; }
  /* Schrittweise: nicht gewählte Zonen treten zurück, ihr Text klappt zu (Höhe über grid-template-rows, weich) */
  .is-live :is(.zone, .marker) { transition: opacity 0.4s ease; }
  .is-stepped .zone:not(.on) { opacity: 0.16; }
  .is-stepped .marker { cursor: pointer; }
  .is-stepped .marker:not(.on) { opacity: 0.55; }
  .is-live .marker :is(circle, text) { transition: fill 0.3s ease; }
  .is-stepped .marker.on circle { fill: var(--accent); }
  .is-stepped .marker.on text { fill: var(--ground); }
  .st-row { all: unset; cursor: pointer; display: block; width: 100%; font: inherit; color: inherit; }
  .st-row:focus-visible { outline: 2px solid var(--cyan); outline-offset: 4px; border-radius: 4px; }
  .st-body { display: grid; grid-template-rows: 1fr; }
  .is-live .st-body { transition: grid-template-rows 0.4s ease, opacity 0.35s ease, visibility 0s; }
  .st-body > div { overflow: hidden; min-height: 0; }
  /* zugeklappt wirklich verborgen (auch für Screenreader, passend zu aria-expanded), erst nach dem Zuklappen */
  .is-stepped li:not(.on) .st-body { grid-template-rows: 0fr; opacity: 0; visibility: hidden; }
  .is-live li:not(.on) .st-body { transition: grid-template-rows 0.4s ease, opacity 0.35s ease, visibility 0s 0.4s; }
  .is-live .st-items li { transition: color 0.3s ease; }
  .is-stepped .st-items li:not(.on) :is(h2, h3) { color: var(--muted); }
  .is-stepped .st-items li:not(.on) .st-n { color: var(--faint); }
  .is-stepped .st-items li { cursor: pointer; }
  /* Wer macht was: Tabelle, Aufgaben links, je Spalte ein Zeichen */
  .st-who { margin-top: clamp(48px, 6vw, 88px); }
  .st-who > :is(h2, h3) { font-size: clamp(24px, 2.2vw, 32px); margin-bottom: 20px; }
  .st-who table { width: 100%; min-width: 0; max-width: 980px; border-collapse: collapse; table-layout: fixed; } /* Aufgabe nimmt den Rest, die Zeichenspalten bleiben schmal */
  .st-who th, .st-who td { padding: 14px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: middle; }
  .st-who thead th { padding-top: 0; font: 400 12px/1.4 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); border-bottom-color: var(--line-strong); }
  .st-who tbody th { font-weight: 400; color: var(--text); font-size: 16px; padding-left: 0; hyphens: auto; -webkit-hyphens: auto; overflow-wrap: break-word; }
  .st-who .c { width: 132px; text-align: center; }
  .st-who td.c { color: var(--muted); }
  .st-who td small { display: block; margin-top: 4px; font-size: 12.5px; color: var(--faint); line-height: 1.3; }
  .st-who .half { display: inline-block; width: 16px; height: 16px; border-radius: 50%; border: 2px solid var(--accent); background: linear-gradient(90deg, var(--accent) 50%, transparent 50%); vertical-align: middle; }
  .st-who .none { color: var(--faint); font-size: 18px; }
  .st-who tbody tr { transition: background-color 0.2s ease; }
  .st-who tbody tr:hover { background: rgba(246, 241, 232, 0.025); }
  .st-legend { display: flex; flex-wrap: wrap; gap: 8px 22px; margin: 16px 0 0; color: var(--faint); font-size: 12px; }
  .st-legend > span { display: inline-flex; align-items: center; gap: 8px; }
  .st-legend .half { width: 12px; height: 12px; }
  @media (max-width: 600px) { .st-who .c { width: 86px; } .st-who th, .st-who td { padding: 12px 4px; } .st-who tbody th { font-size: 15px; padding-right: 8px; } .st-who thead th { letter-spacing: 0.04em; font-size: 11px; } .st-who td small { font-size: 11.5px; } }
  @media (prefers-reduced-motion: reduce) { .zone, .marker, .st-body { transition: none; } }
  .st-items li { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 8px; padding: 22px 0; border-top: 1px solid var(--line); }
  .st-items li:first-child { padding-top: 0; border: 0; }
  .st-n { color: var(--accent); padding-top: 4px; }
  .st-items h2, .st-items h3, .st-safeguards h2, .st-safeguards h3 { font-size: clamp(20px, 1.6vw, 24px); }
  .st-value { display: block; margin-top: 8px; color: var(--accent); font: 500 clamp(17px, 1.3vw, 20px)/1.2 var(--display); }
  .ls-site p { line-height: 1.65; }
  .st-safeguards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; margin-top: clamp(40px, 5vw, 72px); padding-block: 32px; border-block: 1px solid var(--line); }
  .st-safeguards > div > :global(.ico) { width: 36px; height: 36px; }
  .st-safeguards h2, .st-safeguards h3 { margin-top: 18px; }
  .st-safeguards p { font-size: 16px; }
  .st-download { margin-top: 28px; display: flex; align-items: center; gap: 10px; }
  .st-download :global(.ico) { width: 18px; height: 18px; flex: 0 0 auto; }
  @media (max-width: 960px) {
    .st { grid-template-columns: 1fr; }
    .st-fig { position: static; }
    .st-safeguards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .st-safeguards { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
