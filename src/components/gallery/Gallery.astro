---
// Luftige Bildgalerie (Werbung #marketing, Über uns #nachhaltigkeit, Nachhaltigkeit und Indoor #referenzen).
// Runde 5 nach Marcs Referenzen: gleich breite, kleine Spalten mit großzügigen Fugen, unten bündig, oben treppenartig
// versetzt; der Text steht frei links oben, kleine Leuchtpunkt-Akzente in den Lücken. Mobil zwei (ab 44em drei)
// versetzte Spalten als Mauerwerk: die Plätze werden beim Build gerechnet (feines Zeilenraster, Spaltenbreite / 24).
// Anordnung und Zuschnitte: ./layouts.mjs, Material und Belege: public/media/galerie/manifest.json.
// Hover (nur Maus): Kachel hebt sich, Foto hellt auf, Zeile Kunde · Ort · Drohnen blendet ein, alles weich und auch
// beim Verlassen; nur transform, opacity und filter. Erscheinen mit dem Vorhang-Reveal der Seite. Kein Video.
import { getEntry } from 'astro:content';
import manifest from '../../../public/media/galerie/manifest.json';
import GalleryTile from './GalleryTile.astro';
import { GALLERY_LAYOUTS, GALLERY_TEXT, DRONES } from './layouts.mjs';
import { forPath } from '../../i18n/server';
import { contentRoute } from '../../i18n/public-routes.mjs';
interface Props { set: keyof typeof GALLERY_LAYOUTS; class?: string }
const { set, class: cls } = Astro.props;
const { locale, localHref, formatLocale } = forPath(Astro.url.pathname);
const layout = GALLERY_LAYOUTS[set];
if (!layout) throw new Error(`Unbekannte Galerie „${set}“`);
type Entry = (typeof manifest.entries)[number];
const bySlug = new Map(manifest.entries.map((e) => [e.slug, e as Entry]));
const hasHead = Astro.slots.has('head');
const ratio = (ar: string) => { const [a, b = '1'] = ar.split('/').map((x) => parseFloat(x)); return a / Number(b); };


async function photo(t: { slug: string; ar: string; pos?: string }) {
  const e = bySlug.get(t.slug);
  if (!e) throw new Error(`Galerie „${set}“: ${t.slug} fehlt im Manifest`);
  if (e.kind !== 'image') throw new Error(`Galerie „${set}“: ${t.slug} ist kein Standbild`);
  const text = GALLERY_TEXT[t.slug];
  // hochskalierte 1600er bringen keine Details, nur Bytes: dann bleibt es bei 800
  const srcset = (format: string) => e.files.filter((f) => f.format === format && !(f.upscaled && f.width > 800)).map((f) => `/media/galerie/${f.file} ${f.width}w`).join(', ');
  const base = e.files.find((f) => f.format === 'webp' && /-800\./.test(f.file))!;
  const big = e.files.filter((f) => f.format === 'webp').sort((a, b) => b.width - a.width)[0];
  // Referenzseite nur, wenn das Projekt eine öffentliche Fallseite hat (showcase)
  let href: string | undefined;
  if (e.reference) {
    const id = e.reference.replace(/^src\/content\/projects\/|\.md$/g, '');
    const project = await getEntry('projects', id);
    const route = project && contentRoute('projects', id, project.data);
    if (route) href = localHref(route);
  }
  const name = text?.name?.[locale] ?? (e.client && e.client !== 'Privat' ? e.client : undefined);
  const place = text?.place?.[locale];
  const drones = e.drones ? `${e.drones.toLocaleString(formatLocale)} ${DRONES[locale as keyof typeof DRONES]}` : undefined;
  const caption = [name, place, drones].filter(Boolean).join(' · ');
  const alt = locale === 'de' ? e.alt : text?.alt?.[locale as 'en' | 'nl'] ?? e.alt;
  return { kind: 'photo' as const, slug: t.slug, ar: t.ar, pos: t.pos ?? '50% 50%', r: ratio(t.ar), href, caption, alt,
    avif: srcset('avif'), webp: srcset('webp'), src: `/media/galerie/${base.file}`, width: big.width, height: big.height };
}
const columns = await Promise.all(layout.columns.map((col, c) => Promise.all(col.map(async (item, i) =>
  'slug' in item ? { ...(await photo(item)), c, i } : { kind: 'accent' as const, accent: item.accent, side: item.side ?? 'start', c, i }))));
if (columns.length !== layout.cols) throw new Error(`Galerie „${set}“: ${columns.length} Spalten statt ${layout.cols}`);
type Photo = Extract<(typeof columns)[number][number], { kind: 'photo' }>;

// Mobil: Mauerwerk in feinen Zeilen (24 je Spaltenbreite), drei Zeilen Fuge, die zweite (und dritte) Spalte beginnt
// tiefer. Reihenfolge: rechte Galeriespalte zuerst (dort stehen die stärksten Motive), jeweils in die kürzere Spalte.
const UNITS = 24, GAP = 4;
function masonry(n: number, offsets: number[]) {
  const top = offsets.slice(0, n), place = new Map<string, string>();
  const photos = [...columns].reverse().flat().filter((x): x is Photo => x.kind === 'photo');
  for (const p of photos) {
    const c = top.indexOf(Math.min(...top)), span = Math.round(UNITS / p.r);
    place.set(p.slug, `--m${n}c:${c + 1};--m${n}r:${top[c] + 1};--m${n}s:${span}`);
    top[c] += span + GAP;
  }
  return place;
}
const m2 = masonry(2, [0, 14]), m3 = masonry(3, [8, 0, 16]);
const style = (p: Photo) => `--ar:${p.ar};--pos:${p.pos};--i:${p.c};${m2.get(p.slug)};${m3.get(p.slug)}`;
const textCols = layout.text;
const headCols = layout.cols - (layout.top ?? 0);
---
<div class:list={['gal-wrap', cls]}>
  <div class:list={['gal', `gal-${set}`, { 'has-head': hasHead }]} style={`--cols:${layout.cols};--text:${textCols};--head:${headCols}`}>
    {/* Kopf im Raster: überspannt alle Spalten außer den obersten (top), die neben ihm aufsteigen */}
    {hasHead && <div class="g-head"><slot name="head" /></div>}
    <div class="g-copy"><slot /></div>
    <div class="g-cols">
      {/* mobil: kleines Punktraster in der Lücke über der versetzten Spalte */}
      <span class="g-accent g-grid g-maccent" aria-hidden="true"></span>
      {columns.map((col, c) => <div class:list={['g-col', { 'g-rise': c >= textCols, 'g-top': hasHead && c >= layout.cols - (layout.top ?? 0) }]} style={`--c:${c + 1}`}>
        {col.map((x) => x.kind === 'photo'
          ? <GalleryTile {...x} style={style(x)} />
          : <span class:list={['g-accent', x.accent === 'grid' ? 'g-grid' : 'g-dot', `g-${x.side}`]} aria-hidden="true"></span>)}
      </div>)}
    </div>
  </div>
</div>

<style is:global>
  /* global, weil die Kacheln eine eigene Komponente sind; alles hängt an .gal */
  .gal-wrap { container-type: inline-size; }
  .gal { --g-gap: clamp(1.25rem, 2.3vw, 2.75rem); --g-r: var(--radius-14); --g-ease: cubic-bezier(0.33, 1, 0.68, 1); --g-dur: 0.6s; }
  .gal .g-head .section-head { margin-bottom: 0; }
  .gal .g-copy > :last-child { margin-bottom: 0; }

  .gal .g-tile { position: relative; display: block; margin: 0; border-radius: var(--g-r); color: var(--text); text-decoration: none; aspect-ratio: var(--ar);
    transition: transform var(--g-dur) var(--g-ease); }
  /* Schatten als eigene Ebene: nur ihre Deckkraft wird animiert */
  .gal .g-tile::after { content: ""; position: absolute; inset: 0; z-index: -1; border-radius: inherit; box-shadow: 0 1.25rem 2.5rem -1rem var(--shadow-strong); opacity: 0; transition: opacity var(--g-dur) var(--g-ease); pointer-events: none; }
  .gal .g-media { position: absolute; inset: 0; overflow: hidden; border-radius: var(--g-r); background: var(--media-ground); --curtain-r: var(--g-r); }
  .gal .g-media picture { display: contents; }
  .gal .g-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); display: block;
    filter: brightness(0.92); transition: transform var(--dur-slow-long) var(--ease-reveal), filter var(--g-dur) var(--g-ease); transition-delay: calc(var(--i, 0) * var(--dur-stagger)), 0s; }
  /* Vorhang wie global ([data-curtain] > img), hier sitzt das Foto in <picture> */
  .reveal .gal .g-media[data-curtain]:not(.is-in) img { transform: scale(1.28); }

  /* Zeile Kunde · Ort · Drohnen, wie die Zähler auf den Referenzkarten */
  .gal .g-cap { position: absolute; z-index: 2; left: 0.5rem; bottom: 0.5rem; max-width: calc(100% - 1rem); padding: var(--space-1-5) var(--space-2-25);
    border-radius: var(--radius-4); background: var(--overlay-media); -webkit-backdrop-filter: blur(0.5rem); backdrop-filter: blur(0.5rem);
    line-height: 1.35; opacity: 0; transform: translateY(0.375rem); pointer-events: none;
    transition: opacity var(--g-dur) var(--g-ease), transform var(--g-dur) var(--g-ease); }
  @media (hover: hover) and (pointer: fine) {
    .gal .g-tile:hover { transform: translateY(-0.375rem); }
    .gal .g-tile:hover::after { opacity: 1; }
    .gal .g-tile:hover img { filter: brightness(1.08); }
    .gal .g-tile:hover .g-cap { opacity: 1; transform: none; transition-delay: 0.06s; }
  }
  .gal .g-tile:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .gal .g-tile:focus-visible .g-cap { opacity: 1; transform: none; }
  @media (hover: none), (pointer: coarse) { .gal .g-cap { display: none; } }

  /* Leuchtpunkt-Akzente im Logoverlauf: ein Punkt oder ein kleines Raster, ohne Glühen */
  .gal .g-accent { display: block; flex: none; pointer-events: none; }
  .gal .g-dot { width: 0.5rem; height: 0.5rem; border-radius: var(--radius-round); background: var(--grad); }
  .gal .g-grid { width: 4.375rem; height: 2.875rem; background: var(--grad-soft);
    -webkit-mask: radial-gradient(circle, #000 0.17rem, transparent 0.2rem) 0 0 / 0.875rem 0.875rem;
    mask: radial-gradient(circle, #000 0.17rem, transparent 0.2rem) 0 0 / 0.875rem 0.875rem; opacity: 0.85; }
  .gal .g-start { align-self: flex-start; }
  .gal .g-end { align-self: flex-end; }

  /* Breit: gleich breite Spalten, Text links oben, die Spalten darunter kurz, die daneben steigen nach rechts an */
  @media (--grid-expanded) {
    .gal { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); grid-template-rows: auto 1fr; gap: var(--g-gap); }
    .gal .g-cols { display: contents; }
    .gal .g-copy { grid-column: 1 / span var(--text); grid-row: 1; max-width: 42rem; padding-bottom: clamp(var(--space-4), 2vw, var(--space-8)); }
    .gal .g-col { grid-column: var(--c); grid-row: 2; align-self: end; display: flex; flex-direction: column; gap: var(--g-gap); }
    .gal .g-col.g-rise { grid-row: 1 / 3; }
    /* mit Kopf: Zeile 1 Kopf, 2 Text, 3 kurze Spalten; die oberste Spalte reicht bis neben den Kopf */
    .gal.has-head { grid-template-rows: auto auto 1fr; }
    .gal.has-head .g-head { grid-column: 1 / span var(--head); grid-row: 1; padding-bottom: clamp(var(--space-2), 1vw, var(--space-4)); }
    .gal.has-head .g-copy { grid-row: 2; }
    .gal.has-head .g-col { grid-row: 3; }
    .gal.has-head .g-col.g-rise { grid-row: 2 / 4; }
    .gal.has-head .g-col.g-top { grid-row: 1 / 4; }
    .gal .g-maccent { display: none; }
  }

  /* Schmal: Mauerwerk aus zwei (ab 44em drei) Spalten; Platz und Höhe jeder Kachel kommen aus dem Build */
  @media (--grid-stacked) {
    .gal .g-head { margin-bottom: clamp(var(--space-6), 6vw, var(--space-9)); }
    .gal .g-copy { margin-bottom: clamp(var(--space-8), 8vw, var(--space-12)); }
    .gal .g-cols { --n: 2; --mg: clamp(1rem, 4.5vw, 1.75rem); display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); column-gap: var(--mg); row-gap: 0;
      grid-auto-rows: calc((100cqi - (var(--n) - 1) * var(--mg)) / var(--n) / 24); }
    .gal .g-col { display: contents; }
    .gal .g-col .g-accent { display: none; }
    .gal .g-tile { aspect-ratio: auto; grid-column: var(--m2c); grid-row: var(--m2r) / span var(--m2s); }
    .gal .g-maccent { grid-column: 2; grid-row: 4 / span 6; align-self: start; justify-self: start; width: 3.5rem; height: 2rem; }
  }
  @media (min-width: 44em) and (--grid-stacked) {
    .gal .g-cols { --n: 3; }
    .gal .g-tile { grid-column: var(--m3c); grid-row: var(--m3r) / span var(--m3s); }
    .gal .g-maccent { grid-column: 3; grid-row: 4 / span 6; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gal .g-tile, .gal .g-tile::after, .gal .g-cap, .gal .g-media img { transition: none; }
    .gal .g-tile:hover { transform: none; }
  }
</style>
