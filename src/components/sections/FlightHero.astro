---
import type { Section } from '../../content.config';
import Accent from '../Accent.astro';
import { videoPath } from '../../lib/videos';
import { optimizedImage } from '../../lib/media';
// Hero mit laufendem Showreel (Marc, 31.10.2026: „mehr Bewegung, das Showreel gehört in den Hero“, wie im
// Vercel-Prototyp): stumm im Hintergrund, Start erst nach dem ersten Bild. Den Knopf „Showreel ansehen“ (Overlay mit Ton)
// gibt es nicht mehr (Marc, 01.11.2026: „brauchen wir nicht“); bis das Reel läuft, steht das Standbild da.
// Ohne Hintergrundvideo bei reduzierter Bewegung, globaler Pause, Datensparmodus und auf schmalen Bildschirmen.
const { headline, text, words, cta, secondary, poster, video, stats, eyebrow } = Astro.props as Extract<Section, { type: 'showreelHero' }>;
const still = await optimizedImage(poster.src, 960);
---
<section class="hero side" aria-labelledby="hero-h">
  <div class="video-player hero-media" aria-hidden="true"><img src={still.src} width={still.width} height={still.height} alt="" loading="eager" fetchpriority="high" /></div>
  <video class="reel" data-reel data-src={videoPath(video)} muted loop playsinline preload="none" poster={still.src} aria-hidden="true" tabindex="-1"></video>
  <div class="shade" aria-hidden="true"></div>
  <div class="rec mono" aria-hidden="true">Showreel</div>
  <div class="frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="hero-copy">
    {eyebrow && <span class="kicker mono">{eyebrow}</span>}
    <h1 id="hero-h"><Accent text={headline} />{words && words.length > 0 && <> <span class="word" data-rotate={words.join('|')}>{words[0]}</span></>}</h1>
    <p class="lead">{text}</p>
    <div class="actions"><a class="btn primary" href={cta.href}>{cta.label}</a>{secondary && <a class="btn" href={secondary.href}>{secondary.label}</a>}</div>
  </div>
  {stats && stats.length > 0 && <dl class="spec mono" aria-label="Eckdaten">{stats.map((stat) => <><dt>{stat.label}</dt><dd><b>{stat.value}</b></dd></>)}</dl>}
</section>

<script is:inline>
  // Zum Vergleich (Marc, 31.10.2026: „beide Varianten zeigen“): ?hero=voll zeigt die vollflächige Fassung
  if (new URLSearchParams(location.search).get('hero') === 'voll') document.querySelector('.hero.side')?.classList.remove('side');
</script>
<script>
  const reel = document.querySelector<HTMLVideoElement>('video[data-reel]');
  if (reel) {
    const root = document.documentElement;
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const allowed = () => !matchMedia('(prefers-reduced-motion: reduce)').matches && !root.classList.contains('motion-paused') && matchMedia('(min-width: 701px)').matches && !conn?.saveData;
    const hero = reel.closest('.hero')!;
    let visible = true;
    const sync = () => {
      if (allowed() && visible) {
        if (!reel.src) reel.src = reel.dataset.src!;
        reel.play().then(() => hero.classList.add('reel-on')).catch(() => {});
      } else reel.pause();
    };
    reel.addEventListener('error', () => { hero.classList.remove('reel-on'); reel.removeAttribute('src'); });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { threshold: 0.2 }).observe(hero);
    new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['class'] });
    const start = () => sync();
    if (document.readyState === 'complete') setTimeout(start, 300); else addEventListener('load', () => setTimeout(start, 300), { once: true });
  }
</script>
