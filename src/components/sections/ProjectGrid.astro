---
import {nativeField,nativeSection,nativeRecord,nativeRecordMedia} from "../../lib/native-editor";
import { getCollection } from 'astro:content';
import {resolveMedia} from '../../lib/editorial-records';
import { optimizedImage } from '../../lib/media';
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'projectGrid' }> & { index: number };
const { headline = 'Ein paar Nächte, die wir nicht vergessen.', text, kicker, cta, id:sectionId, limit, index } = Astro.props;
const id = `${sectionId ?? (index===0?'projekte':`s${index}`)}-h`;
const H = index === 0 ? 'h1' : 'h2';
const projects = (await getCollection('projects', (p) => process.env.FLYINGSTARS_EDITOR==='1'||!p.data.draft))
  .sort((a, b) => (a.data.showcase?.order ?? 999) - (b.data.showcase?.order ?? 999) || Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, limit);
const images = new Map(await Promise.all(projects.filter((p) => p.data.cover).map(async (p) => [p.id, await optimizedImage(resolveMedia(p.data.cover).src)] as const)));
const home = Astro.url.pathname === '/';
---
<section {...nativeSection(Astro.props)} class="section" id={sectionId ?? `s${index}`} aria-labelledby={id}>
  <div class="sec-head"><div>{kicker && <span class="kicker mono" {...nativeField(Astro.props,["kicker"])}>{kicker}</span>}<H id={id} {...nativeField(Astro.props,["headline"])}>{headline}</H></div>{text && <p {...nativeField(Astro.props,["text"])}>{text}</p>}</div>
  <div class="projects">
    {projects.map((project) => {
      const showcase = project.data.showcase;
      const image = images.get(project.id);
      return <a class="proj" href={showcase ? `/${showcase.route}/` : `/projekte/${project.id}/`}>
        {image && <div class="img"><img {...nativeRecordMedia(`project/${project.id}`,["cover"])} src={image.src} {...image.attributes} width={image.width} height={image.height} alt={resolveMedia(project.data.cover).alt} loading="lazy" decoding="async" />{showcase && <span class="count mono">{showcase.drones} Drohnen</span>}</div>}
        <span class="kick mono">{showcase?.category ?? [project.data.client, project.data.location].filter(Boolean).join(' · ')}</span><h3 {...nativeRecord(`project/${project.id}`,showcase?["showcase","cardTitle"]:["title"])}>{showcase?.cardTitle ?? project.data.title}</h3>
        {!showcase && <p {...nativeRecord(`project/${project.id}`,["summary"])}>{project.data.summary}</p>}
      </a>;
    })}
  </div>
  {cta && <div class="more"><a class="link" href={cta.href}><span {...nativeField(Astro.props,["cta","label"])}>{cta.label}</span> <span aria-hidden="true">→</span></a></div>}
</section>
