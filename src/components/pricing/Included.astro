---
// „Im Preis enthalten“ auf der Preisseite. Erste Fassung (Marc, 02.11.2026): offenes Icon-Raster wie die Extras.
// Moritz' Preistext (17.11.2026): sieben Leistungen und ein Hinweis, was ihr selbst stellt. Damit dieser Abschnitt nicht
// genauso aussieht wie das Upgrade-Raster direkt danach, steht der Kopf links und die sieben Leistungen rechts im
// zweispaltigen Raster; die achte Zelle trägt den Hinweis (ℹ). Ohne Items gilt die frühere Auswahl aus package-details.ts.
import IconFeature from '../IconFeature.astro';
import SectionHead from '../SectionHead.astro';
import { forPath } from '../../i18n/server';
import { getPackageDetails } from '../../content/package-details';
const { INCLUDED } = getPackageDetails(forPath(Astro.url.pathname).locale);
const { t } = forPath(Astro.url.pathname);
interface Item { icon: string; title: string; text: string }
interface Props { id?: string; kicker?: string; headline: string; text?: string; items?: Item[]; note?: string; surface?: 'alt' | 'plain' }
const { id = 'inklusive', kicker, headline, text, items, note, surface = 'alt' } = Astro.props;
const list: Item[] = items ?? INCLUDED;
---
<section class:list={['section', { alt: surface === 'alt' }, { 'inc-split': items }]} id={id} aria-labelledby={`${id}-h`}>
  {items ? (
    <div class="inc">
      <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} class="inc-head" />
      <ul class="ig inc-grid" role="list">
        {list.map((item) => <IconFeature as="li" class="ic" icon={item.icon} title={item.title} text={item.text} />)}
        {/* Runde 5 (Marc: „vom Layout gleich halten, aber farblich etwas anders markieren, damit man sieht, das ist was
             anderes, aber es passt immer noch“): gleiche Zelle mit Icon und Titel, in Cyan aus dem Logoverlauf auf feiner Fläche */}
        {note && <IconFeature as="li" class="ic inc-note" icon="hand-helping" iconClass="inc-note-ico" title={t('preise.incNoteTitle')} text={note} />}
      </ul>
    </div>
  ) : (
    <>
      <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} />
      <div class:list={['ig', { 'cols-4': list.length === 4 }]}>
        {list.map((item) => <IconFeature class="ic" icon={item.icon} title={item.title} text={item.text} />)}
      </div>
    </>
  )}
</section>

<style>
  .inc { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(var(--space-8), 5vw, var(--space-16)); align-items: start; }
  .inc :global(.inc-head) { position: sticky; top: calc(var(--nav-h) + var(--space-8)); }
  .inc-grid { --ig-cols: 2; list-style: none; margin: 0; padding: 0; }
  /* Zelle „Das macht ihr“: Struktur wie die Leistungen, Cyan statt Orange, feine Fläche mit Cyan-Haarlinie oben */
  .inc-grid > :global(.inc-note) { position: relative; background: linear-gradient(180deg, rgb(var(--rgb-cyan) / 0.07), rgb(var(--rgb-cyan) / 0.02)); }
  .inc-grid > :global(.inc-note)::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 1px; background: rgb(var(--rgb-cyan) / 0.55); }
  .inc-grid :global(.inc-note .ico.inc-note-ico) { stroke: var(--cyan); }
  .inc-grid :global(.inc-note > p) { max-width: 40ch; }
  @media (--grid-stacked) {
    .inc { grid-template-columns: 1fr; }
    .inc :global(.inc-head) { position: static; }
  }
  @media (--compact) { .inc-grid { --ig-cols: 1; } }
</style>
