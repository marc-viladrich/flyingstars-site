---
import { forPath } from '../../i18n/server';
const { t } = forPath(Astro.url.pathname);
import type { Section } from '../../content.config';
import Accent from '../Accent.astro';
import SectionHead from '../SectionHead.astro';
import { plain } from '../accent';
import ComparisonMatrix from '../ComparisonMatrix.astro';
type Props = Extract<Section, { type: 'comparison' }> & { index: number };
const { headline, text, rowHeader = t('comparison.criterion'), columns, rows, note, id = `s${Astro.props.index}`, index, kicker } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
const label = plain(headline);
---
<section class="section alt" id={id} aria-labelledby={headingId}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={headingId} level={H} />
  <ComparisonMatrix id={id} label={label} regionLabel={t('comparison.table', { label })} rowHeader={rowHeader}
    tabLabel={t('comparison.valueChooseATechnology', { v0: label })}
    columns={columns.map((label, i) => ({ label: label.value, featured: i === 0 }))}
    rows={rows.map((row) => ({ label: row.label, cells: row.cells ?? row.values.map(item => item.value) }))} />
  {note && <p class="fine mono">{note}</p>}
</section>
