---
// Nachhaltigkeit als Scrollstory aus dem Vercel-Prototyp (Marc, 31.10.2026: „das Scrollytelling finde ich ganz nice,
// das kann bleiben“): Die Bühne bleibt stehen, vier Zahlen übernehmen nacheinander den Bildschirm, im Hintergrund fliegt
// die Flotte eine passende Figur (Schallwelle, Null, geparkte Flotte, Blitz). Ohne JS, bei reduzierter Bewegung und auf
// Wunsch pausiert: dieselben Zahlen als ruhige Liste. Aussagen nur über die Show vor Ort (EmpCo).
// Headline: jeder Satz eine Zeile, der letzte im Logoverlauf (gezielter Einsatz statt drei Titelschnitte).
import type { Section } from '../../content.config';
import { optimizedLogo } from '../../lib/media';
type Props = Extract<Section, { type: 'sustainability' }> & { index: number };
const { headline, text, id = 'nachhaltigkeit', facts = [], points = [], pillars = [], proofImage, proofText, campaign, index, kicker } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
const lines = headline.split(/(?<=\.)\s+/).filter(Boolean);
const parts = (point: string) => point.split(/(\S+-\S+)/).filter(Boolean);
const proof = proofImage ? await optimizedLogo(proofImage.src, 60) : undefined;
---
<section class="eco-sec" id={id} aria-labelledby={headingId}>
  <div class="eco-head">
    <div>{kicker && <span class="kicker mono">{kicker}</span>}<H id={headingId} class="eco-title" data-reveal-group>{lines.map((line, i) => <span data-reveal style={`--i:${i}`} class:list={{ grad: i === lines.length - 1 && lines.length > 1, o: lines.length > 2 && i === 1 }}>{line} </span>)}</H></div>
    {text && <p>{text}</p>}
  </div>
  {facts.length > 0 && <div class="eco-scrolly" data-scrolly><div class="eco-pin">
    <canvas class="eco-canvas" aria-hidden="true"></canvas>
    <dl class="eco-facts">{facts.map((fact, i) => <div class="fact">
      <dt class="fk mono">{fact.label}</dt>
      <dd class:list={['fn', { g: fact.unit === '%', o: i === 1 && facts.length > 2 }]}>{fact.unit === '%' ? <span data-to={fact.value}>{fact.value}</span> : fact.value}{fact.unit && <small>{fact.unit}</small>}</dd>
      <dd class="ft"><p>{fact.text}</p></dd>
    </div>)}</dl>
    <ol class="eco-steps mono" aria-hidden="true">{facts.map((fact, i) => <li style={`--k:${i}`}>{fact.label}</li>)}</ol>
  </div></div>}
  {pillars.length > 0 && <ul class="eco-pillars">{pillars.map((p) => <li>
    <svg class="ico g" viewBox="0 0 48 48" aria-hidden="true">
      {p.icon === 'eu' && <>{Array.from({ length: 12 }, (_, k) => { const a = (k / 12) * Math.PI * 2; const x = 24 + 15 * Math.cos(a), y = 24 + 15 * Math.sin(a); return <path d={`M${x} ${y - 2.6}l.8 1.7 1.8.2-1.3 1.3.3 1.8-1.6-.9-1.6.9.3-1.8-1.3-1.3 1.8-.2z`} style="fill:var(--accent);stroke:none" />; })}</>}
      {p.icon === 'repair' && <path d="M31 7a10 10 0 0 0-9.4 13.3L7.8 34.1a4 4 0 0 0 5.7 5.7l13.8-13.8A10 10 0 0 0 40.6 17l-6 6-5.4-1.2L28 16.4l6-6A10 10 0 0 0 31 7z" />}
      {p.icon === 'ev' && <><path d="M6 31v-7l5-9h18l7 9h4a3 3 0 0 1 3 3v4" /><circle cx="14" cy="32" r="4" /><circle cx="34" cy="32" r="4" /><path d="M18 32h12M6 24h33M24 15v9" /><path d="M23 6l-3 5h4l-3 5" /></>}
      {p.icon === 'campaign' && <><path d="M24 24v-9M24 24l6.4-6.4M24 24h9M24 24l6.4 6.4M24 24v9M24 24l-6.4 6.4M24 24h-9M24 24l-6.4-6.4" /><path d="M24 9v-2M35.3 12.7l1.4-1.4M39 24h2M35.3 35.3l1.4 1.4M24 39v2M12.7 35.3l-1.4 1.4M9 24H7M12.7 12.7l-1.4-1.4" /><path d="M8 40L40 8" /></>}
      {p.icon === 'leaf' && <path d="M10 38c0-18 12-28 30-28 0 18-10 30-28 30m0-2 14-14" />}
    </svg>
    <b>{p.title}</b><span>{p.text}</span>
  </li>)}</ul>}
  {(points.length > 0 || campaign || proofText) && <div class="eco-proof">
    {proofImage && proof && <img src={proof.src} width={proof.width / 2} height={proof.height / 2} alt={proofImage.alt} loading="lazy" decoding="async" />}
    {points.length > 0 && <ul class="eco-points">{points.map((point) => <li><span>{parts(point).map((part) => part.includes('-') ? <span class="nowrap">{part}</span> : part)}</span></li>)}</ul>}
    {(proofText || campaign) && <p>{proofText}{campaign && <> <b>#Böllerciao:</b> {campaign}</>}</p>}
  </div>}
</section>
<script>
  const el = document.querySelector<HTMLElement>('[data-scrolly]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    import('../../scripts/effects/eco-scrolly.js').then(({ ecoScrolly }) => ecoScrolly(el));
  }
</script>
