---
// Einzige Zuordnung Section-Typ → Komponente. Neue Typen: Schema in content.config.ts,
// Komponente in sections/, eine Zeile hier. Mehr nicht.
import type { Section } from '../content.config';
import Hero from './sections/Hero.astro';
import FlightHero from './sections/FlightHero.astro';
import Occasions from './sections/Occasions.astro';
import Metrics from './sections/Metrics.astro';
import Sustainability from './sections/Sustainability.astro';
import TextMedia from './sections/TextMedia.astro';
import Faq from './sections/Faq.astro';
import Cta from './sections/Cta.astro';
import PostList from './sections/PostList.astro';
import ProjectGrid from './sections/ProjectGrid.astro';
import ContactForm from './sections/ContactForm.astro';
import Pricing from './sections/Pricing.astro';
import Steps from './sections/Steps.astro';
import Comparison from './sections/Comparison.astro';
import Team from './sections/Team.astro';
import LogoBar from './sections/LogoBar.astro';
import Timeline from './sections/Timeline.astro';
import Packages from './sections/Packages.astro';
import References from './sections/References.astro';
import Tempo from './sections/Tempo.astro';
import ConfiguratorTeaserSection from './sections/ConfiguratorTeaserSection.astro';
// Anlass-Landingpages (Hochzeit, Werbung, Indoor), 31.10.2026
import { LandingHero, LandingStories, LandingRefs, LandingTeaser, LandingPrice, LandingSite, LandingFlow, LandingBento, LandingSpotlight, LandingCta } from './landing';

import Icon from './Icon.astro';
interface Props { sections: Section[] }
// Redaktionelle Hinweise (todo) nur im lokalen Dev-Server. Kein Build, auch keine Preview, rendert sie (Marc, 02.11.2026).
const annotate = import.meta.env.DEV;
const { sections } = Astro.props;
const map = { showreelHero: FlightHero, occasions: Occasions, metrics: Metrics, sustainability: Sustainability, hero: Hero, textMedia: TextMedia, faq: Faq, cta: Cta, postList: PostList, projectGrid: ProjectGrid, contactForm: ContactForm, pricing: Pricing, steps: Steps, comparison: Comparison, team: Team, logoBar: LogoBar, timeline: Timeline, packages: Packages, references: References, tempo: Tempo, configuratorTeaser: ConfiguratorTeaserSection, landingHero: LandingHero, landingStories: LandingStories, landingRefs: LandingRefs, landingTeaser: LandingTeaser, landingPrice: LandingPrice, landingSite: LandingSite, landingFlow: LandingFlow, landingBento: LandingBento, landingSpotlight: LandingSpotlight, landingCta: LandingCta } as const;
---
{sections.map((s, i) => { const C = map[s.type]; return <>{annotate && s.todo && <aside class="todo-note" role="note"><Icon name="pencil-line" size={18} class="g" /><span><b>Fehlt noch</b> {s.todo}</span></aside>}<C {...(s as any)} index={i} /></>; })}
