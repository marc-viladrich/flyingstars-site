---
// Danke-Seite (Runde 4, Moritz 18.11.2026; Aufbau Runde 6 wie die Anfrage, Marc: „this is the last step“): links Kopf,
// Text und darunter Chopper, der sich als Drohnenformation freut; rechts die freiwillige Frage nach der Quelle in der
// Formular-Box der Anfrage (.inquiry/.ask aus ContactForm), mit Schrittanzeige als letztem Schritt.
// Die Seite ist frei aufrufbar (Lesezeichen, neuer Tab, Neuladen). Direkt aufgerufen zeigt sie den neutralen Satz und
// rechts den Weg zur Anfrage. Dank, Eingang (YAML `text`) und Herkunftsfrage zeigt sie nur im Übergang nach einem
// bestätigten Versand (data-sent): mit JavaScript, wenn das Anfrageformular das Einmal-Merkmal INQUIRY_SENT_KEY gesetzt
// hat (ein Inline-Skript vor dem ersten Bild verbraucht es, damit nichts springt); ohne JavaScript liefert der Endpoint
// diese Seite nach dem Versand selbst mit data-sent aus (functions/api/contact.ts, signierter Link). Die Antwort geht als
// zweite kleine Meldung über denselben Weg (kind=quelle) mit dem getrennt gespeicherten Bezug der Anfrage. Ihren Dank
// zeigt nur ein bestätigtes `sent`: mit JavaScript hier, ohne JavaScript als Seite des Endpoints.
import type { Section } from '../../content.config';
import SectionHead from '../SectionHead.astro';
import InquiryFormStyles from '../InquiryFormStyles.astro';
import Chopper from '../Chopper.astro';
import { site } from '../../site.config';
import { forPath } from '../../i18n/server';
import { SOURCE_OTHER, SOURCE_TEXT_MAX, SOURCE_DONE_ID, INQUIRY_SENT_KEY, INQUIRY_SENT_TTL, THANKS_STATE_ATTR } from '../../content/inquiry-source.mjs';
import { CONTACT } from '../people';
type Props = Extract<Section, { type: 'thanks' }> & { index: number };
const { kicker, headline, text, question, options, otherLabel, sendLabel, doneText, cta, index, id = 'danke' } = Astro.props;
const { t, locale, localHref } = forPath(Astro.url.pathname);
const H = index === 0 ? 'h1' : 'h2';
const headingId = `${id}-h`;
---
<section class="section alt thanks" id={id} aria-labelledby={headingId} {...{ [THANKS_STATE_ATTR]: '' }}>
  <InquiryFormStyles />
  <script is:inline define:vars={{ key: INQUIRY_SENT_KEY, ttl: INQUIRY_SENT_TTL }}>try{var at=sessionStorage.getItem(key);if(at!==null){sessionStorage.removeItem(key);if(Date.now()-Number(at)<ttl)document.currentScript.closest('.thanks').dataset.sent=''}}catch(e){}</script>
  <div class="inquiry">
    <SectionHead variant="embedded" class="intro" kicker={kicker} headline={headline} id={headingId} level={H}>
      {/* Beide Fassungen liegen übereinander (gleiche Höhe), sichtbar ist nur die zum Zustand passende */}
      <p class="lead thanks-lead"><span class="is-neutral">{t('thanks.leadNeutral')}</span>{text && <span class="is-sent">{text}</span>}</p>
      <Chopper mood="happy" class="thanks-chopper" />
    </SectionHead>
    {/* Direkter Aufruf: statt der Herkunftsfrage der Weg zur Anfrage, in derselben Box */}
    <div class="ask thanks-direct">
      <p class="thanks-q">{t('thanks.directInvite')}</p>
      <div class="actions"><a class="btn primary" href={localHref(site.cta.href)}>{site.cta.label}</a><a class="link" href={CONTACT.phone.href}>{CONTACT.phone.label}</a></div>
    </div>
    <form class="ask is-2" action={site.formEndpoint} method="post" data-source-form aria-labelledby="thanks-q">
      <div class="ask-steps" aria-hidden="true"><span>{t('thanks.stepSent')}</span><span class="on">{t('thanks.stepLast')}</span><i></i></div>
      <input type="hidden" name="kind" value="quelle" />
      <input type="hidden" name="locale" value={locale} />
      <input type="hidden" name="ref" value="" data-source-ref />
      <fieldset class="step" aria-describedby="quelle-err">
        <legend class="thanks-q" id="thanks-q">{question}</legend>
        <div class="field">
          <div class="chips">
            {options.map((o, i) => <label><input type="radio" name="quelle" value={o.value} required={i === 0} data-other={o.value === SOURCE_OTHER ? '' : undefined} /><span>{o.label}</span></label>)}
          </div>
          <span class="err" id="quelle-err" data-err-for="quelle" role="alert"></span>
        </div>
        {/* Nur bei „Andere“ sichtbar (CSS über :has, auch ohne JavaScript) und nur dann gesendet (Skript: disabled; ohne
             JavaScript verwirft der Endpoint einen Rest aus einer vorherigen Wahl) */}
        <div class="field" data-source-other>
          <label class="lbl" for="f-quelle-text">{otherLabel} <em>{t('contactform.optional')}</em></label>
          <input id="f-quelle-text" name="quelle-text" type="text" maxlength={SOURCE_TEXT_MAX} autocomplete="off" />
        </div>
        <div class="actions"><button class="btn primary" type="submit">{sendLabel}</button>{cta && <a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a>}</div>
      </fieldset>
      <div aria-hidden="true" class="honeypot"><label>Website<input autocomplete="off" name="website" tabindex="-1" /></label></div>
      <p class="form-status thanks-done" id={SOURCE_DONE_ID} tabindex="-1">{doneText}</p>
      <p class="form-status" data-source-status role="status" tabindex="-1"></p>
    </form>
  </div>
</section>

<script>
  import { INQUIRY_REF_KEY } from '../../content/inquiry-source.mjs';
  import { sendForm, SendError, setFieldError, clearErrorsOnInput } from '../../scripts/form-contract';
  import { t } from '../../i18n/ui.mjs';
  const form = document.querySelector<HTMLFormElement>('[data-source-form]');
  if (form) {
    const read = (key: string) => { try { return sessionStorage.getItem(key); } catch { return null; } };
    const status = form.querySelector<HTMLElement>('[data-source-status]')!;
    const done = form.querySelector<HTMLElement>('.thanks-done')!;
    const otherText = form.querySelector<HTMLInputElement>('[name=quelle-text]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    // Bezug nur im Übergang nach dem Versand, sonst ist die Frage gar nicht sichtbar
    if (form.closest<HTMLElement>('.thanks')?.hasAttribute('data-sent')) form.querySelector<HTMLInputElement>('[data-source-ref]')!.value = read(INQUIRY_REF_KEY) ?? '';
    form.noValidate = true;
    clearErrorsOnInput(form);
    // Ein deaktiviertes Feld gehört nicht zu FormData: der Freitext geht nur mit „Andere“ mit und bleibt beim
    // Zurückwechseln erhalten
    const syncOther = () => { otherText.disabled = !form.querySelector('[name=quelle][data-other]:checked'); };
    syncOther();
    form.addEventListener('change', syncOther);
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      // Ohne Auswahl gibt es nichts zu senden: Meldung an der Gruppe, Fokus auf die erste Antwort
      if (!form.querySelector('[name=quelle]:checked')) {
        setFieldError(form, 'quelle', t('thanks.pleaseChooseAnAnswer'));
        form.querySelector<HTMLInputElement>('[name=quelle]')?.focus();
        return;
      }
      button.disabled = true; status.textContent = '';
      try {
        const result = await sendForm(form.action, new FormData(form));
        if (result.state === 'sent') {
          form.classList.add('is-done');
          done.focus();
          return;
        }
        status.textContent = `${t('thanks.answerNotSent')} ${t('thanks.answerNotConfigured')}`;
      } catch (error) {
        const detail = error instanceof SendError ? error.detail : undefined;
        status.textContent = `${t('thanks.answerNotSent')} ${detail ?? t('thanks.tryAgainLater')}`;
      }
      button.disabled = false;
      status.focus();
    });
  }
</script>

<style>
  /* Raster, Kopf und Formular-Box kommen aus der Anfrage (.inquiry, .ask in InquiryFormStyles.astro); hier nur die Danke-Teile */
  .thanks :global(.thanks-chopper) { max-width: 24rem; margin-top: calc(-1 * var(--space-4)); }
  .thanks-q { padding: 0; margin: 0 0 var(--space-4); font: 500 var(--text-lead)/1.4 var(--display); color: var(--text); text-wrap: balance; }
  /* Neutral oder bestätigt (data-sent): beide Fassungen in derselben Rasterzelle, die andere unsichtbar */
  .thanks-lead { display: grid; }
  .thanks-lead > span { grid-area: 1 / 1; }
  .thanks[data-sent] .thanks-lead:has(.is-sent) .is-neutral, .thanks:not([data-sent]) .is-sent { visibility: hidden; }
  /* Rechte Box: nach dem Versand die Herkunftsfrage, direkt aufgerufen der Weg zur Anfrage */
  .thanks:not([data-sent]) [data-source-form], .thanks[data-sent] .thanks-direct { display: none; }
  .thanks-direct .thanks-q { margin: 0; }
  .thanks .step:not(:has([data-other]:checked)) [data-source-other] { display: none; }
  .thanks [data-source-other] { animation: opt-in var(--dur-enter) var(--ease-enter); }
  .thanks .form-status:empty { display: none; }
  .thanks .form-status { margin: 0; font-size: var(--text-lead); color: var(--text); }
  /* Erfolgszustand nur per Skript nach bestätigtem `sent` */
  .thanks-done { display: none; }
  .ask.is-done .thanks-done { display: block; animation: opt-in var(--dur-enter) var(--ease-enter); }
  :global(html.motion-paused) .ask.is-done .thanks-done, :global(html.motion-paused) .thanks [data-source-other] { animation: none; }
  .ask.is-done :is(.step, [data-source-status]) { display: none; }
  @media (--grid-stacked) { .thanks :global(.thanks-chopper) { margin-inline: auto; } }
</style>
