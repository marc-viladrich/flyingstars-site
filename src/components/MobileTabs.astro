---
// Reiter für Vergleiche auf dem Handy (Marc, 02.11.2026: „den Tab-Component on mobile … auch für alle anderen Bereiche,
// in denen wir vergleichen“). Ein Mechanismus für alle: Der Container trägt data-mtabs, darin stehen diese Reiter als
// direktes Kind und beliebig tief die Tafeln mit data-mtab="<index>". Bis 700 px Breite ist nur die Tafel des gewählten
// Reiters sichtbar; darüber sind die Reiter unsichtbar und alles bleibt, wie es ist. Reine Radiogruppe, funktioniert ohne
// JS. Regeln in global.css („Reiter auf dem Handy“), bis zu vier Reiter.
interface Tab { label: string; color?: string; featured?: boolean }
interface Props { name: string; label: string; tabs: Tab[]; initial?: number }
const { name, label, tabs, initial = 0 } = Astro.props;
---
<div class="mtabs" data-sticky-strip role="radiogroup" aria-label={label} style={`--n: ${tabs.length}`}>
  {tabs.map((t, i) => <label class:list={{ us: t.featured }} style={t.color ? `--c: ${t.color}` : undefined}><input type="radio" name={name} value={i} checked={i === initial} /><span>{t.label}</span></label>)}
</div>
<script>
  // Reiterwechsel lässt die Seite stehen (Marc, 03.11.2026: „nicht an den Anfang der Tabelle springen, sondern einfach da
  // bleiben“): Wer schnell hin und her tippt, vergleicht dieselbe Zeile. Beim Umschalten verschwinden Spalten, an denen
  // der Browser seine Scroll-Verankerung festhält; deshalb die Position vor dem Wechsel merken und danach zurücksetzen.
  document.querySelectorAll<HTMLElement>('.mtabs').forEach((tabs) => {
    // Chromium scrollt beim Fokussieren eines Radios im klebenden Streifen zu dessen Ruheposition (bis zu 370 px,
    // gemessen 03.11.2026). Deshalb wählt ein Tippen auf das Label selbst und fokussiert ohne Scrollen.
    tabs.addEventListener('click', (e) => {
      const label = (e.target as HTMLElement).closest('label'), input = label?.querySelector('input');
      if (!input || e.target === input) return;
      e.preventDefault();
      if (!input.checked) { input.checked = true; input.dispatchEvent(new Event('change', { bubbles: true })); }
      input.focus({ preventScroll: true });
    });
    let y = 0;
    tabs.addEventListener('pointerdown', () => { y = scrollY; });
    tabs.addEventListener('keydown', () => { y = scrollY; });
    tabs.addEventListener('change', () => requestAnimationFrame(() => { if (scrollY !== y) scrollTo({ top: y, behavior: 'instant' }); }));
  });
</script>
