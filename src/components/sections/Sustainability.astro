---
import {localeFromPath} from '../../lib/localized-routes';
const locale = Astro.props.locale ?? Astro.props._locale ?? localeFromPath(Astro.url.pathname);
import InlineText from '../InlineText.astro';
import {inlinePlain} from '../../lib/inline-text';
import {resolveMedia} from '../../lib/content';
import {sectionField,sectionBlock,sectionMedia,listItem,markers} from "../../lib/editor-markers";
import type { Section } from '../../content.config';
import { optimizedImage } from '../../lib/media';
type Props = Extract<Section, { type: 'sustainability' }> & { index: number; locale?:string; _locale?:string };
const { headline, lines, text, kicker, id = 'nachhaltigkeit', facts, proofImage, proofText, campaign, index } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
const media = await optimizedImage(resolveMedia(proofImage,locale).src, 360);
---
<section {...sectionBlock(Astro.props)} class="eco-sec" id={id} aria-labelledby={headingId}>
  <div class="eco-head"><div>{kicker && <span class="kicker mono" {...sectionField(Astro.props,["kicker"])}>{kicker}</span>}<H id={headingId} aria-label={inlinePlain(headline)} class="eco-title" data-reveal-group>{lines.map((line,i) => <span {...markers(sectionField(Astro.props,["lines",i]), listItem(Astro.props,{entry:["lines",i]}))} data-reveal style={`--i:${i}`}><InlineText value={line} /></span>)}</H></div><p {...sectionField(Astro.props,["text"])}>{text}</p></div>
  <div class="eco-scrolly" data-scrolly><div class="eco-pin">
    <canvas class="eco-canvas" aria-hidden="true"></canvas>
    <div class="eco-facts">{facts.map((fact,i) => <div class="fact" {...listItem(Astro.props,{entry:["facts",i]})}><span class="fk mono">{String(i+1).padStart(2,'0')} · <span {...sectionField(Astro.props,["facts",i,"label"])}><InlineText value={fact.label} /></span></span><b class:list={['fn',fact.tone]}>{fact.tone==='g' ? <span {...sectionField(Astro.props,["facts",i,"value"])} data-to={fact.value===inlinePlain(fact.value)?inlinePlain(fact.value):undefined}><InlineText value={fact.value} /></span> : <span {...sectionField(Astro.props,["facts",i,"value"])}><InlineText value={fact.value} /></span>}{fact.unit && <small {...sectionField(Astro.props,["facts",i,"unit"])}>{fact.unit}</small>}</b><p {...sectionField(Astro.props,["facts",i,"text"])}>{fact.text}</p></div>)}</div>
    <ol class="eco-steps mono" aria-hidden="true">{facts.map((fact,i) => <li style={`--k:${i}`} {...markers(sectionField(Astro.props,["facts",i,"label"]), listItem(Astro.props,{entry:["facts",i]}))}><InlineText value={fact.label} /></li>)}</ol>
  </div></div>
  <div class="eco-proof"><img {...sectionMedia(Astro.props,["proofImage"])} data-media-single="logo-proof" src={media.src} width={media.width} height={media.height} alt={resolveMedia(proofImage,locale).alt} loading="lazy" /><p><span {...sectionField(Astro.props,["proofText"])}>{proofText}</span> <b>#Böllerciao:</b> <span {...sectionField(Astro.props,["campaign"])}>{campaign}</span></p></div>
</section>
