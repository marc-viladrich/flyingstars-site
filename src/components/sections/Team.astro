---
import Chopper from '../Chopper.astro';
import {teamMember} from '../../content/people.mjs';
import {field} from 'astro-frontend-editor/markers';
import { forPath } from '../../i18n/server';
const { localHref, locale } = forPath(Astro.url.pathname);
// Team: große Porträts mit Vorhang-Reveal (CSS, html.reveal) und Lichtpunkt-Hover; kein Foto-Zoom. Ohne Porträt stehen
// nur die Initialen da, kein sichtbarer Platzhalter wie „Foto folgt“ (17.11.2026).
import type { Section } from '../../content.config';
import { optimizedImage } from '../../lib/media';
import Accent from '../Accent.astro';
import SectionHead from '../SectionHead.astro';
type Props = Extract<Section, { type: 'team' }> & { index: number };
const { headline, text, members, memberTexts = [], note, cta, secondary, id = `s${Astro.props.index}`, index, kicker } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
const Name = index === 0 ? 'h2' : 'h3';
const initials = (name: string) => name.trim().split(/\s+/).filter((_,i,a)=>i===0||i===a.length-1).map(part=>part[0]).join('').toUpperCase();
// Spalten ohne Waisen: bis 5 Karten in einer Reihe, 6 → 3 × 2, sonst 4 oder 3, je nachdem, was aufgeht
const n = members.length;
const cols = n <= 5 ? n : n % 4 === 0 ? 4 : n % 3 === 0 ? 3 : 4;
// Seitenspezifische Rolle/Bio (memberTexts) gehen vor; dann zeigt der Editor-Marker auf die Seite statt auf die Person.
const own = (personId: string) => memberTexts.find((entry) => entry.personId === personId);
const crew = await Promise.all(members.map(async item => {const member=teamMember(item,undefined,locale);const page=own(item.personId);return {...member, role: page?.role ?? member.role, bio: page?.bio ?? member.bio, ownRole: Boolean(page?.role), ownBio: Boolean(page?.bio), media: member.image ? await optimizedImage(member.image.src, 640) : undefined};}));
---
<section class="team-sec" id={id} aria-labelledby={headingId}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={headingId} level={H} />
  <ul class="crew" style={`--cols:${cols}`} aria-labelledby={headingId} data-crew>{crew.map((member,i) => <li class="member" style={`--i:${i}`} data-dot-host>
    <div {...field({collection:"people",id:member.personId},["image"],{mode:"panel"})} class="portrait" data-dot-img={member.media ? '' : undefined} data-step="6">{member.image && member.media ? <img src={member.media.src} width={member.media.width} height={member.media.height} alt={member.image.alt} loading="lazy" decoding="async" /> : member.personId === "chopper" ? <Chopper mood="happy" class="portrait-chopper" /> : <span class="ini" aria-hidden="true">{initials(member.name)}</span>}</div>
    <span {...(member.ownRole ? {} : field({collection:"people",id:member.personId},["role",locale]))} class="role mono">{member.role}</span><Name {...field({collection:"people",id:member.personId},["name"])}>{member.name}</Name>{member.bio && <p {...(member.ownBio ? {} : field({collection:"people",id:member.personId},["bio",locale]))}>{member.bio}</p>}
  </li>)}</ul>
  {(note || cta || secondary) && <p class="crew-note">{note && <span>{note}</span>}{(cta || secondary) && <span class="crew-links">{cta && <a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a>}{secondary && <a class="link" href={localHref(secondary.href)}>{secondary.label} <span aria-hidden="true">→</span></a>}</span>}</p>}
</section>

<style>
  /* Team: Porträts steigen nacheinander auf und öffnen sich wie ein Vorhang. Der Porträtrahmen selbst (.portrait) ist
     geteilt und liegt in global.css; hier Abschnitt, Reihe, Karten und ihr Auftritt (aus global.css hierher, Audit 4, C2).
     Der Lichtschein setzt erst unter der Kante ein: oben steht die reine Fläche, aus der der Punktübergang ausläuft (himmel.css) */
  .team-sec { padding: var(--section) var(--gutter); background: linear-gradient(var(--media-ground), transparent var(--section)), radial-gradient(70% 45% at 50% 0%, rgb(var(--rgb-logo-orchid) / 0.07), transparent 70%), var(--media-ground); }
  .crew { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--cols, 5), minmax(0, 1fr)); gap: clamp(var(--space-3), 1.6vw, var(--space-5-5)); }
  /* Touch: Lichtpunkt-Reveal statt Vorhang (dotimage.js); steht vor dem Vorhang, die Reihenfolge entspricht dem Stand vor dem Umzug */
  @media (hover: none), (pointer: coarse) {
    :global(.reveal) .member .portrait[data-dot-img], :global(.reveal) .member .portrait[data-dot-img] img { clip-path: none; transform: none; transition: none; }
  }
  /* Die Karte selbst wird beobachtet und darf deshalb nicht verschoben sein (Marc, 03.11.2026: „greift viel zu spät“);
     nur die Kinder bewegen sich */
  .member { display: grid; gap: var(--space-2-5); align-content: start; transition: opacity var(--dur-fade) var(--ease-default); transition-delay: calc(var(--i, 0) * var(--dur-stagger)); }
  .member > * { transition: transform var(--dur-reveal) var(--ease-curtain); transition-delay: calc(var(--i, 0) * var(--dur-stagger)); }
  :global(.reveal) .member:not(.is-in) { opacity: 0; }
  :global(.reveal) .member:not(.is-in) > * { transform: translateY(var(--reveal-member-offset)); }
  :global(.reveal) .member:not(.is-in) .portrait { clip-path: inset(100% 0 0 0 round 1rem); }
  :global(.reveal) .member:not(.is-in) .portrait img { transform: scale(1.28); }
  /* nach dem Auftritt reagieren Hover ohne Verzögerung; kein Foto-Zoom, die Lichtpunkte übernehmen */
  .member.shown, .member.shown > *, .member.shown .portrait img { transition-delay: 0s; }
  .portrait .ini { position: absolute; inset: 0; display: grid; place-items: center; font: 700 clamp(5.25rem, 9.5vw, 10rem)/1 var(--display); letter-spacing: -0.05em; color: transparent; -webkit-text-stroke: 1.5px var(--ink-subtle); background: var(--outline-ground); }
  /* Chopper hat kein Porträtfoto: seine Karte zeigt ihn als Leuchtpunkt-Figur (Runde 4) */
  .portrait :global(.portrait-chopper) { position: absolute; inset: 0; margin: auto; width: 100%; height: auto; }
  .member .role { color: var(--amber); }
  .member h3 { font-size: var(--text-lg); width: fit-content; padding-bottom: var(--space-0-5); }
  .member p { color: var(--muted); font-size: var(--text-sm); }
  .crew-note { margin-top: clamp(var(--space-6-5), 4vw, var(--space-10)); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3-5) var(--space-7); padding-top: var(--space-5-5); border-top: 1px solid var(--line); color: var(--muted); }
  .crew-links { display: flex; flex-wrap: wrap; gap: var(--space-3-5) var(--space-7); }
  @media (--grid-stacked) {
    /* drei Spalten; fünf Personen ließen rechts unten ein Loch. Eine unvollständige letzte Reihe steht mittig (sechs halbe
       Spalten, jede Karte belegt zwei) */
    .crew { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .crew .member { grid-column: span 2; }
    .crew .member:nth-child(3n + 1):nth-last-child(2) { grid-column: 2 / span 2; }
    .crew .member:nth-child(3n + 1):last-child { grid-column: 3 / span 2; }
  }
  /* Handy (Marc, 19.11.2026: keine endlosen Scrollstrecken): eine wischbare Reihe statt untereinander gestapelter Karten.
     Die Reihe läuft bis an die Bildschirmkanten, die erste Karte steht an der Content-Kante, die nächste ist angeschnitten.
     overflow-y: hidden (Marc, 21.11.2026: „alle Slider sollten nur horizontally draggable sein“): Karten außerhalb des Bildes
     warten noch auf ihr Einblenden und stehen 24 px tiefer; mit overflow-y: auto ließ sich die Reihe dadurch hochschieben.
     Wächter: scripts/slider-axis.test.mjs */
  @media (--compact) {
    .crew { display: flex; gap: var(--space-3); margin-inline: calc(-1 * var(--pad)); padding-inline: var(--pad); scroll-padding-inline: var(--pad); overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .crew::-webkit-scrollbar { display: none; }
    .crew:focus-visible { outline: var(--focus-width, 2px) solid var(--cyan); outline-offset: -0.125rem; }
    .crew .member { flex: 0 0 min(15.5rem, 72%); scroll-snap-align: start; }
  }
  @media (prefers-reduced-motion: reduce) { .member { transition: none; } }
</style>
