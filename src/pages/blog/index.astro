---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('de-DE', { dateStyle: 'long' });
---
<Base title="Blog" description="Alle Beiträge in chronologischer Reihenfolge, neueste zuerst. Hintergründe, Projekte und Einblicke.">
  <section class="section" aria-labelledby="blog-h">
    <div class="sec-head"><h1 id="blog-h">Blog</h1><p>Hintergründe zu Shows, Technik und Genehmigungen. Neueste Beiträge zuerst.</p></div>
    <ul class="post-list" role="list">
      {posts.map((p) => (
        <li class="post">
          <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
          <h2><a href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
