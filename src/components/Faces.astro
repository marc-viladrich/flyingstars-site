---
// Kleine runde Porträts (Anfrage, FAQ-Abschluss); beim Hovern werden sie zu Lichtpunkten.
import { optimizedImage } from '../lib/media';
import {field} from 'astro-frontend-editor/markers';
import { FOUNDERS, person } from '../content/people.mjs';
interface Props { people?: string[] }
const people = Astro.props.people?.length ? Astro.props.people.map(id=>person(id)) : FOUNDERS;
const faces = await Promise.all(people.map(async (p) => ({ ...p, img: await optimizedImage(p.image.src, 160) })));
---
<ul class="faces" aria-label={`Ansprechpartner:innen: ${people.map((p) => p.name).join(', ')}`}>
  {faces.map((f) => <li {...(f.id?field({collection:"people",id:f.id},[],{mode:"panel"}):{})} class="face" data-dot-img data-step="4"><img src={f.img.src} width={f.img.width} height={f.img.height} alt="" loading="lazy" decoding="async" /></li>)}
</ul>
