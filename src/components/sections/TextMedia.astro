---
import Picture from '../Picture.astro';
import { marked } from 'marked';
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'textMedia' }> & { index: number };
const { headline, body, image, mediaSide, index } = Astro.props;
const id = `s${index}-h`;
const H = index === 0 ? 'h1' : 'h2';
const html = await marked.parse(body);
---
<section class="section" aria-labelledby={id}>
  <div class:list={[{ 'grid-2': image, 'grid-2--media-left': image && mediaSide === 'left' }]}>
    <div class="prose">
      <H id={id}>{headline}</H>
      <Fragment set:html={html} />
    </div>
    {image && <Picture {...image} />}
  </div>
</section>
