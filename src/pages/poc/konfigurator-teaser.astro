---
// Prüfseite der sechzehnten Konfigurator-Fassung (31.10.2026, nicht verlinkt, noindex): oben der volle Konfigurator als
// Komponente im Seitenfluss (wie auf der Preisseite), darunter der Teaser für die Startseite in einer Section mit Kopf
// (wie ihn die Startseite drumherum baut). Seit der Showreel-Fassung spielt der Teaser sich selbst ab. Auf echten Seiten
// steht nie beides zusammen.
import Base from '../../layouts/Base.astro';
import ShowConfigurator from '../../components/configurator/ShowConfigurator.astro';
import ConfiguratorTeaser from '../../components/configurator/ConfiguratorTeaser.astro';
---
<Base title="Konfigurator und Teaser (Prüfseite)" description="Prüfseite: Show-Konfigurator als Komponente und der minimal interaktive Teaser für die Startseite." noindex fullBleed>
  <ShowConfigurator id="konfigurator" headingLevel={1} />
  <section class="section" id="teaser" aria-labelledby="teaser-h">
    <h2 id="teaser-h" class="poc-teaser-h">Eure Show, <span class="grad">live</span> ausprobiert.</h2>
    <ConfiguratorTeaser />
  </section>
  <!-- Runde 9: die Abläufe für die Landingpages (LandingTeaser.astro bindet sie mit reel="marke" bzw. "hochzeit" ein) -->
  <section class="section" id="teaser-marke" aria-labelledby="teaser-marke-h">
    <h2 id="teaser-marke-h" class="poc-teaser-h">Ablauf „marke“</h2>
    <ConfiguratorTeaser id="cft-marke" reel="marke" />
  </section>
  <section class="section" id="teaser-hochzeit" aria-labelledby="teaser-hochzeit-h">
    <h2 id="teaser-hochzeit-h" class="poc-teaser-h">Ablauf „hochzeit“</h2>
    <ConfiguratorTeaser id="cft-hochzeit" reel="hochzeit" />
  </section>
</Base>

<style>
  .poc-teaser-h { margin: 0 0 clamp(1.5rem, 3vw, 2.5rem); font-size: clamp(1.875rem, 3.4vw, 3.25rem); line-height: 1.04; letter-spacing: -0.03em; }
</style>
