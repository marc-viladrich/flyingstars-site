---
import variants from '../../../data/video-lab.json';
import '../../../styles/fonts.css';
const videos=variants.filter(v=>v.id.startsWith('cut15d-'));
---
<!doctype html><html lang="de"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Großer Videovergleich | FlyingStars</title></head><body>
<main tabindex="-1" id="comparison-stage" data-mode="single" data-fit="cover">
 <h1 class="sr">Showreel-Fassungen in großer Darstellung vergleichen</h1>
 <div class="films" id="stage-films"></div>
 <div class="top"><a href="/poc/video-lab/">← Übersicht</a><a href="/media/video-lab/original-v1.mp4" target="_blank" rel="noopener">Originaldatei · 25,88 s</a><span id="stage-name">15,16s-Schnitt · Vergleich vorbereiten</span><button type="button" id="stage-fullscreen">Vollbild</button></div>
 <div class="welcome" id="stage-welcome"><h2>In Hero-Größe vergleichen</h2><p>Die Filme füllen die Browserhöhe. Wechsle mit 1–4 oder den Pfeiltasten bei gleicher Position zwischen Referenz, 1600, 1440 und 1280 px. „Nebeneinander“ zeigt zwei Fassungen auf voller Höhe.</p><button type="button" id="stage-load">Vier Fassungen laden und starten</button><p id="stage-budget"></p></div>
 <div class="controls" id="stage-controls">
  <div class="variants" role="group" aria-label="Fassung wählen"><button type="button" data-index="0" aria-pressed="true">1 · Referenz</button><button type="button" data-index="1" aria-pressed="false">2 · 1600 px</button><button type="button" data-index="2" aria-pressed="false">3 · 1440 px</button><button type="button" data-index="3" aria-pressed="false">4 · 1280 px</button></div>
  <div class="tools"><button type="button" id="stage-play" disabled>Abspielen</button><label>Codec <select id="stage-codec"><option value="h264">H.264</option><option value="av1">AV1 manuell vergleichen</option></select></label><label>Ansicht <select id="stage-mode"><option value="single">A/B umschalten · volle Fläche</option><option value="pair">Nebeneinander · je halbe Breite</option></select></label><label>Bild <select id="stage-fit"><option value="cover">Hero-Beschnitt · volle Höhe</option><option value="contain">Ganzes Bild · ohne Beschnitt</option></select></label><button type="button" id="stage-hide">Bedienung ausblenden · H</button></div>
  <label class="timeline" for="stage-time">Position <output id="stage-time-label">0,0 s</output><input id="stage-time" type="range" min="0" max="15.12" step="0.04" value="0" disabled/></label>
  <p id="stage-status" role="status">Noch kein Video geladen. Die Referenz ist derselbe 15,16s-Schnitt in hoher H.264-Qualität. Die unveränderte Originaldatei mit 25,88 s findest du in der Übersicht.</p>
 </div>
 <div class="labels" aria-hidden="true"><span>Referenz · 15,16 s</span><span id="stage-pair-name"></span></div>
</main>
<script type="application/json" id="stage-data" set:html={JSON.stringify(videos).replace(/</g,'\\u003c')}></script><script>import '../../../scripts/video-lab-stage';</script>
</body></html>
<style>
:global(html),:global(body){margin:0;background:#050506;color:#f6f1e8;font:400 1rem/1.5 Inter,system-ui,sans-serif;color-scheme:dark}*{box-sizing:border-box}#comparison-stage{position:relative;min-height:100svh;height:100svh;overflow:hidden;background:#050506}.films{position:absolute;inset:0}.films :global(video){position:absolute;inset:0;width:100%;height:100%;object-fit:cover;visibility:hidden}.films :global(video[data-active]){visibility:visible}#comparison-stage[data-mode=pair] .films :global(video[data-reference]){visibility:visible;right:auto;width:50%}#comparison-stage[data-mode=pair] .films :global(video[data-active]:not([data-reference])){left:50%;width:50%}#comparison-stage[data-fit=contain] .films :global(video){object-fit:contain}.top{position:absolute;z-index:3;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.75rem 1rem;background:linear-gradient(#050506e8,#05050600);font-size:.875rem}.top a{color:inherit}.top span{font-family:'Space Grotesk',sans-serif;text-align:center}.welcome{position:absolute;z-index:2;left:50%;top:42%;transform:translate(-50%,-50%);width:min(40rem,calc(100% - 2rem));padding:1.5rem;background:#151311ed;border:1px solid #665e55;border-radius:.5rem}.welcome h2{font-family:'Space Grotesk',sans-serif;margin:0 0 .75rem;font-size:1.8rem}.welcome p{color:#d2c8bb}.welcome[hidden]{display:none}.controls{position:absolute;z-index:4;bottom:0;left:0;right:0;padding:.75rem 1rem;background:#0f0d0cf2;border-top:1px solid #5c5349;transition:opacity .15s}.variants,.tools{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}.variants{margin-bottom:.5rem}button,select{font:inherit;color:inherit;background:#1c1915;border:1px solid #817363;border-radius:.3rem;padding:.45rem .7rem;cursor:pointer}button:hover{background:#31291f}button[aria-pressed=true]{border-color:#ffb45e;background:#4b2d12;color:#fff}button:disabled{opacity:.5;cursor:default}button:focus-visible,select:focus-visible,input:focus-visible,a:focus-visible{outline:.1875rem solid #33edf2;outline-offset:.1875rem}.tools{font-size:.8125rem}.tools label{display:flex;align-items:center;gap:.4rem}.timeline{display:flex;gap:.7rem;align-items:center;font-size:.8125rem;margin-top:.5rem}.timeline input{flex:1;min-width:0;accent-color:#ffb45e}.timeline output{font-variant-numeric:tabular-nums;white-space:nowrap}#stage-status{font-size:.75rem;color:#d2c8bb;margin:.4rem 0 0}.labels{display:none;position:absolute;z-index:2;left:0;right:0;top:4rem;grid-template-columns:1fr 1fr;font:500 .8125rem 'Space Grotesk',sans-serif;pointer-events:none}.labels span{justify-self:center;padding:.25rem .6rem;background:#000a;border-radius:.3rem}#comparison-stage[data-mode=pair] .labels{display:grid}.quiet .controls,.quiet .top,.quiet .labels{opacity:0;pointer-events:none}.quiet .controls:focus-within{opacity:1;pointer-events:auto}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}@media(max-width:45em){.top{align-items:start}.top span{font-size:.75rem}.tools label{flex-wrap:wrap}.controls{padding:.6rem}.variants button{flex:1;padding:.5rem .2rem;font-size:.75rem}.tools{gap:.4rem}.tools select{max-width:14rem}.welcome{top:30%;padding:1rem}.welcome h2{font-size:1.5rem}#stage-status{max-height:3rem;overflow:auto}}
</style>
