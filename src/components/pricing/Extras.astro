---
import Styles from '../Styles.astro';
import ownerStyle0 from './Extras.css?url';
import {field} from 'astro-frontend-editor/markers';
import { forPath } from '../../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
// Extras zum Auswählen (Marc, 01.11.2026): offenes Raster ohne Kartenfläche, nur feine Linien zwischen den Zellen. Eine
// Zelle ist als Ganzes klickbar (die Beschriftung des Kontrollkästchens deckt sie ab); gewählt bekommt sie eine Fläche und
// ein gefülltes Kästchen in Orange. Sobald etwas gewählt ist, erscheint unten eine Leiste mit der Auswahl und dem Knopf
// „Show mit diesen Extras anfragen“; er führt mit ?extras=<id>,… zum Anfrageformular, das die Extras dort vorbelegt.
// Der Knopf im Show-Konfigurator nimmt die Auswahl ebenfalls mit. Ohne JavaScript bleibt es ein Raster zum Lesen.
import Icon from '../Icon.astro';
import IconFeature from '../IconFeature.astro';
import SectionHead from '../SectionHead.astro';
import { getPackageDetails } from '../../content/package-details';
const { EXTRAS } = getPackageDetails(forPath(Astro.url.pathname).locale);
---
<Styles href={ownerStyle0} id="components/pricing/Extras.css" />
<section class="section alt" id="zusaetze" aria-labelledby="zusaetze-h">
  <SectionHead kicker={t('extras.extrasUpgrades')} headline={t('extras.roomForMore')} text={t('extras.chooseTheExtrasYouDLikeTheyGoStraightInto')} id="zusaetze-h" />
  <div class="ig xg" data-extras>
    {EXTRAS.map((x) => (
      <IconFeature class="ic xc" icon={x.icon} iconClass="xc-ico" title={x.title} text={x.text} textId={`x-${x.id}-t`}>
        <input slot="before" class="xc-box" type="checkbox" id={`x-${x.id}`} value={x.id} data-short={x.short} aria-describedby={`x-${x.id}-t x-${x.id}-p`} />
        <label slot="title" for={`x-${x.id}`}>{x.title}</label>
        <span class="xc-price mono" {...(['film','schweiz','indoor'].includes(x.id)?field({collection:'showExtras',id:'configuration'},[x.id,'price','amount'],{mode:'panel'}):{})} id={`x-${x.id}-p`}>{x.price}</span>
        <span class="xc-added mono" aria-hidden="true"><Icon name="check" size={14} strokeWidth={2.4} />{t('extras.addedToEnquiry')}</span>
        {x.link && <a class="link xc-link" href={localHref(x.link.href)}>{x.link.label} <span aria-hidden="true">→</span></a>}
      </IconFeature>
    ))}
  </div>
  <div class="xbar" data-extras-bar inert>
    <p class="xbar-t" role="status"><span data-extras-sum></span></p>
    <a class="btn primary" href={localHref("/#anfrage")} data-extras-cta>{t('extras.requestAShowWithTheseExtras')}</a>
  </div>
</section>



<script>
  import {inquiryHref} from '../../content/inquiry.mjs';
  import { t } from '../../i18n/ui.mjs';
  import { localeFromPath } from '../../i18n/routing.mjs';
  const grid = document.querySelector<HTMLElement>('[data-extras]');
  const bar = document.querySelector<HTMLElement>('[data-extras-bar]');
  if (grid && bar) {
    const boxes = [...grid.querySelectorAll<HTMLInputElement>('.xc-box')];
    const sum = bar.querySelector<HTMLElement>('[data-extras-sum]')!;
    const cta = bar.querySelector<HTMLAnchorElement>('[data-extras-cta]')!;
    const chosen = () => boxes.filter((b) => b.checked);
    // Anfrage-Link mit den gewählten Extras; Indoor setzt zusätzlich den Anlass
    const withExtras = (href: string) => {
      const ids = chosen().map((b) => b.value);
      return inquiryHref({extras:ids,...ids.includes('indoor')?{anlass:'indoor'}:{}},localeFromPath(location.pathname),href,location.origin);
    };
    const sync = () => {
      const list = chosen();
      bar.classList.toggle('on', list.length > 0);
      bar.inert = list.length === 0;
      // Text nur über textContent und b-Elemente, nie als HTML aus Daten
      sum.replaceChildren();
      if (list.length) {
        const count = document.createElement('b');
        count.textContent = list.length === 1 ? t('extras.1Extra') : t('pricing.extrasCount', { count: list.length });
        sum.append(count, t('pricing.extrasSummary', { list: list.map((b) => b.dataset.short).join(', ') }));
      }
      cta.href = withExtras('/#anfrage');
    };
    boxes.forEach((b) => b.addEventListener('change', sync));
    sync();
    // Der Knopf des Show-Konfigurators auf derselben Seite nimmt die Auswahl mit
    document.querySelectorAll<HTMLAnchorElement>('#cfg-cta, #cfg-bar-cta').forEach((link) => link.addEventListener('click', () => {
      if (chosen().length) link.href = withExtras(link.href);
    }));
  }
</script>
