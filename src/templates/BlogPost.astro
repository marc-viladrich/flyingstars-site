---
import {body,field} from 'astro-frontend-editor/markers';
import { localizedCollection } from '../i18n/content';
import { forPath } from '../i18n/server';
const { t, localHref, formatLocale } = forPath(Astro.url.pathname);
import { localeFromPath } from '../i18n/routing.mjs';
const locale = localeFromPath(Astro.url.pathname);
// Blogartikel auf Seitenniveau (Marc, 31.10.2026, Runde 8): Kicker mit Thema, Titel, Autor mit Foto, Datum und Lesezeit,
// Titelbild mit Vorhang, lesbare Spalte (rund 68 Zeichen), am Ende Autor, Anfrage und zwei weitere Beiträge.
// Der Artikeltext bleibt wörtlich wie auf flyingstars.art (Import 31.10.2026), Moritz überarbeitet ihn später.
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cta from '../components/sections/Cta.astro';
import PostGrid from '../components/blog/PostGrid.astro';
import SectionHead from '../components/SectionHead.astro';
import { optimizedImage } from '../lib/media';
import { authorOf, dateOf, readingMinutes, topicOf, sortPosts } from '../components/blog/post-meta';
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const AUTHOR=authorOf(post);
const { Content } = await render(post);
const cover = post.data.cover ? await optimizedImage(post.data.cover.src, 1600) : undefined;
const face = await optimizedImage(AUTHOR.image.src, 160);
const more = sortPosts(await localizedCollection('posts', locale, p => !p.data.draft && p.id !== post.id)).slice(0, 3);
const updated = post.data.updated && post.data.updated.valueOf() !== post.data.date.valueOf() ? new Intl.DateTimeFormat(formatLocale, { dateStyle: 'long' }).format(post.data.updated) : undefined;
---
<Base title={post.data.title} description={post.data.description} image={post.data.cover?.src} navSection="/blog/">
  <article class="section post" aria-labelledby="post-h">
    <header class="post-head">
      <a class="kicker mono post-back" href={localHref("/blog/")}><span aria-hidden="true">←</span> Blog · {topicOf(post)}</a>
      <h1 id="post-h">{post.data.title}</h1>
      <div class="byline">
        <img class="face" src={face.src} width={face.width} height={face.height} alt="" loading="eager" decoding="async" />
        <p><b {...field({collection:"people",id:AUTHOR.id},["name"])}>{AUTHOR.name}</b> <span class="mono">{t(AUTHOR.roleKey)}</span></p>
        <p class="when"><time datetime={post.data.date.toISOString()}>{dateOf(post)}</time> · {readingMinutes(post)} {t('postcard.minRead')}{updated && <> · {t('blog.updated', { date: updated })}</>}</p>
      </div>
    </header>
    {cover && <figure class="post-cover" data-curtain><img src={cover.src} {...cover.attributes} width={cover.width} height={cover.height} alt={post.data.cover!.alt} loading="eager" decoding="async" fetchpriority="high" /></figure>}
    <div class="post-body" {...body(post)}><Content /></div>
    <aside class="post-author" aria-label={t('blogpost.aboutTheAuthor')}>
      <img class="face" src={face.src} width={face.width} height={face.height} alt={AUTHOR.name} loading="lazy" decoding="async" />
      <p><b {...field({collection:"people",id:AUTHOR.id},["name"])}>{AUTHOR.name}</b> {t('blogpost.runsFlyingstarsTogetherWithRonjaDonsbachAndErwinWilmsHe')} <a class="link" href={localHref("/ueber-uns/#team")}>{t('blogpost.theTeam')} <span aria-hidden="true">→</span></a></p>
    </aside>
  </article>
  <Cta type="cta" index={1} headline={t('blogpost.planningYourOwnShow')} text={t('blogpost.aDateLocationAndOccasionAreEnoughForAnInitial')} button={{ label: t('chopper404.requestAShow'), href: '/kontakt/' }} />
  {more.length > 0 && <section class="section post-more" aria-labelledby="more-h">
    <SectionHead kicker={t('blogpost.readOn')} headline={t('blogpost.moreFromTheBlog')} id="more-h" />
    <PostGrid posts={more} level="h3" />
  </section>}
</Base>

<style>
  .post { --measure: 42rem; display: grid; justify-items: center; padding-bottom: 0; }
  .post > * { width: 100%; }
  .post-head { max-width: var(--measure); display: grid; gap: 1.375rem; margin-bottom: clamp(2rem, 4vw, 3.25rem); }
  .post-head h1 { font-size: clamp(2.125rem, 4vw, 3.5rem); line-height: 1.04; }
  .post-back { width: fit-content; margin-bottom: 0; transition: color 0.2s; }
  .post-back:hover { color: #ffbe6b; }
  .byline { display: grid; grid-template-columns: auto 1fr; gap: 0.125rem 0.875rem; align-items: center; color: var(--muted); font-size: var(--text-control); }
  .byline .face { grid-row: span 2; }
  .byline b { color: var(--head); font-weight: 500; margin-right: 0.5rem; }
  .byline .mono { color: var(--faint); }
  .byline .when { color: var(--faint); font-size: var(--text-sm); }
  .face { width: 3rem; height: 3rem; border-radius: 50%; object-fit: cover; }

  .post-cover { max-width: 64rem; margin: 0 0 clamp(2.5rem, 5vw, 4rem); aspect-ratio: 2 / 1; overflow: hidden; border-radius: 1rem; background: #0a0908; --curtain-r: 1rem; }
  .post-cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1); }

  /* Lesespalte: Fließtext in Inter, Zwischentitel in Space Grotesk, Links und Listenpunkte in Orange */
  .post-body { max-width: var(--measure); font-size: var(--text-md); line-height: 1.72; color: #c9bfb0; }
  .post-body > :global(* + *) { margin-top: 1.1em; }
  .post-body :global(h2) { font-size: clamp(1.625rem, 2.4vw, 2.125rem); line-height: 1.12; margin-top: 1.6em; }
  .post-body :global(h3) { font-size: clamp(1.25rem, 1.7vw, 1.4375rem); line-height: 1.25; margin-top: 1.6em; }
  .post-body :global(:is(h2, h3) + *) { margin-top: 0.6em; }
  .post-body :global(strong) { color: var(--head); font-weight: 600; }
  .post-body :global(a) { color: var(--accent); border-bottom: 1px solid var(--accent-line); transition: border-color 0.2s, color 0.2s; }
  .post-body :global(a:hover) { color: #ffbe6b; border-color: var(--accent); }
  .post-body :global(:is(ul, ol)) { padding-left: 1.3em; margin-bottom: 0; }
  .post-body :global(li) { padding-left: 0.3em; }
  .post-body :global(li + li) { margin-top: 0.5em; }
  .post-body :global(li::marker) { color: var(--accent); }
  .post-body :global(ol > li::marker) { font: 500 0.95em var(--display); }
  .post-body :global(p:has(> img:only-child)) { margin-block: 2em; }
  .post-body :global(img) { width: 100%; height: auto; border-radius: 0.875rem; }
  .post-body :global(blockquote) { margin-inline: 0; padding-left: 1.25rem; border-left: 2px solid; border-image: var(--grad) 1; color: var(--head); }

  .post-author { max-width: var(--measure); display: grid; grid-template-columns: auto 1fr; gap: 1.125rem; align-items: start; margin-top: clamp(3rem, 6vw, 4.5rem); padding-top: 1.75rem; border-top: 1px solid var(--line); color: var(--muted); font-size: var(--text-control); }
  .post-author .face { width: 4rem; height: 4rem; }
  .post-author b { color: var(--head); font-weight: 500; }
  .post-author .link { margin-top: 0.625rem; display: flex; }
  .post-more { padding-top: 0; }

  @media (max-width: 45em) {
    .post-body { font-size: var(--text-copy); }
    .post-cover { border-radius: 0.75rem; --curtain-r: 0.75rem; }
  }
</style>
