---
import SustainabilityFolge from './SustainabilityFolge.astro';
import {field} from 'astro-frontend-editor/markers';
import {SUSTAINABILITY_PILLARS,localizedBlock} from '../../content/shared-blocks.mjs';
import {forPath} from '../../i18n/server';
const {locale,fact}=forPath(Astro.url.pathname);
// Startseite: die Scrollstory behält ihr Riesenformat (Marc, Runde 5: „Das Riesenformat bleibt der Scrollstory vorbehalten“);
// überall sonst steht ihr Kopf in der Hero-Stufe (Runde 9, Nachhaltigkeitsseite). Benannte Ausnahme im Wächter
// layout-audit.mjs head-size (.eco-head-xl).
const home = /^\/(?:en\/|nl\/)?$/.test(Astro.url.pathname);
import IconFeature from '../IconFeature.astro';
import SectionHead from '../SectionHead.astro';
import FactList from '../FactList.astro';
// Nachhaltigkeit als Scrollstory aus dem Vercel-Prototyp (Marc, 31.10.2026: „das Scrollytelling finde ich ganz nice,
// das kann bleiben“): Die Bühne bleibt stehen, vier Zahlen übernehmen nacheinander den Bildschirm, im Hintergrund fliegt
// die Flotte eine passende Figur (Schallwelle, Null, geparkte Flotte, Blitz). Ohne JS, bei reduzierter Bewegung und auf
// Wunsch pausiert: dieselben Zahlen als ruhige Liste. Aussagen nur über die Show vor Ort (EmpCo).
// Headline: jeder Satz eine Zeile, der letzte im Logoverlauf (gezielter Einsatz statt drei Titelschnitte).
import type { Section } from '../../content.config';
import { optimizedLogo } from '../../lib/media';
import Icon from '../Icon.astro';
import Chopper from '../Chopper.astro';
import ComparisonMatrix from '../ComparisonMatrix.astro';
const PICON = { eu: 'eu', repair: 'wrench', ev: 'e-car', campaign: 'megaphone', leaf: 'leaf', quiet: 'audio-waveform' } as const;
type Props = Extract<Section, { type: 'sustainability' }> & { index: number };
const { headline, text: source, id = 'nachhaltigkeit', facts = [], points = [], pillarsRef, proofImage, proofText, campaign, index, kicker, image, cta, icon, scene, show, gallery, comparison } = Astro.props;
// Fließtext darf freigegebene Faktenplatzhalter tragen (Indoor: Showdauer aus show-duration.json)
const text = source && fact(source);
import Picture from '../Picture.astro';
import Gallery from '../gallery/Gallery.astro';
import { accentParts, plain } from '../accent';
import { forPath as forPathLink } from '../../i18n/server';
const { localHref } = forPathLink(Astro.url.pathname);
const pillars=pillarsRef?localizedBlock(SUSTAINABILITY_PILLARS,locale).pillars:[];
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
const lines = headline.split(/(?<=\.\*?)\s+/).filter(Boolean);
// Ohne Markierung: letzte Zeile im Verlauf, bei drei Zeilen die mittlere als Kontur (wie im Prototyp). Mit *Markierung*
// (Moritz' Reihenfolge Knall, Müll, Rauch; DESIGN: „Kein Müll.“ im Verlauf) trägt die markierte Zeile den Verlauf,
// weitere Zeilen nach der ersten werden Kontur. Einzeilige Köpfe („Kinder und *Hunde* willkommen“) färben nur das Wort.
const marked = /\*[^*]+\*/.test(headline);
const whole = (line: string) => /^\*[^*]+\*$/.test(line.trim());
const lineClass = (line: string, i: number) => marked
  ? { grad: whole(line), o: lines.length > 2 && i > 0 && !whole(line) }
  : { grad: i === lines.length - 1 && lines.length > 1, o: lines.length > 2 && i === 1 };
// Figur der Scrollstory je Kennzahl nach Einheit, damit die Reihenfolge frei bleibt (Moritz: Knall, Müll, Rauch):
// ohne Einheit Schallwelle, g die Null, kg die geparkte Flotte („nichts bleibt zurück“), % der Blitz für den Strom.
const FIG: Record<string, number> = { g: 1, kg: 2, '%': 3 };
const figs = facts.map((fact, i) => fact.unit ? FIG[fact.unit.trim()] ?? i : 0).join(',');
// Mit Foto oder Icon-Kachel: Einleitung links, Bild rechts. Sonst wie im Prototyp: Einleitung schmal unter dem Titel,
// der Link direkt darunter.
const lead = Boolean(image || icon || scene || show || gallery);
// Bühne statt Bild (Indoor-Reihe, Chopper-Szene): Kopf, Text und Bühne in einem Grid, die Bühne spannt Kopf- und Textzeile
const staged = Boolean(scene || show);
// Startseite seit Runde 14 (Moritz: Nachhaltigkeit erwähnen, aber nicht so viel Raum; Marc: eine kompakte Section): statt der
// Scrollstory die Bühne mit den Figuren der Scrollstory (show: eco). Ein Kopf aus mehreren Sätzen behält dort die Zeilen-
// Logik der Scrollstory (jeder Satz eine Zeile, Kontur und Verlauf), in der normalen Größe einer Section-Überschrift.
const stagedLines = staged && lines.length > 1;
// Ohne Bild ab breitem Desktop: Schlagzeile links, Einleitung und Link rechts unten bündig
const split = Boolean(text) && lines.length > 1;
const parts = (point: string) => point.split(/(\S+-\S+)/).filter(Boolean);
const proof = proofImage ? await optimizedLogo(proofImage.src, 60) : undefined;
// Beleg-Logos gehören in ihre Folie (Marc, Runde 6: naturstrom an der Ökostrom-Zahl statt einer eigenen Box darunter);
// doppelte Pixeldichte, angezeigt in halber Größe
const factItems = await Promise.all(facts.map(async (fact) => {
  if (!fact.logo) return fact;
  const img = await optimizedLogo(fact.logo.src, 64);
  return { ...fact, logo: { src: img.src, width: img.width / 2, height: img.height / 2, alt: fact.logo.alt } };
}));
---
<section class="section alt eco-sec" id={id} aria-labelledby={headingId}>
  {/* Runde 5 (Marc, 18.11.2026): Das Riesenformat bleibt der Scrollstory vorbehalten (Startseite, Nachhaltigkeit). Mit
       Bild, Bühne, Szene oder Galerie („Feste feiern …“, „Faszinierend wie Feuerwerk …“, „Kinder und Hunde willkommen“)
       steht die normale Section-Überschrift mit Verlaufswort, enger an ihrem Bild. Ohne Bild ab breitem Desktop
       zweispaltig: Schlagzeile links, Einleitung und Link rechts unten bündig („weniger Whitespace, weniger Scrolling“). */}
  {staged || gallery ? null : lead
    ? <SectionHead class="eco-head-std" next="text" kicker={kicker} headline={headline} id={headingId} level={H} />
    : <SectionHead variant="display" class:list={['eco-head', { 'eco-split': split, 'eco-head-xl': home }]} titleClass="eco-title" revealTitle grouped={split} kicker={kicker} headline={plain(headline)} text={text} id={headingId} level={H}>
        <Fragment slot="title">{lines.map((line, i) => <span data-reveal style={`--i:${i}`} class:list={lineClass(line, i)}>{whole(line) ? plain(line) : accentParts(line).map((p) => p.g ? <span class="grad">{p.t}</span> : p.t)} </span>)}</Fragment>
        {cta && <p class="eco-more"><a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a></p>}
      </SectionHead>}
  {/* Galerie (Über uns): Einleitung links schmal, Bilder von Festen groß daneben */}
  {/* Kopf im Kopf-Platz der Galerie (Runde 9): bei zwei Leitern steigen die Bilder neben ihn, sonst steht er darüber;
       Kopf → Text und Kopf → Bilder setzt die Galerie mit den Kopfrollen */}
  {gallery && <Gallery set={gallery} class="eco-gallery"><SectionHead slot="head" next="text" kicker={kicker} headline={headline} id={headingId} level={H} /><div class="eco-lead-copy">
    {text && text.split(/\n\s*\n/).map((para) => <p>{para.trim()}</p>)}
    {cta && <p class="eco-more"><a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a></p>}
  </div></Gallery>}
  {staged && <div class="eco-staged">
    {stagedLines
      ? <SectionHead class:list={['eco-head-std eco-staged-head', { 'eco-head-xl': home }]} titleClass="eco-lines" next="text" kicker={kicker} headline={plain(headline)} id={headingId} level={H}>
          <Fragment slot="title">{lines.map((line, i) => <span class:list={lineClass(line, i)}>{whole(line) ? plain(line) : accentParts(line).map((p) => p.g ? <span class="grad">{p.t}</span> : p.t)} </span>)}</Fragment>
        </SectionHead>
      : <SectionHead class="eco-head-std eco-staged-head" next="text" kicker={kicker} headline={headline} id={headingId} level={H} />}
    <div class="eco-lead-copy">
      {text && text.split(/\n\s*\n/).map((para) => <p>{para.trim()}</p>)}
      {cta && <p class="eco-more"><a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a></p>}
    </div>
    {show ? <div class="eco-stage eco-show" data-folge={show} aria-hidden="true"><canvas></canvas></div> : <div class="eco-stage"><Chopper mood="play" /></div>}
  </div>}
  {lead && !gallery && !staged && <div class="eco-lead has-img">
    <div class="eco-lead-copy">
      {text && text.split(/\n\s*\n/).map((para) => <p>{para.trim()}</p>)}
      {cta && <p class="eco-more"><a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a></p>}
    </div>
    {image ? <figure class="eco-photo" data-curtain><Picture {...image} /></figure> : <div class="eco-photo eco-dots" aria-hidden="true"><Icon name={icon!} size={56} class="g" /></div>}
  </div>}
  {/* Vergleich direkt an der Aussage (Nachhaltigkeit, Runde 6): Kopf, Tabelle, dann die Scrollstory mit den Einzelheiten */}
  {comparison && <ComparisonMatrix label={plain(headline)} rowHeader={comparison.rowHeader} columns={comparison.columns} rows={comparison.rows} class="eco-compare" />}
  {facts.length > 0 && <div class="eco-scrolly" data-scrolly data-figs={figs}><div class="eco-pin">
    <canvas class="eco-canvas" aria-hidden="true"></canvas>
    <FactList items={factItems} variant="eco" />
    <ol class="eco-steps mono" aria-hidden="true">{facts.map((fact, i) => <li style={`--k:${i}`}>{fact.label}</li>)}</ol>
  </div></div>}
  {pillars.length > 0 && <ul {...field({collection:"sustainabilityPillars",id:"configuration"},[locale,"pillars"],{mode:"panel"})} class="eco-pillars">{pillars.map((p) => <IconFeature as="li" icon={PICON[p.icon]} title={p.title} text={p.text} />)}</ul>}
  {(points.length > 0 || campaign || proofText) && <div class="eco-proof">
    {proofImage && proof && <img src={proof.src} width={proof.width / 2} height={proof.height / 2} alt={proofImage.alt} loading="lazy" decoding="async" />}
    {points.length > 0 && <ul class="eco-points">{points.map((point) => <li><span>{parts(point.value).map((part) => part.includes('-') ? <span class="nowrap">{part}</span> : part)}</span></li>)}</ul>}
    {(proofText || campaign) && <p>{proofText}{campaign && <> <b>#Böllerciao:</b> {campaign}</>}</p>}
  </div>}
</section>
{show && <SustainabilityFolge />}
<script>
  import { whenNear } from '../../scripts/when-near.mjs';
  import { prepareEcoScrolly, resetEcoScrolly } from '../../scripts/effects/eco-scrolly-setup.mjs';
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    for (const el of document.querySelectorAll<HTMLElement>('[data-scrolly]')) {
      // Keep later anchors and document height stable while the engine is still deferred.
      prepareEcoScrolly(el);
      const load = whenNear(el, async () => {
        try {
          const { ecoScrolly } = await import('../../scripts/effects/eco-scrolly.js');
          ecoScrolly(el);
        } catch (error) {
          resetEcoScrolly(el); // The original fact list remains readable if the chunk fails.
          throw error;
        }
      });
      if (location.hash) void load().catch((error: unknown) => console.warn('Scrollstory could not load', error));
    }
  }
</script>

<style>
  /* Einleitung mit Foto (Startseite: #Böllerciao), Text links, Bild rechts; auf dem Handy untereinander */
  /* Einzelwort im Verlauf bleibt in der Zeile (global: .eco-title span ist sonst block) */
  :global(.eco-title [data-reveal] > .grad) { display: inline; }
  .eco-lead { display: grid; gap: clamp(var(--space-7), 4vw, var(--space-14)); margin: 0 0 clamp(var(--space-10), 6vw, var(--space-20)); }
  /* normale Section-Überschrift über Bild/Bühne/Galerie: darunter steht die Einleitung, also Überschrift → Text
     (Marc, Runde 7: „Der Abstand zwischen Heading und Bodycopy sollte einheitlich sein“; vorher --head-gap-content über
     .sec-head). Bild, Bühne und Galerie stehen daneben, die Galerie holt ihren Inhaltsabstand selbst nach (after="text"). */
  .eco-sec :global(.eco-head-std) { margin-bottom: var(--head-gap-text); }
  /* Scrollstory-Einstieg ab 1100 px zweispaltig: Schlagzeile links, Einleitung und Link als ein Block (SectionHead grouped)
     rechts, beide unten bündig; die Abstände im Block kommen aus den Kopfrollen */
  @media (--grid-expanded) {
    .eco-sec :global(.eco-split) { grid-template-columns: max-content minmax(0, 1fr); column-gap: clamp(var(--space-12), 7vw, var(--space-28)); align-items: end; }
  }
  .eco-lead.has-img { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; }
  .eco-sec :global(.eco-compare) { margin-bottom: var(--section); }
  /* Beleg-Logo in der Folie, gedämpft wie die Logoleisten */
  .eco-scrolly :global(.fact-logo) { display: block; height: 2rem; width: auto; margin-top: var(--space-5); opacity: 0.8; }
  .eco-lead-copy p { color: var(--muted); max-width: 44ch; margin: 0 0 var(--head-gap-text); font-size: var(--text-lead); }
  .eco-lead-copy .eco-more { margin-top: var(--head-gap-cta); }
  .eco-photo { margin: 0; border-radius: var(--radius); overflow: hidden; aspect-ratio: 16 / 9; --curtain-r: var(--radius); }
  .eco-photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* Ohne echtes Showfoto: Kachel mit Icon und Punktmuster wie die Aussage-Kachel (LandingBento, Werbung #agenturen) */
  .eco-dots { position: relative; display: grid; place-items: center; background: var(--surface-2); border: 1px solid var(--line); }
  .eco-dots::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(circle, rgb(var(--rgb-amber) / 0.5) 0.0625rem, transparent 0.1rem); background-size: 1.375rem 1.375rem; -webkit-mask-image: radial-gradient(120% 90% at 100% 0%, #000, transparent 62%); mask-image: radial-gradient(120% 90% at 100% 0%, #000, transparent 62%); opacity: 0.55; pointer-events: none; }
  .eco-dots :global(.ico) { position: relative; width: 3.5rem; height: 3.5rem; }
  /* Link unter der schmalen Einleitung (ohne Foto) */
  /* Bühne statt Bild (Indoor-Reihe, Chopper-Szene): kein Karton, die Bewegung ist das dominante Element. Ab breitem Desktop
     stehen Kopf und Text links, die Bühne spannt rechts beide Zeilen bis zur Content-Kante; schmal untereinander. Die Bühne
     braucht JavaScript, ohne es steht der Text allein. --stage-min: Mindesthöhe der Bühne, --stage-bleed: so weit reicht
     das Canvas der Indoor-Reihe über die Bühne hinaus (Licht, aufsteigende Drohnen; die Feldmitte bleibt die Bühnenmitte). */
  .eco-staged { --stage-min: clamp(20rem, 32vw, 34rem); --stage-bleed: min(15rem, 60%); display: grid; grid-template-areas: "head" "copy" "stage"; column-gap: clamp(var(--space-7), 4vw, var(--space-14)); margin-bottom: clamp(var(--space-10), 6vw, var(--space-20)); }
  .eco-staged:last-child { margin-bottom: 0; }
  /* Kopf aus Sätzen neben der Bühne (Startseite): jeder Satz eine Zeile, die mittlere als Kontur, die letzte im Verlauf */
  .eco-staged :global(.eco-lines .head-line > span) { display: block; width: fit-content; }
  .eco-staged :global(.eco-lines .o) { color: transparent; -webkit-text-stroke: 1.25px var(--ink-bright); }
  /* Startseite (Marc, Runde 15: „deutlich größer … wir brauchen diesen Impact“): fast das Riesenformat der früheren
     Scrollstory (.eco-head-xl .eco-title bis 8,5rem), etwas kleiner, damit „Kein Rauch.“ neben der Bühne in seiner Spalte
     bleibt. Dieselbe benannte Ausnahme im Wächter layout-audit.mjs head-size (.eco-head-xl), keine neue. */
  .eco-staged :global(.eco-head-xl .eco-lines) { font-size: clamp(3rem, 6.6vw, 7.5rem); line-height: 0.92; letter-spacing: -0.045em; }
  .eco-staged :global(.eco-head-xl .eco-lines .o) { -webkit-text-stroke-width: 1.5px; }
  /* Die vier Punkte stehen direkt unter Kopf und Bühne; den Abstand gibt die Bühne vor */
  .eco-staged + :global(.eco-pillars) { margin-top: 0; }
  .eco-staged > :global(.eco-staged-head) { grid-area: head; }
  .eco-staged > .eco-lead-copy { grid-area: copy; }
  .eco-stage { grid-area: stage; position: relative; display: none; margin: 0; }
  :global(html:is(.reveal, .motion-paused)) .eco-stage { display: block; }
  .eco-show { min-height: var(--stage-min); }
  /* Nachhaltigkeit der Startseite (show: eco): die Figuren sind flach (Schallwelle, Flotte) oder schmal (Blitz), die Bühne
     ist deshalb niedriger als die der Indoor-Reihe, gestapelt im Querformat 2 : 1 */
  .eco-show[data-folge="eco"] { --stage-min: clamp(18rem, 26vw, 28rem); }
  /* Startseite mit großem Kopf (Runde 15): die Bühne wächst mit, damit Kopf und Formation gleich schwer stehen; der Blitz
     füllt die Höhe (fill in scenes/eco.js) und wird damit „ein ganzes Stück größer“ */
  @media (--grid-expanded) { .eco-staged:has(.eco-head-xl) .eco-show[data-folge="eco"] { --stage-min: clamp(22rem, 36vw, 40rem); } }
  .eco-show canvas { position: absolute; left: 0; width: 100%; top: calc(-1 * var(--stage-bleed)); height: calc(100% + 2 * var(--stage-bleed)); pointer-events: none; }
  @media (--grid-expanded) {
    :global(html:is(.reveal, .motion-paused)) .eco-staged { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-rows: auto 1fr; grid-template-areas: "head stage" "copy stage"; }
    /* großer Kopf: die linke Spalte ist so breit wie „Kein Rauch.“ bzw. die Einleitung (max-content, die Einleitung ist auf 44ch begrenzt),
       die Bühne bekommt den ganzen Rest; mit 5 : 7 bräche der Kopf um oder die Formation würde schmaler als vorher */
    :global(html:is(.reveal, .motion-paused)) .eco-staged:has(.eco-head-xl) { grid-template-columns: max-content minmax(0, 1fr); column-gap: clamp(var(--space-10), 5vw, var(--space-20)); }
    .eco-stage { align-self: center; }
  }
  /* Gestapelt: die Show-Bühne nimmt ihre Höhe aus der Spaltenbreite (3 : 2, 15–32rem) statt einer festen Höhe bis 22rem
     (Marc, Runde 9: Bilder auf Tablet „viel zu klein“); dieselbe Regel wie die Show-Folge der Startseite (himmel.css).
     Die Spalte ist auf die Containerbreite begrenzt (minmax(0, 1fr)): Mindesthöhe und Seitenverhältnis ergeben sonst eine
     Mindestbreite (390 px: 360 statt 350 px, der Text ragte 10 px über die Kante; layout-audit contain) */
  @media (--grid-stacked) { .eco-lead.has-img { grid-template-columns: 1fr; } .eco-staged { --stage-min: 15rem; grid-template-columns: minmax(0, 1fr); } .eco-show { aspect-ratio: 3 / 2; max-height: 32rem; } }
  @media (--grid-stacked) { .eco-show[data-folge="eco"] { aspect-ratio: 2 / 1; --stage-min: 11rem; } }
  /* gestapelt mit großem Kopf (Startseite): etwas höher als 2 : 1, damit auch der Blitz größer steht; nur über das
     Seitenverhältnis, eine Mindesthöhe ergäbe mit ihm eine Mindestbreite (390 px: 704 px breit, seitliches Scrollen) */
  @media (--grid-stacked) { .eco-staged:has(.eco-head-xl) .eco-show[data-folge="eco"] { aspect-ratio: 5 / 3; } }
</style>
