---
// FAQ im Prototyp-Layout (Kopf links, Fragen rechts). Mit `groups` erscheinen die Fragen in Gruppen mit eigener
// Zwischenüberschrift; mit `closing` folgt der Abschluss „Eure Frage ist nicht dabei?“ mit Anrufen/Schreiben.
import { getCollection, render } from 'astro:content';
import type { Section } from '../../content.config';
import Accent from '../Accent.astro';
import Faces from '../Faces.astro';
import Icon from '../Icon.astro';
import { CONTACT } from '../people';
import { optimizedImage } from '../../lib/media';
type Props = Extract<Section, { type: 'faq' }> & { index: number };
const { headline = 'Häufige Fragen', text, cta, tags, limit, openFirst, groups, closing, id = `s${Astro.props.index}`, index, kicker } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
const G = index === 0 ? 'h2' : 'h3';
const all = (await getCollection('faq', e => !e.data.draft)).sort((a,b) => a.data.order-b.data.order);
const pick = (want?: string[]) => want?.length ? all.filter(e => e.data.tags.some(tag => want.includes(tag))) : all;
const withContent = (list: typeof all) => Promise.all(list.map(async entry => ({ entry, Content: (await render(entry)).Content })));
const blocks = groups?.length
  ? await Promise.all(groups.map(async (g, gi) => ({ id: g.id ? `${id}-${g.id}` : `${id}-g${gi + 1}`, headline: g.headline, items: await withContent(pick(g.tags)) })))
  : [{ id: undefined, headline: undefined, items: await withContent(limit ? pick(tags).slice(0, limit) : pick(tags)) }];
const external = cta?.href.startsWith('https://');
const photo = closing?.image ? await optimizedImage(closing.image.src, 640) : undefined;
---
<section class:list={['section', { 'faq-grouped': groups?.length }]} id={id} aria-labelledby={headingId}>
  <!-- Mit Gruppen (FAQ-Seite): Kopf oben, je Gruppe links die Kategorie, die beim Scrollen mitläuft (sticky), rechts die
       Fragen. So ist klar, was Kategorie und was Frage ist (Marc, 31.10.2026). -->
  <div class="faq-grid">
    <div class="intro">{kicker && <span class="kicker mono">{kicker}</span>}<H id={headingId}><Accent text={headline} /></H>{text && <p>{text}</p>}{cta && <a class="link" href={cta.href} rel={external ? 'noopener' : undefined} target={external ? '_blank' : undefined}>{cta.label} <span aria-hidden="true">→</span></a>}</div>
    <div class="faq-body">
      {blocks.map((block, bi) => <div class="faq-group" id={block.id} aria-labelledby={block.headline ? `${block.id}-h` : undefined} role={block.headline ? 'group' : undefined}>
        {block.headline && <G class="faq-group-h" id={`${block.id}-h`}>{block.headline}</G>}
        <div class="faq">{block.items.map(({ entry, Content }, i) => <details open={openFirst && bi === 0 && i === 0}><summary>{entry.data.question}</summary><div class="answer"><Content /></div></details>)}</div>
      </div>)}
      {closing && <div class="promise faq-cta">
        <Faces />
        <div class="promise-copy">
          <span class="kicker mono">Persönlich</span>
          <G>{closing.headline}</G>
          {closing.text && <p>{closing.text}</p>}
        </div>
        <div class="actions">
          <a class="btn primary" href="/kontakt/">Show anfragen</a>
          <a class="btn" href={CONTACT.phone.href}><Icon name="phone" class="g" />Anrufen</a>
          <a class="btn" href={`mailto:${CONTACT.email}`}><Icon name="mail" class="g" />Schreiben</a>
        </div>
      </div>}
    </div>
  </div>
</section>
