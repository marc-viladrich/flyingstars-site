---
import type { Section } from '../../content.config';
import { optimizedImage } from '../../lib/media';
type Props = Extract<Section, { type: 'team' }> & { index: number };
const { headline, text, members, kicker, note, cta, id = `s${Astro.props.index}`, index } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
const initials = (name: string) => name.trim().split(/\s+/).filter((_,i,a)=>i===0||i===a.length-1).map(part=>part[0]).join('').toUpperCase();
const crew = await Promise.all(members.map(async member => ({...member, media: member.image ? await optimizedImage(member.image.src, 640) : undefined})));
---
<section class="team-sec" id={id} aria-labelledby={headingId}>
  <div class="sec-head"><div>{kicker && <span class="kicker mono">{kicker}</span>}<H id={headingId}>{headline}</H></div>{text && <p>{text}</p>}</div>
  <div class="crew">{crew.map((member,i) => <article class="member" style={`--i:${i}`}><div class="portrait">{member.image && member.media ? <img src={member.media.src} width={member.media.width} height={member.media.height} alt={member.image.alt} loading="lazy" decoding="async" /> : <><span class="ini" aria-hidden="true">{initials(member.name)}</span><span class="soon mono">Foto folgt</span></>}</div><span class="role mono">{member.role}</span><h3>{member.name}</h3>{member.bio && <p>{member.bio}</p>}</article>)}</div>
  {(note || cta) && <p class="crew-note">{note && <span>{note}</span>}{cta && <a class="link" href={cta.href}>{cta.label} <span aria-hidden="true">→</span></a>}</p>}
</section>
