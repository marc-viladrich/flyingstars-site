---
// Labor (nur im Dev-Server, nie im Build, wie labor/blog-bilder): Prototyp eines ganzen Blogartikels, wie Artikel künftig
// aussehen sollen (Runde 15, 21.11.2026). Der echte Artikel im echten Blog-Layout (BlogPost.astro), Text unverändert aus
// der Collection, nur in Abschnitte geteilt: Titelbild im Lichtraster (eigenes Foto), ein Tagbild als Punkt-Reveal, eine
// Bildleiter mit eigenen Fotos, die isometrische Scroll-Geschichte (Bausteine und Ablauf) und das Logo-Finale.
// Bilder und Formation: tools/labor/blog-artikel.mjs. Fotos: Drive-Sichtung im Kundenordner 27-blog-bilder-2026-11-21.
import { getEntry } from 'astro:content';
import BlogPost from '../../../templates/BlogPost.astro';
import Gallery from '../../../components/gallery/Gallery.astro';
import StoryScene from '../../../components/blog/StoryScene.astro';
import FormationFinale from '../../../components/blog/FormationFinale.astro';

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return [{ params: { slug: 'wie-programmiert-man-eine-drohnenshow' } }];
}
const post = (await getEntry('posts', '2025-06-12-wie-programmiert-man-eine-drohnenshow'))!;
const M = '/media/labor/artikel/';

// Artikel-HTML an den Überschriften teilen (Text unverändert). Leere Absätze (geschütztes Leerzeichen) und die beiden
// Bilder aus dem Import fallen weg: an ihre Stelle treten die eigenen Bilder bzw. das Logo-Finale.
const html = post.rendered?.html ?? '';
const parts = html.split(/(?=<h[23][\s>])/).map((chunk) => chunk
  .replace(/<p>(\s|&nbsp;| )*<\/p>/g, '')
  .replace(/<p>\s*<img[^>]*>\s*<\/p>/g, '')
  .trim()).filter(Boolean);
const level = (c: string) => Number(c.match(/^<h([23])/)?.[1] ?? 0);
const titleOf = (c: string) => c.match(/^<h[23][^>]*>(.*?)<\/h[23]>/s)?.[1].replace(/<[^>]+>/g, '').replace(/^\d+\.\s*/, '').replace(/&amp;/g, '&').replace(/&#x26;/g, '&').trim() ?? '';
const intro = parts[0];
const h2 = parts.map((c, i) => ({ c, i })).filter(({ c }) => level(c) === 2);
if (h2.length !== 4) throw new Error(`Gliederung geändert: ${h2.length} Zwischentitel statt 4`);
const [what, blocksH2, flowH2, ours] = h2;
const between = (a: number, b: number) => parts.slice(a + 1, b);
const bausteine = between(blocksH2.i, flowH2.i), ablauf = between(flowH2.i, ours.i);
if (bausteine.length !== 4 || ablauf.length !== 5) throw new Error('Gliederung geändert: erwartet 4 Bausteine und 5 Ablaufschritte');
const blocks = [
  { html: blocksH2.c },
  ...bausteine.map((c, i) => ({ html: c, step: i, title: titleOf(c), group: `Baustein ${i + 1}/4` })),
  { html: flowH2.c },
  ...ablauf.map((c, i) => ({ html: c, step: 4 + i, title: titleOf(c), group: `Ablauf ${i + 1}/5` })),
];
const ladder = [
  { src: `${M}leiter-006.webp`, width: 1000, height: 1000, alt: 'Zwei Personen bereiten bei Sonnenuntergang ein Startfeld vor, eine richtet ein Stativ aus.', caption: 'Vorbereitung am Startfeld' },
  { src: `${M}leiter-018.webp`, width: 1000, height: 1000, alt: 'Eine Blüte aus Drohnen über dem nächtlichen Nieheim.', caption: 'Blüte · Nieheim' },
  { src: `${M}leiter-034.webp`, width: 1000, height: 1000, alt: 'Ein Doppelherz aus Drohnen über Nieheim.', caption: 'Doppelherz · Nieheim' },
];
const NOTES = [
  ['Titelbild', 'Eigenes Foto (#058 der Sichtung) im Lichtraster, zur Build-Zeit gerechnet. Höheres Gamma als im Rezept-Standard, sonst füllt der Lampennebel die Fläche.', 'Foto hochladen; der Build rechnet. Regler nur, wenn das Labor-Rezept nicht trägt.'],
  ['Punkt-Reveal', 'Tagbild (#012) in seinen Farben, nur durch das Punktgitter sichtbar. Für Fotos mit vielen Mitteltönen, die im Lichtraster zu Brei werden.', 'Foto hochladen, Effekt „Punkt-Reveal“ wählen.'],
  ['Bildleiter', 'Bestehende Leiter (Gallery.astro) mit drei eigenen Fotos im Lichtraster: Vorbereitung am Tag, zwei fertige Formationen.', 'Drei Fotos wählen. Die Leiter nimmt neu optional eigene Bilder statt eines Manifest-Satzes.'],
  ['Scroll-Geschichte', 'Isometrische Szene mit der Kamera der Standortzeichnung (story-scene.ts), neun Schritte, je Abschnitt einer. Ebenen fahren zusammen, schrumpfen zu einem Punkt, das Nächste wächst daraus. Endzustand steht im HTML.', 'Nicht im Editor pflegbar: je Artikel eine eigene Szene, die wir bauen (Geometrie + Annotationen, grob 1–2 Tage). Der Text bleibt im Editor; ändert sich die Gliederung, meldet die Seite das beim Build.'],
  ['Logo-Finale', 'Das FlyingStars-Logo mit Schriftzug aus 600 Drohnen, mit der Engine der Fallstudien-Formation (jetzt scripts/formation-play.js). Poster als echtes Bild im HTML.', 'Baustein ohne Pflege: steht unter jedem Artikel. Mit Inhalt übernimmt er den Schlussabschnitt, sonst einen Standardtext.'],
];
---
<BlogPost post={post} noindex coverImage={{ src: `${M}titel-058.webp`, width: 1600, height: 1000, alt: 'Eine Person steht nachts zwischen leuchtenden Drohnenstapeln am Startfeld, als Lichtpunkt-Raster.' }}>
  <Fragment slot="body">
    <div class="post-body ba-col" set:html={intro} />
    <figure class="ba-wide">
      <img src={`${M}reveal-012.webp`} width="1600" height="1000" alt="Showdrohnen auf weißen Startunterlagen, im Raster auf einer gepflasterten Fläche." loading="lazy" decoding="async" />
      <figcaption>Showdrohnen auf ihren Startunterlagen, kurz vor dem Abheben.</figcaption>
    </figure>
    <div class="ba-ladder"><Gallery photos={ladder}><div class="post-body" set:html={what.c} /></Gallery></div>
    <StoryScene blocks={blocks} label="Bausteine und Ablauf einer Drohnenshow" caption="Die vier Bausteine einer Drohnenshow und der Ablauf ihrer Programmierung, als Szene zu den Abschnitten im Text." />
    <FormationFinale><div class="post-body" set:html={ours.c} /></FormationFinale>
  </Fragment>
  <aside slot="after" class="section ba-note" aria-labelledby="ba-note-h">
    <h2 id="ba-note-h">Labor-Notiz</h2>
    <p>Nur im Dev-Server. Was jede Grafik ist und wie FlyingStars sie pflegen könnte.</p>
    <dl>{NOTES.map(([k, what, edit]) => <div><dt>{k}</dt><dd>{what}</dd><dd class="ba-edit">Editor: {edit}</dd></div>)}</dl>
  </aside>
</BlogPost>

<style>
  .ba-col { width: 100%; }
  .ba-wide { width: 100%; max-width: 64rem; margin: clamp(var(--space-10), 5vw, var(--space-16)) 0; }
  .ba-wide img { width: 100%; height: auto; aspect-ratio: 16 / 10; display: block; border-radius: var(--radius-16); background: var(--media-ground); }
  .ba-wide figcaption { margin-top: var(--space-3); color: var(--faint); font-size: var(--text-sm); }
  .ba-ladder { width: 100%; max-width: min(82rem, 100%); margin-block: clamp(var(--space-6), 3vw, var(--space-10)); }
  .ba-ladder :global(.post-body h2) { margin-top: 0; }
  .ba-note { max-width: 64rem; margin: 0 auto; border-top: 1px dashed var(--line-strong); }
  .ba-note h2 { font-size: var(--text-lg, 1.5rem); }
  .ba-note > p { color: var(--muted); margin-top: var(--space-2); }
  .ba-note dl { display: grid; gap: var(--space-5); margin-top: var(--space-6); }
  .ba-note dl > div { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: var(--space-1) var(--space-6); }
  .ba-note dt { font: 500 var(--text-base)/1.3 var(--display); color: var(--accent); grid-row: span 2; }
  .ba-note dd { margin: 0; color: var(--text); font-size: var(--text-sm); line-height: 1.55; }
  .ba-note .ba-edit { color: var(--muted); }
  @media (max-width: 45em) { .ba-note dl > div { grid-template-columns: 1fr; } .ba-wide img { border-radius: var(--radius-12); } }
</style>
