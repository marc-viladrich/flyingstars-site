---
import {nativeRecord as uiMarker} from '../lib/native-editor';
import {siteRecord as readUi} from '../lib/content';
import {localeFromPath,localizedHref,sourcePath} from '../lib/localized-routes';
const locale = Astro.props.locale ?? Astro.props._locale ?? localeFromPath(Astro.url.pathname);
const ui = await readUi('ui',locale);
import '../styles/fonts.css';
import '../styles/global.css';
import {colorTokenCSS} from '../lib/color-tokens.mjs';
import { site } from '../site.config';
import Logo from '../components/Logo.astro';
import { optimizedImage } from '../lib/media';
import { siteRecord } from '../lib/content';
import { nativeRecord,nativeItem } from '../lib/native-editor';
interface Props { _locale?:string; title: string; description: string; noindex?: boolean; canonicalPath?: string; image?: string; navSection?: string; fullBleed?: boolean; locale?:string; }
const { title, description, noindex = false, canonicalPath, image, navSection, fullBleed: bleed = false } = Astro.props;
const canonical = new URL(localizedHref(canonicalPath ?? Astro.url.pathname,locale), Astro.site);
const current = sourcePath(Astro.url.pathname);
// Footer contact values and addresses are owned by site/contact (same record as the contact form).
const contact = await siteRecord('contact',locale), C = (path: string[]) => nativeRecord('site/contact', path);
const navigation = await siteRecord('navigation',locale), N = (path: (string|number)[]) => nativeRecord('site/navigation', path);
const NI = (entry: (string|number)[]) => nativeItem({}, {record:'site/navigation',entry});
const addresses = contact.address ? (['visit', 'post'] as const).map((key) => [key, contact.address[key]] as const) : [];
// Case pages and project details belong to the "Projekte" area of the main navigation.
const section = navSection ?? (current.startsWith('/projekte/') ? '/projekte/' : undefined);
const navState = (href: string) => current === href ? 'page' : section === href ? 'true' : undefined;
const social = image ? await optimizedImage(image, 960, undefined, 'jpg') : undefined;
const fullBleed = bleed || ['/', '/drohnenshow-preise/', '/musikalischer-teaser-bokkenrijders/', '/nfl-berlin-game/', '/exploring-reinvented-der-neue-ford-explorer/', '/puma-bundesliga/'].includes(current) || current.startsWith('/projekte/');
const eco = await optimizedImage('https://flyingstars.art/wp-content/uploads/2024/10/NATURSTROM-Logo_weiss.png', 160);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <style is:inline set:html={colorTokenCSS()} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {['de','en','nl'].map(lang => <link rel="alternate" hreflang={lang} href={new URL(localizedHref(canonicalPath ?? current,lang),Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(sourcePath(canonicalPath ?? current),Astro.site)} />
    {(noindex || process.env.FLYINGSTARS_EDITOR==='1') && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={`${title} | FlyingStars`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {social && <meta property="og:image" content={new URL(social.src, Astro.site)} />}
    {social && <meta property="og:image:width" content={String(social.width)} />}
    {social && <meta property="og:image:height" content={String(social.height)} />}
    <link rel="sitemap" href={localizedHref("/sitemap-index.xml",locale)} />
    <link rel="icon" href={localizedHref("/favicon.svg",locale)} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main" {...uiMarker('site/ui',["base","zum_inhalt_springen"])}>{ui.base.zum_inhalt_springen}</a>
    <div class="nav-sentinel" aria-hidden="true"></div>
    <header class="nav">
      <Logo />
      <nav aria-label={ui.base.hauptnavigation}>{navigation.header.map((item:any,i:number) => <a href={localizedHref(item.href,locale)} aria-current={navState(item.href)} {...NI(["header",i])} {...N(["header",i,"label"])}>{item.label}</a>)}</nav>
      <nav class="lang" aria-label={ui.base.language}>{['de','en','nl'].map(lang=><a data-language-link href={localizedHref(current,lang)} lang={lang} hreflang={lang} aria-current={locale===lang?'page':undefined}>{lang.toUpperCase()}</a>)}</nav>
      <button class="motion-btn" type="button" data-motion-toggle data-pause={ui.base.bewegung_pausieren} data-resume={ui.base.motionResume} aria-pressed="false" aria-label={ui.base.bewegung_pausieren} title={ui.base.bewegung_pausieren}><svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="7" y="6" width="3.2" height="12" rx="1" /><rect x="13.8" y="6" width="3.2" height="12" rx="1" /></svg><svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.5 6.2v11.6a.8.8 0 0 0 1.2.7l9-5.8a.8.8 0 0 0 0-1.4l-9-5.8a.8.8 0 0 0-1.2.7z" /></svg></button>
      <a class="btn small primary" href={localizedHref(navigation.cta.href,locale)} {...N(["cta","label"])}>{navigation.cta.label}</a>
      <button class="menu-btn" type="button" data-menu-open aria-controls="mobile-menu" aria-expanded="false" aria-label={ui.base.menu_offnen}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
    </header>
    <dialog class="mobile-menu" id="mobile-menu" aria-label={ui.base.hauptnavigation}>
      <div class="top"><Logo /><button class="menu-btn menu-close" type="button" data-menu-close aria-label={ui.base.menu_schliessen}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></button></div>
      <nav aria-label={ui.base.mobile_navigation}>{navigation.header.map((item:any,i:number) => <a href={localizedHref(item.href,locale)} {...NI(["header",i])} {...N(["header",i,"label"])}>{item.label}</a>)}{navigation.mobileExtras.map((item:any,i:number) => <a href={localizedHref(item.href,locale)} {...NI(["mobileExtras",i])} {...N(["mobileExtras",i,"label"])}>{item.label}</a>)}</nav>
      <nav class="lang" aria-label={ui.base.language}>{['de','en','nl'].map(lang=><a data-language-link href={localizedHref(current,lang)} lang={lang} hreflang={lang} aria-current={locale===lang?'page':undefined}>{lang.toUpperCase()}</a>)}</nav>
    </dialog>
    <main id="main" class:list={{ 'content-page': !fullBleed }}><slot /></main>
    <footer class="footer">
      <div class="cols">
        <div class="footer-brand"><Logo /><p {...uiMarker('site/ui',["base","drohnenshows_seit_2022_uber_150_shows_in_deutschla"])}>{ui.base.drohnenshows_seit_2022_uber_150_shows_in_deutschla}</p><div class="eco"><img src={eco.src} width={eco.width} height={eco.height} alt="naturstrom" loading="lazy" /><span {...uiMarker('site/ui',["base","text_100_okostrom"])}>{ui.base.text_100_okostrom}</span></div></div>
        <div><h2 class="footer-heading" {...N(["footer","headings","contact"])}>{navigation.footer.headings.contact}</h2><address>{addresses.map(([key, block]) => <span {...C(["address", key, "label"])}>{block.label}<br />{block.name}<br />{block.street}</span>)}<span><a href={localizedHref(contact.email.href,locale)} {...C(["email", "value"])}>{contact.email.value}</a><br /><a href={localizedHref(contact.phone.href,locale)} {...C(["phone", "value"])}>{contact.phone.value}</a></span></address></div>
        <div><h2 class="footer-heading" {...N(["footer","headings","pages"])}>{navigation.footer.headings.pages}</h2><ul>{navigation.footer.pages.map((item:any,i:number) => <li {...NI(["footer","pages",i])}><a href={localizedHref(item.href,locale)} {...N(["footer","pages",i,"label"])}>{item.label}</a></li>)}</ul></div>
        <div><h2 class="footer-heading" {...N(["footer","headings","social"])}>{navigation.footer.headings.social}</h2><ul>{navigation.footer.social.map((item:any,i:number) => <li {...NI(["footer","social",i])}><a href={localizedHref(item.href,locale)} rel="noopener noreferrer" target="_blank" {...N(["footer","social",i,"label"])}>{item.label}</a></li>)}</ul></div>
      </div>
      <div class="base mono"><span>© {new Date().getFullYear()} FlyingStars GmbH</span><nav aria-label={ui.base.rechtliches}>{navigation.footer.legal.map((item:any,i:number) => <a href={localizedHref(item.href,locale)} {...NI(["footer","legal",i])} {...N(["footer","legal",i,"label"])}>{item.label}</a>)}</nav><span {...uiMarker('site/ui',["base","website_vorschau"])}>{ui.base.website_vorschau}</span></div>
    </footer>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
