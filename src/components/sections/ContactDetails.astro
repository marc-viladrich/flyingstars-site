---
// Kontaktwege und Anschriften mit Icons, daneben das Team (Runde 20, Marc 04.11.2026: „deutlich nicer und ansprechender“,
// Adressen mehrzeilig wie auf einem Briefumschlag, Mobil und WhatsApp mit eigenen Icons, zwei Spalten mit Teamfoto).
// Nummern, Adressen und Links stehen nur in CONTACT (people.ts); die Section liefert Überschrift, Text und den Besuchshinweis.
// Solange es kein Teamfoto gibt, stehen hier die Porträts der Geschäftsführer:innen (mit Lichtpunkt-Hover wie im Team).
import { forPath } from '../../i18n/server';
import type { Section } from '../../content.config';
import { optimizedImage } from '../../lib/media';
import { CONTACT, FOUNDERS } from '../people';
import SectionHead from '../SectionHead.astro';
import IconFeature from '../IconFeature.astro';
import Icon from '../Icon.astro';
import Picture from '../Picture.astro';
type Props = Extract<Section, { type: 'contactDetails' }> & { index: number };
const { kicker, headline, text, visitNote, image, id: anchor, index } = Astro.props;
const { t, localHref } = forPath(Astro.url.pathname);
const id = `${anchor ?? `s${index}`}-h`;
const H = index === 0 ? 'h1' : 'h2';
const Item = index === 0 ? 'h2' : 'h3';
const ways = [
  { icon: 'phone', title: t('contactDetails.phone'), label: CONTACT.phone.label, href: CONTACT.phone.href },
  { icon: 'smartphone', title: t('contactDetails.mobile'), label: CONTACT.mobile.label, href: CONTACT.mobile.href },
  { icon: 'whatsapp', title: 'WhatsApp', label: t('contactDetails.whatsappAction'), href: CONTACT.whatsapp.href, external: true },
  { icon: 'mail', title: t('contactDetails.email'), label: CONTACT.email, href: `mailto:${CONTACT.email}` },
];
const crew = image ? [] : await Promise.all(FOUNDERS.map(async (p) => ({ ...p, img: await optimizedImage(p.image.src, 480) })));
---
<section class="section contact-details" id={anchor} aria-labelledby={id}>
  <div class="cd-main">
    <SectionHead variant="embedded" kicker={kicker} headline={headline} text={text} id={id} level={H} textClass="cd-lead" />
    <ul class="cd-grid">
      {ways.map((w) => <IconFeature as="li" icon={w.icon} title={w.title} level={Item}><a class="cd-link" href={localHref(w.href)} rel={w.external ? 'noopener' : undefined} target={w.external ? '_blank' : undefined}>{w.label}</a></IconFeature>)}
      <IconFeature as="li" icon="map-pin" title={t('contactDetails.visit')} level={Item}><address>{CONTACT.visit.map((line) => <span>{line}</span>)}</address>{visitNote && <p class="cd-note">{visitNote}</p>}</IconFeature>
      <IconFeature as="li" icon="mailbox" title={t('contactDetails.post')} level={Item}><address>{CONTACT.post.map((line) => <span>{line}</span>)}</address></IconFeature>
    </ul>
    <a class="btn cd-video" href={localHref(CONTACT.video.href)} rel="noopener" target="_blank"><Icon name="video" class="g" />{t(CONTACT.video.labelKey)}</a>
  </div>
  {image
    ? <figure class="cd-photo"><Picture {...image} /></figure>
    : <ul class="cd-crew" aria-label={t('contactDetails.team')}>{crew.map((p) => <li><div class="portrait" data-dot-img data-step="6"><img src={p.img.src} width={p.img.width} height={p.img.height} alt={p.image.alt} loading="lazy" decoding="async" /></div><span>{p.name}</span></li>)}</ul>}
</section>
<style>
  .contact-details { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: clamp(2.5rem, 6vw, 7rem); align-items: center; }
  .cd-main :global(.cd-lead) { margin: 1rem 0 0; color: var(--muted); }
  .cd-grid { list-style: none; margin: 2.75rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.25rem 2.5rem; }
  .cd-grid :global(.icon-feature) { gap: 0.5rem; }
  .cd-grid :global(.icon-feature > .ico) { width: 1.75rem; height: 1.75rem; margin-bottom: 0.25rem; }
  .cd-grid :global(.ic-h) { font: 500 var(--text-xs)/1.2 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  .cd-link { color: var(--text); font-size: var(--text-copy); border-bottom: 1px solid var(--line-strong); transition: color 0.2s ease, border-color 0.2s ease; }
  .cd-link:hover { color: var(--amber); border-color: var(--amber); }
  /* eine Zeile je Adresszeile wie auf dem Umschlag; muss eine umbrechen, dann ausgewogen („Gründungszentrum / Zeche Zollverein“) */
  address { font-style: normal; font-size: var(--text-copy); line-height: 1.5; color: var(--text); }
  address span { display: block; text-wrap: balance; }
  .cd-note { margin: 0.25rem 0 0; font-size: var(--text-sm); color: var(--muted); }
  .cd-video { margin-top: 2.75rem; }
  .cd-photo { margin: 0; border-radius: var(--radius); overflow: hidden; }
  .cd-photo :global(img) { display: block; width: 100%; height: auto; }
  /* Drei Porträts, die mittlere versetzt: wirkt wie eine Gruppe statt wie drei Passbilder */
  .cd-crew { list-style: none; margin: 0; padding: 0 0 2.5rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  .cd-crew li:nth-child(2) { translate: 0 2.5rem; }
  .cd-crew .portrait { margin-bottom: 0.625rem; }
  .cd-crew span { font-size: var(--text-sm); color: var(--muted); }
  /* unter 75em gestapelt: zwei Spalten ließen den Kontaktwegen zu wenig Breite (bei 940 px brachen Adresszeilen um) */
  @media (max-width: 75em) {
    .contact-details { grid-template-columns: 1fr; }
    .cd-crew { max-width: 40rem; }
  }
  @media (max-width: 30em) {
    .cd-grid { grid-template-columns: 1fr; gap: 1.75rem; }
    .cd-crew li:nth-child(2) { translate: 0 1.5rem; }
  }
</style>
