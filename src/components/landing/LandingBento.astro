---
import Styles from '../Styles.astro';
import ownerStyle0 from './LandingBento.css?url';
import {factText} from '../../content/show-extras.mjs';
import IconFeature from '../IconFeature.astro';
import { forPath } from '../../i18n/server';
const { localHref, locale } = forPath(Astro.url.pathname);
// Kacheln mit einer Hauptkachel (Bild mit Titel darauf oder eine große Aussage) und bis zu vier kleineren Icon-Kacheln. Bricht die Folge aus Text-Bild-Blöcken auf (Marc, 31.10.2026: „mehr Variation in den Layouts“).
// Optional unten ein Textlink (cta) oder ein Abschluss-Kasten (closing, CtaBox.astro).
// Icons: Lucide über src/components/Icon.astro (`icon` je Kachel, `lead.icon` für die Aussage ohne Bild).
import type { Section } from '../../content.config';
import SectionHead from '../SectionHead.astro';
import CtaBox from '../CtaBox.astro';
import Accent from '../Accent.astro';
import Icon from '../Icon.astro';
import { optimizedImage } from '../../lib/media';
type Props = Extract<Section, { type: 'landingBento' }> & { index: number };
const { kicker, headline, text, lead, items, cta, closing, id = `s${Astro.props.index}`, index } = Astro.props;
const H = index === 0 ? 'h1' : 'h2';
const T = index === 0 ? 'h2' : 'h3';
const img = lead.image ? await optimizedImage(lead.image.src, 960, 720) : undefined;
---
<Styles href={ownerStyle0} id="components/landing/LandingBento.css" />
<section class="section lb" id={id} aria-labelledby={`${id}-h`}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} level={H} />
  <div class="lb-grid" data-n={items.length}>
    <article class:list={['lb-lead', { 'has-img': img }]} data-dot-host={img ? '' : undefined}>
      {img && <div class="lb-img" data-curtain data-dot-img><img src={img.src} width={img.width} height={img.height} alt={lead.image!.alt} loading="lazy" decoding="async" /></div>}
      <div class="lb-lead-copy">
        {!img && lead.icon && <Icon name={lead.icon} size={40} class="g lb-lead-ico" />}
        {img && lead.label && <span class="mono lb-k">{lead.label}</span>}
        <T><Accent text={lead.title} /></T>
        {lead.text && <p>{lead.text}</p>}
      </div>
    </article>
    {items.map((it) => (
      <IconFeature class="lb-cell lb-feat" icon={it.icon} title={it.title} text={factText(it.text,locale)} level={T} />
    ))}
  </div>
  {closing ? <CtaBox {...closing} level={T} class="lb-close" /> : cta && <div class="lb-more"><a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a></div>}
</section>
