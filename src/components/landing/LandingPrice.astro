---
import {field} from 'astro-frontend-editor/markers';
import {SHOW_EXTRAS,factText} from '../../content/show-extras.mjs';
import {priceParts} from '../../lib/price.mjs';
import { forPath } from '../../i18n/server';
const { t, localHref, formatLocale, locale } = forPath(Astro.url.pathname);
// Preiskarte (Marc, 31.10.2026: „bei der Hochzeit insbesondere mit den Preisen … viel mehr High Quality“). Links der
// Preis groß, bei Paketbezug mit der Punktfigur des Pakets und Preis/Drohnen aus src/content/show-packages.ts; rechts
// die Gruppen wie ein Kassenzettel (Bezeichnung links, Betrag rechts), optional ein Bonus im Logoverlauf.
// Darunter der Abschluss-Kasten (CtaBox.astro, Pflichtfelder im Schema) wie auf Startseite und Preisseite:
// mit Gesichtern oben, Satz und Knöpfen zentriert. Die Karte selbst trägt deshalb keinen Verlaufsrand.
import type { Section } from '../../content.config';
import SectionHead from '../SectionHead.astro';
import CtaBox from '../CtaBox.astro';
import Icon from '../Icon.astro';
import { SHOW_PACKAGES } from '../../content/show-packages';
import { getPackageDetails } from '../../content/package-details';
import { durationValues } from '../../content/show-duration.mjs';
type Props = Extract<Section, { type: 'landingPrice' }> & { index: number };
const { kicker, headline, text, package: pkg, offer, customPrice, unit, groups, bonus, closing, cta, factors, download, id = 'preise', index } = Astro.props;
const H = index === 0 ? 'h1' : 'h2';
const T = index === 0 ? 'h2' : 'h3';
const p = pkg ? SHOW_PACKAGES[pkg] : undefined;
const {prefix:pre='',amount} = p ? priceParts({amount:p.price,currency:'EUR',qualifier:'from',net:true,travel:'excluded'},locale) : offer ? priceParts(SHOW_EXTRAS[offer].price,locale) : {prefix:customPrice?.prefix,amount:customPrice?.amount??''};
const sub = factText(unit,locale) ?? (p ? t('landingprice.excludingVatForValueDronesPlusTravel', { v0: p.base }) : undefined);
// Staffel nur, wenn das Paket nach oben begrenzt ist (SPARK: bis 150 Drohnen, je 10 weitere +900 €)
// Showzeit wie auf allen Paketkarten (package-details.ts)
const showtime = pkg ? getPackageDetails(locale).showtimeLine(pkg) : undefined;
// Indoor (18.11.2026): mit Faktoren zweigeteilte Karte nach Stripe Pricing; das Startraster der kleinsten Show (20 Drohnen,
// 1-m-Raster wie in der Sicherheitszeichnung) steht als Lichtpunkte neben dem Preis, statt einer Paketfigur
const factorMode = Boolean(factors?.length);
// Punktfelder in den Faktor-Zellen (Punktsprache wie die Standortkarte): jeder Punkt ist eine Einheit des Werts. Fläche
// 10 × 10 m im Meterraster mit dem Startraster der kleinsten Show (5 × 4 = 20 Drohnen) darin, Drohnen min von max (nach
// Spalten gefüllt), Showdauer in Minuten. Keine Beschriftung, der Wert steht darunter.
// Runde 6 (Marc: „that the highlighted dots follow the mouse … CSS-only would be amazing“): unsichtbare Zeigezellen je
// Spalte/Zeile setzen per :has(:hover) --cx/--cy am Feld; jeder Leuchtpunkt rechnet daraus seine Deckkraft (nur opacity,
// weich). Fläche: der Startblock wandert mit der Maus. Drohnen/Showdauer: hell bis zur Maus, mindestens der Einstieg.
type Cell = { x: number; y: number; half?: boolean };
type Field = { w: number; h: number; mode: 'block' | 'range'; cells: Cell[]; vars: string };
const indoor = SHOW_EXTRAS.indoor, dur = durationValues();
const grid = (w: number, h: number, half?: (c: Cell) => boolean) => Array.from({ length: w * h }, (_, i) => { const c = { x: Math.floor(i / h), y: i % h }; return { ...c, half: half?.(c) }; });
const dotFields: Record<string, Field> = (() => {
  const bw = 5, bh = Math.ceil(indoor.drones.min / bw), hx = (bw - 1) / 2, hy = (bh - 1) / 2, oy = bh % 2 ? 0 : 0.5;
  const minCol = Math.ceil(indoor.drones.min / 5) - 1, minMinute = dur.indoorMin - 1;
  return {
    area: { w: 10, h: 10, mode: 'block', cells: grid(10, 10), vars: `--cx0:${Math.floor((10 - bw) / 2) + hx};--cy0:${Math.floor((10 - bh) / 2) + hy + oy};--hx:${hx};--hy:${hy};--oy:${oy};--W:10;--H:10` },
    drones: { w: Math.ceil(indoor.drones.max / 5), h: 5, mode: 'range', cells: grid(Math.ceil(indoor.drones.max / 5), 5), vars: `--cx0:${minCol};--min:${minCol}` },
    duration: { w: dur.indoorMax, h: 1, mode: 'range', cells: grid(dur.indoorMax, 1, (c) => c.x > minMinute), vars: `--cx0:${minMinute};--min:${minMinute}` },
  };
})();
const scale = p && Number.isFinite(p.max) ? t('landingprice.upToValueDronesValuePerValueAdditionalDrones', { v0: p.max, v1: p.add.toLocaleString(formatLocale), v2: p.step }) : undefined;
---
{factorMode ? (
<section class="section alt lp lp-f" id={id} aria-labelledby={`${id}-h`}>
  <SectionHead kicker={kicker} headline={headline} text={factText(text,locale)} id={`${id}-h`} level={H} class="lp-f-head" />
  <div class="lp-sheet">
    <div class="lp-buy">
      <p class="lp-amount" {...(offer?field({collection:'showExtras',id:'configuration'},[offer,'price','amount'],{mode:'panel'}):{})}>{pre && <span class="lp-pre mono">{pre} </span>}{amount}</p>
      {sub && <p class="lp-unit">{sub}</p>}
      <div class="lp-buy-close">
        <T class="lp-close-h">{closing.headline}</T>
        <p>{closing.text}</p>
        <div class="lp-actions">
          <a class="btn primary" href={localHref(closing.button.href)}>{closing.button.label}</a>
          {download && <a class="link lp-sheet-dl" href={localHref(download.href)} download><Icon name="file-text" size={18} />{download.label}</a>}
        </div>
      </div>
    </div>
    <ul class="lp-factors" role="list" data-n={factors!.length}>
      {factors!.map((f) => <li class="lp-factor">
        <span class="lp-factor-h"><Icon name={f.icon} size={22} class="g" />{f.title}</span>
        {f.dots && (() => { const d = dotFields[f.dots]; return <svg class:list={['lp-dots', `lp-dots-${f.dots}`, `is-${d.mode}`]} style={d.vars} viewBox={`0 0 ${d.w * 10} ${d.h * 10}`} aria-hidden="true">
          <g class="lp-base">{d.cells.map((c) => <circle class:list={{ half: c.half }} cx={c.x * 10 + 5} cy={c.y * 10 + 5} r="1.6" />)}</g>
          <g class="lp-lit">{d.cells.map((c) => <circle style={`--x:${c.x};--y:${c.y}`} cx={c.x * 10 + 5} cy={c.y * 10 + 5} r="2.1" />)}</g>
          <g class="lp-hit">{d.mode === 'block' ? d.cells.map((c) => <rect class={`zc${c.x} zr${c.y}`} x={c.x * 10} y={c.y * 10} width="10" height="10" />) : Array.from({ length: d.w }, (_, x) => <rect class={`zc${x}`} x={x * 10} y="0" width="10" height={d.h * 10} />)}</g>
        </svg>; })()}
        <b class="lp-factor-v">{factText(f.value, locale)}</b>
        <span class="lp-factor-t">{factText(f.text, locale)}</span>
      </li>)}
    </ul>
    {groups.slice(0, 1).map((g) => <div class="lp-incl">
      <T class="lp-incl-h">{g.title}</T>
      <ul role="list">{g.items.map((it) => <li><Icon name="check" size={18} class="g" /><span>{it.label}</span>{it.value && <b>{factText(it.value,locale)}</b>}</li>)}</ul>
    </div>)}
  </div>
  {cta && <p class="lp-more"><a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a></p>}
</section>
) : (
<section class="section alt lp" id={id} aria-labelledby={`${id}-h`}>
  <SectionHead kicker={kicker} headline={headline} text={factText(text,locale)} id={`${id}-h`} level={H} />
  <div class="lp-card">
    <div class="lp-price">
      {pkg && p && <div class="lp-pkg"><canvas data-orb={p.orb} data-color={p.color.join(',')} data-n={p.base} aria-hidden="true"></canvas><span class="lp-name">{pkg}</span></div>}
      <p class="lp-amount" {...(offer?field({collection:'showExtras',id:'configuration'},[offer,'price','amount'],{mode:'panel'}):{})}>{pre && <span class="lp-pre mono">{pre} </span>}{amount}</p>
      {sub && <p class="lp-unit">{sub}</p>}
      {showtime && <p class="lp-unit">{showtime}</p>}
      {scale && <p class="lp-scale mono">{scale}</p>}
    </div>
    <div class="lp-groups" data-n={groups.length}>
      {groups.map((g, gi) => (
        <div class="lp-group">
          <T class="mono">{g.title}</T>
          <ul>{g.items.map((it) => <li class:list={{ 'has-value': it.value }}>
            {gi === 0 && pkg ? <Icon name="check" size={18} class="g" /> : gi > 0 && pkg ? <Icon name="plus" size={18} class="g" /> : <span class="lp-pt" aria-hidden="true"></span>}
            <span>{it.label}</span>{it.value && <b>{factText(it.value,locale)}</b>}
          </li>)}</ul>
        </div>
      ))}
      {bonus && <div class="lp-bonus"><span class="lp-bonus-v grad">{factText(bonus.value,locale)}</span><p>{bonus.text}</p></div>}
    </div>
  </div>
  {cta && <p class="lp-more"><a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a></p>}
  <CtaBox {...closing} level={T} class="lp-close" />
</section>
)}

<style>
  .lp-more { margin: clamp(var(--space-5), 2.6vw, var(--space-8)) 0 0; }
  .lp-card { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr); border-radius: var(--radius); background: var(--ground); border: 1px solid var(--line-strong); }
  .lp-price { display: grid; gap: var(--space-2-5); align-content: start; padding: clamp(var(--space-7), 4vw, var(--space-14)); border-right: 1px solid var(--line); }
  .lp-pkg { display: flex; align-items: center; gap: var(--space-3-5); margin-bottom: clamp(var(--space-2-5), 2vw, var(--space-6)); }
  .lp-pkg canvas { width: 3.5rem; height: 3.5rem; flex: none; }
  .lp-name { font: 500 var(--text-control)/1 var(--display); letter-spacing: 0.14em; color: var(--head); }
  .lp-amount { margin: 0; font: 600 clamp(2.75rem, 5.2vw, 5.5rem)/0.95 var(--display); letter-spacing: -0.05em; color: var(--head); white-space: nowrap; }
  .lp-pre { display: block; margin-bottom: var(--space-2-5); font-size: var(--text-label); letter-spacing: 0.1em; color: var(--faint); }
  .lp-unit { margin: var(--space-1-5) 0 0; color: var(--muted); font-size: var(--text-copy); max-width: 26ch; }
  .lp-scale { margin: var(--space-2-5) 0 0; padding-top: var(--space-3-5); border-top: 1px dashed var(--line-strong); color: var(--faint); }
  /* Gruppen nebeneinander, der Bonus als Leiste darunter über die ganze Breite */
  .lp-groups { display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); align-content: start; }
  .lp-groups[data-n='2'] { --cols: 2; }
  .lp-groups[data-n='1'] { --cols: 1; }
  .lp-group { padding: clamp(var(--space-7), 3.4vw, var(--space-12)) clamp(var(--space-5-5), 2.6vw, var(--space-10)); border-left: 1px solid var(--line); display: grid; gap: var(--space-4-5); align-content: start; }
  .lp-groups > :first-child { border-left: 0; }
  .lp-group h2, .lp-group h3 { font: 400 var(--text-xs)/1.5 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  .lp-group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3-5); max-width: 30rem; }
  .lp-group li { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); gap: var(--space-3); align-items: baseline; color: var(--text); font-size: 0.96875rem; line-height: 1.4; }
  .lp-group li.has-value { grid-template-columns: 1.25rem minmax(0, 1fr) auto; }
  .lp-group li :global(.ico) { width: 1.125rem; height: 1.125rem; transform: translateY(0.1875rem); }
  .lp-pt { width: 0.375rem; height: 0.375rem; margin: 0 var(--space-1-75); border-radius: var(--radius-round); background: var(--accent); transform: translateY(-0.125rem); }
  .lp-group li b { font: 500 var(--text-control)/1.4 var(--display); color: var(--head); white-space: nowrap; padding-left: var(--space-2); }
  .lp-bonus { grid-column: 1 / -1; border-top: 1px solid var(--line); display: flex; align-items: center; gap: var(--space-3) var(--space-7); flex-wrap: wrap; padding: clamp(var(--space-4-5), 2vw, var(--space-6-5)) clamp(var(--space-5-5), 2.6vw, var(--space-10)); }
  .lp-bonus-v { font: 600 clamp(2.5rem, 4vw, 4rem)/0.95 var(--display); letter-spacing: -0.05em; }
  .lp-bonus p { color: var(--muted); max-width: 46ch; margin: 0; }
  /* CtaBox ist eine eigene Komponente: Abstand über :global, sonst greift das Komponenten-CSS nicht */
  :global(.lp-close) { margin-top: clamp(var(--space-8), 4vw, var(--space-14)); }
  @media (--grid-stacked) {
    .lp-card { grid-template-columns: 1fr; }
    .lp-price { border-right: 0; border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 47.5em) {
    .lp-groups, .lp-groups[data-n='2'] { grid-template-columns: 1fr; }
    .lp-group { border-left: 0; border-top: 1px solid var(--line); }
    .lp-groups > :first-child { border-top: 0; }
    .lp-bonus { display: grid; }
  }
  /* Indoor-Variante: zweigeteilte Karte. Links Preis und Anfrage auf eigener Fläche, rechts gleich große Faktor-Zellen,
     darunter über die ganze Breite „immer enthalten“. Kopf zweispaltig, damit über der Karte keine leere Hälfte bleibt. */
  .lp-f :global(.lp-f-head) { max-width: none; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--head-gap-text) clamp(var(--space-8), 6vw, var(--space-20)); align-items: end; }
  .lp-f :global(.lp-f-head > p) { margin: 0; max-width: 48ch; }
  .lp-sheet { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 8fr); border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--ground); overflow: hidden; }
  .lp-buy { display: grid; align-content: start; gap: var(--space-2-5); padding: clamp(var(--space-7), 3.4vw, var(--space-12)); background: var(--surface); border-right: 1px solid var(--line); }
  .lp-f .lp-amount { font-size: clamp(3rem, 5vw, 5.75rem); }
  .lp-f .lp-unit { max-width: none; }
  .lp-buy-close { display: grid; gap: var(--space-2); margin-top: clamp(var(--space-6), 3vw, var(--space-10)); padding-top: clamp(var(--space-5), 2.4vw, var(--space-8)); border-top: 1px solid var(--line); }
  .lp-buy-close .lp-close-h { margin: 0; font: 500 clamp(1.25rem, 1.6vw, 1.5rem)/1.2 var(--display); letter-spacing: -0.01em; color: var(--head); }
  .lp-buy-close p { margin: 0; color: var(--muted); max-width: 40ch; text-wrap: pretty; }
  .lp-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); margin-top: var(--space-4); }
  .lp-actions .link { align-self: center; }
  .lp-sheet-dl :global(.ico) { flex: none; }
  .lp-factors { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr)); }
  .lp-factors[data-n='2'] { --n: 2; }
  .lp-factors[data-n='4'] { --n: 2; }
  .lp-factor { display: grid; grid-template-rows: auto 1fr auto auto; align-content: start; gap: var(--space-3); padding: clamp(var(--space-7), 3.4vw, var(--space-12)) clamp(var(--space-5), 2.2vw, var(--space-9)); border-left: 1px solid var(--line); }
  .lp-factor:first-child { border-left: 0; }
  .lp-factor-h { display: inline-flex; align-items: center; gap: var(--space-2-5); font: 400 var(--text-xs)/1.5 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  /* Punktfelder: gemeinsame Grundlinie über dem Wert, gleiche Punktgröße in allen Zellen (Breite nach Spaltenzahl) */
  .lp-dots { align-self: end; justify-self: start; display: block; height: auto; margin: clamp(var(--space-5), 2.4vw, var(--space-9)) 0 var(--space-2); overflow: visible; }
  .lp-dots { --pitch: clamp(0.75rem, 0.95vw, 1.0625rem); }
  .lp-dots-area, .lp-dots-drones { width: min(100%, calc(var(--pitch) * 10)); }
  .lp-dots-duration { width: min(100%, calc(var(--pitch) * 8)); }
  .lp-dots { --cx: var(--cx0); --cy: var(--cy0); }
  .lp-base circle { fill: rgb(var(--rgb-text) / 0.22); }
  .lp-base circle.half { fill: rgb(var(--rgb-amber) / 0.45); }
  .lp-lit { fill: var(--amber); filter: drop-shadow(0 0 0.1875rem rgb(var(--rgb-amber) / 0.85)); }
  .lp-lit circle { transition: opacity var(--dur-underline) var(--ease-default); }
  .lp-hit rect { fill: transparent; }
  /* Fläche: Block (5 × 4) um die gezeigte Zelle, am Rand eingeklemmt; Bereich: hell bis zur gezeigten Spalte, mindestens --min */
  .is-block { --ccx: clamp(var(--hx), var(--cx), var(--W) - 1 - var(--hx)); --ccy: clamp(var(--hy), var(--cy) - var(--oy), var(--H) - 1 - var(--hy)); }
  .is-block .lp-lit circle { opacity: calc(clamp(0, (var(--hx) + 0.5 - max(var(--x) - var(--ccx), var(--ccx) - var(--x))) * 4, 1) * clamp(0, (var(--hy) + 0.5 - max(var(--y) - var(--ccy), var(--ccy) - var(--y))) * 4, 1)); }
  .is-range .lp-lit circle { opacity: clamp(0, (max(var(--min), var(--cx)) - var(--x) + 1) * 4, 1); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .lp-hit { cursor: crosshair; }
    .lp-dots:has(.zc0:hover) { --cx: 0; } .lp-dots:has(.zc1:hover) { --cx: 1; } .lp-dots:has(.zc2:hover) { --cx: 2; } .lp-dots:has(.zc3:hover) { --cx: 3; } .lp-dots:has(.zc4:hover) { --cx: 4; } .lp-dots:has(.zc5:hover) { --cx: 5; } .lp-dots:has(.zc6:hover) { --cx: 6; } .lp-dots:has(.zc7:hover) { --cx: 7; } .lp-dots:has(.zc8:hover) { --cx: 8; } .lp-dots:has(.zc9:hover) { --cx: 9; }
    .lp-dots:has(.zr0:hover) { --cy: 0; } .lp-dots:has(.zr1:hover) { --cy: 1; } .lp-dots:has(.zr2:hover) { --cy: 2; } .lp-dots:has(.zr3:hover) { --cy: 3; } .lp-dots:has(.zr4:hover) { --cy: 4; } .lp-dots:has(.zr5:hover) { --cy: 5; } .lp-dots:has(.zr6:hover) { --cy: 6; } .lp-dots:has(.zr7:hover) { --cy: 7; } .lp-dots:has(.zr8:hover) { --cy: 8; } .lp-dots:has(.zr9:hover) { --cy: 9; }
  }
  .lp-factor-v { margin-top: var(--space-2); font: 600 clamp(1.75rem, 2.6vw, 2.75rem)/1 var(--display); letter-spacing: -0.035em; color: var(--head); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .lp-factor-t { color: var(--muted); font-size: var(--text-copy); line-height: 1.5; text-wrap: pretty; }
  .lp-incl { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) clamp(var(--space-6), 3vw, var(--space-10)); padding: clamp(var(--space-5), 2vw, var(--space-7)) clamp(var(--space-7), 3.4vw, var(--space-12)); border-top: 1px solid var(--line); }
  .lp-incl .lp-incl-h { margin: 0; font: 400 var(--text-xs)/1.5 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  .lp-incl ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2-5) clamp(var(--space-5), 2.4vw, var(--space-9)); }
  .lp-incl li { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--text); font-size: var(--text-copy); }
  .lp-incl li :global(.ico) { flex: none; }
  .lp-incl li b { font-weight: 500; color: var(--head); }
  @media (--grid-stacked) {
    .lp-f :global(.lp-f-head) { grid-template-columns: 1fr; align-items: start; }
    .lp-sheet { grid-template-columns: 1fr; }
    .lp-buy { border-right: 0; border-bottom: 1px solid var(--line); }
  }
  /* schmal: Faktoren als Zeilen, Wert rechts neben Titel und Satz, damit die Karte dicht bleibt */
  @media (max-width: 47.5em) {
    .lp-factors, .lp-factors[data-n] { grid-template-columns: 1fr; }
    .lp-factor { grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto; column-gap: var(--space-4); row-gap: var(--space-1-5); border-left: 0; border-top: 1px solid var(--line); padding: var(--space-5) var(--space-5-5); }
    .lp-factor:first-child { border-top: 0; }
    .lp-factor-h { grid-column: 1; grid-row: 1; }
    .lp-dots { display: none; }
    .lp-factor-v { grid-column: 2; grid-row: 1 / span 2; align-self: center; margin: 0; font-size: 1.625rem; }
    .lp-factor-t { grid-column: 1; grid-row: 2; font-size: var(--text-sm); }
    .lp-incl { display: grid; padding: var(--space-5) var(--space-5-5); }
    .lp-incl ul { display: grid; gap: var(--space-2-5); }
    .lp-buy { padding: var(--space-6) var(--space-5-5); }
  }
</style>
