---
// Designsprache-Probe 2 (30.10.2026, nach Marcs Bewertung). Jede Studie ist einzeln bewertbar: ja, nein, mehr davon, anders.
// Basis ist der erste Prototyp (Branch fix/minimal-fonts), Fakten aus Moritz' Notizen vom 30.10.2026.
import Base from '../../layouts/Base.astro';
import LocalImage from '../../components/LocalImage.astro';
import Comparison from '../../components/sections/Comparison.astro';
import Chopper404 from '../../components/Chopper404.astro';
import { getEntry } from 'astro:content';
import { existsSync, readFileSync } from 'node:fs';
import { optimizedImage, optimizedLogo } from '../../lib/media';
import '../../styles/poc.css';

const home = await getEntry('pages', 'index');
const vergleich = home!.data.sections.find((s: any) => s.id === 'vergleich') as any;

const U = 'https://flyingstars.art/wp-content/uploads/';
const shots = await Promise.all([
  { src: `${U}2024/07/Prada_Cover_img.jpg`, alt: 'Drohnenformation über der Düsseldorfer Skyline am Rheinturm, Show für L’Oréal und Prada' },
  { src: `${U}2024/12/VW50Golf.jpg`, alt: 'Drohnenshow über dem Wolfgangsee zu 50 Jahren VW Golf, Gäste auf einer Terrasse' },
  { src: `${U}2025/10/Extraschicht_Duisburg.jpg`, alt: 'Weltkugel aus Drohnen über dem Rhein bei der Extraschicht in Duisburg' },
].map(async s => ({ ...s, img: await optimizedImage(s.src, 960) })));

const founders = await Promise.all([
  { name: 'Ronja Donsbach', first: 'Ronja', src: `${U}2024/08/Ronja_Teamfoto.jpg`, role: 'Geschäftsführerin', line: 'Beantwortet die meisten Anfragen, auch auf Englisch, und stimmt Design und Musik ab.' },
  { name: 'Florian Becker', first: 'Florian', src: `${U}2024/08/Florian_Teamfoto.jpg`, role: 'Geschäftsführer', line: 'Kümmert sich um Verwaltung, Personal und Kund:innen in Deutschland. Schreibt den Blog.' },
  { name: 'Erwin Wilms', first: 'Erwin', src: `${U}2024/08/Erwin_Teamfoto.jpg`, role: 'Geschäftsführer', line: 'Anträge, Behörden und Luftfahrtrecht. Sorgt dafür, dass eure Show fliegen darf.' },
].map(async f => ({ ...f, img: await optimizedImage(f.src, 400) })));

// Kund:innen: nur bekannte Marken (Recherche Runde 2). Saubere SVGs, wo vorhanden, sonst das Live-PNG.
// Red Bull, Lamborghini, Bentley, ABUS: Show bisher nicht belegt, Beleg bei FlyingStars anfragen.
const logoNames: [string, string][] = [
  ['E.ON', 'svg:kunde-eon-weiss'], ['REWE', 'svg:kunde-rewe-weiss'], ['Spotify', 'svg:kunde-spotify-weiss'], ['L’Oréal', 'svg:kunde-loreal-weiss'],
  ['Bosch', 'svg:bosch-weiss'], ['Amazon', 'svg:kunde-amazon-weiss'], ['NFL', '2023/04/National_Football_League_2008_weiss.png'], ['McKinsey', 'svg:kunde-mckinsey-weiss'],
  ['PUMA', '2023/04/Puma_Logo_weiss.png'], ['Prada', 'svg:kunde-prada-weiss'], ['Volkswagen', 'svg:kunde-volkswagen-weiss'], ['Red Bull', '2024/10/RED-BULL_white.png'],
  ['Bulgari', 'svg:kunde-bulgari-weiss'], ['Ford', 'svg:kunde-ford-weiss'], ['Siemens', 'svg:kunde-siemens-weiss'], ['Lamborghini', 'svg:kunde-lamborghini-weiss'],
  ['Deutsche Umwelthilfe', '2023/04/Deutsche_Umwelthilfe_weiss.png'], ['Bentley', '2023/04/Bentley_logo_weiss.png'], ['ABUS', '2023/04/ABUS_Logo_weiss.png'],
];
// SVGs bekommen 4 % Luft um den viewBox, sonst wirken runde Marken (VW, Spotify, Ford) am Rand angeschnitten
const svgLogo = (file: string) => {
  let t = readFileSync(new URL(`../../../public/poc/logos/${file}.svg`, import.meta.url), 'utf8');
  const m = t.match(/viewBox="([\d.\s-]+)"/)!;
  const [x, y, w, h] = m[1].trim().split(/\s+/).map(Number), p = Math.max(w, h) * 0.04;
  t = t.replace(m[0], `viewBox="${x - p} ${y - p} ${w + 2 * p} ${h + 2 * p}"`).replace(/\s(width|height)="[^"]*"/g, '');
  return { src: `data:image/svg+xml;utf8,${encodeURIComponent(t)}`, ratio: (w + 2 * p) / (h + 2 * p) };
};
// Marken mit schwarzen Innendetails im PNG (Bentley) nicht weiß einfärben, sonst wird die Form zum Fleck
const keepDetail = new Set(['Bentley']);
// optische Größe: breite Wortmarken flacher, runde Bildmarken höher, damit alle gleich schwer wirken
const optical = (ratio: number) => Math.round(Math.min(46, Math.max(22, 30 * Math.sqrt(3 / ratio))));
const logos = (await Promise.all(logoNames.map(async ([name, path]) => {
  try {
    if (path.startsWith('svg:')) { const { src, ratio: r } = svgLogo(path.slice(4)); const h = optical(r); return { name, src, width: Math.round(h * r), height: h, detail: keepDetail.has(name) }; }
    const img = await optimizedLogo(U + path, 92); const r = img.width / img.height, h = optical(r);
    return { name, src: img.src, width: Math.round(h * r), height: h, detail: keepDetail.has(name) };
  } catch { return null; }
}))).filter(Boolean) as { name: string; src: string; width: number; height: number; detail: boolean }[];

const press = [
  { name: 'ZDF', note: '1, 2 oder 3', href: '', logo: '/poc/logos/presse-zdf.svg', knock: true },
  { name: 'WDR', note: 'Fernsehen und Interviews', href: '', logo: '/poc/logos/presse-wdr.svg' },
  { name: 'ntv', note: 'Startup News', href: 'https://www.n-tv.de/mediathek/magazine/startup_news/Drohnen-verwandeln-Nachthimmel-in-Showbuehne-article25835436.html', logo: '/poc/logos/presse-ntv.svg', knock: true },
  { name: 'tagesschau', note: '#BÖLLERCIAO in Berlin', href: '', logo: '/poc/logos/presse-tagesschau.svg' },
  { name: 'Tagesspiegel', note: 'Interview mit Erwin', href: 'https://www.tagesspiegel.de/berlin/drohnen-statt-boller-deutsche-umwelthilfe-zeigt-alternative-zum-berliner-silvester-feuerwerk-10846906.html', logo: '/poc/logos/presse-tagesspiegel.svg' },
  { name: 'WAZ', note: 'Ruhrorter Hafenfest', href: 'https://www.waz.de/lokales/duisburg/article409722481/ruhrorter-hafenfest-die-geheimnisse-hinter-dem-neuen-highlight.html', logo: '/poc/logos/presse-waz.svg' },
];
// Logos werden nur gezeigt, wenn die Datei vorliegt; sonst Text (und live nur mit schriftlicher Freigabe)
const hasFile = (path: string) => existsSync(new URL(`../../../public${path}`, import.meta.url));
const pressShown = press.map(p => ({ ...p, logo: p.logo && hasFile(p.logo) ? p.logo : '' }));

const quality = [
  { title: 'Betriebsgenehmigung', text: 'vom Luftfahrt-Bundesamt, EU-weit nach EASA-Regeln', icon: 'permit', logo: '/poc/logos/quali-lba-weiss.png' },
  { title: 'Schallschutz-Gutachten', text: 'vom TÜV Nord', icon: 'sound', logo: '' },
  { title: 'Haftpflicht bis 1,3 Mio. €', text: 'in jedem Paket enthalten', icon: 'shield', logo: '' },
  { title: 'Ökostrom von naturstrom', text: 'für die ganze Flotte', icon: 'leaf', logo: '/poc/logos/quali-naturstrom.svg' },
].map(q => ({ ...q, logo: q.logo && hasFile(q.logo) ? q.logo : '' }));

const occasions = ['Firmenevent', 'Stadt & Festival', 'Agentur', 'Hochzeit & Privat', 'Indoor', 'Sonstiges'];
// Paket im Formular (Marc 30.10.: sehr relevant für das Angebot); Beschreibungen wie im Konfigurator
const packs: [string, string][] = [['SPARK', 'klassisch in 2D'], ['HORIZON', '3D in Bewegung'], ['ODYSSEY', 'erzählte 3D-Show'], ['Weiß ich noch nicht', '']];
---
<Base title="Designsprache, Probe 3" description="Proof of Concept der Designsprache für den FlyingStars-Relaunch." noindex fullBleed>
  <script is:inline>document.documentElement.classList.add('js-poc');</script>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><linearGradient id="poc-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff9e29" /><stop offset=".5" stop-color="#db64e8" /><stop offset="1" stop-color="#33edf2" /></linearGradient></defs></svg>
  <main id="main" class="poc">
    <header class="poc-intro">
      <h1>Designsprache, Probe 3</h1>
      <p>Dritte Runde nach Marcs Bewertung vom 30.10. Jede Studie sagt in der Notiz, was sich geändert hat.</p>
      <ol class="poc-toc">
        <li><a href="#s1">Logo wird Formation</a></li><li><a href="#s2">Bewegung</a></li><li><a href="#s3">Schrift</a></li>
        <li><a href="#s4">Section-Köpfe</a></li><li><a href="#s5">Bilder aus Lichtpunkten</a></li><li><a href="#s6">Kund:innen, Presse, Qualität</a></li>
        <li><a href="#s7">Vergleich in Farbe</a></li><li><a href="#s8">Anfrage</a></li><li><a href="#s9">Chopper auf der 404</a></li>
      </ol>
    </header>

    {/* 1 */}
    <section class="study" id="s1" aria-labelledby="s1-h">
      <aside class="note"><span class="n">1</span><b>Logo wird Formation</b><p><em>Neu:</em> Alle Texte (Schriftzug, eigener Text, MOIN) kommen jetzt aus FlyingStars' eigenem Textplaner in Einstrich-Schrift, derselbe wie im Konfigurator: eine Drohne auf jeder Ecke und jedem Ende, gleichmäßige Abstände, lesbar ab etwa 100 Drohnen. Logos stehen 5 s, Herz und MOIN 2 s. Neue Drohnenzahl springt zurück zum Logo. Eigener Text erscheint kurz nach dem Tippen. Beim Hovern tritt die Bühne zurück (abgedunkelt, weichgezeichnet). Kein Einrasten mehr vor Übergängen, Punktgröße gleitet.</p><p>Gedacht als Teil des Konfigurators neben dem eigenen Text; der Einbau dort kommt mit der Übertragung auf alle Seiten.</p><p class="q">Bewerten: Schriftzug, eigener Text, Haltezeiten.</p></aside>
      <div class="demo logo-lab" data-logo-lab>
        <div class="lab-copy">
          <h2 id="s1-h">Wie sieht euer Logo am Himmel aus?</h2>
          <p>Zieh dein Logo auf die Bühne oder wähle eine Datei aus. Wir rechnen es direkt hier in Drohnen um.</p>
          <label class="btn primary file"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0-5 5m5-5 5 5M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>Logo hochladen<input type="file" accept="image/svg+xml,image/png,image/jpeg,image/webp" data-file /></label>
          <form class="own-text"><label for="lab-text">oder eigener Text</label><div><input id="lab-text" type="text" maxlength="14" placeholder="z. B. 25 JAHRE" autocomplete="off" data-text /></div></form>
          <fieldset class="seg"><legend>Drohnen</legend>
            <label><input type="radio" name="lab-n" value="100" /><span>100</span></label>
            <label><input type="radio" name="lab-n" value="200" /><span>200</span></label>
            <label><input type="radio" name="lab-n" value="300" checked /><span>300</span></label>
            <label><input type="radio" name="lab-n" value="600" /><span>600</span></label>
          </fieldset>
          <fieldset class="seg"><legend>Farben</legend>
            <label><input type="radio" name="lab-c" value="source" checked /><span>wie im Logo</span></label>
            <label><input type="radio" name="lab-c" value="gradient" /><span>FlyingStars-Verlauf</span></label>
          </fieldset>
          <p class="lab-status" data-status aria-live="polite">Das FlyingStars-Logo mit 300 Drohnen.</p>
          <p class="lab-legal">Lade nur Logos hoch, die du verwenden darfst, zum Beispiel dein eigenes. Die Datei bleibt in deinem Browser: Wir speichern und übertragen sie nicht. Für die echte Show baut unser Team eine eigene Drohnenfassung.</p>
        </div>
        <div class="stage-wrap">
          <canvas class="stage" data-stage aria-label="Vorschau: Logo als Drohnenformation" role="img"></canvas>
          <div class="drop" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24"><path d="M12 16V4m0 0-5 5m5-5 5 5M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg><span>Dein Logo hier reinziehen</span><small>SVG, PNG oder JPG</small></div>
          <button class="stage-btn" type="button" data-pause aria-pressed="false">Anhalten</button>
        </div>
      </div>
    </section>

    {/* 2 */}
    <section class="study" id="s2" aria-labelledby="s2-h">
      <aside class="note"><span class="n">2</span><b>Bewegung</b><p><em>Neu:</em> Kein Einrasten mehr: Ein Schwebe-Anteil wirkte schon beim Start eines Übergangs und ließ alle Drohnen kurz springen, jetzt ist er an Start und Ziel null. Der Lichtlauf startet erst mit der Ankunft der Form, vor ihrem Anfang, und blendet weich ein; vorher konnte er mitten in der Form aufblitzen. Standbild 2 s.</p><p class="q">Bewerten: Ist der Übergang jetzt durchgehend weich?</p></aside>
      <div class="demo motion-lab" data-motion-lab>
        <h2 id="s2-h" class="sr-only">Bewegung</h2>
        <canvas class="stage" data-stage role="img" aria-label="Drohnenformation wechselt zwischen Herz, Ring, Schriftzug und Anker"></canvas>
        <div class="controls">
          <label class="check"><input type="checkbox" data-wave checked /> Lichtlauf</label>
          <label class="range">Vorführtempo <input type="range" min="0.5" max="2" step="0.1" value="1" data-speed /></label>
          <button class="btn small" type="button" data-next>Nächstes Motiv</button>
        </div>
      </div>
    </section>

    {/* 3 */}
    <section class="study" id="s3" aria-labelledby="s3-h">
      <aside class="note"><span class="n">3</span><b>Schrift: Space Grotesk</b><p><em>Neu:</em> Nur die durchgestrichene Null bleibt. Sie steckt jetzt in der normalen Schriftdatei (dieselbe Version 2.000, gleiche Metriken, 21,5 statt 22,3 KB), es wird also keine zusätzliche Datei geladen. Mediävalziffern, Tabellenziffern-Variante und einstöckiges a sind raus.</p><p class="q">Bewerten: Null überall so?</p></aside>
      <div class="demo type-lab">
        <h2 id="s3-h" class="sr-only">Schrift und Ziffern</h2>
        <div class="type-card"><span class="meta">Space Grotesk mit durchgestrichener Null</span><p class="tw">Wir gestalten euer <span class="grad">Stück Himmel.</span></p><p class="nums big">2026 · 600 Drohnen · 10.000 m²</p><p class="nums">178 Shows seit 2022 · ab 7.900 €</p></div>
        <div class="type-card plain0"><span class="meta">zum Vergleich: bisherige Null</span><p class="nums big">2026 · 600 Drohnen · 10.000 m²</p></div>
      </div>
    </section>

    {/* 4 */}
    <section class="study" id="s4" aria-labelledby="s4-h">
      <aside class="note"><span class="n">4</span><b>Section-Köpfe</b><p><em>Gilt für alle Seiten.</em> Nur die Headline, einspaltig. <em>Neu:</em> Headline warm, knapp unter Weiß (#ede6da), Fließtext eine Stufe dunkler (#a89c8b, Kontrast 7,2 : 1). Der Abstand zwischen beiden ist damit etwas größer als im Prototyp.</p><p class="q">Bewerten: Passt die Abstufung?</p></aside>
      <div class="demo heads">
        <h2 id="s4-h" class="sr-only">Section-Köpfe im Vergleich</h2>
        <div class="head-old"><span class="tag">bisher</span><div class="sec-head"><div><span class="kicker mono">Anlässe</span><h3 class="h2 white">Für jeden Anlass die passende Show.</h3></div><p>Ob Firmenjubiläum, Stadtfest oder Hochzeit: Wir entwickeln für jeden Anlass eine Show, die zu euch passt.</p></div></div>
        <div class="head-new"><span class="tag">neu</span><h3 class="h2">Für jeden Anlass die passende Show.</h3></div>
        <div class="head-new"><span class="tag">neu, mit Satz</span><h3 class="h2">Bucht im Vorjahr, spart 10 %.</h3><p class="under">Gilt für Shows im Folgejahr bei Buchung bis zum 31. Dezember.</p></div>
      </div>
    </section>

    {/* 5 */}
    <section class="study" id="s5" aria-labelledby="s5-h">
      <aside class="note"><span class="n">5</span><b>Bilder aus Lichtpunkten</b><p><em>Neu:</em> Unter der Maus funkeln die Lichter leicht gegeneinander versetzt, die hellsten bekommen einen langsam pulsierenden Schein. Gedacht nur für Bilder, mit denen man interagiert: Anlass-Karten, Referenzen, Team. Hier auch an den Porträts in Studie 8.</p><p>Kosten: keine zusätzlichen Daten (das Foto ist schon geladen, Skript ca. 2 KB gzip). Vorbereitung einmal im Leerlauf, danach fünf Bildkopien pro Frame. Messwerte im Bericht.</p><p class="q">Bewerten: Stärke des Funkelns.</p></aside>
      <div class="demo shots">
        <h2 id="s5-h" class="sr-only">Showbilder</h2>
        {shots.map((s, i) => <figure class:list={['dot-img', 'curtain', { wide: i === 0 }]} data-dot-img data-curtain><img src={s.img.src} width={s.img.width} height={s.img.height} alt={s.alt} loading="lazy" decoding="async" /></figure>)}
      </div>
    </section>

    {/* 6 */}
    <section class="study" id="s6" aria-labelledby="s6-h">
      <aside class="note"><span class="n">6</span><b>Kund:innen, Presse, Qualität</b><p><em>Neu:</em> Alle SVGs mit etwas Luft (nichts mehr angeschnitten). Red Bull, Bentley und Umwelthilfe wieder aus den Live-PNGs (die SVG-Fassungen passten nicht), Bentley behält seine Innendetails. Presse ohne Beitragszeile. LBA-Signet (gemeinfrei, ohne Bundesadler) und naturstrom als Logo; TÜV und Haftpflicht als Icon im Verlauf, weil das TÜV-Zeichen nur mit Zertifikat erlaubt ist und der Versicherer nirgends öffentlich genannt wird.</p><p>Vor dem Livegang: Presselogos nur mit schriftlicher Freigabe (Moritz). Namentlich belegt sind nur ntv und WAZ; die tagesschau nennt FlyingStars nicht, im Tagesspiegel-Artikel kommen weder FlyingStars noch Erwin vor. LBA und TÜV Nord als Icon mit Text: Das TÜV-Zeichen gibt es nur mit Zertifikat. Das naturstrom-Logo nur nach Anfrage bei naturstrom. Red Bull, Lamborghini, Bentley und ABUS: Beleg für eine Show anfragen.</p><p class="q">Bewerten: Auswahl der Logos, Platz auf der Startseite.</p></aside>
      <div class="demo proof">
        <h2 id="s6-h" class="sr-only">Kund:innen, Presse und Qualität</h2>
        <div class="poc-marquee" data-poc-marquee aria-label="Kund:innen von FlyingStars" role="region">
          <ul class="track">{logos.map(l => <li><img class:list={[{ detail: l.detail }]} src={l.src} width={l.width} height={l.height} style={`height:${l.height / 16}rem`} alt={l.name} loading="lazy" decoding="async" /></li>)}</ul>
          <ul class="track" aria-hidden="true">{logos.map(l => <li><img class:list={[{ detail: l.detail }]} src={l.src} width={l.width} height={l.height} style={`height:${l.height / 16}rem`} alt="" loading="lazy" decoding="async" /></li>)}</ul>
        </div>
        <div class="press">
          <h3>Unsere Shows waren zu sehen in</h3>
          <ul>{pressShown.map(p => {
            const inner = p.logo ? <LocalImage class:list={[{ knock: p.knock }]} src={p.logo} alt={p.name} loading="lazy" /> : <b>{p.name}</b>;
            return <li>{p.href ? <a href={p.href} rel="noopener" target="_blank" title={`${p.name}: ${p.note}`}>{inner}</a> : <span class="noref" title={p.note}>{inner}</span>}</li>;
          })}</ul>
        </div>
        <div class="quality">
          <h3>Qualität und Sicherheit</h3>
          <ul>{quality.map(q => <li>
            {q.logo ? <LocalImage class="q-logo" src={q.logo} alt="" loading="lazy" /> : <svg class="q-ico" viewBox="0 0 24 24" aria-hidden="true">
              {q.icon === 'permit' && <path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13l2 2 4-4" />}
              {q.icon === 'sound' && <path d="M4 10v4h4l5 4V6L8 10zm12-1a4 4 0 0 1 0 6m2-9a8 8 0 0 1 0 12" />}
              {q.icon === 'shield' && <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4" />}
              {q.icon === 'leaf' && <path d="M5 19c0-9 6-14 15-14 0 9-5 15-14 15m0-1 7-7" />}
            </svg>}
            <b>{q.title}</b><span>{q.text}</span></li>)}</ul>
        </div>
      </div>
    </section>

    {/* 7 */}
    <section class="study" id="s7" aria-labelledby="s7-h">
      <aside class="note"><span class="n">7</span><b>Vergleich in Farbe</b><p>Bleibt so, die Drohnenshow-Spalte ist hervorgehoben.</p></aside>
      <div class="demo compare"><Comparison {...vergleich} kicker={undefined} text={undefined} id="s7-h-wrap" index={1} /></div>
    </section>

    {/* 8 */}
    <section class="study" id="s8" aria-labelledby="s8-h">
      <aside class="note"><span class="n">8</span><b>Anfrage</b><p><em>Neu:</em> Headline oben bündig mit dem Formular, Gesichter darunter. Paket als Auswahl im ersten Schritt. Porträts werden beim Hovern zu Lichtpunkten. Texte macht Moritz, große Fotos fragen wir bei FlyingStars an.</p><p class="q">Bewerten: Felder, Aufteilung, Ausrichtung.</p></aside>
      <div class="demo contact">
        <div class="contact-copy">
          <h2 id="s8-h">Erzählt uns von eurem Termin.</h2>
          <p>Ronja, Florian oder Erwin melden sich innerhalb von 48 Stunden. Meistens ist es Ronja.</p>
          <div class="faces">{founders.map(f => <span class="face" data-dot-img data-step="4"><img src={f.img.src} width={f.img.width} height={f.img.height} alt={f.name} loading="lazy" /></span>)}</div>
          <ul class="ways">
            <li><a href="mailto:team@flyingstars.art"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4zm0 0 8 7 8-7" /></svg><span>team@flyingstars.art</span></a></li>
            <li><a href="tel:+4920988306562"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h3l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v3a2 2 0 0 1-2 2A17 17 0 0 1 4 5a2 2 0 0 1 2-2z" /></svg><span>0209 883 065 62</span></a></li>
            <li><a href="https://calendly.com/team-flyingstars/beratung" rel="noopener" target="_blank"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h12v10H3zm12 3 6-3v10l-6-3" /></svg><span>Videocall buchen</span></a></li>
            <li><a href="https://wa.me/4915792608672"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7zM9 9c0 3 3 6 6 6l1-1.5-2-1-1 1a5 5 0 0 1-2.5-2.5l1-1-1-2z" /></svg><span>WhatsApp</span></a></li>
          </ul>
        </div>
        <form class="ask" data-inquiry novalidate>
          <div class="ask-steps" aria-hidden="true"><span class="on">1 Deine Show</span><span>2 Du</span><i></i></div>
          <fieldset class="step" data-step="1">
            <legend class="sr-only">Schritt 1 von 2: Deine Show</legend>
            <div class="field"><span class="lbl">Wofür ist die Show?</span><div class="chips">{occasions.map((o, i) => <label><input type="radio" name="anlass" value={o} required={i === 0} /><span>{o}</span></label>)}</div></div>
            <div class="row2">
              <label class="field"><span class="lbl">Wo soll sie stattfinden?</span><input type="text" name="ort" required autocomplete="address-level2" /><span class="hint">Ort oder PLZ, bei Shows im Ausland mit Land</span></label>
              <div class="field"><label class="lbl" for="f-datum">Wann soll sie fliegen?</label><input id="f-datum" type="date" name="datum" /><label class="hint"><input type="checkbox" name="datum-offen" data-date-open /> Noch nicht festgelegt</label></div>
            </div>
            <div class="field"><span class="lbl">Welches Paket? <em>optional</em></span><div class="chips">{packs.map((k, i) => <label title={k[1]}><input type="radio" name="paket" value={k[0]} checked={i === packs.length - 1} /><span>{k[0]}</span></label>)}</div><span class="hint">SPARK klassisch in 2D · HORIZON 3D in Bewegung · ODYSSEY erzählte 3D-Show</span></div>
            <label class="field"><span class="lbl">Was soll am Himmel passieren? <em>optional</em></span><textarea name="idee" rows="3"></textarea><span class="hint">Logo, Motiv, Claim, Musikwunsch, Anzahl Gäste: alles, was du schon weißt</span></label>
            <button class="btn primary" type="button" data-next-step>Weiter</button>
          </fieldset>
          <fieldset class="step" data-step="2" hidden>
            <legend class="sr-only">Schritt 2 von 2: Du</legend>
            <div class="row2">
              <label class="field"><span class="lbl">Dein Name</span><input type="text" name="name" autocomplete="name" required /></label>
              <label class="field"><span class="lbl">Deine E-Mail-Adresse</span><input type="email" name="email" autocomplete="email" required /></label>
            </div>
            <div class="row2">
              <label class="field"><span class="lbl">Deine Telefonnummer <em>optional</em></span><input type="tel" name="telefon" autocomplete="tel" /><span class="hint">Für einen Rückruf, wenn du magst</span></label>
              <label class="field"><span class="lbl">Firma oder Organisation <em>optional</em></span><input type="text" name="firma" autocomplete="organization" /></label>
            </div>
            <label class="field"><span class="lbl">Wie hast du von uns erfahren? <em>optional</em></span><select name="quelle"><option value="">Bitte wählen</option><option>Google</option><option>Empfehlung</option><option>Social Media</option><option>Presse</option><option>Eine Show gesehen</option><option>Sonstiges</option></select></label>
            <p class="hint">Mit dem Absenden werden deine Angaben zur Bearbeitung der Anfrage verwendet. Mehr dazu in der <a href="/datenschutz/">Datenschutzerklärung</a>.</p>
            <div class="actions"><button class="btn" type="button" data-prev-step>Zurück</button><button class="btn primary" type="submit">Anfrage senden</button></div>
          </fieldset>
          <p class="sent" hidden aria-live="polite">Danke, wir haben deine Anfrage. Wir melden uns innerhalb von 48 Stunden. (In der Probe wird nichts verschickt.)</p>
        </form>
        <div class="team-row">
          {founders.map((f, i) => <article class="member" style={`--i:${i}`}><div class="portrait" data-dot-img data-step="6"><img src={f.img.src} width={f.img.width} height={f.img.height} alt={`${f.name} mit einer Drohne in der Hand`} loading="lazy" /></div><h3>{f.name}</h3><p class="role">{f.role}</p><p>{f.line}</p></article>)}
        </div>
        {/* Startzustand vor dem ersten Bild setzen: sonst ist das Team kurz sichtbar und blendet aus, bevor der Reveal läuft */}
        <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) document.querySelectorAll('.team-row .member').forEach(m => m.classList.add('pre'));</script>
      </div>
    </section>

    {/* 9 */}
    <section class="study" id="s9" aria-labelledby="s9-h">
      <aside class="note"><span class="n">9</span><b>Chopper auf der 404</b><p><em>Neu:</em> Die Wende läuft als kurze lebendige Wolke (1,1 s) statt Stauchen. Sonst wie gehabt: Propellermütze, gut 400 Drohnen, Ohr, Schwanz und Propeller einzeln bewegt, bei Button-Hover fliegt er hin. <a href="/gibt-es-nicht/">Echte 404 ansehen</a>.</p><p>Rasse und Fell sind noch geraten; mit einem Foto zeichnen wir die Silhouette nach.</p></aside>
      <div class="demo"><h2 id="s9-h" class="sr-only">Chopper</h2><Chopper404 level="h2" /></div>
    </section>
  </main>
</Base>

<script>
  import { initPoc } from '../../scripts/poc/page.js';
  initPoc();
  // Anfrage in zwei Schritten (Probe: es wird nichts verschickt)
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-inquiry]')) {
    const steps = form.querySelectorAll<HTMLFieldSetElement>('.step'), marks = form.querySelectorAll('.ask-steps span');
    const go = (k: number) => { steps.forEach((s, i) => { s.hidden = i !== k; }); marks.forEach((m, i) => m.classList.toggle('on', i <= k)); form.classList.toggle('is-2', k === 1); steps[k].querySelector<HTMLElement>('input, select, textarea')?.focus(); };
    form.querySelector('[data-next-step]')!.addEventListener('click', () => {
      const anlass = form.querySelector<HTMLInputElement>('input[name=anlass]')!, ort = form.querySelector<HTMLInputElement>('input[name=ort]')!;
      const datum = form.querySelector<HTMLInputElement>('input[name=datum]')!, offen = form.querySelector<HTMLInputElement>('[data-date-open]')!;
      datum.setCustomValidity(datum.value || offen.checked ? '' : 'Bitte ein Datum wählen oder „Noch nicht festgelegt“ ankreuzen.');
      for (const el of [anlass, ort, datum]) if (!el.checkValidity()) { el.reportValidity(); return; }
      go(1);
    });
    form.querySelector('[data-prev-step]')!.addEventListener('click', () => go(0));
    form.addEventListener('submit', e => { e.preventDefault(); if (!form.checkValidity()) { form.reportValidity(); return; } form.querySelector<HTMLElement>('.sent')!.hidden = false; });
  }
</script>
