---
import {nativeField,nativeSection,nativeRecord,nativeItem} from "../../lib/native-editor";
import { getCollection } from 'astro:content';
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'postList' }> & { index: number };
const { headline = 'Aktuelles', limit, index } = Astro.props;
const id = `s${index}-h`;
const H = index === 0 ? 'h1' : 'h2';
const posts = (await getCollection('posts', (p) => process.env.FLYINGSTARS_EDITOR==='1'||!p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, limit);
const fmt = new Intl.DateTimeFormat('de-DE', { dateStyle: 'long' });
---
<section {...nativeSection(Astro.props)} class="section" aria-labelledby={id}>
  <div class="wrap">
    <H id={id} {...nativeField(Astro.props,["headline"])}>{headline}</H>
    <div class="cards">
      {posts.map((p) => (
        <article class="card" {...nativeItem(Astro.props,{record:`post/${p.id}`})}>
          <h3><a href={`/blog/${p.id}/`}><span {...nativeRecord(`post/${p.id}`,["title"])}>{p.data.title}</span></a></h3>
          <p class="muted"><time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time></p>
          <p {...nativeRecord(`post/${p.id}`,["description"])}>{p.data.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
