---
import {nativeField,nativeSection,nativeRecord,nativeRecordMedia} from '../../lib/native-editor';
import {editorialRecord,resolveMedia} from '../../lib/editorial-records';
import {optimizedLogo} from '../../lib/media';
const {headline,text,clientIds,columns='two',background=true,showImages=true,index}=Astro.props;
const id=`testimonials-${index}`,H=index===0?'h1':'h2';
const clients=await Promise.all(clientIds.map(async(id:string)=>{const client=editorialRecord('client',id),image=resolveMedia(client.logo);return {...client,id,image,media:showImages&&image?await optimizedLogo(image.src,56):undefined};}));
---
<section {...nativeSection(Astro.props)} class="section" aria-labelledby={id}>
 <div class="sec-head"><H id={id} {...nativeField(Astro.props,['headline'])}>{headline}</H>{text&&<p {...nativeField(Astro.props,['text'])}>{text}</p>}</div>
 <div class:list={['testimonials',{'testimonials--one':columns==='one','testimonials--plain':!background}]}>{clients.map((client:any)=>{const record=`client/${client.id}`;return <article data-native-item-record={process.env.FLYINGSTARS_EDITOR==='1'?record:undefined}>{client.image&&client.media&&<img {...nativeRecordMedia(record,['logo'])} src={client.media.src} width={client.media.width} height={client.media.height} alt={client.image.alt} loading="lazy"/>}{client.testimonial?<><blockquote><p {...nativeRecord(record,['testimonial','quote'])}>{client.testimonial.quote}</p></blockquote><p class="mono"><span {...nativeRecord(record,['testimonial','person'])}>{client.testimonial.person}</span>{client.testimonial.role&&<span {...nativeRecord(record,['testimonial','role'])}>{client.testimonial.role}</span>}</p></>:<p {...nativeRecord(record,['name'])}>{client.name}</p>}</article>;})}</div>
</section>
<style>.testimonials{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.testimonials article{padding:32px;border:1px solid var(--line,#333);border-radius:12px;background:var(--panel,#151a21)}.testimonials--one{grid-template-columns:1fr}.testimonials--plain article{background:transparent;border:none}.testimonials img{object-fit:contain;max-height:56px;max-width:180px;margin-bottom:24px}.testimonials blockquote{margin:0 0 24px;font-size:1.25rem;line-height:1.6}.testimonials .mono span{display:block}@media(max-width:640px){.testimonials{grid-template-columns:1fr}}</style>
