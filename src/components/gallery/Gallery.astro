---
// Bildleiter (Werbung #marketing, Über uns #nachhaltigkeit, Indoor #referenzen). Runde 7 (Marc, 19.11.2026): „Drei Bilder
// in so einer von links nach rechts angeordneten Leiter, plus die Background-Dot-Shape, und mehr brauchen wir nicht.“
// Drei gleich große Bilder in derselben Form steigen von links unten nach rechts oben, mit gleichmäßigem Versatz (Werbung:
// sechs Bilder als zwei solche Leitern übereinander, je Spalte eine Säule aus zwei Bildern);
// der Text steht links daneben, kein Bild unter der Textspalte. Breit: Raster aus fünf gleichen Spalten, Text über zwei,
// Leiter über drei (jedes Bild eine Spalte). Schmal (bis --grid-stacked): Text oben, die Leiter darunter flacher über die
// ganze Breite. Hinter der Leiter liegt die Leuchtpunkt-Unterlage (DotField).
// Abstände: Mit Kopf im Raster (slot „head“) steht der Text im Abstand Überschrift → Text (--head-gap-text) unter dem Kopf,
// die Leiter im Abstand Überschrift → Inhalt (--head-gap-content). after="text" sagt dasselbe für einen Kopf, der direkt
// über der Galerie steht (Sustainability): er setzt den Textabstand, die Leiter holt die Differenz selbst nach.
// Anordnung und Zuschnitte: ./layouts.mjs, Material und Belege: public/media/galerie/manifest.json.
// Hover (nur Maus): Kachel hebt sich, Foto hellt auf, Zeile Kunde · Ort · Drohnen blendet ein, weich in beide
// Richtungen; nur transform, opacity und filter. Erscheinen mit dem Vorhang-Reveal der Seite.
import GalleryTile from './GalleryTile.astro';
import DotField from '../DotField.astro';
import { GALLERY_LAYOUTS } from './layouts.mjs';
import { manifestPhoto, ratio } from './manifest-photo';
interface Props { set: keyof typeof GALLERY_LAYOUTS; class?: string; after?: 'text' | 'content' }
const { set, class: cls, after = 'content' } = Astro.props;
const layout = GALLERY_LAYOUTS[set];
if (!layout) throw new Error(`Unbekannte Galerie „${set}“`);
// drei Bilder = eine Leiter; sechs = zwei Leitern übereinander (Werbung, Marc Runde 7: „immer zwei Zeilen als Leiter“)
if (layout.items.length !== 3 && layout.items.length !== 6) throw new Error(`Galerie „${set}“: eine Leiter hat drei Bilder, zwei Leitern haben sechs (sind ${layout.items.length})`);
const hasHead = Astro.slots.has('head');
// Versatz je Stufe als Anteil der Bildhöhe; margin-top in % bezieht sich im Raster auf die Spaltenbreite, daher / ratio
const r = ratio(layout.ar), STEP = 0.42, STEP_M = 0.26;
const pct = (n: number) => `${+(n * 100).toFixed(3)}%`;
// items zeilenweise: 0–2 obere Leiter, 3–5 untere. Je Spalte stehen die Bilder in einer Säule untereinander; die Säule
// sitzt um ihre Stufe tiefer (links zwei Stufen, rechts keine), so steigen beide Zeilen gleich und nichts überlappt.
const photos = await Promise.all(layout.items.map(async (item, i) => {
  const p = await manifestPhoto(item.slug, Astro.url.pathname);
  return { ...p, col: i % 3, style: `--ar:${layout.ar};--pos:${item.pos ?? '50% 50%'};--i:${(i % 3) + Math.floor(i / 3)}` };
}));
const columns = [0, 1, 2].map((c) => ({ rise: `--rise:${pct((2 - c) * STEP / r)};--rise-m:${pct((2 - c) * STEP_M / r)}`, items: photos.filter((p) => p.col === c) }));
const f = layout.field;
---
<div class:list={['gal-wrap', cls]}>
  <div class:list={['gal', `gal-${set}`, { 'has-head': hasHead, 'after-text': after === 'text' && !hasHead, 'two-rows': layout.items.length === 6 }]}>
    {hasHead && <div class="g-head"><slot name="head" /></div>}
    <div class="g-copy"><slot /></div>
    <div class="g-ladder df-host">
      <DotField inset={f.inset} insetM={f.m} focus={f.focus ?? '50% 50%'} />
      {columns.map((c) => <div class="g-lcol" style={c.rise}>{c.items.map(({ style, slug: _slug, col: _col, ...p }) => <GalleryTile {...p} style={style} />)}</div>)}
    </div>
  </div>
</div>

<style is:global>
  /* global, weil die Kacheln eine eigene Komponente sind; alles hängt an .gal */
  .gal { --g-gap: clamp(0.875rem, 1.4vw, 1.5rem); --g-r: var(--radius-14); --g-ease: var(--ease-lift); --g-dur: var(--dur-reveal); --g-lift: 0rem; }
  /* Kopf → Text ist --head-gap-text; die Leiter ist Inhalt und steht im Abstand --head-gap-content unter dem Kopf */
  .gal .g-head .section-head { margin-bottom: 0; }
  /* der erste Absatz (auch im Fließtextblock .prose) beginnt genau am Abstand Kopf → Text, im Raster kollabiert nichts */
  .gal .g-copy > :first-child, .gal .g-copy > :first-child > :first-child { margin-top: 0; }
  .gal .g-copy > :last-child { margin-bottom: 0; }

  .gal .g-ladder { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--g-gap); align-items: start; }
  /* Säule je Spalte, um ihre Stufe versetzt; margin-top in % bezieht sich auf die Spaltenbreite */
  .gal .g-lcol { display: flex; flex-direction: column; gap: var(--g-gap); margin-top: var(--rise); min-width: 0; }
  .gal .g-tile { margin: 0; position: relative; display: block; border-radius: var(--g-r); color: var(--text); text-decoration: none; aspect-ratio: var(--ar);
    transition: transform var(--g-dur) var(--g-ease); }
  /* Schatten als eigene Ebene: nur ihre Deckkraft wird animiert */
  .gal .g-tile::after { content: ""; position: absolute; inset: 0; z-index: -1; border-radius: inherit; box-shadow: 0 1.25rem 2.5rem -1rem var(--shadow-strong); opacity: 0; transition: opacity var(--g-dur) var(--g-ease); pointer-events: none; }
  .gal .g-media { position: absolute; inset: 0; overflow: hidden; border-radius: var(--g-r); background: var(--media-ground); --curtain-r: var(--g-r); }
  .gal .g-media picture { display: contents; }
  .gal .g-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); display: block;
    filter: brightness(0.92); transition: transform var(--dur-slow-long) var(--ease-reveal), filter var(--g-dur) var(--g-ease); transition-delay: calc(var(--i, 0) * var(--dur-stagger)), 0s; }
  /* Vorhang wie global ([data-curtain] > img), hier sitzt das Foto in <picture> */
  .reveal .gal .g-media[data-curtain]:not(.is-in) img { transform: scale(1.28); }

  /* Zeile Kunde · Ort · Drohnen, wie die Zähler auf den Referenzkarten; nur beim Zeigen, immer nur an einem Bild */
  .gal .g-cap { position: absolute; z-index: 2; left: 0.5rem; bottom: 0.5rem; max-width: calc(100% - 1rem); padding: var(--space-1-5) var(--space-2-25);
    border-radius: var(--radius-4); background: var(--overlay-media); -webkit-backdrop-filter: blur(0.5rem); backdrop-filter: blur(0.5rem);
    line-height: 1.35; opacity: 0; transform: translateY(0.375rem); pointer-events: none;
    transition: opacity var(--g-dur) var(--g-ease), transform var(--g-dur) var(--g-ease); }
  @media (hover: hover) and (pointer: fine) {
    .gal .g-tile:hover { transform: translateY(-0.375rem); }
    .gal .g-tile:hover::after { opacity: 1; }
    .gal .g-tile:hover img { filter: brightness(1.08); }
    .gal .g-tile:hover .g-cap { opacity: 1; transform: none; transition-delay: var(--dur-stagger-reveal); }
  }
  .gal .g-tile:focus-visible .g-cap { opacity: 1; transform: none; }
  /* Lange Ortsnamen („Mönchengladbach“) dürfen umbrechen statt über die Kachel und die Seite hinauszuragen; bei schmalen
     Kacheln (Leiter quer über die Breite) bleibt die Zeile ganz weg, sie hätte dort keinen Platz */
  .gal .g-cap { overflow-wrap: anywhere; }
  @media (hover: none), (pointer: coarse), (--mobile) { .gal .g-cap { display: none; } }

  /* Breit: fünf gleiche Spalten, Text über zwei, Leiter über drei; die Leiter beginnt oben bündig mit dem Text */
  @media (--grid-expanded) {
    .gal { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); column-gap: var(--g-gap); align-items: start; }
    .gal.has-head, .gal.after-text { --g-lift: calc(var(--head-gap-content) - var(--head-gap-text)); }
    .gal .g-head { grid-column: 1 / -1; grid-row: 1; margin-bottom: var(--head-gap-text); }
    .gal .g-copy { grid-column: 1 / span 2; max-width: 42rem; padding-right: var(--g-gap); }
    .gal .g-ladder { grid-column: 3 / span 3; margin-top: var(--g-lift); }
    .gal.has-head .g-copy, .gal.has-head .g-ladder { grid-row: 2; }
  }

  /* Schmal: Text oben, die Leiter darunter über die ganze Breite, flacher (kleinerer Versatz) */
  @media (--grid-stacked) {
    .gal .g-head { margin-bottom: var(--head-gap-text); }
    .gal .g-ladder { margin-top: clamp(var(--space-8), 6vw, var(--space-11)); }
    .gal .g-lcol { margin-top: var(--rise-m); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gal .g-tile, .gal .g-tile::after, .gal .g-cap, .gal .g-media img { transition: none; }
    .gal .g-tile:hover { transform: none; }
  }
</style>
