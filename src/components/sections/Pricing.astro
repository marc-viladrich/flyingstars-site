---
import { forPath } from '../../i18n/server';
const { t, localHref, formatLocale } = forPath(Astro.url.pathname);
import type { Section } from '../../content.config';
import { SHOW_PACKAGES, type ShowPackage } from '../../content/show-packages';
import PackageCard from '../PackageCard.astro';
import OfferCard from '../pricing/OfferCard.astro';
import SectionHead from '../SectionHead.astro';
type Props = Extract<Section, { type: 'pricing' }> & { index: number };
const { headline, text, tiers, note, cta, id = `s${Astro.props.index}`, index, kicker } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
---
<section class="section alt" id={id} aria-labelledby={headingId}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={headingId} level={H} />
  <div class="packs">{tiers.map(tier => {
    return tier.name in SHOW_PACKAGES
      ? <PackageCard packageId={tier.name as ShowPackage} headingId={`${id}-${tier.name}`} highlight={tier.highlight} badge={tier.badge} pointsOverride={tier.features.length ? tier.features : undefined} />
      : <OfferCard tier={tier} />;
  })}</div>
  {(note || cta) && <div class="pack-note">{note && <span class="mono">{note}</span>}{cta && <a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a>}</div>}
</section>
