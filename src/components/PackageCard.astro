---
import {field} from 'astro-frontend-editor/markers';
// Ein Renderer für beide Paketansichten. Fachwerte und redaktionelle Leistungen kommen aus dem Paketmodell.
import { forPath } from '../i18n/server';
import { SHOW_PACKAGES, type ShowPackage } from '../content/show-packages';
import { getPackageDetails } from '../content/package-details';
interface Props { packageId: ShowPackage; variant?: 'summary' | 'detailed'; headingId: string; level?: 'h2' | 'h3'; highlight?: boolean; badge?: string; pointsOverride?: string[]; label?: string; sky?: string; tabIndex?: number }
const { packageId, variant = 'summary', headingId, level: C = 'h3', highlight, pointsOverride, tabIndex } = Astro.props;
const { t, localHref, formatLocale, locale } = forPath(Astro.url.pathname);
const { PACKAGE_FEATURES, PACKAGE_POINTS, PACKAGE_DETAILS, dronesLine, addOnLine, showtimeLine } = getPackageDetails(locale);
const { badge = PACKAGE_DETAILS[packageId].often, label = PACKAGE_DETAILS[packageId].label, sky } = Astro.props;
const p = { name: packageId, ...SHOW_PACKAGES[packageId], shape: { SPARK: 'ring', HORIZON: 'sphere', ODYSSEY: 'torus' }[packageId] };
const money = (v: number) => t('showconfigurator.fromValue', { v0: v.toLocaleString(formatLocale) });
---
{variant === 'summary' ? (
<a class:list={['pack', { featured: highlight }]} aria-labelledby={headingId} href={localHref(`/kontakt/?paket=${p.name}`)} data-pick-paket={p.name} style={`--c:rgb(${p.color.join(',')})`}>
      <canvas data-orb={p.shape} data-color={p.color.join(',')} data-n={p.base} aria-hidden="true"></canvas>
      <div class="pack-head"><div class="name"><C id={headingId}>{p.name}</C>{badge && <span class="chip">{badge}</span>}</div><p class="price">{money(p.price)}</p>{label && <p class="meta mono">{label}</p>}{sky && <p class="pack-sky">{sky}</p>}</div>
      {/* Drohnenzahl als eigene Gruppe in der Paketfarbe, darunter die Kernpunkte (Marc, 01.11.2026). Gleiche Vorschau auf
           Startseite und Anlass-Seiten: Punkte aus package-details.ts, sofern die Seite keine eigenen setzt. */}
      <p class="pack-drones">{dronesLine(p.name)}<span class="pack-time" {...field({collection:'showDuration',id:'configuration'},['outdoor','min'],{mode:'panel'})}>{showtimeLine(p.name)}</span></p>
      <ul class="pack-points">{(pointsOverride ?? PACKAGE_POINTS[p.name]).map((pt) => <li>{pt}</li>)}</ul>
    </a>
) : (
<article class:list={['tier', { 'is-rec': highlight }]} data-mtab={tabIndex} style={`--dot:rgb(${p.color.join(',')})`} aria-labelledby={headingId}>
      <canvas data-orb={p.shape} data-color={p.color.join(',')} data-n={p.base} aria-hidden="true"></canvas>
      <div class="head"><C id={headingId}>{p.name}</C><span class="badge">{badge ?? PACKAGE_FEATURES[p.name].badge}</span></div>
      <p class="tag">{PACKAGE_FEATURES[p.name].tag}</p>
      <div class="p"><b>{money(p.price)}</b><span class="mono">{t('packages.for')} {p.base} {t('configuratorteaser.drones')}</span><span class="mono tier-time" {...field({collection:'showDuration',id:'configuration'},['outdoor','min'],{mode:'panel'})}>{showtimeLine(p.name)}</span></div>
      {PACKAGE_FEATURES[p.name].plus && <span class="plus">{PACKAGE_FEATURES[p.name].plus}</span>}
      {PACKAGE_FEATURES[p.name].groups.map((g) => <><h4 class="mono">{g.title}</h4><ul>{g.items.map((item) => <li>{item}</li>)}</ul></>)}
      <span class="scale-note mono">{addOnLine(p.name)}</span>
      <div class="tier-actions"><a class:list={['btn', { primary: highlight }]} href={localHref(`/kontakt/?paket=${p.name}`)}>{p.name} {t('packages.enquiry')}</a><a class="link" href={localHref(`/drohnenshow-preise/?paket=${p.name}#konfigurator`)}>{t('packages.viewInTheConfigurator')} <span aria-hidden="true">→</span></a></div>
    </article>
)}
