---
import {startingPrice} from '../lib/price.mjs';
import { forPath } from '../i18n/server';
const { t, locale } = forPath(Astro.url.pathname);
// Preisseite nach Moritz' Preistext (17.11.2026, mit Marc abgestimmt): Abschnittsfolge, Überschriften und Wortlaut von
// Moritz, durchgehend in Ihr-Form; das Layout je Abschnitt aus den Bestandskomponenten (docs/DESIGN.md, „Neue Texte in
// bestehende Komponenten“). Der Konfigurator ist der Hauptabschnitt direkt nach dem Kopf, ohne Paketwahl. Die drei Pakete
// sind feste Beispiele mit Festpreis: anfragen (Formular unten, Paket vorbelegt) oder anpassen (Konfigurator startet mit
// dem Paket, nach der ersten Änderung „Individuelles Paket“). Flächen wechseln ab dem Konfigurator: Preisversprechen hell,
// Pakete auf Grund, Leistungen hell, Upgrades auf Grund, Anfrage hell, FAQ auf Grund. Texte unter preise.* im UI-Wörterbuch.
// Entfallen gegenüber der Fassung vom 31.10.: Leistungsvergleich (Tabelle mit Aufpreisen je Paket, passt nicht mehr zu
// festen Paketen) und der Abschluss „Noch unsicher, welches Paket?“ (das Formular steht jetzt auf der Seite).
import Base from '../layouts/Base.astro';
import Packages from '../components/sections/Packages.astro';
import Faq from '../components/sections/Faq.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import SectionHead from '../components/SectionHead.astro';
import FactList from '../components/FactList.astro';
import ShowConfigurator from '../components/configurator/ShowConfigurator.astro';
import Extras from '../components/pricing/Extras.astro';
import Included from '../components/pricing/Included.astro';
import Accent from '../components/Accent.astro';
import Faces from '../components/Faces.astro';
import Icon from '../components/Icon.astro';
import { SHOW_PACKAGES, PACKAGE_NAMES, DRONES_MIN, DRONES_MAX } from '../content/show-packages';
import { durationValues } from '../content/show-duration.mjs';
import { getPackageDetails } from '../content/package-details';
const { PACKAGE_DETAILS, PRICE_NOTE } = getPackageDetails(locale);
const items = PACKAGE_NAMES.map((name) => ({ name, ...PACKAGE_DETAILS[name], badge: PACKAGE_DETAILS[name].often, highlight: Boolean(PACKAGE_DETAILS[name].often) }));
const number = (n: number) => n.toLocaleString(locale === 'en' ? 'en-GB' : locale === 'nl' ? 'nl-NL' : 'de-DE');
const d = durationValues();
const included = [
  ['design', 'pen-tool', t('preise.inc.design'), t('preise.incItem.design')],
  ['tech', 'cpu', t('preise.inc.tech'), t('preise.incItem.tech')],
  ['permit', 'stamp', t('preise.inc.permit'), t('preise.incItem.permit')],
  ['safety', 'shield-check', t('preise.inc.safety'), t('preise.incItem.safety')],
  ['insurance', 'umbrella', t('preise.inc.insurance'), t('preise.incItem.insurance')],
  ['crew', 'users', t('preise.inc.crew'), t('preise.incItem.crew')],
  ['flight', 'timer', t('preise.incItem.flightTitle'), t('preise.incItem.flight', d)],
].map(([, icon, title, text]) => ({ icon, title, text }));
const facts = [
  { value: startingPrice(SHOW_PACKAGES.SPARK.price, locale), label: t('preise.factNet') },
  { value: `${number(DRONES_MIN)}–${number(DRONES_MAX)}`, label: t('preise.factDrones') },
  { value: '10 %', label: t('preise.factEarly') },
];
const promises = [['lock', t('preise.promise1')], ['scale', t('preise.promise2')], ['calendar-check', t('preise.promise3')]];
---
<Base title={t('preise.metaTitle')} description={t('preise.metaDescription')}>

  {/* Marc, 18.11.2026 („For the Preise page we should open with the configurator, as Moritz mentioned“): die Seite beginnt
       mit dem Konfigurator. Moritz' H1, Einleitung und Eckdaten sind sein Kopf, die Live-Vorschau ist das Bild des ersten
       Bildschirms; das Showreel entfällt hier. Ab Desktop steht die H1 über der Bedienung, Einleitung und Eckdaten über
       der Vorschau; auf dem Handy H1 und Eckdaten, dann Vorschau und Regler, die Einleitung nach dem Konfigurator. */}
  <ShowConfigurator id="konfigurator">
    <SectionHead slot="head" variant="embedded" kicker={t('preise.heroKicker')} headline={t('preise.heroHeadline')} id="cfg-h" level="h1" titleClass="pp-h1" />
    <FactList slot="facts" variant="hero" items={facts} />
    <p slot="intro" class="pp-intro">{t('preise.heroText')}</p>
  </ShowConfigurator>

  {/* Preisversprechen (Moritz: H3 unter dem Konfigurator): Kasten mit Verlaufsrand wie jeder Abschluss, die drei Zusagen als
       Zeilen mit Icon statt Fließtext, ein Knopf */}
  <section class="section alt promise-sec" aria-labelledby="versprechen-h">
    <div class="promise pv">
      <Faces />
      <div class="promise-copy"><h3 id="versprechen-h"><Accent text={t('preise.promiseHeadline')} /></h3></div>
      <ul class="pv-list" role="list">{promises.map(([icon, line]) => <li><Icon name={icon} size={22} class="g" /><span>{line}</span></li>)}</ul>
      <div class="actions"><a class="btn primary" href={forPath(Astro.url.pathname).localHref('/kontakt/?anliegen=vergleich')}>{t('preise.promiseCta')}</a></div>
    </div>
  </section>

  <Packages
    type="packages"
    index={2}
    id="pakete"
    kicker={t('preise.pkgKicker')}
    headline={t('preise.pkgHeadline')}
    text={t('preise.pkgText')}
    note={PRICE_NOTE}
    compact={false}
    items={items}
    surface="plain"
  />

  <Included
    kicker={t('preise.incKicker')}
    headline={t('preise.incHeadline')}
    text={t('preise.incText')}
    items={included}
    note={t('preise.incNote')}
  />

  <Extras surface="plain" />

  <ContactForm
    type="contactForm"
    index={5}
    kicker={t('preise.contactKicker')}
    headline={t('preise.contactHeadline')}
    text={t('preise.contactText')}
  />

  <Faq
    type="faq"
    index={6}
    id="preisfragen"
    kicker={t('preise.faqKicker')}
    headline={t('preise.faqHeadline')}
    cta={{ label: t('pricingpage.allQuestions'), href: '/faq/' }}
    openFirst={true}
    tags={['preise-moritz']}
  />
</Base>

<style>
  /* 18.11.2026 (Long Task beim Start, 4× Drossel): Das erste Layout der ganzen Seite kostete am Stück rund 60 ms. Die Sections
     unter dem Konfigurator legt der Browser erst aus, wenn sie in die Nähe kommen (Safari ab 18, Chrome ab 85); die
     gemerkte Größe (auto) hält die Bildlaufleiste ruhig. Sprungziele (#anfrage, #pakete) funktionieren weiter. */
  /* Farbflächen (.alt) ausgenommen: content-visibility schneidet ihre Punktübergänge über die Kante ab (docs/himmel.md) */
  :global(main > section.section:not(.cfg, .alt)) { content-visibility: auto; contain-intrinsic-size: auto 56rem; }
  /* Garantie direkt unter dem Konfigurator (Marc, Runde 5: „oben und unten etwas weniger Abstand, aktuell floatet es sehr
     im Nichts“): eigene Abstände knapp, und die Section rückt in den Bodenabstand des Konfigurators hinein */
  .promise-sec { padding-block: clamp(var(--space-8), 3.5vw, var(--space-14)); margin-top: calc(-1 * clamp(var(--space-10), 5vw, var(--space-20))); }
  /* Preisversprechen: drei Zusagen als ruhige Zeilen im Kasten, links bündig in einer zentrierten Spalte */
  .pv-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); justify-items: start; text-align: left; }
  .pv-list li { display: flex; align-items: flex-start; gap: var(--space-3); color: var(--text); font-size: var(--text-md); line-height: 1.4; }
  .pv-list :global(.ico) { flex: none; margin-top: var(--space-0-25); }
  /* Kopf im Konfigurator (has-head, ShowConfigurator.astro). Desktop: H1 über der Bedienung, Einleitung und Eckdaten über
     der Vorschau, beide unten bündig; Handy: H1, Eckdaten, Vorschau, Regler, Einleitung zuletzt. Innerhalb des Kopfs die
     Kopf-Rolle --head-gap-text (global.css). Seitenkopf → Konfigurator ab Desktop bewusst größer als --head-gap-content
     (Marc, Runde 5/6: „mehr Abstand von Section-Header zu Konfigurator selbst“, bei 1440 ≈ 94 px), auf dem Handy die Rolle.
     Das Raster setzt den Text-Abstand schon zwischen die Zeilen, darum der Rest als Rand */
  :global(.cfg.has-head) { --cfg-top: clamp(6.5rem, 8vw, 8.5rem); --cfg-head-content: clamp(var(--space-14), 6.5vw, var(--space-24)); --cfg-head-rest: calc(var(--cfg-head-content) - var(--head-gap-text)); grid-template-areas: "head intro" "head facts" "panel stage"; row-gap: var(--head-gap-text); }
  /* Die Bühne passt mit Steuerleiste in den ersten Bildschirm (Kopf ≈ 19 rem plus Kopfabstand), auch in niedrigen
     Fenstern wie 1280 × 720; beim Scrollen klebt sie in derselben Höhe neben der Bedienung */
  @media (--nav-expanded) { :global(.cfg.has-head > .cfg-stage) { height: clamp(18rem, calc(100svh - 22rem - var(--cfg-head-content)), 48rem); min-height: 0; } }
  :global(.cfg.has-head > .cfg-head) { grid-area: head; align-self: end; }
  :global(.cfg.has-head > .cfg-intro) { grid-area: intro; align-self: end; }
  :global(.cfg.has-head > .cfg-facts) { grid-area: facts; align-self: end; }
  :global(.cfg.has-head > .cfg-panel) { grid-area: panel; margin-top: var(--cfg-head-rest); }
  :global(.cfg.has-head > .cfg-stage) { grid-area: stage; margin-top: var(--cfg-head-rest); }
  :global(.cfg-head .pp-h1) { margin: 0; font-size: clamp(2.125rem, 3vw, 3.25rem); line-height: 1.02; letter-spacing: -0.035em; text-wrap: balance; }
  .pp-intro { margin: 0; max-width: 64ch; color: var(--muted); font-size: var(--text-copy); line-height: 1.6; text-wrap: pretty; }
  :global(.cfg-facts .lh-facts) { margin: 0; max-width: none; }
  @media (--nav-collapsed) {
    :global(.cfg.has-head) { --cfg-head-content: var(--head-gap-content); grid-template-areas: "head" "facts" "stage" "panel" "intro"; padding-top: calc(var(--nav-h, 4rem) + var(--space-5)); row-gap: var(--head-gap-text); }
    :global(.cfg.has-head > .cfg-panel) { margin-top: var(--head-gap-text); }
    :global(.cfg-head .pp-h1) { font-size: clamp(1.875rem, 7.4vw, 2.5rem); }
    :global(.cfg.has-head > .cfg-intro) { margin-top: var(--space-4); }
  }
</style>
