---
// Gemeinsame Icon-Komponente (Marc, 31.10.2026: eine Icon-Bibliothek statt selbst gezeichneter Icons). Grundlage ist
// Lucide (ISC-Lizenz, @lucide/astro), gerendert beim Build als reines SVG ohne JavaScript. Name = Lucide-Name in
// kebab-case, Übersicht: https://lucide.dev/icons. Ergänzt um Motive, die Lucide nicht führt: „eu“ (Sternenkranz),
// „whatsapp“ (Sprechblase mit Telefon im Lucide-Strich) und „e-car“ (Lucide-Auto mit Blitz darüber; Marc 01.11.2026:
// „car-front“ allein erkennt man nicht als Elektroauto) und „swiss“ (Lucide-Schild mit gefülltem Schweizer Kreuz, nach
// Marcs Vorlage icon-swiss-privacy.svg von ant-npo.com, 01.11.2026). Farbe: currentColor; mit class="g" in Orange (--accent).
import * as L from '@lucide/astro';

interface Props { name: string; size?: number; class?: string; strokeWidth?: number; label?: string }
const { name, size = 20, class: cls, strokeWidth = 1.75, label } = Astro.props;
const pascal = name.split('-').map((p) => p[0].toUpperCase() + p.slice(1)).join('');
const custom = name === 'eu' || name === 'whatsapp' || name === 'e-car' || name === 'swiss';
const Lucide = custom ? undefined : ((L as Record<string, unknown>)[pascal] as ((props: Record<string, unknown>) => unknown) | undefined);
if (!custom && !Lucide) throw new Error(`Icon „${name}“ gibt es in Lucide nicht (https://lucide.dev/icons)`);
const a11y: Record<string, string> = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
const stars = Array.from({ length: 12 }, (_, k) => { const a = (k / 12) * Math.PI * 2 - Math.PI / 2; return [12 + 8 * Math.cos(a), 12 + 8 * Math.sin(a)]; });
---
{Lucide && <Lucide size={size} stroke-width={strokeWidth} class:list={['ico', cls]} {...a11y} />}
{name === 'eu' && <svg class:list={['ico', 'ico-eu', cls]} width={size} height={size} viewBox="0 0 24 24" {...(a11y as astroHTML.JSX.SVGAttributes)}>{stars.map(([x, y]) => <circle cx={x.toFixed(2)} cy={y.toFixed(2)} r="1.25" style="fill:currentColor;stroke:none" />)}</svg>}
{name === 'e-car' && <svg class:list={['ico', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" {...(a11y as astroHTML.JSX.SVGAttributes)}><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2" /><circle cx="7" cy="17" r="2" /><path d="M9 17h6" /><circle cx="17" cy="17" r="2" /><path d="m19 1.5-2 3h3l-2 3" /></svg>}
{name === 'swiss' && <svg class:list={['ico', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" {...(a11y as astroHTML.JSX.SVGAttributes)}><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path class="ico-fill" d="M10.75 7.5h2.5v3h3v2.5h-3v3h-2.5v-3h-3v-2.5h3z" fill="currentColor" stroke="none" /></svg>}
{name === 'whatsapp' && <svg class:list={['ico', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" {...(a11y as astroHTML.JSX.SVGAttributes)}><path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.6z" /><path d="M9 8.5c0 3.3 2.9 6.5 6.5 6.5l1-1.6-2-1-1 1c-1.2-.4-2.3-1.5-2.8-2.8l1-1-1-2z" /></svg>}

<style>
  /* EU-Sterne nehmen die Farbe wie die Striche an (.ico.g = Orange) */
  :global(.ico-eu.g) circle { fill: var(--accent) !important; }
</style>
