---
import { forPath } from '../../i18n/server';
const { t, localHref, formatLocale } = forPath(Astro.url.pathname);
// Preiskarte (Marc, 31.10.2026: „bei der Hochzeit insbesondere mit den Preisen … viel mehr High Quality“). Links der
// Preis groß, bei Paketbezug mit der Punktfigur des Pakets und Preis/Drohnen aus src/content/show-packages.ts; rechts
// die Gruppen wie ein Kassenzettel (Bezeichnung links, Betrag rechts), optional ein Bonus im Logoverlauf.
// Darunter der Abschluss-Kasten (CtaBox.astro, Pflichtfelder im Schema) wie auf Startseite und Preisseite:
// mit Gesichtern oben, Satz und Knöpfen zentriert. Die Karte selbst trägt deshalb keinen Verlaufsrand.
import type { Section } from '../../content.config';
import SectionHead from '../SectionHead.astro';
import CtaBox from '../CtaBox.astro';
import Icon from '../Icon.astro';
import { SHOW_PACKAGES } from '../../content/show-packages';
type Props = Extract<Section, { type: 'landingPrice' }> & { index: number };
const { kicker, headline, text, package: pkg, price, unit, groups, bonus, closing, id = 'preise', index } = Astro.props;
const H = index === 0 ? 'h1' : 'h2';
const T = index === 0 ? 'h2' : 'h3';
const orb = { SPARK: 'ring', HORIZON: 'sphere', ODYSSEY: 'torus' } as const;
const p = pkg ? SHOW_PACKAGES[pkg] : undefined;
const shown = p ? t('showconfigurator.fromValue', { v0: p.price.toLocaleString(formatLocale) }) : price ?? '';
// „ab“ bzw. „ab ca.“ klein über dem Betrag, damit auch „ab ca. 15.000 €“ in die Spalte passt
const [, pre = '', amount = shown] = shown.match(/^((?:ab|bis|from|up to|vanaf|tot)(?: ca\.| approx\.)?)\s+(.+)$/) ?? [];
const sub = unit ?? (p ? t('landingprice.excludingVatForValueDronesPlusTravel', { v0: p.base }) : undefined);
// Staffel nur, wenn das Paket nach oben begrenzt ist (SPARK: bis 150 Drohnen, je 10 weitere +900 €)
const scale = p && Number.isFinite(p.max) ? t('landingprice.upToValueDronesValuePerValueAdditionalDrones', { v0: p.max, v1: p.add.toLocaleString(formatLocale), v2: p.step }) : undefined;
---
<section class="section alt lp" id={id} aria-labelledby={`${id}-h`}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} level={H} />
  <div class="lp-card">
    <div class="lp-price">
      {pkg && p && <div class="lp-pkg"><canvas data-orb={orb[pkg]} data-color={p.color.join(',')} data-n={p.base} aria-hidden="true"></canvas><span class="lp-name">{pkg}</span></div>}
      <p class="lp-amount">{pre && <span class="lp-pre mono">{pre} </span>}{amount}</p>
      {sub && <p class="lp-unit">{sub}</p>}
      {scale && <p class="lp-scale mono">{scale}</p>}
    </div>
    <div class="lp-groups" data-n={groups.length}>
      {groups.map((g, gi) => (
        <div class="lp-group">
          <T class="mono">{g.title}</T>
          <ul>{g.items.map((it) => <li class:list={{ 'has-value': it.value }}>
            {gi === 0 && pkg ? <Icon name="check" size={18} class="g" /> : gi > 0 && pkg ? <Icon name="plus" size={18} class="g" /> : <span class="lp-pt" aria-hidden="true"></span>}
            <span>{it.label}</span>{it.value && <b>{it.value}</b>}
          </li>)}</ul>
        </div>
      ))}
      {bonus && <div class="lp-bonus"><span class="lp-bonus-v grad">{bonus.value}</span><p>{bonus.text}</p></div>}
    </div>
  </div>
  <CtaBox {...closing} level={T} class="lp-close" />
</section>

<style>
  .lp-card { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr); border-radius: var(--radius); background: var(--ground); border: 1px solid var(--line-strong); }
  .lp-price { display: grid; gap: 10px; align-content: start; padding: clamp(28px, 4vw, 56px); border-right: 1px solid var(--line); }
  .lp-pkg { display: flex; align-items: center; gap: 14px; margin-bottom: clamp(10px, 2vw, 24px); }
  .lp-pkg canvas { width: 56px; height: 56px; flex: none; }
  .lp-name { font: 500 15px/1 var(--display); letter-spacing: 0.14em; color: var(--head); }
  .lp-amount { margin: 0; font: 600 clamp(44px, 5.2vw, 88px)/0.95 var(--display); letter-spacing: -0.05em; color: var(--head); white-space: nowrap; }
  .lp-pre { display: block; margin-bottom: 10px; font-size: 13px; letter-spacing: 0.1em; color: var(--faint); }
  .lp-unit { margin: 6px 0 0; color: var(--muted); font-size: 17px; max-width: 26ch; }
  .lp-scale { margin: 10px 0 0; padding-top: 14px; border-top: 1px dashed var(--line-strong); color: var(--faint); }
  /* Gruppen nebeneinander, der Bonus als Leiste darunter über die ganze Breite */
  .lp-groups { display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); align-content: start; }
  .lp-groups[data-n='2'] { --cols: 2; }
  .lp-groups[data-n='1'] { --cols: 1; }
  .lp-group { padding: clamp(28px, 3.4vw, 48px) clamp(22px, 2.6vw, 40px); border-left: 1px solid var(--line); display: grid; gap: 18px; align-content: start; }
  .lp-groups > :first-child { border-left: 0; }
  .lp-group h2, .lp-group h3 { font: 400 12px/1.5 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  .lp-group ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; max-width: 30rem; }
  .lp-group li { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 12px; align-items: baseline; color: var(--text); font-size: 15.5px; line-height: 1.4; }
  .lp-group li.has-value { grid-template-columns: 20px minmax(0, 1fr) auto; }
  .lp-group li :global(.ico) { width: 18px; height: 18px; transform: translateY(3px); }
  .lp-pt { width: 6px; height: 6px; margin: 0 7px; border-radius: 50%; background: var(--accent); transform: translateY(-2px); }
  .lp-group li b { font: 500 15px/1.4 var(--display); color: var(--head); white-space: nowrap; padding-left: 8px; }
  .lp-bonus { grid-column: 1 / -1; border-top: 1px solid var(--line); display: flex; align-items: center; gap: 12px 28px; flex-wrap: wrap; padding: clamp(18px, 2vw, 26px) clamp(22px, 2.6vw, 40px); }
  .lp-bonus-v { font: 600 clamp(40px, 4vw, 64px)/0.95 var(--display); letter-spacing: -0.05em; }
  .lp-bonus p { color: var(--muted); max-width: 46ch; margin: 0; }
  /* CtaBox ist eine eigene Komponente: Abstand über :global, sonst greift das Komponenten-CSS nicht */
  :global(.lp-close) { margin-top: clamp(32px, 4vw, 56px); }
  @media (max-width: 1100px) {
    .lp-card { grid-template-columns: 1fr; }
    .lp-price { border-right: 0; border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 760px) {
    .lp-groups, .lp-groups[data-n='2'] { grid-template-columns: 1fr; }
    .lp-group { border-left: 0; border-top: 1px solid var(--line); }
    .lp-groups > :first-child { border-top: 0; }
    .lp-bonus { display: grid; }
  }
</style>
