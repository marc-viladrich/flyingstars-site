# Generated by node scripts/generate-public-delivery.mjs. Public static webroot only.
# Never install this file on the separate Node editor subdomain.
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Production convention observed 2026-10-15: HTTPS, apex host.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^flyingstars\.art$ [NC]
RewriteRule ^ https://flyingstars.art%{REQUEST_URI} [R=301,L,NE]

# Exact legacy mappings and removed project aliases, with optional trailing slash.
RewriteRule ^100-drohnen-fur-puma-zum-anstoss-eines-bundesliga-derbys/?$ /puma-bundesliga/ [R=301,L]
RewriteRule ^contact/?$ /kontakt/ [R=301,L]
RewriteRule ^de/?$ / [R=301,L]
RewriteRule ^en/100-drones-for-puma-at-the-start-of-a-bundesliga-derby/?$ /en/puma-bundesliga/ [R=301,L]
