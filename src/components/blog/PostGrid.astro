---
// Raster für Blogkarten: drei Spalten ab 1100 px, darunter zwei, auf dem Handy eine. Zwei Karten teilen sich die Breite.
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
interface Props { posts: CollectionEntry<'posts'>[]; level?: 'h2' | 'h3' }
const { posts, level = 'h2' } = Astro.props;
---
<div class="post-grid" data-count={posts.length}>{posts.map((post, i) => <PostCard post={post} i={i} level={level} />)}</div>

<style>
  .post-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(var(--space-8), 3vw, var(--space-12)) var(--card-grid-gap); }
  @media (--grid-stacked) { .post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 45em) { .post-grid { grid-template-columns: minmax(0, 1fr); } }
  /* Bleibt in der letzten Reihe eine Karte allein, nimmt sie die ganze Zeile: Bild in Kartenbreite links, Text daneben
     mittig, statt einer leeren Kartenbreite rechts (Audit 3, V10). Benannte Flächen, damit nur die Fläche je Rasterbreite
     wechselt; die Spalten kommen per subgrid aus dem Raster */
  .post-grid > :global(.post-card) { grid-template-areas: 'img' 'kick' 'title' 'text'; }
  .post-grid > :global(.post-card) > :global(.img) { grid-area: img; }
  .post-grid > :global(.post-card) :global(.media-card-body > .kick) { grid-area: kick; }
  .post-grid > :global(.post-card) :global(.media-card-body > :is(h2, h3)) { grid-area: title; }
  .post-grid > :global(.post-card) :global(.media-card-body > p) { grid-area: text; max-width: 60ch; }
  @media (min-width: 45.0625em) and (--grid-stacked) {
    .post-grid > :global(.post-card:last-child:nth-child(odd)) { grid-column: 1 / -1; grid-template-columns: subgrid; grid-template-rows: 1fr auto auto auto 1fr; grid-template-areas: 'img .' 'img kick' 'img title' 'img text' 'img .'; column-gap: var(--card-grid-gap); }
  }
  @media (--grid-expanded) {
    /* Genau zwei Karten (z. B. „Mehr aus dem Blog“): zwei Hälften statt zwei von drei Spalten (Audit 4, E4). Bild neben
       Text war bei 1180 px zu eng für die Titel */
    .post-grid[data-count="2"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .post-grid > :global(.post-card:last-child:nth-child(3n + 1)) { grid-column: 1 / -1; grid-template-columns: subgrid; grid-template-rows: 1fr auto auto auto 1fr; grid-template-areas: 'img . .' 'img kick kick' 'img title title' 'img text text' 'img . .'; column-gap: var(--card-grid-gap); }
  }
</style>
