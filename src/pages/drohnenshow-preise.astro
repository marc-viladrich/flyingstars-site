---
// Preisseite (31.10.2026, Marcs Feedbackrunde 6/8): Aufbau wie im Vercel-Prototyp. Oben die drei Pakete, dann der
// Show-Konfigurator, danach mit farbigen Punkten je Paket, was immer enthalten ist, alle Leistungen im Vergleich, Extras,
// Preisversprechen (Fragebogen 21.10.), Fragen zum Preis und Abschluss. Preise und Drohnenzahlen nur aus
// show-packages.ts, Texte aus package-details.ts.
import Base from '../layouts/Base.astro';
import Packages from '../components/sections/Packages.astro';
import Cta from '../components/sections/Cta.astro';
import Metrics from '../components/sections/Metrics.astro';
import Faq from '../components/sections/Faq.astro';
import SectionHead from '../components/SectionHead.astro';
import Faces from '../components/Faces.astro';
import Icon from '../components/Icon.astro';
import ShowConfigurator from '../components/configurator/ShowConfigurator.astro';
import { SHOW_PACKAGES, PACKAGE_NAMES } from '../content/show-packages';
import { PACKAGE_DETAILS, COMPARISON, COMPARISON_NOTE, INCLUDED, EXTRAS, SHOW_DURATION } from '../content/package-details';
const money = (v: number) => `ab ${v.toLocaleString('de-DE')} €`;
const items = PACKAGE_NAMES.map((name) => ({ name, ...PACKAGE_DETAILS[name], badge: PACKAGE_DETAILS[name].often, highlight: Boolean(PACKAGE_DETAILS[name].often) }));
const featured = PACKAGE_NAMES.findIndex((name) => PACKAGE_DETAILS[name].often);
const orb = { SPARK: 'ring', HORIZON: 'sphere', ODYSSEY: 'torus' } as const;
---
<Base title="Drohnenshow Preise: drei Pakete ab 7.900 €" description="Drei Drohnenshow-Pakete ab 7.900 € netto zzgl. Anfahrt. Design, Genehmigung und Team vor Ort sind immer enthalten. Mit Show-Konfigurator.">

  <Packages
    type="packages"
    index={0}
    id="pakete"
    kicker="Preise & Pakete"
    headline="Drei Pakete. Feste Einstiegspreise."
    text="Jedes Paket lässt sich mit mehr Drohnen und Extras erweitern. Alle Preise netto zzgl. Anfahrt."
    note={SHOW_DURATION}
    compact={false}
    items={items}
  />

  <!-- Reihenfolge (Marc, 31.10.2026): erst die Pakete, dann der Konfigurator -->
  <ShowConfigurator id="konfigurator" headingLevel={2} kicker="Show-Konfigurator" heading="Wie komplex darf’s sein?" />

  <Metrics
    type="metrics"
    index={2}
    id="inklusive"
    kicker="Immer inklusive"
    headline="Wofür ihr eigentlich bezahlt."
    text="Der größte Teil der Arbeit steckt nicht in den Drohnen, sondern in Design, Genehmigung und einem sicheren Ablauf."
    items={INCLUDED.map((item) => ({ label: item.title, text: item.text }))}
  />

  <section class="section" id="leistungen" aria-labelledby="leistungen-h">
    <SectionHead kicker="Vergleich" headline="Alle Leistungen im Vergleich." id="leistungen-h" />
    <div class="table-wrap" role="region" aria-label="Alle Leistungen im Vergleich (Tabelle, horizontal scrollbar)" tabindex="0">
      <!-- position:relative hält die visuell versteckten Texte („nicht enthalten“) im Scrollbereich der Tabelle -->
      <table style="position:relative">
        <caption class="sr-only">Leistungen der Pakete SPARK, HORIZON und ODYSSEY</caption>
        <thead>
          <tr><th scope="col">Leistung</th>{PACKAGE_NAMES.map((name, i) => <th scope="col" class:list={['pk', { us: i === featured }]} style={`--c:rgb(${SHOW_PACKAGES[name].color.join(',')})`}><canvas data-orb={orb[name]} data-color={SHOW_PACKAGES[name].color.join(',')} data-n={Math.round(SHOW_PACKAGES[name].base * 0.6)} aria-hidden="true"></canvas><span class="pk-name">{name}</span><span class="mono">{money(SHOW_PACKAGES[name].price)}</span></th>)}</tr>
        </thead>
        <tbody>
          {COMPARISON.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.all ? <td colspan="3">{row.all}</td> : row.cells!.map((cell, i) => cell === null
                ? <td class:list={['no', { us: i === featured }]}><span aria-hidden="true">–</span><span class="sr-only">nicht enthalten</span></td>
                : cell === true
                ? <td class:list={['yes', { us: i === featured }]} style={`--c:rgb(${SHOW_PACKAGES[PACKAGE_NAMES[i]].color.join(',')})`}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5l4 4 8-9" /></svg><span class="sr-only">enthalten</span></td>
                : <td class:list={{ us: i === featured }}>{cell}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="fine mono">Alle Preise netto zzgl. Anfahrt. {COMPARISON_NOTE}</p>
  </section>

  <section class="section alt" id="zusaetze" aria-labelledby="zusaetze-h">
    <SectionHead kicker="Extras & Upgrades" headline="Mehr geht immer." text="Was ein Zusatz kostet, steht vorab im Angebot." id="zusaetze-h" />
    <div class="extras">
      {EXTRAS.map((x) => (
        <div class="extra">
          <span class="k mono"><Icon name={x.icon} class="g" size={22} />{x.kick}</span>
          <h3>{x.title}</h3>
          <p>{x.text}</p>
          <span class="price mono">{x.price}</span>
          {x.link && <a class="link" href={x.link.href}>{x.link.label} <span aria-hidden="true">→</span></a>}
        </div>
      ))}
    </div>
  </section>

  <!-- Preisversprechen: von FlyingStars im Fragebogen (21.10.2026) bestätigt -->
  <section class="section promise-sec" aria-labelledby="versprechen-h">
    <div class="promise">
      <Faces />
      <div><h2 id="versprechen-h">Günstigeres Angebot mit gleicher Leistung? Wir unterbieten es.</h2><p>Schickt uns das Vergleichsangebot. Bei gleichem Leistungsumfang machen wir euch einen besseren Preis.</p></div>
      <a class="btn primary" href="/kontakt/?anliegen=vergleich">Angebot prüfen lassen</a>
    </div>
  </section>

  <Faq
    type="faq"
    index={5}
    id="preisfragen"
    kicker="Fragen zum Preis"
    headline="Was kostet eine Drohnenshow wirklich?"
    text="Was in Gesprächen über das Budget am häufigsten gefragt wird."
    cta={{ label: 'Alle Fragen', href: '/faq/' }}
    openFirst={true}
    tags={['preise']}
  />

  <Cta
    type="cta"
    index={6}
    headline="Noch unsicher, welches Paket?"
    text="Schickt uns Datum und Ort. Wenn ihr kein Paket auswählt, schlagen wir euch eins vor."
    button={{ label: 'Show anfragen', href: '/kontakt/' }}
  />
</Base>
