---
// Porträt im Telefon-Knopf des Seitenkopfs (Marc, Runde 15: „damit man sofort sieht: echte Menschen“; Runde 16: drei
// Porträts neben dem Knopf waren „zu voll“, jetzt Ronjas Bild IM Knopf statt des Telefon-Icons, ein Element weniger).
// Ronja, Erwin, Florian aus src/content/people (dieselben Bilder wie das Team), rund und überlappend. Die Bilder sind
// Schmuck (alt=""); der Knopf verweist per aria-describedby auf den Satz „Am Telefon: …“. Feste Maße, kein Layout-Shift.
// Der Aufrufer stellt Knopf und Porträts in eine Gruppe (.call), die nicht umbricht.
import { optimizedImage } from '../lib/media';
import { portraitPerson } from '../content/people.mjs';
import { forPath } from '../i18n/server';
interface Props { id: string }
const { id } = Astro.props;
const { t, locale } = forPath(Astro.url.pathname);
const people = ['ronja-donsbach'].map((pid) => portraitPerson(pid));
const faces = await Promise.all(people.map(async (p) => ({ name: p.name, img: await optimizedImage(p.image.src, 112) })));
const first = (name: string) => name.split(/\s+/)[0];
const names = new Intl.ListFormat(locale, { type: 'conjunction' }).format(people.map((p) => first(p.name)));
---
<span class="call-faces"><span class="sr-only" id={id}>{t('hero.callPeople', { names })}</span>{faces.map((f) => <span class="cf" aria-hidden="true"><img src={f.img.src} width={f.img.width} height={f.img.height} alt="" loading="eager" decoding="async" /></span>)}</span>

<style is:global>
  /* Knopf und Porträts bleiben eine Zeile; die Knopfreihe (.actions) darf vor der Gruppe umbrechen */
  .call { display: inline-flex; align-items: center; gap: var(--space-3); flex-wrap: nowrap; min-width: 0; }
  .call-faces { display: inline-flex; flex: none; }
  /* Ausschnitt aufs Gesicht: die Teamfotos sind Halbtotalen (4 : 5), bei 36 px wäre der Kopf sonst winzig. Das Bild ist
     1,8-mal so breit wie der Kreis, Bildpunkt (50 %, 32 %) liegt in der Kreismitte. */
  .call-faces .cf { position: relative; display: block; width: 1.75rem; height: 1.75rem; border-radius: var(--radius-round); overflow: hidden;
    box-shadow: 0 0 0 1px var(--line-strong); background: var(--media-ground); }
  /* im Knopf: Porträt statt Icon, links etwas weniger Innenabstand, damit der Kreis optisch mittig im Rand sitzt */
  .btn:has(> .call-faces) { padding-left: var(--space-2-5); }
  .call-faces .cf + .cf { margin-left: -0.5rem; }
  .call-faces img { position: absolute; width: 180%; height: auto; max-width: none; left: -40%; top: -22%; }
</style>
