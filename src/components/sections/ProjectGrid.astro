---
import { getCollection } from 'astro:content';
import { optimizedImage } from '../../lib/media';
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'projectGrid' }> & { index: number };
const { headline = 'Shows, die wir schon geflogen sind.', text, cta, limit, id, index } = Astro.props;
const headingId = `${id ?? (index === 0 ? 'projekte' : `s${index}`)}-h`;
const H = index === 0 ? 'h1' : 'h2';
const Title = index === 0 ? 'h2' : 'h3';
const projects = (await getCollection('projects', (p) => !p.data.draft))
  .sort((a, b) => (a.data.showcase?.order ?? 999) - (b.data.showcase?.order ?? 999) || Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, limit);
const images = new Map(await Promise.all(projects.filter((p) => p.data.cover).map(async (p) => [p.id, await optimizedImage(p.data.cover!.src)] as const)));
// One line of facts: occasion (first part of the category, e.g. "Sport"), venue, drones.
const meta = (p: (typeof projects)[number]) => [p.data.showcase ? p.data.showcase.category.split('·')[0].trim() : p.data.client, p.data.location, p.data.showcase && `${p.data.showcase.drones} Drohnen`].filter(Boolean).join(' · ');
---
<section class="section" id={id} aria-labelledby={headingId}>
  <div class="sec-head"><H id={headingId}>{headline}</H>{text && <p>{text}</p>}</div>
  <ul class="projects" role="list">
    {projects.map((project) => {
      const showcase = project.data.showcase;
      const image = images.get(project.id);
      return <li><a class="proj" href={showcase ? `/${showcase.route}/` : `/projekte/${project.id}/`}>
        <span class:list={['img', { empty: !image }]}>{image && <img src={image.src} {...image.attributes} width={image.width} height={image.height} alt={project.data.cover!.alt} loading="lazy" decoding="async" />}</span>
        <Title>{showcase?.cardTitle ?? project.data.title}</Title>
        <span class="proj-meta">{meta(project)}</span>
        {!showcase && <span class="proj-text">{project.data.summary}</span>}
      </a></li>;
    })}
  </ul>
  {cta && <p class="more"><a class="btn" href={cta.href}>{cta.label}</a></p>}
</section>
