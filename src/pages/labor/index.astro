---
// Schrift-Labor · Übersicht, Runde 3 (13.11.2026) nach Marcs Rückmeldung: weniger am Schwarm, Punktübergänge zwischen
// den Sections, neue Antworten des Himmels, und die Schriftfrage auf Space Grotesk gegen Geist Pixel verengt
// (dazu eine eigene Ableitung mit weichen Ecken). Konzept: docs/schrift-labor/himmel.md, Schrift: docs/schrift-labor/pixel-weich.md.
import Base from '../../layouts/Base.astro';

interface Candidate { id: string; name: string; kind: string; css: string; facts: [string, string][]; verdict: string; query: string }

const fonts: Candidate[] = [
  {
    id: 'pixel-weich', name: 'Geist Pixel, weiche Ecken', kind: 'Eigene Ableitung, Demo', css: "font-family:'FS Pixel Weich';font-variation-settings:'ROND' 100", query: 'schrift=pixel-weich',
    facts: [['Was', 'Die gefüllte Buchstabenform von Geist Pixel, aber mit gerundeten Ecken. Ein Regler von hart bis weich'], ['Auftritt', 'Linien, dann Punkte, dann gefüllt, dann werden die Ecken weich'], ['Lizenz', 'SIL Open Font License 1.1; Ableitungen sind erlaubt, unter anderem Namen'], ['Datei', '16 KB (Geist Pixel: 29 KB). Der Auftritt lädt heute beide'], ['Offen', 'Eine Datei mit beiden Zuständen; Zeichen einzeln durchsehen']],
    verdict: 'Die Antwort auf „geht das auch ohne harte Kanten?“: ja. Die Schrift bleibt so lesbar wie Geist Pixel, weil die Striche durchgehen, und wirkt weicher. Es ist eine Demo: gebaut per Skript, nicht von Hand nachgezeichnet.',
  },
  {
    id: 'geist-pixel', name: 'Geist Pixel', kind: 'Original, runde Pixelform', css: "font-family:'Geist Pixel';font-variation-settings:'ELSH' 20", query: 'schrift=geist-pixel&pixel=rund',
    facts: [['Was', 'Die Schrift bringt einen Regler mit, der jeden Pixel einzeln vom Quadrat zum Kreis formt'], ['Auftritt', 'Linien laufen zu Punkten zusammen'], ['Lizenz', 'SIL Open Font License 1.1 (Vercel)'], ['Datei', '29 KB'], ['Grenze', 'Rund sind nur die einzelnen Pixel. Gefüllt bleibt die Form eckig']],
    verdict: 'Mit runden Pixeln näher an Lichtpunkten, aber die Striche sehen dann wie Perlenketten aus. In kleinen Größen ist der Unterschied zu eckig kaum zu sehen.',
  },
  {
    id: 'space-grotesk', name: 'Space Grotesk', kind: 'Ist-Stand', css: "font-family:'Space Grotesk';font-weight:500;letter-spacing:-0.03em", query: 'schrift=space-grotesk',
    facts: [['Was', 'Die heutige Überschriftenschrift, mit durchgestrichener Null'], ['Auftritt', 'keiner'], ['Datei', 'schon geladen']],
    verdict: 'Der Vergleich. Am ruhigsten und am besten lesbar, aber ohne Bezug zu Lichtpunkten.',
  },
];
const LADDER: [string, string, string][] = [
  ['H1', 'var(--text-4xl)', 'Wir gestalten euer Stück Himmel.'],
  ['H2', 'var(--text-3xl)', 'Für jeden Anlass die passende Show.'],
  ['H3', 'var(--text-xl)', 'Eure Marke auf der größten Leinwand der Welt'],
  ['H4', '1.125rem', 'Wie viel Vorlauf braucht ihr? · ab 15.900 €'],
  ['Etikett', 'var(--text-xs)', 'MARKEN & WERBUNG · 48 H ANTWORT'],
];
const pages = [{ label: 'Startseite', path: '/' }, { label: 'Marken & Werbung', path: '/drohnenshow-werbung/' }];
const world = (q: string) => `${q}&einsatz=alles&auftritt=lauf&himmel=antwortet&kante=punkte`;
const CHANGED: [string, string][] = [
  ['Keine Zahlen mehr', 'Die Bilder stehen ohne Name, Drohnenzahl und Maße. Auch die Himmelszeile und das Formular zeigen nur noch das Bild.'],
  ['Bilder nur mit Luft', 'Ein Bild erscheint neben einer Überschrift nur, wenn es nichts berührt. In „Ablauf“ (Marken & Werbung) steht deshalb keins mehr.'],
  ['Früher unterwegs', 'Der Schwarm fliegt los, sobald die nächste Stelle ins Bild kommt, und startet nie von weit außerhalb. Am Formular steht das Bild, bevor man dort ist.'],
  ['Hinweise aus', 'Die orangen „Fehlt noch“-Hinweise erscheinen auch im Dev-Server nicht mehr.'],
];
const NEW: [string, string, string, string][] = [
  ['Übergänge', 'Wo zwei Sectionfarben aufeinandertreffen, löst sich die Kante in Punkte auf statt in einer Haarlinie zu enden. Unregelmäßig, sehr leise, 4 KB.', '/?kante=punkte&himmel=aus#pakete', 'Übergang ansehen'],
  ['Himmelszeile kennt Motive', 'Wer „Herz“, „Stern“, „Leuchtturm“ oder ein anderes der 82 Katalogmotive eintippt, sieht erst das Wort, dann das Bild. Ohne Eingabe wechseln Worte und Bilder.', '/?himmel=antwortet', 'Ausprobieren'],
  ['Countdown zur Show', 'Im Formular folgt auf das gewählte Datum am Himmel „NOCH 211 TAGE“.', '/?himmel=antwortet#anfrage', 'Datum wählen'],
  ['Dank am Himmel', 'Nach dem Absenden bedankt sich der Schwarm beim Vornamen, danach steht der Stern. Im Dev-Server über den Knopf „Anfrage-Finale“ in der Labor-Leiste.', '/?himmel=antwortet#anfrage', 'Zum Formular'],
];
---
<Base title="Schrift-Labor" description="Die Seite als Show: Runde 3." noindex>
  <section class="page-hero">
    <div class="page-hero-copy">
      <span class="kicker mono">Labor · Runde 3 · 13.11.2026</span>
      <h1 data-lab-still>Die Seite als Show: leiser, früher, runder</h1>
      <p class="lead">Der Schwarm hält sich zurück, die Sections fließen ineinander, und Geist Pixel bekommt weiche Ecken. Jede Neuerung lässt sich in der Leiste unten rechts einzeln schalten.</p>
      <ul class="lo-links">
        {pages.map((p) => <li><a class="link" href={`${p.path}?${world('schrift=pixel-weich')}`}>{p.label} mit allem <span aria-hidden="true">→</span></a></li>)}
      </ul>
    </div>
  </section>

  <section class="section lo">
    <article class="lo-font" id="schwarm">
      <div class="lo-show">
        <span class="kicker mono">Geändert</span>
        <dl class="lo-facts lo-wide">{CHANGED.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}</dl>
      </div>
      <div class="lo-side">
        <ul class="lo-links">
          <li><a class="link" href="/?himmel=antwortet">Schwarm antwortet <span aria-hidden="true">→</span></a></li>
          <li><a class="link" href="/?himmel=fliegt">Schwarm fliegt nur beim Scrollen <span aria-hidden="true">→</span></a></li>
          <li><a class="link" href="/?himmel=aus&schrift=space-grotesk&kante=linie">Ist-Stand <span aria-hidden="true">→</span></a></li>
        </ul>
      </div>
    </article>
    <article class="lo-font" id="neu">
      <div class="lo-show">
        <span class="kicker mono">Neu</span>
        <dl class="lo-facts lo-wide">{NEW.map(([k, v, href, go]) => <div><dt class="mono">{k}</dt><dd>{v} <a class="link" href={href}>{go} <span aria-hidden="true">→</span></a></dd></div>)}</dl>
      </div>
    </article>
    {fonts.map((f, i) => (
      <article class="lo-font" id={f.id}>
        <div class="lo-show">
          <span class="kicker mono">Schrift {i + 1} · {f.kind}</span>
          <h2 class="lo-name" data-lab-still style="font-family:var(--display);font-weight:500;letter-spacing:-0.03em;font-variation-settings:normal">{f.name}</h2>
          <div class="lo-ladder">
            {LADDER.map(([label, size, text]) => <div><small class="mono">{label}</small><p style={`${f.css};font-size:${size}${label === 'Etikett' ? ';letter-spacing:0.1em;color:var(--accent)' : ''}`} data-orphans="keep">{text}</p></div>)}
          </div>
        </div>
        <div class="lo-side">
          <p class="lo-verdict">{f.verdict}</p>
          <dl class="lo-facts">{f.facts.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}</dl>
          <ul class="lo-links">
            {pages.map((p) => <li><a class="link" href={`${p.path}?${world(f.query)}`}>{p.label} mit {f.name} <span aria-hidden="true">→</span></a></li>)}
          </ul>
        </div>
      </article>
    ))}
    <p class="lo-note">Handjet, Bitcount und Doto sind aus dem Labor entfernt; die Entscheidung fällt zwischen Space Grotesk und Geist Pixel.</p>
  </section>
</Base>
<style>
  .lo { display: grid; gap: 0; padding-top: 0; }
  .lo-font { display: grid; gap: var(--space-9) clamp(var(--space-8), 5vw, var(--space-20)); padding: clamp(var(--space-12), 6vw, var(--space-20)) 0; border-top: 1px solid var(--line); scroll-margin-top: 5.5rem; }
  @media (--grid-expanded) { .lo-font { grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr); align-items: start; } }
  .lo-show { display: grid; gap: var(--space-5); min-width: 0; }
  .lo-show > .kicker { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); align-items: center; }
  .lo-warn { font-weight: 500; color: var(--bad); border: 1px solid currentColor; border-radius: var(--radius-pill); padding: var(--space-1) var(--space-2); letter-spacing: 0.08em; }
  .lo-name { font-size: var(--text-xl); line-height: 1.15; color: var(--muted); margin-top: calc(-1 * var(--space-3)); }
  /* Die echte Hero-Zeile in der Kandidatenschrift ist das eine große Element je Block */
  .lo-xl { margin: 0; font-size: var(--text-4xl); line-height: 1.04; color: var(--head); max-width: 9.4em; text-wrap: balance; font-synthesis: none; font-feature-settings: normal; }
  .lo-sm { margin: 0; font-size: var(--text-xl); line-height: 1.25; color: var(--head); font-synthesis: none; font-feature-settings: normal; }
  #doto .lo-xl { letter-spacing: -0.03em; }
  #doto .lo-sm { font-variation-settings: 'ROND' 0 !important; font-weight: 800 !important; }
  .lo-states { margin: var(--space-4) 0 0; display: grid; gap: var(--space-3); }
  .lo-strip { display: flex; flex-wrap: wrap; gap: var(--space-4) clamp(var(--space-5), 3vw, var(--space-10)); padding-top: var(--space-5); border-top: 1px solid var(--line); }
  .lo-strip div { display: grid; gap: var(--space-1-5); }
  .lo-strip span { font-size: var(--text-2xl); line-height: 1.1; color: var(--head); font-synthesis: none; font-feature-settings: normal; }
  .lo-strip small { color: var(--faint); }
  .lo-states figcaption { color: var(--muted); font-size: var(--text-sm); }
  .lo-side { display: grid; gap: var(--space-7); min-width: 0; }
  @media (--grid-expanded) { .lo-side { padding-top: calc(var(--space-9) + var(--space-2)); } }
  .lo-verdict { margin: 0; font-size: var(--text-md); line-height: 1.55; color: var(--text); max-width: 44ch; }
  .lo-facts { margin: 0; display: grid; }
  .lo-facts div { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--space-4); padding: var(--space-3) 0; border-top: 1px solid var(--line); }
  .lo-facts dt { color: var(--faint); padding-top: 0.2em; }
  .lo-facts dd { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: 1.5; }
  .lo-facts dd .link { display: inline-flex; margin-left: var(--space-2); font-size: inherit; }
  .lo-links { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .lo-ladder { display: grid; gap: var(--space-5); }
  .lo-ladder div { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: var(--space-4); align-items: baseline; }
  .lo-ladder small { color: var(--faint); }
  .lo-ladder p { margin: 0; line-height: 1.08; color: var(--head); font-synthesis: none; font-feature-settings: normal; text-wrap: balance; min-width: 0; overflow-wrap: anywhere; }
  .lo-facts.lo-wide div { grid-template-columns: minmax(0, 11rem) minmax(0, 1fr); }
  .lo-note { margin: 0; padding-top: var(--space-9); border-top: 1px solid var(--line); color: var(--muted); font-size: var(--text-sm); max-width: 70ch; }
  @media (max-width: 43.75em) { .lo-ladder div, .lo-facts.lo-wide div { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); } }
</style>
