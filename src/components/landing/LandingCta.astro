---
// Abschluss mit Handlung und Gesichtern, gestaltet wie auf Startseite und Preisseite (Marc, 31.10.2026: CTAs „schmaler
// und zentrierter“): schmaler Kasten mit Verlaufsrand (.promise in global.css), Gesichter oben, Text und Knöpfe zentriert.
import type { Section } from '../../content.config';
import Accent from '../Accent.astro';
import Faces from '../Faces.astro';
type Props = Extract<Section, { type: 'landingCta' }> & { index: number };
const { headline, text, button, index } = Astro.props;
const id = `s${index}-h`;
const H = index === 0 ? 'h1' : 'h2';
---
<section class="section" aria-labelledby={id}>
  <div class="promise">
    <Faces />
    <div class="promise-copy">
      <H id={id}><Accent text={headline} /></H>
      {text && <p>{text}</p>}
    </div>
    <div class="actions"><a class="btn primary" href={button.href}>{button.label}</a></div>
  </div>
</section>
