---
// Inhaltsseiten (Sammlung pages, Sections). Preis-, Blog-, Fallstudien- und 404-Routen haben eigene Dateien daneben,
// damit jede Routenart nur ihr eigenes CSS lädt (src/i18n/static-paths.ts).
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionRenderer from '../components/SectionRenderer.astro';
import { staticPathsFor } from '../i18n/static-paths';

export const getStaticPaths = () => staticPathsFor('page', 'slug');
interface Props { page: CollectionEntry<'pages'>; }
const { page } = Astro.props;
---
<Base title={page.data.title} description={page.data.description} noindex={page.data.noindex} image={page.data.image}><SectionRenderer sections={page.data.sections} /></Base>
