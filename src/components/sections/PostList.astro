---
import {localeFromPath,localeFormat,localizedHref} from '../../lib/localized-routes';
import {siteRecord as readUi} from '../../lib/content';
const ui = await readUi('ui',Astro.props._locale ?? localeFromPath(Astro.url.pathname));
const locale = Astro.props._locale ?? localeFromPath(Astro.url.pathname);
import InlineText from '../InlineText.astro';
import {sectionField,sectionBlock,recordField,listItem,sectionUses} from "../../lib/editor-markers";
import {getPosts} from '../../lib/content';
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'postList' }> & { index: number; locale?:string; _locale?:string };
const { headline = ui.components.postList.headline, limit, index } = Astro.props;
const id = `s${index}-h`;
const H = index === 0 ? 'h1' : 'h2';
const posts = (await getPosts(locale))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, limit);
const fmt = new Intl.DateTimeFormat(localeFormat(locale), { dateStyle: 'long' });
---
<section {...sectionBlock(Astro.props)} class="section" aria-labelledby={id}>
  <div class="wrap">
    <H id={id} {...sectionField(Astro.props,["headline"])}><InlineText value={headline} /></H>
    <div class="cards">
      {posts.map((p) => (
        <article class="card" {...listItem(Astro.props,{record:`post/${p.id}`})}>
          <h3><a href={localizedHref(`/blog/${p.id}/`,locale)}><span {...recordField(`post/${p.id}`,["title"])}>{p.data.title}</span></a></h3>
          <p class="muted"><time datetime={p.data.date.toISOString()} {...sectionUses(Astro.props,[{record:`post/${p.id}`,path:['date']}])}>{fmt.format(p.data.date)}</time></p>
          <p {...recordField(`post/${p.id}`,["description"])}>{p.data.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
