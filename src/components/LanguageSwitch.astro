---
import { LOCALES, LOCALE_NAMES, localizedHref, type Locale } from '../i18n/routing.mjs';
interface Props { locale: Locale; path: string; }
const { locale, path } = Astro.props;
import { createTranslator } from '../i18n/ui.mjs';
const t = createTranslator(locale);
---
<nav class="language-switch" aria-label={t('language.choose')}>
  {LOCALES.map((language) => <a href={localizedHref(path, language)} lang={language} hreflang={language} aria-label={LOCALE_NAMES[language]} aria-current={language === locale ? 'page' : undefined} data-language-link>{language.toUpperCase()}</a>)}
</nav>
<script>
  // Preserve configurator selections, selected extras and deep section links when switching language.
  document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((link) => {
    const target = new URL(link.href);
    target.search = location.search; target.hash = location.hash;
    link.href = target.href;
  });
</script>
<style>
  .language-switch { margin-left: 0; display: flex; gap: 0.125rem; align-items: center; flex-shrink: 0; }
  .language-switch a { display: grid; place-items: center; min-width: 2rem; min-height: 2.75rem; padding: 0.25rem; font: 500 var(--text-xs) var(--display); color: var(--muted); text-decoration: none; border-bottom: 2px solid transparent; }
  .language-switch a[aria-current] { color: var(--head); border-color: var(--accent); }
  .language-switch a:hover { color: var(--accent); }
  .language-switch a:focus-visible { outline: 2px solid var(--accent); outline-offset: 0.125rem; }
  @media (max-width: 30em) { .language-switch a { min-width: 1.625rem; padding-inline: 0.125rem; } }
</style>

<style>
  /* Im Mobile-Menü steht der Sprachschalter an derselben Stelle wie im Header */
  :global(.nav) .language-switch, :global(.mobile-menu .top) .language-switch { margin-left: 0; gap: 0.125rem; display: flex; }
</style>
