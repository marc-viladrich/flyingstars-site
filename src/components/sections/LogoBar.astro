---
import {siteRecord as readUi} from '../../lib/content';
import {localeFromPath,localizedHref} from '../../lib/localized-routes';
const locale = Astro.props.locale ?? Astro.props._locale ?? localeFromPath(Astro.url.pathname);
const ui = await readUi('ui',locale);
import InlineText from '../InlineText.astro';
import {sectionField,sectionBlock,recordField,recordMedia,listItem,sectionUses,markers} from '../../lib/editor-markers';
import {editorialRecord,resolveMedia} from '../../lib/content';
import {optimizedLogo} from '../../lib/media';
const {headline,press,clientIds,showImages=true}=Astro.props;
const items=await Promise.all(clientIds.map(async(id:string)=>{const client=await editorialRecord('client',id,locale),image=resolveMedia(client.logo,locale);return {...client,id,image,media:image&&showImages?await optimizedLogo(image.src,client.tall?80:56):undefined};}));
---
<div {...sectionBlock(Astro.props)} class="band" aria-label={ui.components.logoBar.clientLabel}>
  <div class="band-head mono">{headline&&<span {...sectionField(Astro.props,['headline'])}><InlineText value={headline} /></span>}{press&&<span>{ui.components.logoBar.pressLabel} <b {...sectionField(Astro.props,['press'])}>{press}</b></span>}</div>
  <div class="marquee">{items.map((client:any,i:number)=>{const record=`client/${client.id}`;const content=client.image&&client.media?<img {...markers(recordMedia(record,['logo']), sectionUses(Astro.props,[{record,path:['tall']}]))} data-media-single="logo-marquee" src={client.media.src} width={client.media.width} height={client.media.height} alt={client.image.alt} class:list={{tall:client.tall}}  loading="lazy" decoding="async"/>:<span {...recordField(record,['name'])}>{client.name}</span>;return <span {...listItem(Astro.props,{record,entry:['clientIds',i]})}>{client.href?<a {...recordField(record,['href'])} href={localizedHref(client.href,locale)}>{content}</a>:content}</span>;})}</div>
</div>
