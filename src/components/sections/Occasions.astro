---
import type { Section } from '../../content.config';
import { optimizedImage } from '../../lib/media';
type Props = Extract<Section, { type: 'occasions' }> & { index: number };
const { headline, text, id = 'anlaesse', cards, index } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
const Card = index === 0 ? 'h2' : 'h3';
// The whole card is one link; title and line give it its accessible name. Facts and downloads belong on the occasion pages.
const items = await Promise.all(cards.map(async card => ({ ...card, media: await optimizedImage(card.image.src, 960, 640), small: await optimizedImage(card.image.src, 480, 320) })));
---
<section class="section" id={id} aria-labelledby={headingId}>
  <div class="sec-head"><H id={headingId}>{headline}</H><p>{text}</p></div>
  <ul class="occasions" role="list" data-count={items.length}>
    {items.map(card => <li>
      <a class="occ" href={card.cta.href}>
        <span class="img"><img src={card.media.src} srcset={`${card.small.src} 480w, ${card.media.src} 960w`} sizes="(max-width: 640px) calc(100vw - 40px), (max-width: 1100px) 45vw, 32vw" width={card.media.width} height={card.media.height} alt={card.image.alt} loading="lazy" decoding="async" /></span>
        <Card>{card.title}</Card>
        <span class="occ-text">{card.text}</span>
      </a>
    </li>)}
  </ul>
</section>
