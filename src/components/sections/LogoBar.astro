---
import IconFeature from '../IconFeature.astro';
import PressItem from '../PressItem.astro';
import SectionHead from '../SectionHead.astro';
import { forPath } from '../../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
// Kund:innen als Laufband (ohne Hover-Effekt), darunter optional Presse und „Qualität und Sicherheit“
// (docs/DESIGN.md, Studie 6 der Designsprache-Probe). Logos liegen unter public/brand/logos/.
// Presse- und Partnerlogos erscheinen nur mit `cleared: true` (schriftliche Freigabe), sonst Text bzw. Verlaufs-Icon.
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import type { Section } from '../../content.config';
import { optimizedLogo } from '../../lib/media';
type Props = Extract<Section, { type: 'logoBar' }> & { index: number };
import Icon from '../Icon.astro';
const QICON = { permit: 'file-badge', sound: 'audio-lines', shield: 'shield-check', leaf: 'leaf' } as const;
const { headline, label, pressLabel, logos, pressHeadline = t('logoBar.pressHeadline'), pressItems, qualityHeadline = t('logoBar.qualityHeadline'), quality, kicker, id = `s${Astro.props.index}` } = Astro.props;

const file = (path: string) => join(process.cwd(), 'public', path);
const has = (path?: string) => Boolean(path && existsSync(file(path)));
// optische Größe: breite Wortmarken flacher, runde Bildmarken höher, damit alle gleich schwer wirken
const optical = (ratio: number) => Math.round(Math.min(46, Math.max(22, 30 * Math.sqrt(3 / ratio))));
// SVGs bekommen 4 % Luft um den viewBox (sonst wirken runde Marken angeschnitten). Statt den viewBox umzuschreiben
// (dann müsste das SVG inline in die Seite) wird die Luft als Innenabstand gesetzt: die Datei bleibt im Browser-Cache.
const svgSize = (path: string) => {
  const m = readFileSync(file(path), 'utf8').match(/viewBox="([\d.\s,-]+)"/);
  if (!m) return undefined;
  const [, , w, h] = m[1].trim().split(/[\s,]+/).map(Number);
  return { w, h };
};
const pngSize = (path: string) => { const b = readFileSync(file(path)); return { w: b.readUInt32BE(16), h: b.readUInt32BE(20) }; };
type Mark = { name: string; src: string; width: number; height: number; pad: string; detail: boolean; href?: string };
const marks = (await Promise.all(logos.map(async (logo): Promise<Mark | null> => {
  try {
    if (logo.file && has(logo.file)) {
      const size = logo.file.endsWith('.svg') ? svgSize(logo.file) : pngSize(logo.file);
      if (!size) return null;
      const p = logo.file.endsWith('.svg') ? Math.max(size.w, size.h) * 0.04 : 0;
      const ratio = (size.w + 2 * p) / (size.h + 2 * p), height = optical(ratio), width = Math.round(height * ratio);
      // Bildkoordinaten und intrinsische Maße bleiben unverändert; nur CSS-Ausgaben werden durch 16 geteilt.
      const pad = `${Number((p / (size.h + 2 * p) * height).toFixed(1)) / 16}rem ${Number((p / (size.w + 2 * p) * width).toFixed(1)) / 16}rem`;
      return { name: logo.name, src: logo.file, width, height, pad, detail: logo.detail, href: logo.href };
    }
    if (logo.image) {
      const img = await optimizedLogo(logo.image.src, 92), ratio = img.width / img.height, height = optical(ratio);
      return { name: logo.name, src: img.src, width: Math.round(height * ratio), height, pad: '0rem', detail: logo.detail, href: logo.href };
    }
  } catch {}
  return null;
}))).filter((m): m is Mark => Boolean(m));
// Presselogos im Raster wie „Qualität und Sicherheit“ (Marc 31.10.: die Kästen wirkten „out of whack“), optisch gleich
// schwer: breite Wortmarken flacher, kompakte Marken höher
const pressHeight = (path?: string) => { const v = path && has(path) ? (path.endsWith('.svg') ? svgSize(path) : pngSize(path)) : undefined; return v ? Math.round(Math.min(48, Math.max(20, 29 * Math.sqrt(2.4 / (v.w / v.h))))) : 29; }; // Runde 5: etwas größer, kompakte Marken (NDR, ZDF) dürfen höher werden
const pressAll = pressItems.map((p) => ({ name: p.name, logo: p.logo, knock: p.knock, href: p.href, note: p.note, show: p.cleared && has(p.logo), height: pressHeight(p.logo) }));
// Presse als Zeile unter dem Laufband (Moritz, 15.11.2026: „Geflogen für: #Logos / Ihr kennt uns aus: ZDF, WDR, NTV, WAZ“)
const inlinePress = pressLabel ? pressAll : [];
const press = pressLabel ? [] : pressAll;
const seals = quality.filter((q) => !q.secondary).map((q) => ({ ...q, show: q.cleared && has(q.logo) }));
const minor = quality.filter((q) => q.secondary);
const STILL_MAX = 8;
---
{(marks.length > 0 || inlinePress.length > 0) && <div class="band" id={id} role="region" aria-label={headline ?? t('logobar.flyingstarsClients')}>
  {label && <p class="band-label mono">{label}</p>}
  {/* Wenige Kund:innen-Logos (Hochzeit, Runde 6) stehen als ruhige Reihe wie die Presse darunter; ein Laufband bräuchte
       genug Logos, um die Breite ohne Lücke zu füllen */}
  {marks.length > 0 && marks.length <= STILL_MAX && <ul class="band-row">{marks.map((m) => <li><img class:list={{ detail: m.detail }} src={m.src} width={m.width} height={m.height} style={`height:${m.height / 16}rem;padding:${m.pad}`} alt={m.name} loading="lazy" decoding="async" /></li>)}</ul>}
  {marks.length > STILL_MAX && <div class="logo-marquee" data-loop>
    {[0, 1].map((copy) => <ul class="track" aria-hidden={copy === 1 ? 'true' : undefined}>{marks.map((m) => {
      const img = <img class:list={{ detail: m.detail }} src={m.src} width={m.width} height={m.height} style={`height:${m.height / 16}rem;padding:${m.pad}`} alt={copy ? '' : m.name} loading="lazy" decoding="async" />;
      return <li>{m.href && !copy ? <a href={localHref(m.href)}>{img}</a> : img}</li>;
    })}</ul>)}
  </div>}
  {inlinePress.length > 0 && <div class="band-press"><p class="band-label mono">{pressLabel}</p><ul>{inlinePress.map((p) => <PressItem {...p} />)}</ul></div>}
</div>}
{(press.length > 0 || seals.length > 0) && <section class="section proof" id={marks.length > 0 || inlinePress.length > 0 ? `${id}-belege` : id} aria-label={[press.length && pressHeadline, seals.length && qualityHeadline].filter(Boolean).join(', ')}>
  {press.length > 0 && <div class="press">
    <SectionHead variant="embedded" kicker={kicker} headline={pressHeadline} id={`${id}-press-h`} titleClass="proof-h" />
    <ul>{press.map((p) => <PressItem {...p} layout="cell" />)}</ul>
  </div>}
  {seals.length > 0 && <div class="quality">
    <SectionHead variant="embedded" kicker={press.length ? undefined : kicker} headline={qualityHeadline} id={`${id}-quality-h`} titleClass="proof-h" />
    <ul>{seals.map((q) => <IconFeature as="li" icon={QICON[q.icon]} logo={q.show ? q.logo : undefined} title={q.title} text={q.text} />)}</ul>
    {minor.length > 0 && <ul class="q-minor">{minor.map((q) => <IconFeature as="li" variant="compact" icon={QICON[q.icon]} title={q.title} text={q.text} />)}</ul>}
  </div>}
</section>}

<script>import '../../scripts/css-loop';</script>

<style>
  /* Beide Gruppen gleich aufgebaut (Marc, Runde 5): Label zentriert darüber, Logos darunter, klarer Abstand zwischen
     Kund:innen und Presse und mehr Luft insgesamt */
  .band { padding-block: clamp(var(--space-10), 5vw, var(--space-16)); }
  .band-label { color: var(--faint); margin: 0 0 clamp(var(--space-5), 2vw, var(--space-7)); text-align: center; }
  .band-press:not(:first-child) { margin-top: clamp(var(--space-10), 5vw, var(--space-16)); }
  .band-press { display: grid; justify-items: center; }
  .band-row, .band-press ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-6) clamp(var(--space-8), 4vw, var(--space-14)); max-width: 72rem; }
  .band-row { margin-inline: auto; }
  .band-row img { display: block; width: auto; filter: var(--logo-mono); opacity: 0.66; }
  .band-row img.detail { filter: grayscale(1) brightness(1.15); mix-blend-mode: screen; opacity: 0.8; }
  /* Einträge: PressItem.astro besitzt Logo, Name und Hover; die beiden Listen setzen nur ihre Kontextwerte */
  .band-press ul { --press-max: 8.5rem; --press-opacity: 0.66; --press-knock-opacity: 0.9; --press-name-size: 1rem; }
  .press ul { --press-max: 9.375rem; --press-opacity: 0.82; --press-knock-opacity: 1; --press-name-size: 1.375rem; --press-name-tracking: -0.02em; }
  /* Presse im Raster wie Qualität und Sicherheit: Logo, darunter leise der Anlass. Keine Kästen */
  .press ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(9.375rem, 100%), 1fr)); gap: var(--space-7) var(--space-6); }
</style>

<style is:global>
  /* Laufband (aus global.css hierher, Audit 18.11.2026 C2). Global, weil das Laufband über [data-loop] am gemeinsamen
     Schleifenschalter hängt; .proof-h, weil SectionHead die Klasse an seine Überschrift setzt.
     .proof und .proof .quality bleiben in global.css: LandingSite nutzt sie ebenfalls. */
  .logo-marquee { display: flex; overflow: hidden; padding: var(--space-1-5) 0; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .logo-marquee .track { list-style: none; margin: 0; padding: 0 clamp(var(--space-11), 5vw, var(--space-19)) 0 0; display: flex; align-items: center; gap: clamp(var(--space-11), 5vw, var(--space-19)); flex: none; animation: logo-slide var(--dur-marquee) var(--ease-linear) infinite; animation-play-state: var(--loop-play, running); }
  .logo-marquee img { display: block; width: auto; max-width: none; filter: var(--logo-mono); opacity: 0.66; }
  .logo-marquee img.detail { filter: grayscale(1) brightness(1.15); mix-blend-mode: screen; opacity: 0.8; } /* dunkle Innendetails (Bentley) bleiben sichtbar */
  @keyframes logo-slide { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) {
    .logo-marquee { -webkit-mask-image: none; mask-image: none; }
    .logo-marquee .track { animation: none; flex-wrap: wrap; flex: 1 1 auto; justify-content: center; padding: 0; row-gap: var(--space-6); }
    .logo-marquee .track + .track { display: none; }
  }
  .proof-h { font-size: clamp(1.5rem, 2.4vw, 2rem); letter-spacing: -0.02em; }
</style>
