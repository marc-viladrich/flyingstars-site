---
import Icon from './Icon.astro';
interface Props { icon?: string; logo?: string; title: string; text?: string; level?: 'h2' | 'h3'; class?: string; as?: 'div' | 'li' | 'label'; variant?: 'default' | 'compact'; textId?: string; iconClass?: string }
const { icon, logo, title, text, level: H = 'h3', as: Tag = 'div', variant = 'default', class: cls, textId, iconClass, ...rest } = Astro.props;
---
<Tag class:list={['icon-feature', { 'icon-feature-compact': variant === 'compact' }, cls]} {...rest}>
  <slot name="before" />
  {logo ? <img class="q-logo" src={logo} alt="" loading="lazy" decoding="async" /> : icon && <Icon name={icon} size={variant === 'compact' ? 18 : 36} class={`g ic-ico ${iconClass ?? ''}`} />}
  <H class="ic-h"><slot name="title">{title}</slot></H>{text && <p id={textId}>{text}</p>}
  <slot />
</Tag>
<style is:global>
  .icon-feature { display: grid; gap: 0.625rem; align-content: start; justify-items: start; }
  .icon-feature > .ico { width: 2.25rem; height: 2.25rem; }
  .icon-feature > p { margin: 0; color: var(--muted); font-size: var(--text-control); }
  .icon-feature-compact { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.375rem; }
  .icon-feature-compact > .ico { width: 1.125rem; height: 1.125rem; align-self: center; margin: 0 0.25rem 0 0; }
  .icon-feature-compact > .ic-h, .icon-feature-compact > p { font: inherit; color: inherit; }
</style>
