---
import { getCollection } from 'astro:content';
import type { Section } from '../../content.config';
import Accent from '../Accent.astro';
import ProjectCard from '../projects/ProjectCard.astro';
import { sortProjects } from '../projects/refs';
type Props = Extract<Section, { type: 'projectGrid' }> & { index: number };
const { headline = 'Ein paar Nächte, die wir nicht vergessen.', text, cta, limit, id: ownId, index } = Astro.props;
const home = Astro.url.pathname === '/';
const sectionId = ownId ?? (home ? 'projekte' : undefined);
const id = sectionId ? `${sectionId}-h` : index === 0 ? 'projekte-h' : `s${index}-h`;
const H = index === 0 ? 'h1' : 'h2';
// Startseite ohne eigenes cta: Link auf alle Referenzen wie im Prototyp
const more = cta ?? (home ? { label: 'Alle Referenzen', href: '/referenzen/' } : undefined);
const projects = sortProjects(await getCollection('projects', (p) => !p.data.draft)).slice(0, limit);
---
<section class="section" id={sectionId} aria-labelledby={id}>
  <div class="sec-head"><H id={id}><Accent text={headline} /></H>{text && <p>{text}</p>}</div>
  <div class="projects">{projects.map((project, i) => <ProjectCard project={project} i={i} level={index === 0 ? 'h2' : 'h3'} />)}</div>
  {more && <div class="more"><a class="link" href={more.href}>{more.label} <span aria-hidden="true">→</span></a></div>}
</section>
