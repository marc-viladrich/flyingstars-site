---
// Meilensteine als vertikaler Zeitstrahl (Marc, 31.10.2026, Runde 8: „ein bisschen mehr Farbe“). Dieselbe Mechanik wie
// der Ablauf auf der Startseite (Tempo.astro, .ruler): Beim Erscheinen zieht die Verlaufslinie von Punkt zu Punkt, die
// Punkte schalten nacheinander farbig ein, wie Drohnen. Die Farbe wandert über den Logoverlauf (amber → orchid → cyan),
// die Jahreszahl übernimmt die Farbe ihres ersten Punkts. Ruhig, kein Schwarm (docs/DESIGN.md).
// Eine Jahreszahl, die sich wiederholt, steht nur einmal sichtbar da und bleibt für Screenreader lesbar.
// Ohne JS, bei reduzierter Bewegung und globaler Pause: alles sofort sichtbar und farbig.
import type { Section } from '../../content.config';
import {projectValues} from '../../content/project-facts.mjs';
import {localeFromPath} from '../../i18n/routing.mjs';
import ProcessList from '../ProcessList.astro';
import SectionHead from '../SectionHead.astro';
type Props = Extract<Section, { type: 'timeline' }> & { index: number };
const { headline, text, items, cta, surface, id = `s${Astro.props.index}`, index, kicker } = Astro.props;
import { forPath } from '../../i18n/server';
const { localHref } = forPath(Astro.url.pathname);
const H = index === 0 ? 'h1' : 'h2';
const T = index === 0 ? 'h2' : 'h3';
const headingId = `${id}-h`;
---
<section class:list={['section ms-sec', { alt: surface === 'alt' }]} id={id} aria-labelledby={headingId}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={headingId} level={H} />
  <ProcessList items={projectValues(items,localeFromPath(Astro.url.pathname))} variant="milestones" level={T} />
  {cta && <p class="ms-more"><a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a></p>}
</section>

<style>
  .ms-more { margin-top: clamp(var(--space-6), 3vw, var(--space-9)); }
</style>

