---
import Styles from '../Styles.astro';
import portraitStyles from '../Portrait.css?url';
import ownerStyle0 from './ContactDetails.css?url';
import {record,field} from 'astro-frontend-editor/markers';
import {CONTACT_OWNER} from '../../content/contact.mjs';
// Kontaktwege und Anschriften mit Icons, daneben das Team (Runde 20, Marc 04.11.2026: „deutlich nicer und ansprechender“,
// Adressen mehrzeilig wie auf einem Briefumschlag, Mobil und WhatsApp mit eigenen Icons, zwei Spalten mit Teamfoto).
// Nummern, Adressen und Links stehen nur in CONTACT (people.ts); die Section liefert Überschrift, Text und den Besuchshinweis.
// Solange es kein Teamfoto gibt, stehen hier die Porträts der Geschäftsführer:innen (mit Lichtpunkt-Hover wie im Team).
import { forPath } from '../../i18n/server';
import type { Section } from '../../content.config';
import { optimizedImage } from '../../lib/media';
import { CONTACT, FOUNDERS } from '../people';
import SectionHead from '../SectionHead.astro';
import IconFeature from '../IconFeature.astro';
import Icon from '../Icon.astro';
import Picture from '../Picture.astro';
type Props = Extract<Section, { type: 'contactDetails' }> & { index: number };
const { kicker, headline, text, visitNote, image, id: anchor, index } = Astro.props;
const { t, localHref } = forPath(Astro.url.pathname);
const id = `${anchor ?? `s${index}`}-h`;
const H = index === 0 ? 'h1' : 'h2';
const Item = index === 0 ? 'h2' : 'h3';
const ways = [
  { path: ['phone'], icon: 'phone', title: t('contactDetails.phone'), label: CONTACT.phone.label, href: CONTACT.phone.href },
  { path: ['mobile'], icon: 'smartphone', title: t('contactDetails.mobile'), label: CONTACT.mobile.label, href: CONTACT.mobile.href },
  { path: ['mobile'], icon: 'whatsapp', title: 'WhatsApp', label: t('contactDetails.whatsappAction'), href: CONTACT.whatsapp.href, external: true },
  { path: ['email'], icon: 'mail', title: t('contactDetails.email'), label: CONTACT.email, href: `mailto:${CONTACT.email}` },
];
const crew = image ? [] : await Promise.all(FOUNDERS.map(async (p) => ({ ...p, img: await optimizedImage(p.image.src, 480) })));
---
<Styles href={ownerStyle0} id="components/sections/ContactDetails.css" />
<Styles href={portraitStyles} id="components/Portrait.css" />
<section class="section contact-details" id={anchor} aria-labelledby={id}>
  <div class="cd-main">
    <SectionHead variant="embedded" kicker={kicker} headline={headline} text={text} id={id} level={H} textClass="cd-lead" />
    <ul class="cd-grid" {...record(CONTACT_OWNER)}>
      {ways.map((w) => <IconFeature as="li" icon={w.icon} title={w.title} level={Item}><a {...field(CONTACT_OWNER,w.path,{mode:'panel'})} class="cd-link hover-line" href={localHref(w.href)} rel={w.external ? 'noopener' : undefined} target={w.external ? '_blank' : undefined}>{w.label}</a></IconFeature>)}
      <IconFeature as="li" icon="map-pin" title={t('contactDetails.visit')} level={Item}><address>{CONTACT.visit.map((line,i) => <span {...field(CONTACT_OWNER,['visit',i],{mode:'panel'})}>{line}</span>)}</address>{visitNote && <p class="cd-note">{visitNote}</p>}</IconFeature>
      <IconFeature as="li" icon="mailbox" title={t('contactDetails.post')} level={Item}><address>{CONTACT.post.map((line,i) => <span {...field(CONTACT_OWNER,['post',i],{mode:'panel'})}>{line}</span>)}</address></IconFeature>
    </ul>
    <a {...field(CONTACT_OWNER,['video','href'],{mode:'panel'})} class="btn cd-video" href={localHref(CONTACT.video.href)} rel="noopener" target="_blank"><Icon name="video" class="g" />{t(CONTACT.video.labelKey)}</a>
  </div>
  {image
    ? <figure class="cd-photo"><Picture {...image} /></figure>
    : <ul class="cd-crew" aria-label={t('contactDetails.team')}>{crew.map((p) => <li><div class="portrait" data-dot-img data-step="6"><img src={p.img.src} width={p.img.width} height={p.img.height} alt={p.image.alt} loading="lazy" decoding="async" /></div><span>{p.name}</span></li>)}</ul>}
</section>
