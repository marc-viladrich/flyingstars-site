---
import MediaFrame from '../MediaFrame.astro';
import FactList from '../FactList.astro';
import { forPath } from '../../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
import type { Section } from '../../content.config';
import Accent from '../Accent.astro';
import { videoPath, videos } from '../../lib/videos';
import { heroVideoSources } from '../../lib/hero-video-sources';
import { optimizedImage } from '../../lib/media';
// Hero mit laufendem Showreel (Marc, 31.10.2026: „mehr Bewegung, das Showreel gehört in den Hero“, wie im
// Vercel-Prototyp): stumm im Hintergrund, Start erst nach dem ersten Bild. Den Knopf „Showreel ansehen“ (Overlay mit Ton)
// gibt es nicht mehr (Marc, 01.11.2026: „brauchen wir nicht“); bis das Reel läuft, steht das Standbild da.
// Ohne Video bei reduzierter Bewegung, globaler Pause und Datensparmodus. Auf dem Handy (bis 700 px) steht das Video als
// gerahmtes Bild im Fluss über der Überschrift und lädt die kleine Fassung (Marc, 02.11.2026).
const { headline, text, words, cta, secondary, poster, video, stats, eyebrow } = Astro.props as Extract<Section, { type: 'showreelHero' }>;
const still = await optimizedImage(poster.src, 960);
const sources = video === videos.showreel ? heroVideoSources() : undefined;
---
<section class="hero side" aria-labelledby="hero-h" data-reel-host>
  <div class="video-player hero-media" aria-hidden="true"><img src={still.src} width={still.width} height={still.height} alt="" loading="eager" fetchpriority="high" /></div>
  <video class="reel" data-reel data-reel-sources={sources ? JSON.stringify(sources) : undefined} data-src={videoPath(video)} data-src-small={videoPath(video, 'preview')} muted loop playsinline preload="none" poster={still.src} aria-hidden="true" tabindex="-1"></video>
  <div class="shade" aria-hidden="true"></div>
  <div class="rec mono" aria-hidden="true">Showreel</div>
  <MediaFrame corners="content" as="div" aria-hidden="true" />
  <div class="hero-copy">
    {eyebrow && <span class="kicker mono">{eyebrow}</span>}
    <h1 id="hero-h"><Accent text={headline} />{words && words.length > 0 && <> <span class="word" data-rotate={words.map(word => word.value).join('|')}>{words[0].value}</span></>}</h1>
    <p class="lead">{text}</p>
    <div class="actions"><a class="btn primary" href={localHref(cta.href)}>{cta.label}</a>{secondary && <a class="btn" href={localHref(secondary.href)}>{secondary.label}</a>}</div>
  </div>
  {stats && stats.length > 0 && <FactList items={stats} variant="spec" label={t('flighthero.keyFacts')} />}
</section>

<script is:inline>
  // Zum Vergleich (Marc, 31.10.2026: „beide Varianten zeigen“): ?hero=voll zeigt die vollflächige Fassung
  if (new URLSearchParams(location.search).get('hero') === 'voll') document.querySelector('.hero.side')?.classList.remove('side');
</script>
<script>import '../../scripts/hero-reel';</script>
