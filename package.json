{
  "name": "astro-site-template",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test 'scripts/*.test.mjs' && playwright test",
    "gates": "astro check && astro build && npm test",
    "editor": "node editor/server.mjs",
    "ci": "node editor/ci/check.mjs",
    "test:unit": "node --test 'editor/*.test.mjs' 'editor/core/*.test.mjs' 'editor/test/*.test.mjs' 'scripts/*.test.mjs' src/schemas/editorial-source.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.1",
    "astro-frontend-editor": "npm:@marc-viladrich/astro-frontend-editor@0.2.4",
    "marked": "^18.1.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "typescript": "^6.0.3"
  }
}
