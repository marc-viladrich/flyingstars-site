---
import {recordField as uiMarker} from '../../lib/editor-markers';
import {jsonScript} from '../../lib/json-script.mjs';
import {siteRecord as readUi} from '../../lib/content';
import {localeFromPath,localizedHref} from '../../lib/localized-routes';
const locale = Astro.props.locale ?? Astro.props._locale ?? localeFromPath(Astro.url.pathname);
const ui = await readUi('ui',locale);
import {getExtras} from '../../lib/content';
const extras=await getExtras(locale);
import {getScreen} from '../../lib/content';
const screen = await getScreen('drohnenshow-preise',locale);
import Base from '../../layouts/Base.astro';
import Calculator from '../pricing/Calculator.astro';
import PackageDetails from '../pricing/PackageDetails.astro';
import { siteRecord } from '../../lib/content';
import { recordField } from '../../lib/editor-markers';
const pricingFaq: Array<{question:string;answer:string}>=ui.prices.faq.items;
const faqJson={"@context":"https://schema.org","@type":"FAQPage",mainEntity:pricingFaq.map(item=>({"@type":"Question",name:item.question,acceptedAnswer:{"@type":"Answer",text:item.answer}}))};
const videoCall = (await siteRecord('contact',locale)).videoCall;
---
<Base locale={locale} title={screen.title} description={screen.description} noindex={screen.noindex}>
  <Calculator />
  <PackageDetails />

  <section class="section" aria-labelledby="incl-h">
    <div class="sec-head">
      <div><span class="kicker mono" {...uiMarker('site/ui',["prices", "included", "label"])}>{ui.prices.included.label}</span><h2 id="incl-h" {...uiMarker('site/ui',["prices", "included", "headline"])}>{ui.prices.included.headline}</h2></div>
      <p {...uiMarker('site/ui',["prices", "included", "intro"])}>{ui.prices.included.intro}</p>
    </div>
    <div class="inclusive">
      {ui.prices.included.items.map((item:{label:string;title:string;text:string},i:number) => <div><span class="k mono" style="color:var(--faint)" {...uiMarker('site/ui',['prices','included','items',i,'label'])}>{item.label}</span><b {...uiMarker('site/ui',['prices','included','items',i,'title'])}>{item.title}</b><p {...uiMarker('site/ui',['prices','included','items',i,'text'])}>{item.text}</p></div>)}
    </div>
  </section>

  <!-- extras -->
  <section class="section alt" aria-labelledby="extras-h">
    <div class="sec-head">
      <div><span class="kicker mono" {...uiMarker('site/ui',["prices", "extras", "label"])}>{ui.prices.extras.label}</span><h2 id="extras-h" {...uiMarker('site/ui',["prices", "extras", "headline"])}>{ui.prices.extras.headline}</h2></div>
      <p {...uiMarker('site/ui',["prices", "extras", "intro"])}>{ui.prices.extras.intro}</p>
    </div>
    <div class="extras">
      {extras.map(extra => <div class="extra"><span class="k mono" {...recordField(`extra/${extra.id}`,['name'])}>{extra.data.name}</span><h3 {...recordField(`extra/${extra.id}`,['title'])}>{extra.data.title}</h3><p {...recordField(`extra/${extra.id}`,['text'])}>{extra.data.text}</p><span class="price mono" {...recordField(`extra/${extra.id}`,['priceNote'])}>{extra.data.priceNote}</span></div>)}
    </div>
  </section>

  <!-- price promise -->
  <section class="section" aria-labelledby="promise-h">
    <div class="promise">
      <div style="display:grid;gap:12px">
        <span class="kicker mono" style="margin:0" {...uiMarker('site/ui',["prices", "promise", "label"])}>{ui.prices.promise.label}</span>
        <h2 id="promise-h" {...uiMarker('site/ui',["prices", "promise", "headline"])}>{ui.prices.promise.headline}</h2>
        <p {...uiMarker('site/ui',["prices", "promise", "text"])}>{ui.prices.promise.text}</p>
      </div>
      <a class="btn primary" href={localizedHref("/#anfrage",locale)} {...uiMarker('site/ui',["prices", "promise", "buttonText"])}>{ui.prices.promise.buttonText}</a>
    </div>
  </section>

  <!-- pricing faq -->
  <section class="section alt" id="faq" aria-labelledby="faq-h">
    <div class="faq-grid">
      <div class="intro">
        <span class="kicker mono" style="margin:0" {...uiMarker('site/ui',["prices", "faq", "label"])}>{ui.prices.faq.label}</span>
        <h2 id="faq-h" {...uiMarker('site/ui',["prices", "faq", "headline"])}>{ui.prices.faq.headline}</h2>
        <p {...uiMarker('site/ui',["prices", "faq", "intro"])}>{ui.prices.faq.intro}</p>
        <a class="link" href={localizedHref(videoCall.href,locale)} target="_blank" rel="noopener" {...recordField("site/contact", ["videoCall", "href"])}>{ui.prices.faq.buttonText} <span aria-hidden="true">→</span></a>
      </div>
      <div class="faq">
        {pricingFaq.map((item,i) => <details open={i===0}><summary {...uiMarker('site/ui',['prices','faq','items',i,'question'])}>{item.question}</summary><div class="answer"><p {...uiMarker('site/ui',['prices','faq','items',i,'answer'])}>{item.answer}</p></div></details>)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cta-h">
    <div class="promise" style="background:var(--surface)">
      <div style="display:grid;gap:12px"><h2 id="cta-h" {...uiMarker('site/ui',["prices", "cta", "headline"])}>{ui.prices.cta.headline}</h2><p {...uiMarker('site/ui',["prices", "cta", "text"])}>{ui.prices.cta.text}</p></div>
      <a class="btn primary" href={localizedHref("/#anfrage",locale)} {...uiMarker('site/ui',["prices", "cta", "buttonText"])}>{ui.prices.cta.buttonText}</a>
    </div>
  </section>

<script is:inline type="application/ld+json" set:html={jsonScript(faqJson)} />
</Base>
<script>
  import '../../scripts/pricing.js';
</script>
