---
import { localizedCollection } from '../i18n/content';
import { forPath } from '../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
import '../styles/fonts.css';
import '../styles/global.css';
import { getSite } from '../site.config';
const site = getSite(forPath(Astro.url.pathname).locale);
import Logo from '../components/Logo.astro';
import { optimizedImage } from '../lib/media';
import { LOCALES, localeFromPath, sourcePath, sourceId, localizedHref } from '../i18n/routing.mjs';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { SHOWS_TOTAL } from '../components/facts';
interface Props { title: string; description: string; noindex?: boolean; canonicalPath?: string; image?: string; navSection?: string; fullBleed?: boolean; }
const { title, description, noindex = false, canonicalPath, image, navSection, fullBleed: bleed = false } = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const locale = localeFromPath(Astro.url.pathname);
const current = sourcePath(Astro.url.pathname);
const hasTranslations = !current.startsWith('/poc/');
const href = (path: string) => localizedHref(path, locale);
// Case pages and project details belong to the "Projekte" area of the main navigation.
// Fallstudien übergeben navSection="/referenzen/" und gehören damit zum Bereich „Referenzen“.
const section = navSection;
const navState = (href: string) => current === href ? 'page' : section === href ? 'true' : undefined;
const social = image ? await optimizedImage(image, 960, undefined, 'jpg') : undefined;
// Vollflächig: Startseite, Preisseite und Fallstudien (diese kommen mit navSection, die Übersicht /referenzen/ nicht)
const fullBleed = bleed || ['/', '/drohnenshow-preise/'].includes(current) || (navSection === '/referenzen/' && current !== '/referenzen/');
// Anlass-Seiten (drohnenshow-*) für den Footer, Name aus navLabel bzw. Titel der Seite
const occasionPages = (await localizedCollection('pages', locale, p => sourceId(p.id).startsWith('drohnenshow-') && !p.data.noindex))
  .map((p) => ({ label: p.data.navLabel ?? p.data.title, href: href(`/${sourceId(p.id)}/`) }))
  .sort((a, b) => a.label.localeCompare(b.label, locale));
const inNav = (href: string) => site.nav.some((item) => item.href === href);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && <>{LOCALES.map((language) => <link rel="alternate" hreflang={language} href={new URL(localizedHref(sourcePath(canonical.pathname), language), Astro.site)} />)}<link rel="alternate" hreflang="x-default" href={new URL(sourcePath(canonical.pathname), Astro.site)} /></>}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={`${title} | FlyingStars`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {social && <meta property="og:image" content={new URL(social.src, Astro.site)} />}
    {social && <meta property="og:image:width" content={String(social.width)} />}
    {social && <meta property="og:image:height" content={String(social.height)} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Reveal-Startzustand vor dem ersten Bild: nur mit Bewegung (keine reduzierte Bewegung, keine gespeicherte Pause) -->
    <script is:inline>(function(){var s=null;try{s=sessionStorage.getItem('flyingstars:motion')}catch(e){}var still=s?s==='paused':matchMedia('(prefers-reduced-motion: reduce)').matches;if(!still&&'IntersectionObserver' in window)document.documentElement.classList.add('reveal')})();</script>
  </head>
  <body>
    <a class="skip" href="#main">{t('base.skipToContent')}</a>
    <!-- Logoverlauf für Icon-Konturen (.ico.g, stroke: url(#fs-grad)); nicht display:none, sonst greift der Verweis nicht -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs><linearGradient id="fs-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff9e29" /><stop offset=".5" stop-color="#db64e8" /><stop offset="1" stop-color="#33edf2" /></linearGradient></defs></svg>
    <div class="nav-sentinel" aria-hidden="true"></div>
    <header class="nav">
      <Logo />
      <nav aria-label={t('base.mainNavigation')}>{site.nav.map((item) => item.children ? <div class="nav-drop"><a href={localHref(item.href)} aria-current={navState(item.href)}>{item.label} <svg class="caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" /></svg></a><ul>{item.children.map((c) => <li><a href={localHref(c.href)} aria-current={navState(c.href)}>{c.label}</a></li>)}</ul></div> : <a href={localHref(item.href)} aria-current={navState(item.href)}>{item.label}</a>)}</nav>
      {hasTranslations && <LanguageSwitch locale={locale} path={current} />}
      <button class="motion-btn" type="button" data-motion-toggle aria-pressed="false" aria-label={t('base.pauseMotion')} title={t('base.pauseMotion')}><svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="7" y="6" width="3.2" height="12" rx="1" /><rect x="13.8" y="6" width="3.2" height="12" rx="1" /></svg><svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.5 6.2v11.6a.8.8 0 0 0 1.2.7l9-5.8a.8.8 0 0 0 0-1.4l-9-5.8a.8.8 0 0 0-1.2.7z" /></svg></button>
      <a class="btn small primary" href={localHref(site.cta.href)}>{site.cta.label}</a>
      <button class="menu-btn" type="button" data-menu-open aria-controls="mobile-menu" aria-expanded="false" aria-label={t('base.openMenu')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
    </header>
    <dialog class="mobile-menu" id="mobile-menu" aria-label={t('base.mainNavigation')}>
      <div class="top"><Logo /><button class="menu-btn menu-close" type="button" data-menu-close aria-label={t('base.closeMenu')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></button></div>
      <nav aria-label={t('base.mobileNavigation')}>{site.nav.map((item) => <><a href={localHref(item.href)}>{item.label}</a>{item.children && <ul class="sub">{item.children.map((c) => <li><a href={localHref(c.href)}>{c.label}</a></li>)}</ul>}</>)}{!inNav('/blog/') && <a href={localHref("/blog/")}>Blog</a>}<a href={localHref(site.cta.href)}>{site.cta.label}</a></nav>
      {hasTranslations && <LanguageSwitch locale={locale} path={current} />}
    </dialog>
    <main id="main" class:list={{ 'content-page': !fullBleed }}><slot /></main>
    <footer class="footer">
      <div class="cols">
        <div class="footer-brand"><Logo /><p>{t('base.droneShowsSince2022')} {SHOWS_TOTAL} {t('base.showsInGermanyAndEurope')}</p><p class="eco"><img src="/brand/logos/quali-naturstrom.svg" alt="naturstrom" width="120" height="30" loading="lazy" decoding="async" /><span>{t('base.100GreenElectricityForTheEntireFleet')}</span></p></div>
        <div><h2 class="footer-heading">{t('base.contact')}</h2><address><span>{t('base.visitUs')}<br />Triple Z – Gründungszentrum Zeche Zollverein<br />Katernberger Str. 107, 45327 Essen</span><span>{t('base.post')}<br />FlyingStars GmbH<br />Bulmker Straße 107, 45888 Gelsenkirchen</span><span><a href="mailto:team@flyingstars.art">team@flyingstars.art</a><br /><a href="tel:+4920988306562">0209 883 065 62</a></span></address></div>
        <div><h2 class="footer-heading">{t('base.pages')}</h2><ul>{site.nav.map((item) => <li><a href={localHref(item.href)}>{item.label}</a></li>)}{!inNav('/blog/') && <li><a href={localHref("/blog/")}>Blog</a></li>}<li><a href={localHref(site.cta.href)}>{site.cta.label}</a></li></ul>{occasionPages.length > 0 && <><h2 class="footer-heading footer-sub">{t('base.occasions')}</h2><ul>{occasionPages.map((item) => <li><a href={localHref(item.href)}>{item.label}</a></li>)}</ul></>}</div>
        <div><h2 class="footer-heading">{t('base.followUs')}</h2><ul><li><a href="https://www.instagram.com/flyingstars.art/" rel="noopener noreferrer" target="_blank">Instagram</a></li><li><a href="https://www.youtube.com/@flyingstars." rel="noopener noreferrer" target="_blank">YouTube</a></li><li><a href="https://www.tiktok.com/@flyingstars_art" rel="noopener noreferrer" target="_blank">TikTok</a></li><li><a href="https://www.facebook.com/FlyingStars.Art/" rel="noopener noreferrer" target="_blank">Facebook</a></li></ul></div>
      </div>
      <div class="base mono"><span>© {new Date().getFullYear()} FlyingStars GmbH</span><nav aria-label={t('base.legal')}>{site.footer.legal.map((item) => <a href={localHref(item.href)}>{item.label}</a>)}</nav><span>{t('base.websitePreview')}</span></div>
    </footer>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
