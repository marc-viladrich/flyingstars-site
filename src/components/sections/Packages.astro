---
import { forPath } from '../../i18n/server';
const { t, localHref, formatLocale } = forPath(Astro.url.pathname);
import SectionHead from '../SectionHead.astro';
// Die drei Pakete im Prototyp-Look. Preis, Drohnenzahl und Farbe kommen nur aus src/content/show-packages.ts,
// die Texte aus dem YAML. compact: Karten wie auf der Startseite (Punktfigur, Name, Preis, eine Zeile);
// sonst ausführlich wie im Vercel-Prototyp: Kurzbeschreibung, Gruppen mit Punkten in der Paketfarbe (PACKAGE_FEATURES).
import type { Section } from '../../content.config';
import { SHOW_PACKAGES } from '../../content/show-packages';
import { getPackageDetails } from '../../content/package-details';
const { PACKAGE_FEATURES, PACKAGE_POINTS, addOnLine, dronesLine } = getPackageDetails(forPath(Astro.url.pathname).locale);
import Accent from '../Accent.astro';
import MobileTabs from '../MobileTabs.astro';
type Props = Extract<Section, { type: 'packages' }> & { index: number };
const { headline, text, note, cta, compact, items, id = 'pakete', index, kicker } = Astro.props;
const H = index === 0 ? 'h1' : 'h2';
const C = index === 0 ? 'h2' : 'h3';
const money = (v: number) => t('showconfigurator.fromValue', { v0: v.toLocaleString(formatLocale) });
const orb = { SPARK: 'ring', HORIZON: 'sphere', ODYSSEY: 'torus' } as const;
const packs = items.map((item) => ({ ...item, ...SHOW_PACKAGES[item.name], shape: orb[item.name] }));
---
<section class="section alt" id={id} aria-labelledby={`${id}-h`}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} level={H} />
  {compact ? (
    <div class="packs">{packs.map((p) => <a class:list={['pack', { featured: p.highlight }]} aria-labelledby={`${id}-${p.name}`} href={localHref(`/kontakt/?paket=${p.name}`)} data-pick-paket={p.name} style={`--c:rgb(${p.color.join(',')})`}>
      <canvas data-orb={p.shape} data-color={p.color.join(',')} data-n={p.base} aria-hidden="true"></canvas>
      <div class="pack-head"><div class="name"><C id={`${id}-${p.name}`}>{p.name}</C>{p.badge && <span class="chip">{p.badge}</span>}</div><p class="price">{money(p.price)}</p>{p.label && <p class="meta mono">{p.label}</p>}{p.sky && <p class="pack-sky">{p.sky}</p>}</div>
      <!-- Drohnenzahl als eigene Gruppe in der Paketfarbe, darunter die Kernpunkte (Marc, 01.11.2026). Gleiche Vorschau auf
           Startseite und Anlass-Seiten: Punkte aus package-details.ts, sofern die Seite keine eigenen setzt. -->
      <p class="pack-drones">{dronesLine(p.name)}</p>
      <ul class="pack-points">{(p.points ?? PACKAGE_POINTS[p.name]).map((pt) => <li>{pt}</li>)}</ul>
    </a>)}</div>
  ) : (
    <div data-mtabs>{/* Handy: ein Reiter je Paket statt drei Karten untereinander, empfohlenes Paket vorgewählt */}
    <MobileTabs name={`${id}-tab`} label={t('mobileTabs.choosePackage')} initial={Math.max(0, packs.findIndex((p) => p.highlight))} tabs={packs.map((p) => ({ label: p.name, color: `rgb(${p.color.join(',')})` }))} />
    <div class="tiers-grid">{packs.map((p, i) => <article class:list={['tier', { 'is-rec': p.highlight }]} data-mtab={i} style={`--dot:rgb(${p.color.join(',')})`} aria-labelledby={`${id}-${p.name}`}>
      <canvas data-orb={p.shape} data-color={p.color.join(',')} data-n={p.base} aria-hidden="true"></canvas>
      <div class="head"><C id={`${id}-${p.name}`}>{p.name}</C><span class="badge">{p.badge ?? PACKAGE_FEATURES[p.name].badge}</span></div>
      <p class="tag">{PACKAGE_FEATURES[p.name].tag}</p>
      <div class="p"><b>{money(p.price)}</b><span class="mono">{t('packages.for')} {p.base} {t('configuratorteaser.drones')}</span></div>
      {PACKAGE_FEATURES[p.name].plus && <span class="plus">{PACKAGE_FEATURES[p.name].plus}</span>}
      {PACKAGE_FEATURES[p.name].groups.map((g) => <><h4 class="mono">{g.title}</h4><ul>{g.items.map((item) => <li>{item}</li>)}</ul></>)}
      <span class="scale-note mono">{addOnLine(p.name)}</span>
      <div class="tier-actions"><a class:list={['btn', { primary: p.highlight }]} href={localHref(`/kontakt/?paket=${p.name}`)}>{p.name} {t('packages.enquiry')}</a><a class="link" href={localHref(`/drohnenshow-preise/?paket=${p.name}#konfigurator`)}>{t('packages.viewInTheConfigurator')} <span aria-hidden="true">→</span></a></div>
    </article>)}</div>
    </div>
  )}
  {(note || cta) && <div class="pack-note">{note && <span class="mono">{note}</span>}{cta && <a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a>}</div>}
</section>
