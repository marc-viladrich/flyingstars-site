---
import Styles from '../Styles.astro';
import ownerStyle0 from './LandingSpotlight.css?url';
import FactList from '../FactList.astro';
// Breites Bild als Bühne: Orte (Werbung) oder Einsatzarten (Indoor) liegen als Markierungen auf dem Bild, darunter
// Einträge (z. B. Referenzen mit Datum) links und Kennzahlen rechts. Bild mit Vorhang-Reveal, ohne Hover-Effekt.
import type { Section } from '../../content.config';
import SectionHead from '../SectionHead.astro';
import { optimizedImage } from '../../lib/media';
type Props = Extract<Section, { type: 'landingSpotlight' }> & { index: number };
const { kicker, headline, text, image, tags, entries, facts, id = `s${Astro.props.index}`, index } = Astro.props;
const H = index === 0 ? 'h1' : 'h2';
const T = index === 0 ? 'h2' : 'h3';
const wide = await optimizedImage(image.src, 960, 480);
const narrow = await optimizedImage(image.src, 640, 480);
---
<Styles href={ownerStyle0} id="components/landing/LandingSpotlight.css" />
<section class="section alt sp" id={id} aria-labelledby={`${id}-h`}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} level={H} />
  <figure class="sp-stage">
    <div class="sp-img" data-curtain>
      <picture>
        <source media="(max-width: 43.75em)" srcset={narrow.src} width={narrow.width} height={narrow.height} />
        <img src={wide.src} width={wide.width} height={wide.height} alt={image.alt} loading="lazy" decoding="async" />
      </picture>
    </div>
    {tags.length > 0 && <ul class="sp-tags" data-reveal-group>{tags.map((t, i) => <li class="mono" data-reveal style={`--i:${i}`}><span class="sp-pin" aria-hidden="true"></span>{t.value}</li>)}</ul>}
  </figure>
  {(entries.length > 0 || facts.length > 0) && (
    <div class:list={['sp-below', { 'only-facts': entries.length === 0 }]}>
      {entries.length > 0 && <div class="sp-entries">{entries.map((e) => <article><span class="kicker mono">{e.kicker}</span><T>{e.title}</T>{e.text && <p>{e.text}</p>}</article>)}</div>}
      {facts.length > 0 && <FactList items={facts} variant="spotlight" />}
    </div>
  )}
</section>
