---
// Labor (nur im Dev-Server, nie im Build, wie labor/blog-bilder): Prototyp eines ganzen Blogartikels, wie Artikel künftig
// aussehen sollen (Runde 15, 21.11.2026). Prototyp 2 nach Marcs Rückmeldung: alles einspaltig wie ein Blogpost, Titelbild
// als Nachtformation im Lichtraster, normale Fotos im Text (ArticlePhotos), Szene klebt oben über der Lesespalte, ruhige
// Logo-Formation am Schluss. Der echte Artikel im echten Blog-Layout (BlogPost.astro), Text unverändert aus
// der Collection, nur in Abschnitte geteilt: Titelbild im Lichtraster (eigenes Foto), ein Tagbild als Punkt-Reveal, eine
// Bildleiter mit eigenen Fotos, die isometrische Scroll-Geschichte (Bausteine und Ablauf) und das Logo-Finale.
// Bilder und Formation: tools/labor/blog-artikel.mjs. Fotos: Drive-Sichtung im Kundenordner 27-blog-bilder-2026-11-21.
import { getEntry } from 'astro:content';
import BlogPost from '../../../templates/BlogPost.astro';
import ArticlePhotos from '../../../components/blog/ArticlePhotos.astro';
import StoryScene from '../../../components/blog/StoryScene.astro';
import FormationFinale from '../../../components/blog/FormationFinale.astro';

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return [{ params: { slug: 'wie-programmiert-man-eine-drohnenshow' } }];
}
const post = (await getEntry('posts', '2025-06-12-wie-programmiert-man-eine-drohnenshow'))!;
const M = '/media/labor/artikel/';

// Artikel-HTML an den Überschriften teilen (Text unverändert). Leere Absätze (geschütztes Leerzeichen) und die beiden
// Bilder aus dem Import fallen weg: an ihre Stelle treten die eigenen Bilder bzw. das Logo-Finale.
const html = post.rendered?.html ?? '';
const parts = html.split(/(?=<h[23][\s>])/).map((chunk) => chunk
  .replace(/<p>(\s|&nbsp;| )*<\/p>/g, '')
  .replace(/<p>\s*<img[^>]*>\s*<\/p>/g, '')
  .trim()).filter(Boolean);
const level = (c: string) => Number(c.match(/^<h([23])/)?.[1] ?? 0);
const titleOf = (c: string) => c.match(/^<h[23][^>]*>(.*?)<\/h[23]>/s)?.[1].replace(/<[^>]+>/g, '').replace(/^\d+\.\s*/, '').replace(/&amp;/g, '&').replace(/&#x26;/g, '&').trim() ?? '';
const intro = parts[0];
const h2 = parts.map((c, i) => ({ c, i })).filter(({ c }) => level(c) === 2);
if (h2.length !== 4) throw new Error(`Gliederung geändert: ${h2.length} Zwischentitel statt 4`);
const [what, blocksH2, flowH2, ours] = h2;
const between = (a: number, b: number) => parts.slice(a + 1, b);
const bausteine = between(blocksH2.i, flowH2.i), ablauf = between(flowH2.i, ours.i);
if (bausteine.length !== 4 || ablauf.length !== 5) throw new Error('Gliederung geändert: erwartet 4 Bausteine und 5 Ablaufschritte');
const blocks = [
  { html: blocksH2.c },
  ...bausteine.map((c, i) => ({ html: c, step: i, title: titleOf(c), group: 'Die wichtigsten Bausteine' })),
  { html: flowH2.c },
  ...ablauf.map((c, i) => ({ html: c, step: 4 + i, title: titleOf(c), group: 'Möglicher Ablauf' })),
];
const groups = [{ name: 'Die wichtigsten Bausteine', short: 'Bausteine' }, { name: 'Möglicher Ablauf', short: 'Ablauf' }];
const row = [
  { src: `${M}foto-006.webp`, width: 960, height: 1200, alt: 'Ein Techniker richtet bei Sonnenuntergang auf einer Wiese ein Stativ mit GPS-Antenne aus.' },
  { src: `${M}foto-018.webp`, width: 960, height: 1200, alt: 'Eine blaue Blüte aus Drohnen über dem nächtlichen Nieheim.' },
  { src: `${M}foto-034.webp`, width: 960, height: 1200, alt: 'Ein Doppelherz aus roten und violetten Drohnen am Nachthimmel.' },
];
const NOTES = [
  ['Titelbild', 'Eigenes Nachtfoto (#030, Schriftzug NIEHEIM) im Lichtraster, zur Build-Zeit gerechnet. Nachtformationen bleiben im Raster lesbar; Gamma 1,8 und Schwelle 0,08 halten den Himmel ruhig.', 'Foto hochladen; der Build rechnet. Regler nur, wenn das Labor-Rezept nicht trägt.'],
  ['Fotos im Text', 'Normale Fotos ohne Effekt, mit der Leuchtpunkt-Unterlage der Seite dahinter (ArticlePhotos.astro). Ein Bild über die Artikelbreite oder eine Reihe; auf dem Handy wird die Reihe zum Slider.', 'Fotos wählen, Alternativtext und Bildzeile eintragen. Gilt für jeden Artikel, auch ohne Szene.'],
  ['Scroll-Geschichte', 'Isometrische Szene (story-scene.ts), klebt oben über der Lesespalte. Neun Schritte, je Abschnitt einer, jeder mit eigenem Bildausschnitt. Drohne erst zusammen, dann explodiert; Windlinien und Eigenbewegung in der Simulation. Endzustand steht im HTML.', 'Nicht im Editor pflegbar: je Cornerstone-Artikel eine eigene Szene, die wir bauen (Geometrie, Ausschnitte, Annotationen). Der Text bleibt im Editor; ändert sich die Gliederung, meldet die Seite das beim Build.'],
  ['Logo-Formation', 'Das FlyingStars-Logo aus 600 Drohnen, klein im Textfluss über dem Schlussabschnitt (Engine scripts/formation-play.js). Poster als echtes Bild im HTML.', 'Baustein ohne Pflege: kann unter jedem Artikel stehen. Mit Inhalt übernimmt er den Schlussabschnitt, sonst einen Standardtext.'],
];
---
<BlogPost post={post} noindex coverImage={{ src: `${M}titel-030.webp`, width: 1600, height: 800, alt: 'Der Schriftzug NIEHEIM aus Drohnen über dem nächtlichen Horizont, als Lichtpunkt-Raster.' }}>
  <Fragment slot="body">
    <div class="post-body ba-col" set:html={intro} />
    <ArticlePhotos photos={[{ src: `${M}foto-012.webp`, width: 1600, height: 1000, alt: 'Showdrohnen auf weißen Startunterlagen, im Raster auf einer gepflasterten Fläche.' }]} caption="Showdrohnen auf ihren Startunterlagen, kurz vor dem Abheben." />
    <div class="post-body ba-col" set:html={what.c} />
    <ArticlePhotos photos={row} caption="Vom Startfeld zur fertigen Formation: Vorbereitung am Stativ, Blüte und Doppelherz über Nieheim." focus="20% 80%" />
    <StoryScene blocks={blocks} groups={groups} label="Bausteine und Ablauf einer Drohnenshow" caption="Die vier Bausteine einer Drohnenshow und der Ablauf ihrer Programmierung, als Szene zu den Abschnitten im Text." />
    <FormationFinale><div class="post-body" set:html={ours.c} /></FormationFinale>
  </Fragment>
  <aside slot="after" class="section ba-note" aria-labelledby="ba-note-h">
    <h2 id="ba-note-h">Labor-Notiz</h2>
    <p>Nur im Dev-Server. Was jede Grafik ist und wie FlyingStars sie pflegen könnte.</p>
    <dl>{NOTES.map(([k, what, edit]) => <div><dt>{k}</dt><dd>{what}</dd><dd class="ba-edit">Editor: {edit}</dd></div>)}</dl>
  </aside>
</BlogPost>

<style>
  .ba-col { width: 100%; }
  .ba-note { max-width: 64rem; margin: 0 auto; border-top: 1px dashed var(--line-strong); }
  .ba-note h2 { font-size: var(--text-lg, 1.5rem); }
  .ba-note > p { color: var(--muted); margin-top: var(--space-2); }
  .ba-note dl { display: grid; gap: var(--space-5); margin-top: var(--space-6); }
  .ba-note dl > div { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: var(--space-1) var(--space-6); }
  .ba-note dt { font: 500 var(--text-base)/1.3 var(--display); color: var(--accent); grid-row: span 2; }
  .ba-note dd { margin: 0; color: var(--text); font-size: var(--text-sm); line-height: 1.55; }
  .ba-note .ba-edit { color: var(--muted); }
  @media (max-width: 45em) { .ba-note dl > div { grid-template-columns: 1fr; } }
</style>
