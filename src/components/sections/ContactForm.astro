---
import {nativeField,nativeSection,nativeRecord} from "../../lib/native-editor";
import {siteRecord,fillText} from "../../lib/editorial-records";
import {SHOW_PACKAGES,PACKAGE_NAMES} from '../../content/show-packages';
import { site } from '../../site.config';
interface Props { headline: string; text?: string; index?: number; }
const { headline, text, index = 0 } = Astro.props;
const H = index === 0 ? 'h1' : 'h2';
// Contact values and form texts have one owner each: site/contact and site/inquiry.
const contact = siteRecord('contact'), form = siteRecord('inquiry');
const C = (path: string[]) => nativeRecord('site/contact', path), I = (path: string[]) => nativeRecord('site/inquiry', path);
const channels = [['email', contact.email], ['phone', contact.phone], ['whatsapp', contact.whatsapp], ['videoCall', contact.videoCall]] as const;
const external = (href: string) => href.startsWith('https:');
const occasions = Object.entries(form.occasions) as [string, string][];
const email = { email: contact.email.value };
// Texts the script shows later (step counter, validation, send states), already resolved against site/contact.
const messages = { step: form.progress.step, required: form.messages.required, occasion: form.occasion.error, invalidEmail: form.email.invalid, sending: form.messages.sending, success: form.messages.success, notConfigured: fillText(form.messages.notConfigured, email), sendFailed: form.messages.sendFailed, failed: form.messages.failed, retry: fillText(form.messages.retry, email), submit: form.buttons.submit, skyText: form.message.skyText };
---
<section {...nativeSection(Astro.props)} aria-labelledby="anfrage-h" class="section alt" id="anfrage">
<div class="inquiry">
<div class="intro">
<span class="kicker mono" {...I(['kicker'])}>{form.kicker}</span>
<H id="anfrage-h" {...nativeField(Astro.props,["headline"])}>{headline}</H>
<p class="lead" {...nativeField(Astro.props,["text"])}>{text}</p>
<ul class="contact-list">
{channels.map(([key, channel]) => <li><span class="k mono" {...C([key, 'label'])}>{channel.label}</span>{external(channel.href) ? <a href={channel.href} rel="noopener" target="_blank" {...C([key, 'value'])}>{channel.value}</a> : <a href={channel.href} {...C([key, 'value'])}>{channel.value}</a>}</li>)}
</ul>
</div>
<form action={site.formEndpoint} aria-labelledby="anfrage-h" class="form" id="inquiry-form" method="post" data-messages={JSON.stringify(messages)}>
<div class="progress mono" hidden=""><span data-step-label="" {...I(['progress','step'])}>{fillText(form.progress.step, { current: 1, total: 2 })}</span><span {...I(['progress','duration'])}>{form.progress.duration}</span></div>
<div aria-hidden="true" class="bar" hidden=""><i></i></div>
<fieldset data-step="">
<legend class="sr-only" {...I(['steps','show'])}>{form.steps.show}</legend>
<div class="field">
<span id="occasion-label" {...I(['occasion','label'])}>{form.occasion.label}</span>
<div aria-labelledby="occasion-label" class="chips" role="radiogroup">
{occasions.map(([value, label], i) => <label>{i === 0 ? <input name="anlass" required="" type="radio" value={value}/> : <input name="anlass" type="radio" value={value}/>}<span {...I(['occasions', value])}>{label}</span></label>)}
</div>
<span class="err" data-err-for="anlass" role="alert"></span>
</div>
<div class="fields">
<div class="field"><label for="f-datum" {...I(['date','label'])}>{form.date.label}</label><input id="f-datum" name="datum" type="date"/></div>
<div class="field"><label for="f-ort" {...I(['place','label'])}>{form.place.label}</label><input autocomplete="address-level2" id="f-ort" maxlength="200" name="ort" placeholder={form.place.placeholder} type="text" {...I(['place','placeholder'])}/></div>
<div class="field full"><label for="f-paket" {...I(['package','label'])}>{form.package.label}</label>
<select id="f-paket" name="paket" {...I(['package','unknown'])}><option value="">{form.package.unknown}</option>{PACKAGE_NAMES.map(name=><option value={name}>{SHOW_PACKAGES[name].displayName} · {SHOW_PACKAGES[name].base}{name==='ODYSSEY'?'+':''} {form.package.suffix}</option>)}</select>
</div>
</div>
<div class="row"><span class="hint" {...I(['hint'])}>{form.hint}</span><button class="btn primary" data-next="" type="button" {...I(['buttons','next'])}>{form.buttons.next}</button></div>
</fieldset>
<fieldset data-step="">
<legend class="sr-only" {...I(['steps','contact'])}>{form.steps.contact}</legend>
<div class="fields">
<div class="field"><label for="f-name" {...I(['fullName','label'])}>{form.fullName.label}</label><input autocomplete="name" data-msg={form.fullName.error} id="f-name" maxlength="120" name="name" required="" type="text" {...I(['fullName','error'])}/><span class="err" data-err-for="name" role="alert"></span></div>
<div class="field"><label for="f-mail" {...I(['email','label'])}>{form.email.label}</label><input autocomplete="email" data-msg={form.email.error} id="f-mail" maxlength="200" name="email" required="" type="email" {...I(['email','error'])}/><span class="err" data-err-for="email" role="alert"></span></div>
<div class="field full"><label for="f-tel" {...I(['phone','label'])}>{form.phone.label}</label><input autocomplete="tel" id="f-tel" maxlength="200" name="telefon" type="tel"/></div>
<div class="field full"><label for="f-msg" {...I(['message','label'])}>{form.message.label}</label><textarea id="f-msg" maxlength="5000" name="message" placeholder={form.message.placeholder} {...I(['message','placeholder'])}></textarea></div>
</div>
<p class="hint" {...I(['privacy','before'])}>{form.privacy.before} <a class="link" href="/datenschutz/" {...I(['privacy','link'])}>{form.privacy.link}</a>{form.privacy.after}</p>
<div class="row"><button class="btn" data-back="" type="button" {...I(['buttons','back'])}>{form.buttons.back}</button><button class="btn primary" type="submit" {...I(['buttons','submit'])}>{form.buttons.submit}</button></div>
<div aria-hidden="true" class="honeypot"><label>Website<input autocomplete="off" name="website" tabindex="-1"/></label></div></fieldset>
<p class="form-status" data-form-status="" role="status" tabindex="-1"></p></form>

</div>
</section>
<script>import '../../scripts/contact';</script>
