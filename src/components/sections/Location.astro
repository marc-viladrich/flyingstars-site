---
// Standort als Punktkarte (Über uns, 17.11.2026). Es gibt kein Gebäudefoto; die Karte trägt den Abschnitt: Nordrhein-
// Westfalen aus Lichtpunkten wie ein Drohnenfeld (public/media/standort-nrw.svg, zum Ruhrgebiet hin heller, Generator
// tools/standort/nrw-punkte.mjs), die Orte leuchten in Farben des Logoverlaufs. Keine Beschriftung auf der Karte selbst
// (nahe Orte würden sich überdecken).
// 18.11.2026 (Marc: „we need the individual addresses nicely displayed with icons and in multiple rows below the text“):
// unter dem Text je Ort ein Adressblock, Icon in der Farbe seines Kartenpunkts, Anschrift mehrzeilig aus den Kontaktdaten,
// Route über OpenStreetMap (keine Google-Karte) und der passende Kontaktweg. Zeigen oder Fokus auf einem Block lässt
// seinen Punkt aufleuchten und umgekehrt; die Blöcke ersetzen die frühere Legende unter der Karte.
import {record,field} from 'astro-frontend-editor/markers';
import type { Section } from '../../content.config';
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { nrwPosition, NRW_MAP } from '../../lib/nrw-map.mjs';
import { contact as CONTACT, CONTACT_OWNER } from '../../content/contact.mjs';
import { forPath } from '../../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
type Props = Extract<Section, { type: 'location' }> & { index: number };
const { kicker, headline, text, places, note, cta, surface, id = `s${Astro.props.index}`, index } = Astro.props;
const H = index === 0 ? 'h1' : 'h2';
const Item = index === 0 ? 'h2' : 'h3';
const TONES = ['amber', 'cyan', 'orchid', 'amber'] as const;
// Kontaktweg je Anschrift: am Büro das Telefon, an der Post die E-Mail
const reach = {
  visit: { icon: 'phone', label: CONTACT.phone.label, href: CONTACT.phone.href, path: ['phone'] },
  post: { icon: 'mail', label: CONTACT.email, href: `mailto:${CONTACT.email}`, path: ['email'] },
} as const;
const pins = places.map((place, i) => ({
  ...place, tone: TONES[i], ...nrwPosition(place.lat, place.lon),
  lines: place.address ? CONTACT[place.address] : undefined,
  route: `https://www.openstreetmap.org/directions?route=%3B${place.lat}%2C${place.lon}#map=15/${place.lat}/${place.lon}`,
  reach: place.address ? reach[place.address] : undefined,
}));
const withAddress = pins.some((pin) => pin.lines);
---
<section class:list={['section loc', { alt: surface === 'alt' }]} id={id} aria-labelledby={`${id}-h`} data-loc>
  <div class="loc-grid">
    <div class="loc-copy">
      <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} level={H} variant="embedded" />
      {withAddress && <ul class="loc-places" role="list" {...record(CONTACT_OWNER)}>
        {pins.map((pin, i) => <li class:list={['loc-place', pin.tone]} data-pin={i}>
          <span class="loc-ico" aria-hidden="true"><Icon name={pin.icon ?? 'map-pin'} size={20} /></span>
          <div class="loc-body">
            <Item class="loc-name"><span class="loc-label mono">{pin.label}</span>{pin.role && <span class="loc-role">{pin.role}</span>}</Item>
            {pin.lines && <address>{pin.lines.map((line, n) => <span {...field(CONTACT_OWNER, [pin.address!, n], { mode: 'panel' })}>{line}</span>)}</address>}
            <p class="loc-links">
              <a class="hover-line" href={pin.route} target="_blank" rel="noopener" aria-label={t('location.routeLabel', { v0: pin.lines?.slice(-2).join(', ') ?? pin.label })}><Icon name="route" size={16} />{t('location.route')}</a>
              {pin.reach && <a class="hover-line" href={localHref(pin.reach.href)} {...field(CONTACT_OWNER, [...pin.reach.path], { mode: 'panel' })}><Icon name={pin.reach.icon} size={16} />{pin.reach.label}</a>}
            </p>
          </div>
        </li>)}
      </ul>}
      {cta && <p class="loc-more"><a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a></p>}
    </div>
    <figure class="loc-map">
      <div class="loc-stage">
        <img src="/media/standort-nrw.svg" width={NRW_MAP.width} height={NRW_MAP.height} alt="" loading="lazy" decoding="async" />
        {pins.map((pin, i) => <span class:list={['loc-pin', pin.tone]} data-pin={i} style={`left:${pin.x.toFixed(2)}%;top:${pin.y.toFixed(2)}%`} aria-hidden="true"></span>)}
      </div>
      <figcaption>
        {!withAddress && <ul class="loc-legend">{pins.map((pin) => <li><span class:list={['loc-key', pin.tone]} aria-hidden="true"></span>{pin.label}</li>)}</ul>}
        {note && <p class="loc-note mono">{note}</p>}
      </figcaption>
    </figure>
  </div>
</section>

<script>
  // Block ↔ Punkt: Zeigen oder Fokus auf einer Anschrift lässt ihren Kartenpunkt aufleuchten und umgekehrt
  for (const root of document.querySelectorAll<HTMLElement>('[data-loc]')) {
    const all = (i: string) => root.querySelectorAll<HTMLElement>(`[data-pin="${i}"]`);
    const set = (i: string | undefined, on: boolean) => { if (i !== undefined) all(i).forEach((el) => el.classList.toggle('is-hot', on)); };
    root.querySelectorAll<HTMLElement>('[data-pin]').forEach((el) => {
      const i = el.dataset.pin;
      el.addEventListener('pointerenter', () => set(i, true));
      el.addEventListener('pointerleave', () => set(i, false));
      el.addEventListener('focusin', () => set(i, true));
      el.addEventListener('focusout', () => set(i, false));
    });
  }
</script>

<style>
  .loc-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(var(--space-8), 6vw, var(--space-20)); align-items: center; }
  /* Kopf wie .sec-head (Abstand und Farbe), aber ohne dessen unteren Rand: Text und Karte stehen nebeneinander */
  .loc-copy :global(.section-head) { display: grid; gap: var(--space-4); justify-items: start; }
  .loc-copy :global(.section-head > p) { color: var(--muted); font-size: var(--text-lead); max-width: 46ch; margin: 0; }
  .loc-more { margin-top: clamp(var(--space-5), 2.6vw, var(--space-8)); }
  .loc-map { margin: 0; justify-self: center; width: min(100%, 40rem); }
  .loc-stage { position: relative; }
  .loc-stage img { display: block; width: 100%; height: auto; }
  /* Markierung wie eine leuchtende Drohne: heller Kern, weicher Schein. Büro und Hauptsitz liegen nur 4 km auseinander und
     stehen auf der Karte als Doppelstern nebeneinander, deshalb kein Ring, der sie überdecken würde. */
  .loc-pin { position: absolute; width: 0.5rem; height: 0.5rem; margin: -0.25rem 0 0 -0.25rem; border-radius: var(--radius-round); background: var(--pin); box-shadow: 0 0 0.375rem var(--pin), 0 0 1.75rem 0.5rem rgb(var(--pin-rgb) / 0.35); transition: transform var(--dur-standard) var(--ease-default), box-shadow var(--dur-standard) var(--ease-default); }
  /* größere Zeigefläche, ohne den Punkt zu vergrößern */
  .loc-pin::before { content: ""; position: absolute; inset: -0.25rem; border-radius: inherit; }
  .loc-pin.is-hot { z-index: 1; transform: scale(1.9); box-shadow: 0 0 0.375rem var(--pin), 0 0 2.5rem 1rem rgb(var(--pin-rgb) / 0.5); }
  .amber { --pin: var(--amber); --pin-rgb: var(--rgb-amber); }
  .cyan { --pin: var(--cyan); --pin-rgb: var(--rgb-cyan); }
  .orchid { --pin: var(--orchid); --pin-rgb: var(--rgb-orchid); }
  .loc-map figcaption { margin-top: clamp(var(--space-5), 2.5vw, var(--space-7)); display: grid; gap: var(--space-3); }
  .loc-legend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-7); color: var(--text); font-size: var(--text-sm); }
  .loc-legend li { display: inline-flex; align-items: center; gap: var(--space-2-5); }
  .loc-key { flex: none; width: 0.5rem; height: 0.5rem; border-radius: var(--radius-round); background: var(--pin); box-shadow: 0 0 0.5rem var(--pin); }
  .loc-note { margin: 0; color: var(--faint); }

  /* Anschriften: zwei Blöcke nebeneinander unter dem Text, je eine Haarlinie in der Punktfarbe oben */
  .loc-places { list-style: none; margin: clamp(var(--space-8), 3.6vw, var(--space-12)) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14.5rem), 1fr)); gap: var(--space-8) clamp(var(--space-6), 3vw, var(--space-10)); }
  .loc-place { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-4); align-items: start; padding-top: var(--space-5); border-top: 1px solid var(--line); }
  .loc-place::before { content: ""; position: absolute; left: 0; top: -1px; width: 2.5rem; height: 1px; background: var(--pin); transition: width var(--dur-standard) var(--ease-default); }
  .loc-place.is-hot::before { width: 100%; }
  .loc-ico { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: var(--radius-round); color: var(--pin); background: rgb(var(--pin-rgb) / 0.1); box-shadow: inset 0 0 0 1px rgb(var(--pin-rgb) / 0.35); transition: box-shadow var(--dur-standard) var(--ease-default); }
  .loc-place.is-hot .loc-ico { box-shadow: inset 0 0 0 1px rgb(var(--pin-rgb) / 0.7), 0 0 1.25rem rgb(var(--pin-rgb) / 0.35); }
  .loc-body { display: grid; gap: var(--space-3); min-width: 0; }
  .loc-name { margin: 0; display: grid; gap: var(--space-1); font: 500 var(--text-copy)/1.3 var(--body); color: var(--head); }
  .loc-label { font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--pin); font-weight: 400; }
  address { font-style: normal; font-size: var(--text-copy); line-height: 1.5; color: var(--muted); }
  address span { display: block; text-wrap: balance; }
  .loc-links { margin: var(--space-1) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); font-size: var(--text-sm); }
  .loc-links a { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--text); }
  .loc-links a :global(.ico) { flex: none; color: var(--pin); }
  @media (prefers-reduced-motion: reduce) { .loc-pin, .loc-place::before, .loc-ico { transition: none; } }
  @media (--grid-stacked) { .loc-grid { grid-template-columns: 1fr; } .loc-map { justify-self: start; } }
</style>
