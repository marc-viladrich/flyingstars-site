---
// Kleine runde Porträts (Anfrage, FAQ-Abschluss); beim Hovern werden sie zu Lichtpunkten.
import { optimizedImage } from '../lib/media';
import {field} from 'astro-frontend-editor/markers';
import { FOUNDERS, portraitPerson } from '../content/people.mjs';
interface Props { people?: string[] }
const people = Astro.props.people?.length ? Astro.props.people.map(id=>portraitPerson(id)) : FOUNDERS;
const faces = await Promise.all(people.map(async (p) => ({ ...p, img: await optimizedImage(p.image.src, 160) })));
---
<ul class="faces" aria-label={`Ansprechpartner:innen: ${people.map((p) => p.name).join(', ')}`}>
  {faces.map((f) => <li {...(f.id?field({collection:"people",id:f.id},[],{mode:"panel"}):{})} class="face" data-dot-img data-step="4"><img src={f.img.src} width={f.img.width} height={f.img.height} alt="" loading="lazy" decoding="async" /></li>)}
</ul>

<style is:global>
  /* Gesichter (aus global.css hierher, Audit 2, C2). Global mit unveränderter Spezifität, weil Steps (.ic-more-in .faces) und
     CtaBox (.promise .faces) Größe und Ausrichtung im Kontext setzen */
  .faces { list-style: none; margin: 0; padding: 0 0 0 0; display: flex; }
  .faces .face { position: relative; display: block; width: 4rem; height: 4rem; border-radius: var(--radius-round); overflow: hidden; border: 0.1875rem solid var(--surface); margin-right: calc(-1 * var(--space-3-5)); background: var(--media-ground); }
  .faces .face img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; }
</style>
