---
// Cornerstone-Artikel „Drohnen als Alternative zum Feuerwerk“ (Labor, Runde 18, 22.11.2026) im Format des Prototyps.
// Text unverändert aus der Collection, an den Zwischentiteln geteilt.
// KEINE Szene: Der Artikel erklärt keinen Ablauf und keinen Aufbau, er vergleicht und zählt Vorteile, Einsatzgebiete und
// Sicherheitsmaßnahmen auf. Eine isometrische Szene müsste sich ihren Inhalt erfinden (oder die des Programmier-Artikels
// wiederholen). Was der Artikel braucht, ist der Vergleich, und den hat die Seite schon: die Vergleichstabelle
// Drohnenshow · Feuerwerk · Lasershow von „Nachhaltigkeit“ (dieselben Daten aus nachhaltigkeit.yaml, nicht kopiert),
// direkt an der Umwelt-Aussage. Dazu echte Showfotos und die Logo-Formation am Platz des Import-Logos.
import { getEntry } from 'astro:content';
import BlogPost from '../../../templates/BlogPost.astro';
import ArticlePhotos from '../../blog/ArticlePhotos.astro';
import FormationFinale from '../../blog/FormationFinale.astro';
import ComparisonMatrix from '../../ComparisonMatrix.astro';
import LaborNote from './LaborNote.astro';
import { sections, splitAfterParagraph } from './split';

const post = (await getEntry('posts', '2025-03-31-drohnen-feuerwerk-als-alternative'))!;
const M = '/media/labor/cornerstone/';
const { intro, h2 } = sections(post.rendered?.html ?? '', ['Was sind Drohnenshows', 'Umweltfreundlichkeit', 'Drohnenshows als spektakuläre Werbung', 'Sicherheit und Risiken', 'FlyingStars für unvergessliche Events', 'Drohnenshows von Flyingstars']);
const [was, umwelt, werbung, sicherheit, events, ours] = h2;
const [umweltLuft, umweltReuse] = splitAfterParagraph(umwelt, 1);
// Vergleich aus der Nachhaltigkeitsseite („Die Alternative zum Feuerwerk“), eine Quelle für beide Stellen
const page = await getEntry('pages', 'nachhaltigkeit');
const alt = (page?.data.sections as { type: string; id?: string; comparison?: { rowHeader?: string; columns: { value: string }[]; rows: never[] } }[] | undefined)?.find((s) => s.type === 'sustainability' && s.id === 'alternative');
const cmp = alt?.comparison;
if (!cmp) throw new Error('Vergleichstabelle auf der Nachhaltigkeitsseite nicht gefunden');
const NOTES: [string, string, string][] = [
  ['Titelbild', 'Peace-Zeichen über Nieheim (#044) im Lichtraster, im Raster die klarste Figur der Sichtung: ein Lichtzeichen ohne Knall. Geprüft: Doppelherz #034 (trägt jetzt „Wie funktioniert eine Drohnenshow?“).', 'Foto hochladen; der Build rechnet.'],
  ['Keine Szene', 'Der Text erklärt keinen Ablauf, er vergleicht. Statt einer erfundenen Animation steht die Vergleichstabelle der Seite Nachhaltigkeit direkt an der Umwelt-Aussage (Daten aus nachhaltigkeit.yaml, keine Kopie).', 'Tabelle wird auf der Nachhaltigkeitsseite gepflegt und erscheint hier mit.'],
  ['Fotos', 'Einleitung: Blüte über Nieheim (#018) statt des Import-Fotos. Wiederverwendbarkeit: Drohnen in ihren Transportkoffern (#014). Werbung: Markenzeichen, Schriftzug, Jubiläumszahl (#052, #055, #048; Jubiläumsordner, Herkunft vor Veröffentlichung bestätigen).', 'Fotos wählen, Alternativtext und Bildzeile eintragen.'],
  ['Logo-Formation', 'Am Platz des Import-Logos, über „Drohnenshows von Flyingstars“.', 'Baustein ohne Pflege.'],
];
---
<BlogPost post={post} noindex headroom coverImage={{ src: `${M}feuerwerk-titel-044.webp`, width: 1600, height: 800, alt: 'Ein Peace-Zeichen aus Drohnen über dem nächtlichen Nieheim, als Lichtpunkt-Raster.' }}>
  <Fragment slot="body">
    <div class="post-body cs-col" set:html={intro} />
    <ArticlePhotos photos={[{ src: `${M}feuerwerk-018.webp`, width: 1600, height: 1000, alt: 'Eine blaue Blüte aus Drohnen am Nachthimmel, darunter die Lichter eines Festgeländes.' }]} caption="Eine Blüte aus Drohnen über Nieheim, ganz ohne Knall." />
    <div class="post-body cs-col" set:html={was} />
    <div class="post-body cs-col cs-gap" set:html={umweltLuft} />
    <figure class="cs-compare">
      <ComparisonMatrix label="Drohnenshow, Feuerwerk und Lasershow im Vergleich" rowHeader={cmp.rowHeader} columns={cmp.columns} rows={cmp.rows} />
      <figcaption>Drohnenshow, Feuerwerk und Lasershow im Vergleich.</figcaption>
    </figure>
    <div class="post-body cs-col" set:html={umweltReuse} />
    <ArticlePhotos photos={[{ src: `${M}feuerwerk-014.webp`, width: 1600, height: 1000, alt: 'Offene Transportkoffer mit Reihen von Showdrohnen auf einer Wiese.' }]} caption="Nach der Show zurück in die Koffer, bereit für die nächste." />
    <div class="post-body cs-col" set:html={werbung} />
    <ArticlePhotos photos={[
      { src: `${M}feuerwerk-052.webp`, width: 1000, height: 1000, alt: 'Ein rotes Markenzeichen aus Drohnen am Abendhimmel.' },
      { src: `${M}feuerwerk-055.webp`, width: 1000, height: 1000, alt: 'Der Schriftzug PKE aus blauen Drohnen vor Wolken.' },
      { src: `${M}feuerwerk-048.webp`, width: 1000, height: 1000, alt: 'Der Schriftzug „seit 1826“ aus weißen Drohnen in der Dämmerung.' },
    ]} caption="Markenzeichen, Schriftzug und Jubiläum am Himmel." focus="20% 80%" />
    <div class="post-body cs-col" set:html={sicherheit} />
    <div class="post-body cs-col cs-gap" set:html={events} />
    <FormationFinale><div class="post-body" set:html={ours} /></FormationFinale>
  </Fragment>
  <LaborNote slot="after" notes={NOTES} />
</BlogPost>

<style>
  .cs-col { width: 100%; }
  .cs-gap { margin-top: var(--space-10); }
  /* Vergleich: etwas breiter als die Lesespalte, wie die Fotos im Text */
  .cs-compare { width: 100%; max-width: min(56rem, 100%); margin: clamp(var(--space-8), 4vw, var(--space-12)) 0; }
  .cs-compare figcaption { margin-top: var(--space-4); color: var(--faint); font-size: var(--text-sm); }
</style>
