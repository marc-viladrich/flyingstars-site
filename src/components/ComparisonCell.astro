---
import {factText} from '../content/show-extras.mjs';
import Icon from './Icon.astro';
import { forPath } from '../i18n/server';
import { comparisonTone, comparisonIcon, type ComparisonValue } from '../lib/comparison';
interface Props { value: ComparisonValue; mobile?: boolean; responsibility?: 'full' | 'part' | 'none'; hint?: string; legend?: boolean }
const { value, mobile = false, responsibility, hint, legend = false } = Astro.props;
const { t, locale } = forPath(Astro.url.pathname);
const tone = comparisonTone(value);
const badge = value !== null && typeof value === 'object' ? value : undefined;
const label = t(tone === 'yes' ? (mobile ? 'pricingpage.mobileIncluded' : 'pricingpage.included') : (mobile ? 'pricingpage.mobileNotIncluded' : 'pricingpage.notIncluded'));
---
{responsibility ? <>
  {responsibility === 'full' && <Icon name="check" size={legend ? 14 : 20} strokeWidth={2.4} class="g" label={legend ? undefined : t('landingsite.full')} />}
  {responsibility === 'part' && <span class:list={['half', { 'is-legend': legend }]} role={legend ? undefined : 'img'} aria-hidden={legend ? 'true' : undefined} aria-label={legend ? undefined : t('landingsite.part')}></span>}
  {responsibility === 'none' && <span class="none" role={legend ? undefined : 'img'} aria-hidden={legend ? 'true' : undefined} aria-label={legend ? undefined : t('landingsite.none')}>–</span>}
  {responsibility === 'part' && hint && <small class="responsibility-hint">{hint}</small>}
</> : badge ? <>
  {/* Einordnung als Wort ohne Icon (Marc, 02.11.2026: Icons in dieser Vergleichstabelle verwirren) */}
  <span class:list={['m', badge.tone]}>{badge.label}</span>
  {badge.text && (mobile ? <span class="t">{badge.text}</span> : <> {badge.text}</>)}
</> : tone === 'value' ? factText(value,locale) : <span class={tone}>
  <Icon name={comparisonIcon(tone)!} size={20} />
  <span class:list={{ 'sr-only': !mobile }}>{label}</span>
</span>}
<style>
  .responsibility-hint { display: block; margin-top: var(--space-1); font-size: var(--text-label); color: var(--faint); line-height: 1.3; }
  @media (--small-facts) { .responsibility-hint { font-size: var(--text-xs); } }
  .half { display: inline-block; width: 1rem; height: 1rem; border-radius: var(--radius-round); border: 2px solid var(--accent); background: linear-gradient(90deg, var(--accent) 50%, transparent 50%); vertical-align: middle; }
  .half.is-legend { width: 0.75rem; height: 0.75rem; }
  .none { color: var(--faint); font-size: var(--text-md); }
</style>
