---
import {nativeRecord as uiMarker} from '../lib/native-editor';
import {siteRecord as readUi} from '../lib/content';
import {localeFromPath} from '../lib/localized-routes';
const locale = Astro.props.locale ?? Astro.props._locale ?? localeFromPath(Astro.url.pathname);
const ui = readUi('ui',locale);
import { optimizedImage } from '../lib/media';
import { videoPath } from '../lib/videos';
interface Props { _locale?:string; locale?:string;  src: string; poster?: string; class?: string; loop?: boolean; label?: string; hero?: boolean; }
const { src, poster, class: className = '', loop = false, label = ui.video.play, hero = false } = Astro.props;
const markers=Object.fromEntries(Object.entries(Astro.props).filter(([key])=>key.startsWith('data-native-')));
const image = poster ? await optimizedImage(poster, hero ? 960 : 720) : undefined;
---
<div class:list={['video-player', className]} data-video-player>
  {image && <img {...markers} src={image.src} width={image.width} height={image.height} alt="" loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : 'auto'} />}
  <video data-src={videoPath(src)} controls playsinline preload="none" loop={loop} aria-label={label} hidden></video>
  <button class="video-play btn" type="button" data-video-play aria-label={label}><span aria-hidden="true">▶</span> {label}</button>
  <p class="video-error" role="status" hidden {...uiMarker('site/ui',["video","das_video_ist_gerade_nicht_verfugbar_bitte_versuch"])}>{ui.video.das_video_ist_gerade_nicht_verfugbar_bitte_versuch}</p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-video-player]').forEach((player) => {
    const video = player.querySelector('video')!;
    const button = player.querySelector<HTMLButtonElement>('[data-video-play]')!;
    const error = player.querySelector<HTMLElement>('.video-error')!;
    button.addEventListener('click', async () => {
      video.src ||= video.dataset.src!;
      video.hidden = false;
      player.classList.add('video-active');
      button.hidden = true;
      error.hidden = true;
      try { await video.play(); video.focus(); }
      catch { button.hidden = false; error.hidden = false; }
    });
    video.addEventListener('error', () => { error.hidden = false; button.hidden = false; });
    new IntersectionObserver(([entry]) => { if (!entry.isIntersecting) video.pause(); }).observe(player);
    document.addEventListener('visibilitychange', () => { if (document.hidden) video.pause(); });
  });
</script>
