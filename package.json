{
  "name": "astro-site-template",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "rm -f .astro/data-store.json && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "npm run test:unit && playwright test",
    "gates": "npm run check && npm run build && node scripts/check-i18n-build.mjs && npm test",
    "editor": "node editor/server.mjs",
    "ci": "node editor/ci/check.mjs",
    "test:unit": "node scripts/run-unit.mjs",
    "test:effects": "node --test 'src/scripts/effects/*.test.mjs'",
    "audit:layout": "node scripts/layout-audit.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.66.0",
    "astro": "^7.3.6",
    "astro-frontend-editor": "npm:@marc-viladrich/astro-frontend-editor@0.3.1",
    "marked": "^18.1.0",
    "sharp": "^0.35.5",
    "vanilla-cookieconsent": "3.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "typescript": "^6.0.3"
  }
}
