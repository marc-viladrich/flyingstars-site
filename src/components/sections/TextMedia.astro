---
import InlineText from '../InlineText.astro';
import {nativeField,nativeSection,nativeMedia} from "../../lib/native-editor";
import Picture from '../Picture.astro';
import { marked } from 'marked';
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'textMedia' }> & { index: number };
const { headline, body, image, mediaSide, showImage=true, index } = Astro.props;
const id = `s${index}-h`;
const H = index === 0 ? 'h1' : 'h2';
const visibleImage=showImage?image:undefined;
const html = await marked.parse(body);
---
<section {...nativeSection(Astro.props)} class="section text-media" aria-labelledby={id}>
  <div class:list={['wrap', { 'grid-2': visibleImage, 'grid-2--media-left': visibleImage && mediaSide === 'left' }]}>
    <div class="prose">
      <H id={id} {...nativeField(Astro.props,["headline"],true)}><InlineText value={headline} /></H>
      <div {...nativeField(Astro.props,["body"])} data-native-markdown={process.env.FLYINGSTARS_EDITOR==='1'?'true':undefined} set:html={html} />
    </div>
    {visibleImage && <Picture {...visibleImage} {...nativeMedia(Astro.props,["image"])} />}
  </div>
</section>
<style>
  .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: clamp(24px, 4vw, 64px); }
  .grid-2 > .prose { min-width: 0; max-width: none; }
  .grid-2--media-left > .prose { order: 2; }
  .grid-2--media-left > :global(picture) { order: 1; }
  @media (max-width: 760px) {
    .grid-2 { grid-template-columns: 1fr; }
    .grid-2--media-left > .prose, .grid-2--media-left > :global(picture) { order: initial; }
  }
</style>
