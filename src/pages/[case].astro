---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseStudy from '../components/projects/CaseStudy.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft && Boolean(p.data.showcase));
  return projects.map((project) => ({ params: { case: project.data.showcase!.route }, props: { project } }));
}
const { project } = Astro.props;
---
<Base title={project.data.title} description={project.data.summary}>
  <CaseStudy project={project} />
</Base>
