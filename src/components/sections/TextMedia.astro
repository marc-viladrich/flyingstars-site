---
import {nativeField,nativeSection,nativeMedia} from "../../lib/native-editor";
import Picture from '../Picture.astro';
import { marked } from 'marked';
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'textMedia' }> & { index: number };
const { headline, body, image, mediaSide, showImage=true, index } = Astro.props;
const id = `s${index}-h`;
const H = index === 0 ? 'h1' : 'h2';
const visibleImage=showImage?image:undefined;
const html = await marked.parse(body);
---
<section {...nativeSection(Astro.props)} class="section" aria-labelledby={id}>
  <div class:list={['wrap', { 'grid-2': visibleImage, 'grid-2--media-left': visibleImage && mediaSide === 'left' }]}>
    <div class="prose">
      <H id={id} {...nativeField(Astro.props,["headline"])}>{headline}</H>
      <div {...nativeField(Astro.props,["body"])} data-native-markdown={process.env.FLYINGSTARS_EDITOR==='1'?'true':undefined} set:html={html} />
    </div>
    {visibleImage && <Picture {...visibleImage} {...nativeMedia(Astro.props,["image"])} />}
  </div>
</section>
