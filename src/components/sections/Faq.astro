---
import { getCollection, render } from 'astro:content';
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'faq' }> & { index: number };
const { headline = 'Häufige Fragen', text, cta, tags, limit, openFirst, id = `s${Astro.props.index}`, index } = Astro.props;
const headingId = `${id}-h`;
const H = index === 0 ? 'h1' : 'h2';
let entries = (await getCollection('faq', e => !e.data.draft)).sort((a,b) => a.data.order-b.data.order);
if(tags?.length) entries = entries.filter(e=>e.data.tags.some(tag=>tags.includes(tag)));
if(limit) entries = entries.slice(0,limit);
const rendered = await Promise.all(entries.map(async entry => ({entry, Content:(await render(entry)).Content})));
const external = cta?.href.startsWith('https://');
---
<section class="section" id={id} aria-labelledby={headingId}>
  <div class="faq-grid"><div class="intro"><H id={headingId}>{headline}</H>{text && <p>{text}</p>}{cta && <a class="link" href={cta.href} rel={external ? 'noopener' : undefined} target={external ? '_blank' : undefined}>{cta.label}</a>}</div>
  <div class="faq">{rendered.map(({entry,Content},i) => <details open={openFirst && i===0}><summary>{entry.data.question}</summary><div class="answer"><Content /></div></details>)}</div></div>
</section>
