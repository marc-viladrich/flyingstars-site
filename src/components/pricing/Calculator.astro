---
import {nativeRecord as uiMarker} from '../../lib/native-editor';
import {siteRecord as readUi} from '../../lib/content';
import {localeFromPath,localeFormat,localizedHref} from '../../lib/localized-routes';
const locale = Astro.props.locale ?? Astro.props._locale ?? localeFromPath(Astro.url.pathname);
const ui = await readUi('ui',locale);
import InlineText from '../InlineText.astro';
import {inlinePlain} from '../../lib/inline-text';
import {nativeRecord} from '../../lib/native-editor';
import {getScreen} from '../../lib/content';
const screen = await getScreen('drohnenshow-preise',locale);
const native=(path:string[],inline=false)=>nativeRecord('screen/drohnenshow-preise',path,inline);
import {fillText,getPackages} from '../../lib/content';
const SHOW_PACKAGES = await getPackages(locale);
const money = (value: number) => value.toLocaleString(localeFormat(locale));
---

  <!-- calculator hero -->
  <section data-runtime={JSON.stringify({packages:SHOW_PACKAGES,ui:ui.calculator,locale,home:localizedHref("/",locale)})} class="calc-hero" aria-labelledby="calc-h">
    <canvas id="swarm" aria-hidden="true"></canvas>
    <button class="btn small swarm-motion" id="swarm-motion" type="button" aria-pressed="false" {...uiMarker('site/ui',["calculator","animation_pausieren"])}>{ui.calculator.animation_pausieren}</button>
    <div class="calc-copy">
      <span class="kicker mono" style="margin:0" {...uiMarker('site/ui',["calculator","preise_pakete"])}>{ui.calculator.preise_pakete}</span>
      <h1 id="calc-h" {...native(["headline"],true)}><InlineText value={screen.headline} /></h1>
      <p class="lead" {...native(["text"])}>{screen.text}</p>
      <div class="calc">
        <div class="calc-top">
          <div class="count" id="count" aria-hidden="true">{SHOW_PACKAGES.HORIZON.base}<small {...uiMarker('site/ui',["calculator","drohnen"])}>{ui.calculator.drohnen}</small></div>
          <div class="total" id="total" aria-live="polite"><b>{fillText(ui.calculator.fromPrice,{price:money(SHOW_PACKAGES.HORIZON.price)+" €"})}</b><span class="mono" {...uiMarker('site/ui',["calculator","netto_zzgl_anfahrt"])}>{ui.calculator.net}</span></div>
        </div>
        <div>
          <label class="sr-only" for="drones" {...uiMarker('site/ui',["calculator","anzahl_drohnen"])}>{ui.calculator.anzahl_drohnen}</label>
          <input class="range" id="drones" type="range" min="100" max="1000" step="10" value={SHOW_PACKAGES.HORIZON.base}>
          <div class="scale mono" aria-hidden="true"><span style="--p:0">100</span><span style="--p:.1667">250</span><span style="--p:.4444">500</span><span style="--p:.7222">750</span><span style="--p:1">{(1000).toLocaleString(localeFormat(locale))}</span></div>
        </div>
        <div class="tiers" role="group" aria-label={ui.calculator.paket}>
          <button type="button" data-tier="SPARK" aria-pressed="false"><b style="font:inherit" {...nativeRecord('package/spark',['displayName'],true)}><InlineText value={SHOW_PACKAGES.SPARK.displayName} /></b><span>{fillText(ui.calculator.fromPrice,{price:money(SHOW_PACKAGES.SPARK.price)+" €"})}</span></button>
          <button type="button" data-tier="HORIZON" aria-pressed="true"><b style="font:inherit" {...nativeRecord('package/horizon',['displayName'],true)}><InlineText value={SHOW_PACKAGES.HORIZON.displayName} /></b><span>{fillText(ui.calculator.fromPrice,{price:money(SHOW_PACKAGES.HORIZON.price)+" €"})}</span></button>
          <button type="button" data-tier="ODYSSEY" aria-pressed="false"><b style="font:inherit" {...nativeRecord('package/odyssey',['displayName'],true)}><InlineText value={SHOW_PACKAGES.ODYSSEY.displayName} /></b><span>{fillText(ui.calculator.fromPrice,{price:money(SHOW_PACKAGES.ODYSSEY.price)+" €"})}</span></button>
        </div>
        <div class="field textin">
          <label for="showtext">{ui.calculator.dein_text_am_himmel} <span class="mono" {...uiMarker('site/ui',["calculator","optional"])}>{ui.calculator.optional}</span></label>
          <input id="showtext" type="text" maxlength="60" placeholder={ui.calculator.z_b_anna_tom} autocomplete="off" spellcheck="false">
          <p class="mono" id="text-read" aria-live="polite" {...uiMarker('site/ui',["calculator","wir_zeigen_ihn_mit_deiner_drohnenzahl_in_unserer_s"])}>{ui.calculator.wir_zeigen_ihn_mit_deiner_drohnenzahl_in_unserer_s}</p>
        </div>
        <div class="readout mono" id="calc-read"><span>{ui.calculator.paket} <b>{inlinePlain(SHOW_PACKAGES.HORIZON.displayName)}</b></span><span>{ui.calculator.dauer} <b {...uiMarker('site/ui',["calculator","ca_13_min"])}>{SHOW_PACKAGES.HORIZON.dur}</b></span></div>
        <p class="mono" id="calc-note" aria-live="polite" style="color:var(--amber);min-height:1.5em"></p>
        <div class="actions"><a class="btn primary" id="calc-cta" href={localizedHref(`/?paket=HORIZON&drohnen=${SHOW_PACKAGES.HORIZON.base}#anfrage`,locale)} {...uiMarker('site/ui',["calculator","mit_200_drohnen_anfragen"])}>{fillText(ui.calculator.inquiry,{count:SHOW_PACKAGES.HORIZON.base.toLocaleString(localeFormat(locale))})}</a><a class="btn" href="#pakete" {...uiMarker('site/ui',["calculator","pakete_vergleichen"])}>{ui.calculator.pakete_vergleichen}</a></div>
      </div>
    </div>
  </section>


<noscript><p class="section" {...uiMarker('site/ui',["calculator","der_interaktive_preisrechner_benotigt_javascript_d"])}>{ui.calculator.der_interaktive_preisrechner_benotigt_javascript_d}</p></noscript>
<style>
.swarm-motion { position:absolute; right:var(--pad); top:100px; z-index:2; }
@media (max-width:1100px) { .swarm-motion { top:85px; } .calc-hero #swarm { position:relative; inset:auto; height:32vh; min-height:230px; order:-1; margin:0 calc(var(--pad) * -1); width:calc(100% + var(--pad) * 2); } .calc-hero { min-height:0; padding-top:76px; gap:8px; } .calc-copy { gap:16px; } .calc-copy h1 { font-size:clamp(34px,9vw,48px); } }
</style>
