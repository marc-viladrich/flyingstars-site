---
import IconFeature from '../IconFeature.astro';
import { forPath } from '../../i18n/server';
const { localHref } = forPath(Astro.url.pathname);
// Kacheln mit einer Hauptkachel (Bild mit Titel darauf oder eine große Aussage) und bis zu vier kleineren Icon-Kacheln. Bricht die Folge aus Text-Bild-Blöcken auf (Marc, 31.10.2026: „mehr Variation in den Layouts“).
// Optional unten ein Textlink (cta) oder ein Abschluss-Kasten (closing, CtaBox.astro).
// Icons: Lucide über src/components/Icon.astro (`icon` je Kachel, `lead.icon` für die Aussage ohne Bild).
import type { Section } from '../../content.config';
import SectionHead from '../SectionHead.astro';
import CtaBox from '../CtaBox.astro';
import Accent from '../Accent.astro';
import Icon from '../Icon.astro';
import { optimizedImage } from '../../lib/media';
type Props = Extract<Section, { type: 'landingBento' }> & { index: number };
const { kicker, headline, text, lead, items, cta, closing, id = `s${Astro.props.index}`, index } = Astro.props;
const H = index === 0 ? 'h1' : 'h2';
const T = index === 0 ? 'h2' : 'h3';
const img = lead.image ? await optimizedImage(lead.image.src, 960, 720) : undefined;
---
<section class="section lb" id={id} aria-labelledby={`${id}-h`}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} level={H} />
  <div class="lb-grid" data-n={items.length}>
    <article class:list={['lb-lead', { 'has-img': img }]} data-dot-host={img ? '' : undefined}>
      {img && <div class="lb-img" data-curtain data-dot-img><img src={img.src} width={img.width} height={img.height} alt={lead.image!.alt} loading="lazy" decoding="async" /></div>}
      <div class="lb-lead-copy">
        {!img && lead.icon && <Icon name={lead.icon} size={40} class="g lb-lead-ico" />}
        {img && lead.label && <span class="mono lb-k">{lead.label}</span>}
        <T><Accent text={lead.title} /></T>
        {lead.text && <p>{lead.text}</p>}
      </div>
    </article>
    {items.map((it) => (
      <IconFeature class="lb-cell lb-feat" icon={it.icon} title={it.title} text={it.text} level={T} />
    ))}
  </div>
  {closing ? <CtaBox {...closing} level={T} class="lb-close" /> : cta && <div class="lb-more"><a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a></div>}
</section>

<style>
  .lb-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: minmax(12.5rem, auto); gap: clamp(0.75rem, 1.4vw, 1.25rem); }
  .lb-lead { grid-column: span 2; grid-row: span 2; position: relative; border-radius: var(--radius); overflow: hidden; background: var(--surface-2); border: 1px solid var(--line); display: grid; align-content: end; min-height: 26.25rem; }
  .lb-lead.has-img { border: 0; }
  /* Aussage ohne Bild: ruhiges Raster aus Lichtpunkten, nach oben rechts ausblendend, wie Drohnen am Boden vor dem Start */
  .lb-lead:not(.has-img)::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(245, 167, 60, 0.5) 0.0625rem, transparent 0.1rem); background-size: 1.375rem 1.375rem; -webkit-mask-image: radial-gradient(120% 90% at 100% 0%, #000, transparent 62%); mask-image: radial-gradient(120% 90% at 100% 0%, #000, transparent 62%); opacity: 0.55; pointer-events: none; }
  .lb-img { position: absolute; inset: 0; --curtain-r: var(--radius); }
  .lb-img img { width: 100%; height: 100%; object-fit: cover; }
  .lb-lead.has-img::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(15, 13, 12, 0.86)); pointer-events: none; z-index: 1; }
  .lb-lead-copy { position: relative; z-index: 2; display: grid; gap: 0.75rem; justify-items: start; padding: clamp(1.5rem, 3vw, 2.75rem); }
  .lb-lead h2, .lb-lead h3 { font-size: clamp(1.75rem, 3.2vw, 3rem); line-height: 1.04; letter-spacing: -0.03em; max-width: 16ch; }
  .lb-lead p { color: var(--muted); max-width: 44ch; margin: 0; }
  .lb-lead.has-img p { color: rgba(246, 241, 232, 0.82); }
  .lb-k { color: var(--accent); }
  .lb-cell { border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); padding: clamp(1.375rem, 2.4vw, 2rem); display: grid; gap: 0.625rem; align-content: start; }
  /* zwei Kacheln: je eine ganze Zeile rechts; drei: die letzte rechts unten über zwei Spalten */
  .lb-grid[data-n='2'] .lb-cell { grid-column: span 2; }
  .lb-grid[data-n='3'] .lb-cell:last-child { grid-column: span 2; }
  .lb-grid[data-n='1'] .lb-cell { grid-column: span 2; grid-row: span 2; }
  .lb-feat { gap: 0.75rem; }
  /* Icon und Überschrift wie im Icon-Raster der Preisseite (.ic-ico/.ic-h in global.css) */
  /* CtaBox ist eine eigene Komponente: Abstand über :global, sonst greift das Komponenten-CSS nicht */
  :global(.lb-close) { margin-top: clamp(2rem, 4vw, 3.5rem); }
  .lb-more { margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  /* Aussage ohne Bild: Inhalt in der Mitte statt unten, Icon darüber */
  .lb-lead:not(.has-img) { align-content: center; }
  .lb-lead-copy :global(.lb-lead-ico) { width: 2.5rem; height: 2.5rem; margin-bottom: 0.375rem; }
  @media (max-width: 68.75em) {
    .lb-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lb-lead { grid-column: 1 / -1; grid-row: auto; min-height: 23.75rem; }
    .lb-grid[data-n='3'] .lb-cell:last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 40em) {
    .lb-grid { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .lb-grid .lb-cell, .lb-grid[data-n] .lb-cell { grid-column: auto; grid-row: auto; }
    .lb-lead { min-height: 21.25rem; }
  }
</style>
