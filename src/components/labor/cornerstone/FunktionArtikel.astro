---
// Cornerstone-Artikel „Wie funktioniert eine Drohnenshow?“ (Labor, Runde 18, 22.11.2026) im Format des Prototyps
// „Wie programmiert man eine Drohnenshow?“. Text unverändert aus der Collection, an den Zwischentiteln geteilt.
// Szene ja, aber nur für „Ablauf einer Drohnenshow“: Der Abschnitt erklärt einen Ablauf in vier Schritten (Raster, Start,
// Formation/Animation, Rückkehr), den man sehen will. Alles andere sind Fotos: Die Drohne zeigt der Programmier-Artikel
// schon als Explosionsansicht, hier steht eine echte Showdrohne. „Technik und Programmierung“ bekommt kein Bild, um nicht
// den Programmier-Artikel zu doppeln. Bilder: tools/labor/blog-cornerstone.mjs.
import { getEntry } from 'astro:content';
import BlogPost from '../../../templates/BlogPost.astro';
import ArticlePhotos from '../../blog/ArticlePhotos.astro';
import FormationFinale from '../../blog/FormationFinale.astro';
import AblaufStory from './AblaufStory.astro';
import LaborNote from './LaborNote.astro';
import { sections, listSteps } from './split';

const post = (await getEntry('posts', '2025-01-14-wie-funktioniert-drohnenshow-drohne'))!;
const M = '/media/labor/cornerstone/';
const { intro, h2 } = sections(post.rendered?.html ?? '', ['Was ist eine Drohne', 'Technik und Programmierung', 'Ablauf einer Drohnenshow', 'Kreative Möglichkeiten', 'Grenzen und Herausforderungen', 'Tipps für erfolgreiche', 'Fazit']);
const [drohne, technik, ablauf, kreativ, grenzen, tipps, fazit] = h2;
const flow = listSteps(ablauf, 4);
const group = { name: 'Schlüsselschritte im Ablauf', short: 'Ablauf' };
const blocks = [{ html: flow.head }, ...flow.steps.map((s, i) => ({ html: s.html, step: i, title: s.title, group: group.name }))];
const NOTES: [string, string, string][] = [
  ['Titelbild', 'Doppelherz über Nieheim (#034) im Lichtraster, Zuschnitt oben, Gamma 2,2 und Schwelle 0,12. Geprüft und verworfen: das grüne Startraster bei Nacht (#010), im Raster nur Striche ohne erkennbares Motiv.', 'Foto hochladen; der Build rechnet.'],
  ['Fotos', 'Was ist eine Drohne: zwei echte Showdrohnen (#002, #013) statt einer Zeichnung, die der Programmier-Artikel schon hat. Kreative Möglichkeiten: Ortsname NIEHEIM (#030). Grenzen: Startraster im Park (#015), die Fläche, um die es im Abschnitt geht. Das Importbild „Drohne in der Dämmerung“ entfällt.', 'Fotos wählen, Alternativtext und Bildzeile eintragen.'],
  ['Szene „Ablauf“', 'Nur für die vier Schlüsselschritte: Raster auf dem Feld, alle heben gleichzeitig ab und bilden einen Kreis, der Kreis wird zum Herz und schlägt leise, jede Drohne landet auf ihrem Startpunkt. Kein Bild für „Technik und Programmierung“: Software, Simulation und Explosionsansicht zeigt der Programmier-Artikel. Eine Annotation je Schritt. Im HTML steht die Herz-Formation (ohne JavaScript, Suche).', 'Nicht im Editor pflegbar (wie die Szene des Programmier-Artikels). Ändert sich die Liste der Schritte, meldet der Build das.'],
  ['Logo-Formation', 'Unverändert aus dem Prototyp, über dem Fazit.', 'Baustein ohne Pflege.'],
];
---
<BlogPost post={post} noindex headroom coverImage={{ src: `${M}funktion-titel-034.webp`, width: 1600, height: 800, alt: 'Ein Doppelherz aus Drohnen über dem nächtlichen Nieheim, als Lichtpunkt-Raster.' }}>
  <Fragment slot="body">
    <div class="post-body cs-col" set:html={intro} />
    <div class="post-body cs-col" set:html={drohne} />
    <ArticlePhotos photos={[
      { src: `${M}funktion-002.webp`, width: 960, height: 1200, alt: 'Eine einzelne Showdrohne mit vier Propellern auf einer Wiese, im Gegenlicht der tief stehenden Sonne.' },
      { src: `${M}funktion-013.webp`, width: 960, height: 1200, alt: 'Zwei Showdrohnen auf weißen Startunterlagen auf einer gepflasterten Fläche, dahinter weitere Drohnen.' },
    ]} caption="Showdrohnen aus der Nähe: vier Propeller, ein leichter Rahmen und oben die LED." />
    <div class="post-body cs-col" set:html={technik} />
    <AblaufStory blocks={blocks} group={group} label="Ablauf einer Drohnenshow" caption="Ablauf einer Drohnenshow in vier Schritten: Die Drohnen stehen im Animationsraster, heben gleichzeitig ab und bilden einen Kreis, der Kreis wird zum Herz, danach landet jede Drohne auf ihrem Startpunkt." />
    <div class="post-body cs-col cs-after" set:html={kreativ} />
    <ArticlePhotos photos={[{ src: `${M}funktion-030.webp`, width: 1600, height: 1000, alt: 'Der Schriftzug NIEHEIM aus grünen und blauen Drohnen über einem nächtlichen Festgelände.' }]} caption="Ein Ortsname als Formation, über dem Festgelände in Nieheim." />
    <div class="post-body cs-col" set:html={grenzen} />
    <ArticlePhotos photos={[{ src: `${M}funktion-015.webp`, width: 1600, height: 1000, alt: 'Ein Startraster aus Showdrohnen auf der Wiese eines Parks, umgeben von Bäumen und Skulpturen.' }]} caption="Ein Startraster im Park. Wie viele Drohnen fliegen, hängt von der freien Fläche ab." focus="20% 80%" />
    <div class="post-body cs-col" set:html={tipps} />
    <FormationFinale><div class="post-body" set:html={fazit} /></FormationFinale>
  </Fragment>
  <LaborNote slot="after" notes={NOTES} />
</BlogPost>

<style>
  .cs-col { width: 100%; }
  .cs-col + .cs-col { margin-top: var(--space-10); }
  .cs-after { margin-top: var(--space-10); }
</style>
