---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Video from '../Video.astro';
import { optimizedImage } from '../../lib/media';

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const data = project.data.showcase;
if (!data) throw new Error(`Project ${project.id} has no showcase content`);
const available = (await getCollection('projects', (p) => !p.data.draft && Boolean(p.data.showcase)))
  .sort((a, b) => a.data.showcase!.order - b.data.showcase!.order);
// A deliberately hidden case also disappears from related-project navigation.
const next = available.find((p) => p.data.showcase!.route === data.nextRoute)
  ?? available.find((p) => p.id !== project.id);
const nextData = next?.data.showcase;
const uniqueImages = [...new Set([...data.story.map((s) => s.image.src), ...data.gallery.map((p) => p.src)])];
const images = new Map(await Promise.all(uniqueImages.map(async (src) => [src, await optimizedImage(src)] as const)));
const img = (src: string) => images.get(src)!;
const nextImage = next?.data.cover ? await optimizedImage(next.data.cover.src) : undefined;

// The title lines were set as two display lines in the prototype ("Bokken" / "rijders"); here they read as one headline.
const title = data.titleLines.reduce((all, line) => (/^\p{Ll}/u.test(line) ? `${all}${line}` : `${all} ${line}`));
// The page heading always names the project, also when the show title does not ("Stronger Together" for PUMA).
const namePrefix = title.toLowerCase().includes(data.name.toLowerCase()) ? '' : `${data.name}: `;
// "Drohnen: 600" reads as "600 Drohnen" in a line of facts; every other value speaks for itself.
const facts = data.credits.map((credit) => ({ ...credit, text: /^\d+$/.test(credit.value) ? `${credit.value} ${credit.label}` : credit.value }));
const occasion = (category: string) => category.split('·')[0].trim();
const nextMeta = next && nextData ? [occasion(nextData.category), next.data.location, `${nextData.drones} Drohnen`].filter(Boolean).join(' · ') : '';
const inquiry = `/kontakt/?anlass=firma&quelle=referenz-${data.route}`;
---
<div class="case">
  <section class="hero c-hero" aria-labelledby="case-h">
    <Video src={data.heroVideo} poster={project.data.cover?.src} label="Showvideo ansehen" class="hero-media" loop hero />
    <div class="shade" aria-hidden="true"></div>
    <div class="hero-copy">
      <h1 id="case-h">{namePrefix && <span class="sr-only">{namePrefix}</span>}{title}</h1>
      <p class="lead">{data.tagline}</p>
      <dl class="c-credits">{facts.map((fact) => <div><dt class="sr-only">{fact.label}</dt><dd>{fact.text}</dd></div>)}</dl>
    </div>
  </section>

  <section class="section c-numbers" aria-label="In Zahlen">
    <ul class="c-nums" role="list" data-count={data.numbers.length}>
      {data.numbers.map((number) => <li class="c-num"><b class="num">{number.value.toLocaleString('de-DE')}</b><span>{number.label}</span></li>)}
    </ul>
  </section>

  <section class="section c-story" aria-label="Die Geschichte">
    {data.story.map((step) => <article class:list={['c-step', { tall: data.portrait }]}>
      <figure><img src={img(step.image.src).src} {...img(step.image.src).attributes} width={img(step.image.src).width} height={img(step.image.src).height} alt={step.image.alt} loading="lazy" decoding="async" /></figure>
      <div class="c-step-copy"><h2>{step.title}</h2><p>{step.text}</p></div>
    </article>)}
  </section>

  <section class="section c-play" aria-labelledby="play-h">
    <div class="sec-head"><h2 id="play-h">{data.formation.title}</h2><p>{data.formation.text}</p></div>
    <div class="c-stage"><canvas data-formation={data.formation.src} aria-hidden="true"></canvas></div>
    <div class="c-play-row">
      <button class="btn small" type="button" data-replay disabled>Noch mal starten</button>
      <button class="btn small" type="button" data-formation-pause aria-pressed="false">Animation pausieren</button>
      <span class="tally" data-tally role="status"></span>
    </div>
  </section>

  <section class="section c-reel" aria-labelledby="reel-h">
    <div class="c-reel-head">
      <h2 id="reel-h">Die Show in {data.gallery.length} Bildern.</h2>
      <div class="ctrl">
        <button type="button" data-prev aria-label="Vorheriges Bild"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
        <button type="button" data-next aria-label="Nächstes Bild"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
      </div>
    </div>
    <div class:list={['c-track', { tall: data.portrait }]} tabindex="0" role="region" aria-label={`${data.name}: Bildergalerie`}>
      {data.gallery.map((picture) => <figure><div class="img"><img src={img(picture.src).src} {...img(picture.src).attributes} width={img(picture.src).width} height={img(picture.src).height} alt={picture.alt} loading="lazy" decoding="async" draggable="false" /></div><figcaption>{picture.caption}</figcaption></figure>)}
    </div>
  </section>

  <section class="section c-setlist split" aria-labelledby="set-h">
    <div class="sec-head split-head"><h2 id="set-h">Was am Himmel zu sehen war.</h2></div>
    <div class="groups">{data.setlist.map((group) => <div><h3>{group.title}</h3><ol role="list">{group.items.map((item) => <li>{item}</li>)}</ol></div>)}</div>
  </section>

  {data.press.length > 0 && <section class="section c-press" aria-labelledby="press-h">
    <div class="sec-head"><h2 id="press-h">In der Presse.</h2></div>
    <div class="clips">{data.press.map((clip) => <article class="clip"><p class="clip-src">{clip.publication} · {clip.date}</p><h3>{clip.title}</h3><p>{clip.text}</p></article>)}</div>
  </section>}

  {nextData && <section class="section c-next-sec" aria-label="Nächstes Projekt">
    <a class="c-next" href={`/${nextData.route}/`}>
      <div class="img">{nextImage && <img src={nextImage.src} {...nextImage.attributes} width={nextImage.width} height={nextImage.height} alt="" loading="lazy" decoding="async" />}</div>
      <div class="c-next-copy">
        <h2>{nextData.name}</h2>
        <span class="c-next-meta">{nextMeta}</span>
        <span class="c-next-go">Nächstes Projekt ansehen</span>
      </div>
    </a>
  </section>}

  <section class="section" aria-labelledby="cta-h">
    <div class="sec-head cta-block">
      <h2 id="cta-h">{data.cta.title}</h2>
      <p>{data.cta.text}</p>
      <p class="actions"><a class="btn primary" href={inquiry}>Show anfragen</a></p>
    </div>
  </section>
</div>
<script>import './case.js';</script>
