---
import {field} from 'astro-frontend-editor/markers';
import {landingSiteContent} from '../../content/shared-blocks.mjs';
import {factText} from '../../content/show-extras.mjs';
import IconFeature from '../IconFeature.astro';
import { forPath } from '../../i18n/server';
const { t, localHref, locale } = forPath(Astro.url.pathname);
// Ein Schema für alle Standort- und Sicherheitsabschnitte. Maßangaben sind Content,
// die Geometrie ist bewusst schematisch. Belege: docs/sicherheitskonzept-quellen.md.
// Kompakt (Marc, 17.11.2026: „deutlich kleiner“): links Kicker, Schlagzeile, Text und Punkte, rechts nur die Karte. Die
// Zonen erklären sich über Popover an der Karte (Zeigen, Fokus, Tippen; Esc schließt), keine Liste und keine
// Zuständigkeitstabelle mehr daneben. Die Popover positioniert JavaScript klassisch (Safari 18 kann kein CSS Anchor
// Positioning). Ohne JavaScript stehen die Zonen als nummerierte Legende unter der Karte. Darunter Zulassungs-Logos.
import type { Section } from '../../content.config';
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
type Props = Extract<Section, { type: 'landingSite' }> & { index: number };
const { kicker, headline, text, variant, diagram, items, safeguards, download, points, cta, quality, id = 'location', index } = landingSiteContent(Astro.props,locale);
// Zulassungen als Logo-Reihe unter Text und Karte (LBA, EASA, naturstrom nur mit Freigabe und vorhandener Datei, sonst
// Verlaufs-Icon). Nachrangige Belege (secondary) stehen nicht mehr in der kompakten Section.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
const QICON = { permit: 'file-badge', sound: 'audio-lines', shield: 'shield-check', leaf: 'leaf' } as const;
const seals = (quality ?? []).filter((q) => !q.secondary).map((q) => ({ ...q, show: Boolean(q.cleared && q.logo && existsSync(join(process.cwd(), 'public', q.logo))) }));
const sharedField=(key:string)=>Astro.props.safetyRef?field({collection:'safetyConcept',id:'configuration'},[locale,key],{mode:'panel'}):{};
const H = index === 0 ? 'h1' : 'h2';
const T = index === 0 ? 'h2' : 'h3';
const numbers = Object.fromEntries(items.map((item, i) => [item.zone, i + 1]));
const colors = ['#ff9e29', '#f58a5a', '#ec7f95', '#db64e8', '#b88bec', '#8aa9ee', '#6fc8ef', '#33edf2'];
const line = Array.from({ length: 21 }, (_, i) => ({ x: 110 + i * 8.5, y: 138, color: colors[Math.round(i / 20 * 7)] }));
const grid = Array.from({ length: 20 }, (_, i) => ({ x: 142 + (i % 5) * 25, y: 306 + Math.floor(i / 5) * 32 }));
const swarm = Array.from({ length: 18 }, (_, i) => ({ x: 90 + i * 9, y: 122 - Math.sin(i / 17 * Math.PI) * 40, color: colors[Math.round(i / 17 * 7)] }));
// Zonenfarben wie im Technik-Datenblatt von FlyingStars (Marc, 03.11.2026: „die Darstellung … sieht deutlich nicer aus“):
// Rot = äußerer, Gelb = innerer Sicherheitsbereich, Grün = Flugbereich, Blau = Start und Landung, Violett = Publikum,
// Drohnen als orange Punktlinie. Für dunklen Grund aufgehellt; Liste und Nummern in der Zeichnung tragen dieselbe Farbe.
const zoneColor: Record<string, string> = { safety: '#ff7a6e', operative: '#f5b43c', drones: '#6fdc98', start: '#6aa8ff', guests: '#c49bf2', ceiling: '#f5b43c', floor: '#6aa8ff', kit: '#ff9e29' };
// Abgerundetes Vieleck (Ecken als Bézier), damit die Zonen weich wie im Datenblatt wirken
const rounded = (pts: number[][], r: number) => pts.map((p, i) => {
  const a = pts[(i + pts.length - 1) % pts.length], c = pts[(i + 1) % pts.length];
  const towards = (q: number[]) => { const dx = q[0] - p[0], dy = q[1] - p[1], len = Math.hypot(dx, dy), k = Math.min(r, len / 2) / len; return [p[0] + dx * k, p[1] + dy * k]; };
  const [s, e] = [towards(a), towards(c)];
  return `${i ? 'L' : 'M'}${s[0].toFixed(1)} ${s[1].toFixed(1)}Q${p[0]} ${p[1]} ${e[0].toFixed(1)} ${e[1].toFixed(1)}`;
}).join('') + 'Z';
// Lageplan (Draufsicht, leicht gedreht wie im Datenblatt): Zonen ineinander, Drohnenlinie quer zur Blickrichtung
const plan = {
  outer: rounded([[70, 86], [146, 50], [264, 54], [330, 104], [338, 214], [288, 286], [146, 294], [78, 240]], 30),
  operative: rounded([[92, 100], [152, 72], [258, 76], [312, 116], [318, 206], [276, 266], [154, 272], [98, 228]], 24),
  flight: rounded([[114, 116], [160, 94], [250, 98], [292, 130], [296, 198], [262, 246], [162, 252], [118, 212]], 18),
  drones: Array.from({ length: 21 }, (_, i) => ({ x: 146 + i * 6.3, y: 196 - Math.sin(i / 20 * Math.PI) * 4 })),
  buildings: [[6, 6, 50, 30], [70, 4, 64, 24], [148, -6, 50, 24], [296, 4, 50, 30], [374, 30, 30, 62], [374, 108, 30, 74], [374, 198, 30, 54], [374, 268, 30, 70], [6, 312, 44, 34], [312, 334, 46, 30], [-6, 384, 70, 30], [92, 386, 74, 30], [196, 388, 60, 30], [282, 386, 76, 30]],
  trees: [[16, 108, 8], [32, 140, 6], [14, 172, 9], [34, 206, 7], [16, 240, 8], [30, 272, 6]],
};
const markers = variant === 'outdoor'
  ? [{ zone: 'safety', x: 302, y: 70 }, { zone: 'operative', x: 318, y: 160 }, { zone: 'drones', x: 268, y: 222 }, { zone: 'start', x: 192, y: 127 }, { zone: 'guests', x: 290, y: 320 }]
  : [{ zone: 'ceiling', x: 49, y: 28 }, { zone: 'drones', x: 262, y: 83 }, { zone: 'floor', x: 118, y: 285 }, { zone: 'kit', x: 305, y: 442 }, { zone: 'guests', x: 350, y: 160 }];
// Tippflächen über den Nummern der Zeichnung, in Prozent der viewBox. Draußen liegen die Nummern in der um −14° gedrehten
// Gruppe: dieselbe Drehung hier nachrechnen, damit Knopf und gezeichnete Nummer deckungsgleich sind.
const VB = variant === 'outdoor' ? { w: 400, h: 400 } : { w: 400, h: 490 };
const turn = (x: number, y: number) => { const a = -14 * Math.PI / 180, dx = x - 204, dy = y - 172; return [204 + dx * Math.cos(a) - dy * Math.sin(a), 172 + dx * Math.sin(a) + dy * Math.cos(a)]; };
const hotspots = markers.filter((m) => numbers[m.zone]).map((m) => { const [x, y] = variant === 'outdoor' ? turn(m.x, m.y) : [m.x, m.y]; return { zone: m.zone, x: (x / VB.w * 100).toFixed(2), y: (y / VB.h * 100).toFixed(2) }; }).sort((a, b) => numbers[a.zone] - numbers[b.zone]);
const itemOf = Object.fromEntries(items.map((item, i) => [item.zone, { ...item, n: i + 1 }]));
---
<section class="section ls-site" id={id} aria-labelledby={`${id}-h`}>
  <div class:list={['st', `st-${variant}`]}>
    <SectionHead kicker={kicker} headline={headline} text={text} id={`${id}-h`} level={H} class="st-copy">
      {points && points.length > 0 && <ul class="st-points">{points.map((point) => <li><Icon name="check" size={20} class="g" /><span>{point.value}</span></li>)}</ul>}
      {(cta || download) && <p class="st-more">
        {cta && <a class="link" href={localHref(cta.href)}>{cta.label} <span aria-hidden="true">→</span></a>}
        {download && <a {...sharedField("download")} class="link st-download" href={localHref(download.href)} type="application/pdf" target="_blank" rel="noopener">{download.label}<Icon name="download" size={18} class="g" /></a>}
      </p>}
    </SectionHead>
    <figure {...sharedField("diagram")} class="st-fig">
      <div class="st-map" data-st-map>
        <svg viewBox={variant === 'outdoor' ? '0 0 400 400' : '0 0 400 490'} role="img" aria-labelledby={`${id}-diagram-title ${id}-diagram-desc`}>
          <title id={`${id}-diagram-title`}>{variant === 'outdoor' ? t('landingsite.outdoorTitle') : t('landingsite.indoorTitle')}</title>
          <desc id={`${id}-diagram-desc`}>{factText(diagram.description,locale)} {t('landingsite.numberedList')} {factText(diagram.caption,locale)}</desc>
          {variant === 'outdoor' ? <>
            <g class="plan" aria-hidden="true">
              <path class="road" d="M362 0v374M0 374h400" />
              {plan.buildings.map(([x, y, w, h]) => <rect class="house" x={x} y={y} width={w} height={h} rx="3" />)}
              <path class="park" d={rounded([[-4, 92], [50, 88], [56, 292], [-4, 296]], 8)} />
              {plan.trees.map(([x, y, r]) => <circle class="tree" cx={x} cy={y} r={r} />)}
            </g>
            <g transform="rotate(-14 204 172)">
              <g class="zone" data-zone="safety" data-pick="safety" style={`--zc: ${zoneColor.safety}`}><path class="shape" d={plan.outer} />
                <path class="dim" d="M70 30L330 30M70 24v12M330 24v12" />
                <g class="pill" transform="translate(200 30)"><rect x="-34" y="-10" width="68" height="20" rx="10" /><text y="4.5" text-anchor="middle">{factText(diagram.horizontalLabel,locale)}</text></g></g>
              <g class="zone" data-zone="operative" data-pick="operative" style={`--zc: ${zoneColor.operative}`}><path class="under" d={plan.operative} /><path class="shape" d={plan.operative} /></g>
              <g class="zone" data-zone="drones" data-pick="drones" style={`--zc: ${zoneColor.drones}`}><path class="under" d={plan.flight} /><path class="shape" d={plan.flight} />
                <path class="dim" d="M146 172h126M146 166v12M272 166v12" />
                <g class="pill" transform="translate(209 172)"><rect x="-30" y="-10" width="60" height="20" rx="10" /><text y="4.5" text-anchor="middle">{factText(diagram.detailLabel,locale)}</text></g>
                {plan.drones.map((d, i) => <circle class="drone" cx={d.x} cy={d.y} r="2.9" style={`--d: ${(i * 0.11).toFixed(2)}s`} />)}</g>
              <g class="zone" data-zone="start" data-pick="start" style={`--zc: ${zoneColor.start}`}><rect class="shape pad" x="132" y="118" width="40" height="17" rx="4" /><rect class="ring" x="126" y="112" width="52" height="29" rx="7" />
                {Array.from({ length: 12 }, (_, i) => <circle class="seed" cx={138 + (i % 6) * 5.6} cy={123 + Math.floor(i / 6) * 6} r="1.2" />)}</g>
              <g class="zone" data-zone="guests" data-pick="guests" style={`--zc: ${zoneColor.guests}`}><rect class="shape" x="140" y="308" width="134" height="26" rx="7" />
                {Array.from({ length: 20 }, (_, i) => <circle class="guest" cx={150 + (i % 10) * 12.7} cy={316 + Math.floor(i / 10) * 10} r="2.3" />)}
                <path class="view" d="M207 302v-38m-5 8 5-8 5 8" /></g>
              {markers.map((m) => <g class="marker" data-zone={m.zone} data-pick={m.zone} style={`--zc: ${zoneColor[m.zone]}`} transform={`translate(${m.x} ${m.y}) rotate(14)`}><circle r="11" /><text y="4.5" text-anchor="middle">{numbers[m.zone]}</text></g>)}
            </g>
          </> : <>
            <path class="wall" d="M49 28h324M49 210h324" />
            <g class="zone" data-zone="ceiling" data-pick="ceiling" style={`--zc: ${zoneColor.ceiling}`}>{Array.from({ length: 17 }, (_, i) => <path class="hatch" d={`M${53 + i * 19} 28l-9 -12`} />)}
            <path class="dim" d="M31 34v176M25 34h12M25 210h12" />
            <text class="lbl" x="17" y="123" text-anchor="middle" transform="rotate(-90 17 123)">{factText(diagram.verticalLabel,locale)}</text></g>
            <g class="zone" data-zone="drones" data-pick="drones" style={`--zc: ${zoneColor.drones}`}><rect class="flight" x="73" y="53" width="211" height="155" rx="8" />
            {swarm.map((d) => <circle cx={d.x} cy={d.y} r="3.3" fill={d.color} />)}</g>
            <g class="zone" data-zone="guests" data-pick="guests" style={`--zc: ${zoneColor.guests}`}>{[0, 1, 2].map((i) => <><circle class="guest" cx={312 + i * 23} cy="180" r="5" /><path class="guest-body" d={`M${304 + i * 23} 210v-13a8 8 0 0 1 16 0v13`} /></>)}</g>
            <path class="divider" d="M49 238h324" />
            <g class="zone" data-zone="floor" data-pick="floor" style={`--zc: ${zoneColor.floor}`}><rect class="pad" x="88" y="202" width="179" height="8" rx="3" />
            <path class="dim" d="M118 270h156M118 264v12M274 264v12" />
            <text class="lbl" x="196" y="261" text-anchor="middle">{factText(diagram.horizontalLabel,locale)}</text>
            <rect class="flight" x="105" y="279" width="182" height="174" rx="6" />
            <rect class="pad" x="118" y="292" width="156" height="148" rx="4" />
            {grid.map((d) => <circle class="seed" cx={d.x} cy={d.y} r="3" />)}</g>
            <g class="zone" data-zone="kit" data-pick="kit" style={`--zc: ${zoneColor.kit}`}>{[[105, 279], [287, 279], [105, 453], [287, 453]].map(([x, y]) => <circle class="antenna" cx={x} cy={y} r="5" />)}
            <text class="lbl" x="196" y="482" text-anchor="middle">{factText(diagram.detailLabel,locale)}</text></g>
          </>}
          {variant === 'indoor' && markers.map((m) => <g class="marker" data-zone={m.zone} data-pick={m.zone} style={`--zc: ${zoneColor[m.zone]}`} transform={`translate(${m.x} ${m.y})`}><circle r="12" /><text y="4.5" text-anchor="middle">{numbers[m.zone]}</text></g>)}
        </svg>
        {hotspots.map((h) => <button type="button" class="st-hot" data-zone={h.zone} data-hot={h.zone} style={`--x: ${h.x}%; --y: ${h.y}%; --zc: ${zoneColor[h.zone]}`} aria-expanded="false" aria-controls={`${id}-z${h.zone}`}><span class="sr-only">{itemOf[h.zone].n}. {itemOf[h.zone].title}</span></button>)}
        <ol {...sharedField("items")} class="st-tips">
          {items.map((item, i) => <li id={`${id}-z${item.zone}`} data-tip={item.zone} style={`--zc: ${zoneColor[item.zone]}`}>
            <span class="st-n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <T class="st-t">{item.title}</T>
            {item.value && <span class="st-value">{factText(item.value,locale)}</span>}
            <p>{factText(item.text,locale)}</p>
          </li>)}
        </ol>
      </div>
      <figcaption><span class="st-hint">{t('landingsite.tapHint')}</span> <span class="st-height"><Icon name="move-up" size={16} class="g" />{factText(diagram.flightLabel,locale)}</span> <span class="st-cap">{factText(diagram.caption,locale)}</span></figcaption>
    </figure>
  </div>
  {safeguards && <div class="st-safeguards">
    {safeguards.map((item) => <IconFeature icon={item.icon} title={item.title} text={factText(item.text,locale)} level={T} />)}
  </div>}
  {seals.length > 0 && <div class="proof st-proof"><div class="quality">
    <ul>{seals.map((q) => <IconFeature as="li" icon={QICON[q.icon]} logo={q.show ? q.logo : undefined} title={q.title} text={q.text} level={T} />)}</ul>
  </div></div>}
</section>

<script>
  // Popover an der Karte: Zeigen (Maus) auf Nummer oder Zone, Fokus oder Tippen öffnet die Erklärung der Zone neben der
  // Nummer. Esc, Tippen daneben oder Verlassen der Karte mit der Maus schließt. Positionierung klassisch per JavaScript,
  // innerhalb der Kartenbreite geklemmt (kein seitliches Scrollen auf dem Handy).
  document.querySelectorAll<HTMLElement>('.ls-site [data-st-map]').forEach((map) => {
    const fig = map.closest('.st-fig') as HTMLElement;
    const hots = [...map.querySelectorAll<HTMLButtonElement>('[data-hot]')];
    const tips = [...map.querySelectorAll<HTMLElement>('[data-tip]')];
    let current = '';
    const place = (zone: string) => {
      const hot = hots.find((b) => b.dataset.hot === zone), tip = tips.find((el) => el.dataset.tip === zone);
      if (!hot || !tip || getComputedStyle(tip).position !== 'absolute') return;
      const m = map.getBoundingClientRect(), b = hot.getBoundingClientRect(), gap = 6;
      const w = tip.offsetWidth, h = tip.offsetHeight;
      const cx = b.left + b.width / 2 - m.left;
      const left = Math.max(0, Math.min(m.width - w, cx - w / 2));
      const below = b.bottom - m.top + gap, above = b.top - m.top - h - gap;
      const top = below + h <= m.height || above < 0 ? below : above;
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      tip.style.left = `${(left / rem).toFixed(3)}rem`; tip.style.top = `${(top / rem).toFixed(3)}rem`;
    };
    const show = (zone: string) => {
      current = zone;
      fig.classList.toggle('has-on', Boolean(zone));
      map.querySelectorAll<SVGElement | HTMLElement>('[data-zone], [data-tip]').forEach((el) => el.classList.toggle('on', (el.dataset.zone ?? el.dataset.tip) === zone));
      hots.forEach((b) => b.setAttribute('aria-expanded', String(b.dataset.hot === zone)));
      if (zone) place(zone);
    };
    // Zeigen wählt nur bei echter Mausbewegung, nicht wenn sich der Inhalt unter dem stehenden Zeiger verschiebt
    let last = { x: -1, y: -1 };
    map.addEventListener('pointermove', (e) => { last = { x: e.clientX, y: e.clientY }; });
    map.querySelectorAll<HTMLElement | SVGElement>('[data-pick], [data-hot]').forEach((el) => {
      const zone = (el as HTMLElement).dataset.pick ?? (el as HTMLElement).dataset.hot!;
      el.addEventListener('pointerenter', (e) => {
        const p = e as PointerEvent;
        if (p.pointerType === 'mouse' && (p.clientX !== last.x || p.clientY !== last.y)) show(zone);
      });
      el.addEventListener('click', (e) => { e.stopPropagation(); show(zone); });
    });
    let restoring = false; // Esc gibt den Fokus an die Nummer zurück, ohne das Popover wieder zu öffnen
    hots.forEach((b) => b.addEventListener('focus', () => { if (!restoring) show(b.dataset.hot!); }));
    map.addEventListener('focusout', (e) => { if (!map.contains(e.relatedTarget as Node)) show(''); });
    map.addEventListener('pointerleave', (e) => { if ((e as PointerEvent).pointerType === 'mouse' && !map.contains(document.activeElement)) show(''); });
    map.addEventListener('keydown', (e) => { if (e.key === 'Escape' && current) { const hot = hots.find((b) => b.dataset.hot === current); show(''); restoring = true; hot?.focus({ preventScroll: true }); restoring = false; } });
    document.addEventListener('click', (e) => { if (current && !map.contains(e.target as Node)) show(''); });
    addEventListener('resize', () => { if (current) place(current); }, { passive: true });
    fig.classList.add('is-live');
  });
</script>

<style>
  /* Text links, Karte rechts; die Karte bleibt klein (max. ~30rem), damit die Section nicht mehr dominiert */
  .st { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 30rem); gap: clamp(var(--space-8), 6vw, var(--space-22)); align-items: center; }
  .st-indoor { grid-template-columns: minmax(0, 1fr) minmax(0, 26rem); }
  .st :global(.st-copy) { margin: 0; }
  .st-fig { margin: 0; padding: clamp(var(--space-3-5), 1.6vw, var(--space-5-5)); border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .st-map { position: relative; }
  .st-map svg { width: 100%; height: auto; display: block; }
  .st-fig figcaption { margin-top: var(--space-3-5); color: var(--faint); font-size: var(--text-xs); line-height: 1.5; display: grid; gap: var(--space-1-5); }
  .st-hint { color: var(--muted); }
  .st-height { display: inline-flex; align-items: center; gap: var(--space-1-5); color: var(--muted); }
  .st-height :global(.ico) { flex: 0 0 auto; width: 1rem; height: 1rem; }
  .st-fig:not(.is-live) .st-hint { display: none; }
  /* Lageplan (outdoor): Straßen, Häuser und Park nur als ruhiger Grund, die Zonen tragen die Farbe */
  .plan .road { fill: none; stroke: rgb(var(--rgb-head) / 5%); stroke-width: 12; }
  .plan .house { fill: rgb(var(--rgb-head) / 5%); stroke: rgb(var(--rgb-head) / 9%); }
  .plan .park { fill: rgb(var(--rgb-good) / 5%); }
  .plan .tree { fill: rgb(var(--rgb-good) / 11%); }
  .zone { cursor: pointer; }
  .zone .under { fill: var(--surface); }
  .shape { fill: color-mix(in srgb, var(--zc) 20%, transparent); stroke: color-mix(in srgb, var(--zc) 70%, transparent); stroke-width: 1.5; }
  [data-zone="operative"] .shape { fill: color-mix(in srgb, var(--zc) 30%, transparent); }
  [data-zone="guests"] .shape { fill: color-mix(in srgb, var(--zc) 30%, transparent); }
  .shape.pad { fill: color-mix(in srgb, var(--zc) 80%, transparent); stroke: var(--zc); }
  .drone { fill: var(--logo-amber); stroke: var(--surface); stroke-width: 0.8; }
  .pill rect { fill: var(--ground); stroke: var(--line-strong); }
  /* SVG-Text bleibt in viewBox-Benutzerkoordinaten und skaliert mit der gesamten Zeichnung. */
  .pill text { fill: var(--head); font: 500 11px var(--mono); letter-spacing: 0.04em; }
  /* Innenraum (indoor): dieselben Zonenfarben, sparsamer */
  .flight { fill: color-mix(in srgb, var(--zc, var(--good)) 8%, transparent); stroke: color-mix(in srgb, var(--zc, var(--good)) 55%, transparent); stroke-dasharray: 3 4; }
  .pad { fill: color-mix(in srgb, var(--zc, var(--diagram-blue)) 14%, transparent); stroke: color-mix(in srgb, var(--zc, var(--diagram-blue)) 80%, transparent); stroke-width: 1; }
  .dim, .wall, .hatch, .view { fill: none; stroke: var(--faint); stroke-width: 1; }
  .hatch { stroke: var(--zc, var(--faint)); opacity: 0.7; }
  .view { stroke: var(--zc, var(--faint)); stroke-dasharray: 3 4; opacity: 0.8; }
  .divider { stroke: var(--line); }
  .lbl { fill: var(--head); font: 400 17px var(--display); }
  .seed { fill: var(--head); }
  .guest { fill: var(--zc, var(--head)); opacity: 0.85; }
  .guest-body { fill: none; stroke: var(--zc, var(--head)); stroke-width: 1.5; opacity: 0.85; }
  .antenna { fill: var(--zc, var(--accent)); stroke: var(--ground); stroke-width: 2; }
  .marker circle { fill: var(--surface); stroke: var(--zc, var(--accent)); stroke-width: 1.4; }
  .marker text { fill: var(--zc, var(--accent)); font: 600 13px var(--display); }
  /* Gewählte Zone: die anderen treten zurück, die gewählte bekommt die laufende Kontur. Gedämpft wird nur die Farbe,
     nicht die Unterlage (.under), sonst schimmern die äußeren Zonen durch die inneren. */
  .is-live :is(.zone > *, .marker) { transition: opacity var(--dur-glide) var(--ease-default), stroke-width var(--dur-color) var(--ease-default); }
