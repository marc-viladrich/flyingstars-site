---
import Styles from '../Styles.astro';
import ownerStyle0 from '../MediaCard.css?url';
import { localizedCollection } from '../../i18n/content';
import { forPath } from '../../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
import { localeFromPath } from '../../i18n/routing.mjs';
const locale = localeFromPath(Astro.url.pathname);
import type { Section } from '../../content.config';
import Accent from '../Accent.astro';
import SectionHead from '../SectionHead.astro';
import ProjectCard from '../projects/ProjectCard.astro';
import { sortProjects } from '../projects/refs';
type Props = Extract<Section, { type: 'projectGrid' }> & { index: number };
const { headline = t('projectgrid.aFewNightsWeWonTForget'), text, cta, limit, id: ownId, index, kicker } = Astro.props;
const home = ['/', '/en/', '/nl/'].includes(Astro.url.pathname);
const sectionId = ownId ?? (home ? 'projekte' : undefined);
const id = sectionId ? `${sectionId}-h` : index === 0 ? 'projekte-h' : `s${index}-h`;
const H = index === 0 ? 'h1' : 'h2';
// Startseite ohne eigenes cta: Link auf alle Referenzen wie im Prototyp
const more = cta ?? (home ? { label: t('projectgrid.allOurWork'), href: '/referenzen/' } : undefined);
const projects = sortProjects(await localizedCollection('projects', locale, p => !p.data.draft)).slice(0, limit);
---
<Styles href={ownerStyle0} id="components/MediaCard.css" />
<section class="section" id={sectionId} aria-labelledby={id}>
  <SectionHead kicker={kicker} headline={headline} text={text} id={id} level={H} />
  <div class="projects">{projects.map((project, i) => <ProjectCard project={project} i={i} level={index === 0 ? 'h2' : 'h3'} autoplay={i === 0} />)}</div>
  {more && <div class="more"><a class="link" href={localHref(more.href)}>{more.label} <span aria-hidden="true">→</span></a></div>}
</section>
