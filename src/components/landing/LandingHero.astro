---
import { forPath } from '../../i18n/server';
const { t, localHref } = forPath(Astro.url.pathname);
// Seitenkopf der Anlass-Landingpages (Marc, 31.10.2026: „in der Hero Section … so ein kleines Showreel, gerne in einer
// kleineren Variante, so ähnlich wie wir jetzt ein Hero-Bild haben“). Links Kicker, Headline, Satz, Aktionen und bis zu
// vier Eckdaten; rechts ein Bildrahmen mit stummem Loop. Startet erst, wenn der Rahmen im Bild ist: ab 701 px von selbst,
// auf dem Handy per Knopf (Datenvolumen). Hält an bei globaler Pause (html.motion-paused), reduzierter Bewegung,
// Datensparmodus und außerhalb des Bildes. Quelle nur aus src/lib/videos.ts, als kleine Vorschau über videoPath() auf derselben Origin.
import type { Section } from '../../content.config';
import Accent from '../Accent.astro';
import Icon from '../Icon.astro';
import { optimizedImage } from '../../lib/media';
import { videos, videoPath } from '../../lib/videos';
type Props = Extract<Section, { type: 'landingHero' }> & { index: number };
const { kicker, headline, text, cta, secondary, video, videoLabel = t('common.showreel'), poster, facts } = Astro.props;
const still = await optimizedImage(poster.src, 960);
const src = videoPath(videos[video], 'preview');
---
<section class="lh" aria-labelledby="hero-h">
  <div class="lh-copy">
    {kicker && <span class="kicker mono">{kicker}</span>}
    <h1 id="hero-h"><Accent text={headline} /></h1>
    <p class="lead">{text}</p>
    <div class="actions"><a class="btn primary" href={localHref(cta.href)}>{cta.label}</a>{secondary && <a class="btn" href={localHref(secondary.href)}>{secondary.label}</a>}</div>
    {facts.length > 0 && <dl class="lh-facts">{facts.map((f) => <div><dt class="mono">{f.label}</dt><dd>{f.value}</dd></div>)}</dl>}
  </div>
  <figure class="lh-media" data-lh-reel>
    <img src={still.src} width={still.width} height={still.height} alt={poster.alt} loading="eager" fetchpriority="high" decoding="async" />
    <video data-src={src} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
    <span class="lh-rec mono" aria-hidden="true">{videoLabel}</span>
    <span class="lh-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <button class="lh-toggle mono" type="button" data-lh-toggle aria-pressed="false" hidden>
      <Icon name="play" size={16} class="g i-play" /><Icon name="pause" size={16} class="g i-pause" />
      <span data-lh-label>{t('landinghero.playVideo')}</span>
    </button>
  </figure>
</section>

<script>
  import { t } from '../../i18n/ui.mjs';
  document.querySelectorAll<HTMLElement>('[data-lh-reel]').forEach((host) => {
    const v = host.querySelector('video')!;
    const btn = host.querySelector<HTMLButtonElement>('[data-lh-toggle]')!;
    const label = host.querySelector<HTMLElement>('[data-lh-label]')!;
    const root = document.documentElement;
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const paused = () => root.classList.contains('motion-paused');
    // Von selbst nur auf großen Bildschirmen und ohne Bewegungs- oder Datenspar-Wunsch; ein Klick überstimmt das.
    const auto = () => !matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(min-width: 701px)').matches && !conn?.saveData;
    let visible = false;
    let choice: boolean | null = null;
    const want = () => visible && !paused() && (choice ?? auto());
    const show = (on: boolean) => {
      btn.setAttribute('aria-pressed', String(on));
      label.textContent = on ? t('landinghero.pauseVideo') : t('landinghero.playVideo');
      btn.setAttribute('aria-label', label.textContent);
      host.classList.toggle('is-on', on);
      // einmal gelaufen: angehalten bleibt das Bild des Videos stehen, das Standbild kommt nicht zurück
      if (on) host.classList.add('has-played');
      host.classList.add('ready');
    };
    const sync = () => {
      if (want()) {
        if (!v.src) v.src = v.dataset.src!;
        v.play().then(() => show(true)).catch(() => show(false));
      } else { v.pause(); show(false); }
    };
    btn.hidden = false;
    btn.addEventListener('click', () => { choice = !host.classList.contains('is-on'); if (choice && paused()) choice = false; sync(); });
    // Klick irgendwo aufs Video schaltet wie der Knopf (Marc, 02.11.2026); der Knopf bleibt das Ziel für Tastatur und Screenreader
    host.addEventListener('click', (event) => { if (!btn.hidden && !btn.contains(event.target as Node)) btn.click(); });
    host.classList.add('can-toggle');
    v.addEventListener('error', () => { host.classList.remove('is-on', 'can-toggle'); btn.hidden = true; });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { threshold: 0.25 }).observe(host);
    new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('visibilitychange', () => { if (document.hidden) v.pause(); else sync(); });
  });
</script>

<style>
  .lh { position: relative; display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); gap: clamp(32px, 5vw, 80px); align-items: center; padding: clamp(36px, 6vw, 88px) var(--gutter) clamp(56px, 7vw, 112px); overflow: hidden; }
  /* ruhiges Leuchten hinter dem Rahmen, wie Restlicht einer Show */
  .lh::before { content: ""; position: absolute; right: -10%; top: 0; width: 70%; height: 100%; background: radial-gradient(closest-side, rgba(219, 100, 232, 0.12), rgba(51, 237, 242, 0.04) 60%, transparent); pointer-events: none; }
  .lh-copy { position: relative; display: grid; gap: 22px; justify-items: start; }
  .lh-copy .kicker { margin: 0 0 -10px; }
  .lh h1 { font-size: clamp(40px, 5.4vw, 80px); line-height: 1; letter-spacing: -0.035em; max-width: 16ch; }
  .lh .lead { max-width: 48ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .lh-facts { display: flex; flex-wrap: wrap; gap: 0; margin: 10px 0 0; padding-top: 22px; border-top: 1px solid var(--line); width: 100%; max-width: 40rem; }
  .lh-facts > div { display: grid; gap: 4px; padding-right: clamp(18px, 2.4vw, 32px); margin-right: clamp(18px, 2.4vw, 32px); border-right: 1px solid var(--line); }
  .lh-facts > div:last-child { border-right: 0; margin-right: 0; padding-right: 0; }
  .lh-facts dt { color: var(--faint); order: 2; }
  .lh-facts dd { margin: 0; font: 500 clamp(20px, 1.8vw, 26px)/1.1 var(--display); letter-spacing: -0.02em; color: var(--head); white-space: nowrap; }
  .lh-media { position: relative; margin: 0; aspect-ratio: 16 / 11; border-radius: var(--radius); overflow: hidden; background: #0a0908; box-shadow: 0 30px 80px -40px rgba(219, 100, 232, 0.35); }
  .lh-media img, .lh-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .lh-media video { opacity: 0; transition: opacity 0.8s ease; }
  .lh-media.is-on video, .lh-media.has-played video { opacity: 1; }
  .lh-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15, 13, 12, 0.45), transparent 26%, transparent 70%, rgba(15, 13, 12, 0.55)); pointer-events: none; }
  /* Rahmen wie im Startseiten-Hero (Vercel-Prototyp): Label und Knopf rasten innen in den Ecken ein, mittig auf Höhe des
     Schenkelendes und 14 px neben dem senkrechten Schenkel. --c-in: Abstand der Ecken vom Rand, --c-arm: Schenkellänge */
  .lh-media { --c-in: 12px; --c-arm: 18px; }
  .lh-rec { position: absolute; z-index: 2; left: calc(var(--c-in) + 14px); top: calc(var(--c-in) + var(--c-arm)); transform: translateY(-50%); line-height: 1; display: inline-flex; align-items: center; gap: 8px; color: var(--text); }
  .lh-rec::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--faint); transition: background 0.3s, box-shadow 0.3s; }
  .lh-media.is-on .lh-rec::before { background: #ff6f61; box-shadow: 0 0 10px #ff6f61; }
  .lh-corners i { position: absolute; z-index: 2; width: 18px; height: 18px; border: 0 solid rgba(246, 241, 232, 0.55); }
  .lh-corners i { width: var(--c-arm); height: var(--c-arm); }
  .lh-corners i:nth-child(1) { left: var(--c-in); top: var(--c-in); border-width: 1px 0 0 1px; }
  .lh-corners i:nth-child(2) { right: var(--c-in); top: var(--c-in); border-width: 1px 1px 0 0; }
  .lh-corners i:nth-child(3) { left: var(--c-in); bottom: var(--c-in); border-width: 0 0 1px 1px; }
  .lh-corners i:nth-child(4) { right: var(--c-in); bottom: var(--c-in); border-width: 0 1px 1px 0; }
  /* Knopf (Marc, 02.11.2026): läuft das Video, sitzt „Video anhalten“ unten rechts in der Ecke. Angehalten (oder noch nicht
     gestartet) wandert er weich in die Mitte, verliert die Beschriftung und wird zum großen Play-Knopf; das Bild des
     Videos bleibt stehen. Lage über left/top/transform, damit sich die Bewegung überblenden lässt. */
  .lh-toggle { position: absolute; z-index: 3; left: calc(100% - var(--c-in) - 14px); top: calc(100% - var(--c-in) - var(--c-arm)); transform: translate(-100%, -50%); display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 36px; min-width: 36px; padding: 0 14px 0 10px; border-radius: 999px; border: 1px solid rgba(246, 241, 232, 0.3); background: rgba(15, 13, 12, 0.66); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); color: var(--text); cursor: pointer; opacity: 0; transition: left 0.55s cubic-bezier(0.3, 0.9, 0.3, 1), top 0.55s cubic-bezier(0.3, 0.9, 0.3, 1), transform 0.55s cubic-bezier(0.3, 0.9, 0.3, 1), height 0.45s ease, min-width 0.45s ease, padding 0.45s ease, gap 0.45s ease, background-color 0.3s ease, border-color 0.3s ease, opacity 0.3s ease; }
  .lh-media.ready .lh-toggle { opacity: 1; }
  .lh-toggle [data-lh-label] { display: inline-block; max-width: 14em; overflow: hidden; white-space: nowrap; transition: max-width 0.45s ease, opacity 0.25s ease; }
  .lh-media:not(.is-on) .lh-toggle { left: 50%; top: 50%; transform: translate(-50%, -50%); height: 76px; min-width: 76px; padding: 0; gap: 0; background: rgba(15, 13, 12, 0.55); border-color: rgba(246, 241, 232, 0.5); }
  .lh-media:not(.is-on) .lh-toggle [data-lh-label] { max-width: 0; opacity: 0; }
  .lh-media:not(.is-on) .lh-toggle :global(.ico) { width: 30px; height: 30px; margin-left: 4px; }
  .lh-media:not(.is-on):hover .lh-toggle { background: rgba(15, 13, 12, 0.75); border-color: var(--text); }
  @media (prefers-reduced-motion: reduce) { .lh-toggle, .lh-toggle [data-lh-label] { transition: none; } }
  .lh-media.can-toggle { cursor: pointer; }
  .lh-toggle:hover, .lh-media.can-toggle:hover .lh-toggle { border-color: rgba(246, 241, 232, 0.6); }
  .lh-toggle:focus-visible { outline: 3px solid var(--cyan); outline-offset: 3px; }
  .lh-toggle :global(.ico) { width: 16px; height: 16px; flex: 0 0 auto; transition: width 0.45s ease, height 0.45s ease, margin 0.45s ease; }
  .lh-toggle :global(.i-pause) { display: none; }
  .lh-media.is-on :global(.i-play) { display: none; }
  .lh-media.is-on :global(.i-pause) { display: inline; }
  @media (max-width: 900px) {
    .lh { grid-template-columns: 1fr; }
    .lh::before { width: 120%; right: -40%; top: 40%; height: 60%; }
    .lh-media { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 600px) {
    /* Handy: Eckdaten als gleich breite Spalten, damit nichts einzeln umbricht */
    .lh-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); }
    .lh-facts > div { padding-right: 10px; margin-right: 10px; }
    .lh-facts dd { font-size: 17px; white-space: normal; }
  }
</style>
