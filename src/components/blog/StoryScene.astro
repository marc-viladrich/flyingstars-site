---
// Scroll-Geschichte im Blogartikel (Labor, Runde 15). Prototyp 2 (Marc, 21.11.2026 abends): einspaltig wie ein normaler
// Blogpost. Die Szene klebt oben über die Breite des Artikels, der Text läuft darunter; die Szene bleibt an derselben Stelle
// und erzählt Schritt für Schritt weiter. Jeder Schritt hat einen eigenen Bildausschnitt, die Kamera fährt weich dorthin.
// Übergänge nur über transform und opacity. Schleifen (Abspielkopf, Wind, die leise Eigenbewegung der Drohnen) laufen nur,
// solange ihr Schritt aktiv und die Bühne sichtbar ist, und halten bei der globalen Pause (Kopfzeile) und reduzierter Bewegung.
// SEO und Barrierefreiheit (27-blog-bilder-2026-11-21/seo-interaktive-grafiken.md): Der Text steht vollständig im HTML,
// die Szene ist Inline-SVG mit dem Endzustand im HTML (Live-Show, ohne JavaScript sichtbar), die Bühne hat eine feste Höhe
// aus CSS, reduzierte Bewegung zeigt jeden Schritt ohne Übergang und ohne Schleife.
// Übertragbar: Die Komponente kennt nur Schritte, Teile, Drohnen, Annotationen und Ausschnitte. Eine andere Szene (Story)
// und andere Textblöcke genügen für einen anderen Cornerstone-Artikel.
import Icon from '../Icon.astro';
import { storyScene, pathD, frameCam, type Piece } from './story-scene';
interface Block { html: string; step?: number; title?: string; group?: string }
interface Props { blocks: Block[]; caption: string; label: string; groups: { name: string; short: string }[] }
const { blocks, caption, label, groups } = Astro.props;
const colors = ['#ff9e29', '#f58a5a', '#ec7f95', '#db64e8', '#b88bec', '#8aa9ee', '#6fc8ef', '#33edf2'];
// Farben wie die Zonen der Standortzeichnung (LandingSite.astro), je Baustein eine
const zone = { drone: '#ff9e29', software: '#c49bf2', sim: '#6fdc98', field: '#e8dccb', station: '#6aa8ff', idea: '#db64e8', warn: '#f5b43c', crowd: '#c49bf2' };
const story = storyScene({ colors, zone });
const LAST = story.steps - 1;
// Zeichenfläche im HTML (ohne JavaScript): eine breite Bühne; das Skript setzt die echte Größe
const VW = 1000, VH = 470;
const cam = frameCam(story.frames[LAST], VW, VH);
const stateOf = (p: Piece, s: number) => {
  if (p.steps.includes(s)) return { t: `translate(0px, ${p.shift?.[s] ?? 0}px)`, o: p.dim?.includes(s) ? 0.32 : 1 };
  const h = (s > Math.max(...p.steps) && p.after) || p.hide || { s: [0.04, 0.04] as [number, number] };
  return { t: `translate(0px, ${h.dy ?? 0}px) scale(${h.s[0]}, ${h.s[1]})`, o: 0 };
};
const steps = blocks.filter((b) => b.step !== undefined);
const head = blocks[0]?.step === undefined ? blocks[0] : undefined;
const body = head ? blocks.slice(1) : blocks;
// Ein Zwischentitel ohne eigenen Schritt (neuer Abschnitt) gehört zum nächsten Schritt
const stepAfter = (i: number) => body.slice(i).find((b) => b.step !== undefined)?.step ?? LAST;
const drawn = (cls: string) => cls === 'stream' || cls === 'stream-base' || cls === 'path';
const noteStyle = (n: { x: number; y: number; row?: number }) => `--x: ${((n.x * cam.k + cam.tx) / VW * 100).toFixed(2)}%; --y: ${((n.y * cam.k + cam.ty) / VH * 100).toFixed(2)}%; --row: ${n.row ?? 0}`;
---
<section class="ss" aria-label={label} data-ss>
  {head && <div class="ss-head post-body" set:html={head.html} />}
  <figure class="ss-fig">
    <div class="ss-stage" data-stage data-step={LAST} data-frames={JSON.stringify(story.frames)} data-wind={story.wind.join(' ')} data-sweep={story.sweep.flat().join(' ')}>
      <svg viewBox={`0 0 ${VW} ${VH}`} role="img" aria-label={caption}>
        <g class="cam" data-cam style={`transform: translate(${cam.tx}px, ${cam.ty}px) scale(${cam.k})`}>
          {story.pieces.map((p, li) => { const st = stateOf(p, LAST); return <g class="pc" data-key={p.key} data-steps={p.steps.join(' ')} data-dim={p.dim?.join(' ')} data-shift={p.shift ? JSON.stringify(p.shift) : undefined} data-asm={p.asm} data-hide={p.hide ? `${p.hide.s.join(' ')} ${p.hide.dy ?? 0}` : undefined} data-after={p.after ? `${p.after.s.join(' ')} ${p.after.dy ?? 0}` : undefined} aria-hidden="true" style={`--zc: ${p.zc}; --li: ${li}; transform-origin: ${p.origin[0]}px ${p.origin[1]}px; transform: ${st.t}; opacity: ${st.o}`}>
            {p.shapes.map((s) => s.t === 'circle' ? <circle class={s.cls} cx={s.c[0]} cy={s.c[1]} r={s.r} /> : <path class={s.cls} d={pathD(s)} pathLength={drawn(s.cls) ? 1 : undefined} />)}
          </g>; })}
          <g class="ss-drones" aria-hidden="true">
            {story.drones.map((d) => { const [x, y, a] = d.pos[LAST]; return <g class="sd" data-pos={d.pos.map((q) => q.join(',')).join(';')} data-w={d.w} style={`--c: ${d.c}; --k: ${d.k}; transform: translate(${x}px, ${y}px); opacity: ${a}`}><g class="sw"><circle class="halo" r="4.2" /><circle class="core" r="1.7" /></g></g>; })}
          </g>
        </g>
      </svg>
      {story.notes.map((n) => <span class:list={['sn', `sn-${n.side}`, { on: n.steps.includes(LAST), 'sn-check': n.check, 'sn-list': n.row !== undefined }]} data-steps={n.steps.join(' ')} data-target={n.target} data-x={n.x} data-y={n.y} style={noteStyle(n)} aria-hidden="true"><i class="sn-dot"></i><span class="sn-pill">{n.check && <Icon name="check" size={13} />}{n.text}</span></span>)}
    </div>
    <div class="ss-bar">
      <p class="ss-now" aria-hidden="true"><span class="ss-num mono" data-num>{String(steps.filter((b) => b.group === steps.at(-1)?.group).length).padStart(2, '0')}</span><span data-now>{steps.at(-1)?.title}</span></p>
      <div class="ss-track">
        {groups.map((g) => { const own = steps.filter((b) => b.group === g.name); return <div class:list={['ss-grp', { on: own.some((b) => b.step === LAST) }]} data-grp={g.name}>
          <span class="ss-glab">{g.short}</span>
          <ol aria-label={g.name}>{own.map((b, i) => <li><button type="button" data-goto={b.step} data-n={i + 1} data-title={b.title} aria-label={`${g.name}, ${i + 1}: ${b.title}`} aria-current={b.step === LAST ? 'step' : undefined} class:list={{ done: (b.step ?? 0) < LAST }}><span class="ss-seg"></span></button></li>)}</ol>
        </div>; })}
      </div>
    </div>
    <figcaption class="sr-only">{caption}</figcaption>
  </figure>
  <div class="ss-text post-body">
    {body.map((b, i) => b.step === undefined
      ? <div class="ss-chapter" data-step={stepAfter(i)} set:html={b.html} />
      : <div class="ss-step" data-step={b.step} set:html={b.html} />)}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-ss]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const svg = stage.querySelector('svg')!;
    const camG = stage.querySelector<SVGGElement>('[data-cam]')!;
    const pieces = [...stage.querySelectorAll<SVGGElement>('.pc')];
    const notes = [...stage.querySelectorAll<HTMLElement>('.sn')];
    const marks = [...root.querySelectorAll<HTMLElement>('.ss-text > [data-step]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-goto]')];
    const grps = [...root.querySelectorAll<HTMLElement>('[data-grp]')];
    const now = root.querySelector<HTMLElement>('[data-now]'), num = root.querySelector<HTMLElement>('[data-num]');
    const frames = JSON.parse(stage.dataset.frames!) as [number, number, number, number][];
    const [wx, wy] = stage.dataset.wind!.split(' ').map(Number);
    const sweep = stage.dataset.sweep!.split(' ').map(Number);
    const nums = (v?: string) => (v ? v.split(' ').map(Number) : []);
    const P = pieces.map((el) => ({
      el, steps: nums(el.dataset.steps), dim: nums(el.dataset.dim),
      shift: el.dataset.shift ? (JSON.parse(el.dataset.shift) as Record<string, number>) : {},
      hide: nums(el.dataset.hide), after: nums(el.dataset.after), asm: el.dataset.asm === undefined ? null : Number(el.dataset.asm),
    }));
    const D = [...stage.querySelectorAll<SVGGElement>('.sd')].map((el, i) => ({
      el, sw: el.querySelector<SVGGElement>('.sw')!, w: Number(el.dataset.w), ph: i * 1.7, g: 0.7 + ((i * 7919) % 13) / 20,
      pos: el.dataset.pos!.split(';').map((q) => q.split(',').map(Number)),
    }));
    const N = notes.map((el) => ({ el, steps: nums(el.dataset.steps), x: Number(el.dataset.x), y: Number(el.dataset.y) }));
    const streams = [...stage.querySelectorAll<SVGPathElement>('.stream')];
    const playhead = stage.querySelector<SVGPathElement>('.playhead');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const held = () => reduce.matches || document.documentElement.classList.contains('motion-paused');

    // Schleifen laufen nur in diesen Schritten; T: Länge einer Böe in Sekunden
    const ALIVE = new Set([2, 5, 6, 8]), LOOP = new Set([1, 2, 5, 6, 8]);
    const T = 3.6; // Länge einer Böe in Sekunden

    // ---------- Kamera ----------
    let W = 1000, H = 470, step = -1, exploded = true, boom = 0, visible = false, frame = 0, t0 = 0;
    const camOf = (s: number) => { const [x, y, w, h] = frames[s], k = Math.min(W / w, H / h); return { k, tx: W / 2 - (x + w / 2) * k, ty: H / 2 - (y + h / 2) * k }; };
    const place = () => {
      const c = camOf(Math.max(0, step));
      camG.style.transform = `translate(${c.tx}px, ${c.ty}px) scale(${c.k})`;
      N.forEach((n) => { n.el.style.setProperty('--x', `${((n.x * c.k + c.tx) / W) * 100}%`); n.el.style.setProperty('--y', `${((n.y * c.k + c.ty) / H) * 100}%`); });
    };
    const measure = () => { const r = stage.getBoundingClientRect(); W = Math.max(1, r.width); H = Math.max(1, r.height); svg.setAttribute('viewBox', `0 0 ${W} ${H}`); };

    // ---------- Schritt ----------
    const pose = (p: (typeof P)[number], s: number) => {
      if (p.steps.includes(s)) {
        const dy = s === 0 && !exploded && p.asm !== null ? p.asm : p.shift[s] ?? 0;
        return { t: `translate(0px, ${dy}px)`, o: p.dim.includes(s) ? 0.32 : s === 0 && !exploded && p.el.dataset.key === 'drone-axis' ? 0 : 1 };
      }
      const h = s > Math.max(...p.steps) && p.after.length ? p.after : p.hide.length ? p.hide : [0.04, 0.04, 0];
      return { t: `translate(0px, ${h[2] ?? 0}px) scale(${h[0]}, ${h[1]})`, o: 0 };
    };
    const paint = (prev: number) => {
      P.forEach((p) => {
        const on = p.steps.includes(step), was = p.steps.includes(prev);
        p.el.style.transitionDelay = on && !was ? 'var(--ss-enter)' : '0s'; // was kommt, wartet, bis das Gehende kleiner ist
        const { t, o } = pose(p, step); p.el.style.transform = t; p.el.style.opacity = String(o);
      });
      N.forEach((n) => n.el.classList.toggle('on', n.steps.includes(step) && (step !== 0 || exploded)));
      fitLater();
    };
    // Die Explosion startet erst, wenn die Bühne im Blick ist
    const arm = (ms: number) => {
      clearTimeout(boom);
      if (step === 0 && !exploded && visible) boom = window.setTimeout(() => { if (step === 0) { exploded = true; paint(0); } }, ms);
    };
    const set = (s: number) => {
      if (s === step) return;
      const prev = step; step = s;
      stage.dataset.step = String(s);
      // Erst die zusammengesetzte Drohne, dann die Explosion (Marc: „damit man beides verknüpft“)
      exploded = s !== 0 || held();
      paint(prev);
      arm(prev === -1 ? 900 : 1500);
      D.forEach((d) => { const [x, y, a] = d.pos[s]; d.el.style.transform = `translate(${x}px, ${y}px)`; d.el.style.opacity = String(a); });
      place();
      dots.forEach((d) => { const n = Number(d.dataset.goto); if (n === s) d.setAttribute('aria-current', 'step'); else d.removeAttribute('aria-current'); d.classList.toggle('done', n < s); });
      const cur = dots.find((d) => Number(d.dataset.goto) === s);
      grps.forEach((g) => g.classList.toggle('on', !!cur && g.contains(cur)));
      if (cur && now) now.textContent = cur.dataset.title ?? '';
      if (cur && num) num.textContent = String(cur.dataset.n).padStart(2, '0');
      run();
    };

    // ---------- Auslöser: der Textblock, dessen Anfang die Leselinie unter der Bühne überschritten hat ----------
    const pick = () => {
      const line = stage.getBoundingClientRect().bottom + (innerHeight - stage.getBoundingClientRect().bottom) * 0.32;
      let s = Number(marks[0]?.dataset.step ?? 0);
      for (const m of marks) if (m.getBoundingClientRect().top < line) s = Number(m.dataset.step);
      set(s);
    };
    let ticking = false;
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; pick(); }); } }, { passive: true });

    // ---------- Annotationen, die über den Bildschirm ragen würden, stehen auf der anderen Seite ----------
    const fit = () => notes.forEach((n) => {
      n.classList.remove('sn-flip');
      const r = n.querySelector('.sn-pill')!.getBoundingClientRect();
      if (r.right > document.documentElement.clientWidth - 8 || r.left < 8) n.classList.add('sn-flip');
    });
    let fitLater = () => {};
    const relayout = () => { stage.classList.add('is-reset'); measure(); place(); void stage.getBoundingClientRect(); stage.classList.remove('is-reset'); requestAnimationFrame(fit); };

    // Anfangszustand ohne Übergang (im HTML steht der Endzustand für Suche, Vorschau und ohne JavaScript)
    stage.classList.add('is-reset');
    measure(); pick(); if (step < 0) set(0);
    void stage.getBoundingClientRect();
    stage.classList.remove('is-reset');
    fitLater = () => requestAnimationFrame(() => setTimeout(fit, 30));
    fit();
    if ('ResizeObserver' in window) new ResizeObserver(relayout).observe(stage); else addEventListener('resize', relayout);
    dots.forEach((d) => d.addEventListener('click', () => {
      const m = marks.find((el) => el.dataset.step === d.dataset.goto && el.classList.contains('ss-step'));
      if (!m) return;
      const line = stage.getBoundingClientRect().bottom + (innerHeight - stage.getBoundingClientRect().bottom) * 0.32;
      scrollTo({ top: scrollY + m.getBoundingClientRect().top - line + 24, behavior: held() ? 'auto' : 'smooth' });
    }));
    notes.forEach((n) => {
      const hit = () => pieces.filter((p) => p.dataset.key === n.dataset.target);
      n.addEventListener('pointerenter', () => { if (n.classList.contains('on')) { stage.classList.add('has-hl'); hit().forEach((p) => p.classList.add('hl')); } });
      n.addEventListener('pointerleave', () => { stage.classList.remove('has-hl'); hit().forEach((p) => p.classList.remove('hl')); });
    });

    // ---------- Schleifen: Abspielkopf (Software), Wind und Böen (Simulation), leise Eigenbewegung des Sterns ----------
    function still() {
      D.forEach((d) => { d.sw.style.transform = ''; });
      streams.forEach((p) => { p.style.strokeDasharray = ''; p.style.strokeDashoffset = ''; });
      if (playhead) playhead.style.transform = '';
    }
    function loop(ms: number) {
      frame = 0;
      if (!visible || held() || document.hidden || !LOOP.has(step)) { still(); return; }
      if (!t0) t0 = ms;
      const t = (ms - t0) / 1000;
      if (step === 1 && playhead) {
        const u = (Math.sin(t * 0.55 - Math.PI / 2) + 1) / 2;
        playhead.style.transform = `translate(${sweep[0] + (sweep[2] - sweep[0]) * u}px, ${sweep[1] + (sweep[3] - sweep[1]) * u}px)`;
      }
      if (step === 2) streams.forEach((p, i) => {
        // jede Linie zeichnet sich von Luv nach Lee und läuft dann aus; leicht versetzt
        const q = ((t + 0.11 * ((i * 5) % 8)) / T) % 1, head = Math.min(1, q / 0.62), tail = Math.max(0, Math.min(1, (q - 0.34) / 0.62));
        p.style.strokeDasharray = `${Math.max(0.0001, head - tail)} 2`; p.style.strokeDashoffset = String(-tail);
      });
      if (ALIVE.has(step)) {
        const amp = step === 2 ? 1 : 0.6, sx = Math.sin(t * 0.45) * 1.4 * amp, sy = Math.sin(t * 0.6 + 1) * 0.9 * amp;
        D.forEach((d) => {
          let x = sx + Math.sin(t * 1.1 + d.ph) * 0.8 * amp, y = sy + Math.cos(t * 0.9 + d.ph * 1.3) * 0.8 * amp;
          if (step === 2) {
            // Böe: trifft die Drohne, wenn die Windlinie ihre Lage erreicht; sie gibt nach und fängt sich wieder
            let tau = (((t / T) % 1) - d.w * 0.62) * T; if (tau < 0) tau += T;
            const push = 4.2 * d.g * 8.15 * tau * Math.exp(-3 * tau) * Math.cos(tau * 1.6);
            x += wx * push - wy * push * 0.25 * Math.sin(d.ph); y += wy * push + wx * push * 0.25 * Math.sin(d.ph);
          }
          d.sw.style.transform = `translate(${x.toFixed(2)}px, ${y.toFixed(2)}px)`;
        });
      } else D.forEach((d) => { d.sw.style.transform = ''; });
      frame = requestAnimationFrame(loop);
    }
    function run() { if (!frame && visible && !held() && !document.hidden && LOOP.has(step)) frame = requestAnimationFrame(loop); else if (!LOOP.has(step) || held()) still(); }
    new IntersectionObserver((es) => { visible = es[es.length - 1].isIntersecting; arm(700); run(); }, { threshold: 0.35 }).observe(stage);
    document.addEventListener('flyingstars:motion-change', () => { if (held()) { exploded = true; if (step === 0) paint(0); } run(); });
    document.addEventListener('visibilitychange', run);
  });
</script>

<style>
  .ss { --ss-enter: 0.38s; --ss-stage-h: clamp(15rem, 56svh - 3rem, 36rem); width: 100%; max-width: min(64rem, 100%); display: grid; justify-items: center; margin-block: clamp(var(--space-10), 5vw, var(--space-16)) 0; }
  .ss-head, .ss-text { width: 100%; max-width: var(--measure, 42rem); }
  /* Der Schritttitel in der Leiste darf die Spalte des Artikels nicht weiten (nowrap, Auslassung) */
  .ss, .ss-fig, .ss-bar, .ss-now { min-width: 0; }
  .ss-fig { width: 100%; }
  .ss-head :global(h2) { margin-top: 0; }
  .ss-head { margin-bottom: var(--space-6); }

  /* Bühne: klebt unter dem Kopf über die Breite des Artikels; der Text läuft darunter durch */
  .ss-fig { position: sticky; top: var(--nav-h); z-index: 3; width: 100%; margin: 0; padding-block: var(--space-3) 0; background: var(--ground); box-shadow: 0 0 0 100vmax var(--ground); clip-path: inset(0 -100vmax 0 -100vmax); }
  .ss-fig::after { content: ""; position: absolute; left: 0; right: 0; top: 100%; height: var(--space-8); background: linear-gradient(var(--ground), transparent); pointer-events: none; }
  .ss-stage { position: relative; width: 100%; height: var(--ss-stage-h); }
  /* Die Zeichnung endet weich an den Rändern der Bühne (Boden und Feld dürfen hinauslaufen) */
  .ss-stage svg { width: 100%; height: 100%; display: block; overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 4%, #000 86%, transparent), linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 4%, #000 86%, transparent), linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-composite: source-in; mask-composite: intersect; }
  .cam { transform-origin: 0 0; transition: transform 1.15s var(--ease-scene); }

  /* Teile: weich wachsen und schrumpfen, nur transform und opacity */
  .pc { transform-box: view-box; transition: transform 1.05s var(--ease-scene), opacity 0.7s var(--ease-out); }
  .sd { transition: transform 1.25s var(--ease-scene) calc(var(--k) * 22ms), opacity 0.6s var(--ease-out) calc(var(--k) * 22ms); }
  .is-reset, .is-reset * { transition: none !important; }

  /* Zeichnung: Vokabular der Standortzeichnung (Startseite), etwas gröber und ruhiger */
  .slab { fill: rgb(var(--rgb-head) / 3%); stroke: rgb(var(--rgb-head) / 12%); stroke-width: 0.6; }
  .slab-side { fill: rgb(var(--rgb-head) / 6%); stroke: rgb(var(--rgb-head) / 10%); stroke-width: 0.5; }
  .floor-line { fill: none; stroke: rgb(var(--rgb-head) / 4%); stroke-width: 0.5; }
  .zplate { fill: color-mix(in srgb, var(--zc) 16%, var(--ground)); stroke: color-mix(in srgb, var(--zc) 75%, transparent); stroke-width: 0.9; }
  .zplate-side, .zplate-edge { fill: color-mix(in srgb, var(--zc) 30%, var(--ground)); stroke: color-mix(in srgb, var(--zc) 55%, transparent); stroke-width: 0.5; }
  .part { fill: color-mix(in srgb, var(--zc) 16%, var(--ground)); stroke: color-mix(in srgb, var(--zc) 80%, transparent); stroke-width: 0.8; }
  .part-side { fill: color-mix(in srgb, var(--zc) 34%, var(--ground)); stroke: color-mix(in srgb, var(--zc) 60%, transparent); stroke-width: 0.5; }
  .chip { fill: color-mix(in srgb, var(--zc) 45%, var(--ground)); }
  .trace { fill: none; stroke: color-mix(in srgb, var(--zc) 40%, transparent); stroke-width: 0.6; }
  .rotor { fill: color-mix(in srgb, var(--zc) 8%, transparent); stroke: color-mix(in srgb, var(--zc) 50%, transparent); stroke-width: 0.6; }
  .arm { fill: none; stroke: color-mix(in srgb, var(--zc) 80%, transparent); stroke-width: 2; stroke-linecap: round; }
  .hub { fill: var(--ground); stroke: var(--zc); stroke-width: 0.8; }
  .led-base { fill: color-mix(in srgb, var(--zc) 22%, var(--ground)); stroke: var(--zc); stroke-width: 0.8; }
  .led-glow { fill: var(--zc); opacity: 0.16; }
  .led-core { fill: #fff3df; }
  .bar { stroke: none; }
  .bar-0 { fill: #ff9e29; } .bar-1 { fill: #f58a5a; } .bar-2 { fill: #ec7f95; } .bar-3 { fill: #db64e8; } .bar-4 { fill: #b88bec; } .bar-5 { fill: #8aa9ee; } .bar-6 { fill: #6fc8ef; } .bar-7 { fill: #33edf2; }
  .track { fill: none; stroke: color-mix(in srgb, var(--zc) 40%, transparent); stroke-width: 0.6; }
  .tick { fill: none; stroke: color-mix(in srgb, var(--zc) 14%, transparent); stroke-width: 0.5; }
  .playhead { fill: none; stroke: var(--accent); stroke-width: 1.2; }
  .route { fill: none; stroke: color-mix(in srgb, var(--zc) 70%, transparent); stroke-width: 0.7; }
  .guide { fill: none; stroke: rgb(var(--rgb-head) / 20%); stroke-width: 0.6; stroke-dasharray: 1.5 3.5; }
