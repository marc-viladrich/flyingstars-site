---
import SectionHead from '../SectionHead.astro';
import FactList from '../FactList.astro';
import { localizedCollection } from '../../i18n/content';
import { forPath } from '../../i18n/server';
const { t, localHref, formatLocale } = forPath(Astro.url.pathname);
import { localeFromPath } from '../../i18n/routing.mjs';
const locale = localeFromPath(Astro.url.pathname);
import type { CollectionEntry } from 'astro:content';
import { videoPath } from '../../lib/videos';
import CtaBox from '../CtaBox.astro';
import { optimizedImage } from '../../lib/media';

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const data = project.data.showcase;
if (!data) throw new Error(`Project ${project.id} has no showcase content`);
const available = (await localizedCollection('projects', locale, p => !p.data.draft && Boolean(p.data.showcase)))
  .sort((a, b) => a.data.showcase!.order - b.data.showcase!.order);
// A deliberately hidden case also disappears from related-project navigation.
const next = available.find((p) => p.data.showcase!.route === data.nextRoute)
  ?? available.find((p) => p.id !== project.id);
const nextData = next?.data.showcase;
const uniqueImages = [...new Set([...data.story.map((s) => s.image.src), ...data.gallery.map((p) => p.src)])];
const images = new Map(await Promise.all(uniqueImages.map(async (src) => [src, await optimizedImage(src)] as const)));
const nextImage = next?.data.cover ? await optimizedImage(next.data.cover.src) : undefined;
const still = project.data.cover ? await optimizedImage(project.data.cover.src, 960) : undefined;
const count = (n: number) => String(n).padStart(2, '0');
---
<div class="case" style={`--accent:${data.accent}`}>
  <!-- Kopf wie auf der Startseite (Marc, 01.11.2026): Showvideo rechts, stumm im Loop, nach links ins Schwarz ausgeblendet;
       kein Abspielknopf. Bis das Video läuft (und auf dem Handy), steht das Titelbild. Skript: src/scripts/hero-reel.ts -->
  <section class="c-hero" aria-labelledby="case-h" data-reel-host>
    <div class="hero-media" aria-hidden="true">{still && <img src={still.src} width={still.width} height={still.height} alt="" loading="eager" fetchpriority="high" />}</div>
    {data.heroVideo && <video class="reel" data-reel data-src={videoPath(data.heroVideo)} data-src-small={videoPath(data.heroVideo, 'preview')} muted loop playsinline preload="none" poster={still?.src} aria-hidden="true" tabindex="-1"></video>}
    <div class="shade" aria-hidden="true"></div>
    <div class="c-top mono">
      <nav class="crumbs" aria-label={t('casestudy.breadcrumbs')}><a href={localHref("/")}>{t('casestudy.home')}</a><span aria-hidden="true">/</span><a href={localHref("/referenzen/")}>{t('casestudy.ourWork')}</a><span aria-hidden="true">/</span><span aria-current="page">{data.name}</span></nav>
      <span class="idx">{t('casestudy.project')} {count(data.order)} / {count(available.length)}</span>
    </div>
    <div class="c-title">
      {data.kicker && <span class="c-kick mono">{data.kicker}</span>}
      <h1 id="case-h" class="c-h1"><span class="sr-only">{data.name}: </span><span class="c-name" style={`--chars:${data.titleChars}`} aria-hidden="true">{data.titleLines.map((line) => <span>{line}</span>)}</span><span class="c-tag">{data.tagline}</span></h1>
    </div>
    <FactList items={data.credits} variant="credits" />
  </section>

  <section aria-label={t('casestudy.inNumbers')}><FactList variant="numbers" items={data.numbers.map((n) => ({ label: n.label, value: n.value.toLocaleString(formatLocale), count: n.value }))} /></section>

  <section class="c-story" aria-label={t('casestudy.theStory')}>
    <div class="c-media" aria-hidden="true">
      {data.story.map((step, index) => <figure data-scene class:list={{ on: index === 0 }}><img src={images.get(step.image.src)!.src} {...images.get(step.image.src)!.attributes} width={images.get(step.image.src)!.width} height={images.get(step.image.src)!.height} alt="" loading="lazy" decoding="async" /></figure>)}
      <div class="meta mono"><span>{data.name}</span><span data-progress>01 / {count(data.story.length)}</span></div>
    </div>
    <div class="c-steps">
      {data.story.map((step, index) => <article class="c-step on" data-story-step>
        <figure class:list={{ tall: data.portrait }}><img src={images.get(step.image.src)!.src} {...images.get(step.image.src)!.attributes} width={images.get(step.image.src)!.width} height={images.get(step.image.src)!.height} alt={step.image.alt} loading="lazy" decoding="async" /></figure>
        <SectionHead variant="contents" kicker={step.kicker} kickerClass="k" headline={step.title} text={step.text} id={`story-${index}-h`} />
        {index === data.story.length - 1 && data.videoLink && <a class="link" href={data.videoLink.href}>{data.videoLink.label} <span aria-hidden="true">↗</span></a>}
      </article>)}
    </div>
  </section>

  {data.formation && <section class="c-play" aria-labelledby="play-h">
    <canvas data-formation={data.formation.src} aria-hidden="true"></canvas>
    <div class="c-play-copy">
      <SectionHead variant="contents" headline={data.formation.title} text={data.formation.text} id="play-h" />
      <div class="row"><button class="btn small" type="button" data-replay disabled>{t('casestudy.startAgain')}</button><button class="btn small" type="button" data-formation-pause aria-pressed="false">{t('casestudy.pauseAnimation')}</button><span class="tally mono" data-tally role="status"></span></div>
    </div>
  </section>}

  {data.gallery.length > 0 && <section class="c-reel" aria-labelledby="reel-h">
    <div class="c-reel-head"><SectionHead variant="contents" headline={`${t('casestudy.theShowIn')} ${data.gallery.length} ${t('casestudy.pictures')}`} id="reel-h" /><div class="ctrl"><button type="button" data-prev aria-label={t('showconfigurator.previousScene')}>←</button><button type="button" data-next aria-label={t('showconfigurator.nextScene')}>→</button></div></div>
    <div class:list={['c-track', { tall: data.portrait }]} tabindex="0" role="region" aria-label={t('case.gallery', { name: data.name })}>
      {data.gallery.map((picture, index) => <figure><div class="img"><img src={images.get(picture.src)!.src} {...images.get(picture.src)!.attributes} width={images.get(picture.src)!.width} height={images.get(picture.src)!.height} alt={picture.alt} loading="lazy" decoding="async" draggable="false" /></div><figcaption class="mono"><b>{count(index + 1)}</b>{picture.caption}</figcaption></figure>)}
    </div>
  </section>}

  <section class="c-setlist" aria-labelledby="set-h"><SectionHead variant="contents" headline={t('casestudy.whatAppearedInTheSky')} id="set-h" /><div class="groups">{data.setlist.map((group) => <div><h3>{group.title}</h3><ol>{group.items.map((item) => <li>{item}</li>)}</ol></div>)}</div></section>
  {data.press.length > 0 && <section class="c-press" aria-label={t('casestudy.press')}>{data.press.map((clip) => <article class="clip"><div class="mast">{clip.publication}<span>{clip.date}</span></div><b>{clip.title}</b><p>{clip.text}</p></article>)}</section>}

  {nextData && nextImage && <a class="c-next" href={localHref(`/${nextData.route}/`)} data-dot-img data-step="10">
    <img class="next-poster" src={nextImage.src} {...nextImage.attributes} width={nextImage.width} height={nextImage.height} alt="" loading="lazy" decoding="async" />
    <div class="shade" aria-hidden="true"></div><div class="in"><span class="k mono">{t('casestudy.nextProject')} {count(nextData.order)} / {count(available.length)} · {nextData.drones} {t('configuratorteaser.drones')}</span><b style={`--chars:${Math.max(...nextData.name.split(/\s+/).map((word) => word.length))}`}>{nextData.name} <i aria-hidden="true">→</i></b></div>
  </a>}
  <section class="section" aria-labelledby="cta-h"><CtaBox headline={data.cta.title} text={data.cta.text} button={{ label: t('chopper404.requestAShow'), href: '/#anfrage' }} id="cta-h" /></section>
</div>
<script>import './case.js';</script>
<script>import '../../scripts/hero-reel';</script>
<style>

  /* Teaser aufs nächste Projekt: beim Hovern Lichtpunkte statt Foto-Zoom (dotimage.js), Abdunklung bleibt darüber */
  .next-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.75; }
  .c-next :global(.dot-cv) { opacity: 0.85; }

</style>
