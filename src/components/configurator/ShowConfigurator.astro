---
// Show-Konfigurator als einbettbare Komponente (sechzehnte Fassung, Marc 31.10.2026: „Auf der Preisseite sollte der
// Konfigurator auf jeden Fall direkt angezeigt werden“). Vorher war er die eigene Seite /show-konfigurator/ (jetzt eine
// Weiterleitung auf /drohnenshow-preise/#konfigurator). Die Komponente rendert ihre eigene <section> im normalen
// Seitenfluss und richtet den Inhalt an der globalen Inhaltsbreite aus (--gutter, Rückfall --pad).
// Zwei Entscheidungen: Anlass (eine Folge von Motiven, die wie eine kleine Show läuft) und Aufwand (Paket und
// Drohnenzahl, die einzigen Preistreiber). Die inneren IDs bleiben cfg-*: Der Konfigurator steht höchstens einmal auf
// einer Seite (der Teaser für die Startseite nutzt eigene IDs, ConfiguratorTeaser.astro).
// Direktlinks lesen Query-Parameter: /drohnenshow-preise/?anlass=launch&paket=ODYSSEY&drohnen=450&motiv=mond#konfigurator
import { OCCASIONS, STEPS } from '../../content/show-configurator.js';
import { SHOW_PACKAGES, DRONE_RANGES, DRONES_MIN, DRONES_MAX, DRONE_STEP } from '../../content/show-packages';

interface Props {
  /** Anker der Section (Sprungziel, z. B. /drohnenshow-preise/#konfigurator) */
  id?: string;
  /** Ebene der Überschrift: 1 auf einer eigenen Seite, 2 eingebettet */
  headingLevel?: 1 | 2;
  /** Text der Überschrift */
  heading?: string;
}
const { id = 'konfigurator', headingLevel = 2, heading = 'Was soll am Himmel passieren?' } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';

const list = OCCASIONS;
const start = 1;
const money = (v: number) => `ab ${v.toLocaleString('de-DE')} €`;
const startPkg = STEPS[start].pkg as keyof typeof SHOW_PACKAGES;
const first = SHOW_PACKAGES[startPkg];
const firstCaption = list[0].motifs[0].tiers[startPkg]?.caption ?? '';
// Drohnenregler (zwölfte Fassung): die Spur zeigt die Bereiche der Pakete in ihrer Farbe. Seit der dreizehnten Fassung
// schließen die Bereiche lückenlos aneinander an (eine Lücke bliebe hier leer)
const at = (n: number) => ((n - DRONES_MIN) / (DRONES_MAX - DRONES_MIN)) * 100;
const rgb = (k: keyof typeof SHOW_PACKAGES) => `rgb(${SHOW_PACKAGES[k].color.join(',')})`;
const rangeTrack = `linear-gradient(90deg, ${(Object.keys(DRONE_RANGES) as (keyof typeof SHOW_PACKAGES)[]).map((k, i, all) => {
  const r = DRONE_RANGES[k], next = all[i + 1] ? DRONE_RANGES[all[i + 1]].min : null;
  return [`${rgb(k)} ${at(r.min)}%`, `${rgb(k)} ${at(r.max)}%`, ...(next !== null && next - r.max > DRONE_STEP ? [`transparent ${at(r.max)}%`, `transparent ${at(next)}%`] : [])].join(', ');
}).join(', ')})`;
const ticks = [DRONES_MIN, ...Object.values(DRONE_RANGES).slice(1).map((r) => r.min), DRONES_MAX];
---
<section class="cfg" id={id} aria-labelledby="cfg-h">
    <div class="cfg-stage" aria-label="Vorschau der Show" aria-describedby="cfg-scene">
      <canvas id="cfg-field" aria-hidden="true"></canvas>
      <!-- vierzehnte Fassung: ein Klick irgendwo auf die Bühne hält die Vorführung an oder lässt sie weiterlaufen (wie bei
           YouTube); als echter Knopf erreichbar, Leertaste und Eingabe schalten um -->
      <button type="button" class="cfg-hit" id="cfg-hit" aria-label="Vorführung anhalten" aria-pressed="false"></button>
      <span class="cfg-flash" id="cfg-flash" aria-hidden="true"><svg class="i-pause" viewBox="0 0 16 16"><rect x="4" y="3" width="2.6" height="10" rx="1"/><rect x="9.4" y="3" width="2.6" height="10" rx="1"/></svg><svg class="i-play" viewBox="0 0 16 16"><path d="M5 3.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L5.9 2.7a.6.6 0 0 0-.9.5z"/></svg></span>
      <div class="cfg-caption"><em id="cfg-new">{STEPS[start].pkg}</em></div>
      <div class="cfg-drop" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4m0 0-5 5m5-5 5 5M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg><span>Dein Logo hier reinziehen</span><small>SVG, PNG oder JPG</small></div>
      <span class="sr-only" id="cfg-scene">{firstCaption}</span>
      <p class="cfg-toast" id="cfg-toast" role="status"></p>
      <p class="cfg-error" id="cfg-error" role="status" hidden>Die Vorschau ist gerade nicht verfügbar. Du kannst weiterhin ein Paket wählen und anfragen.</p>
      <div class="cfg-player" id="cfg-player" role="group" aria-label="Vorführung">
        <button type="button" class="cfg-play" id="cfg-play" aria-label="Vorführung pausieren" data-paused="false">
          <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="4" y="3" width="2.6" height="10" rx="1"/><rect x="9.4" y="3" width="2.6" height="10" rx="1"/></svg>
          <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L5.9 2.7a.6.6 0 0 0-.9.5z"/></svg>
        </button>
        <button type="button" class="cfg-stepbtn" id="cfg-prev" aria-label="Vorheriges Bild">‹</button>
        <div class="cfg-track" id="cfg-track" role="slider" tabindex="0" aria-label="Bild der Show" aria-valuemin="1" aria-valuemax="1" aria-valuenow="1" aria-describedby="cfg-tip">
          <div class="cfg-marks" id="cfg-marks" aria-hidden="true"></div>
        </div>
        <!-- sechzehnte Fassung: Motive, die erst mit mehr Drohnen spielen, als ungeleuchtete Lichtpunkte (show-configurator.js) -->
        <div class="cfg-locks" id="cfg-locks" role="group" aria-label="Motive mit mehr Drohnen" hidden></div>
        <span class="cfg-tip" id="cfg-tip" role="tooltip"><b>{list[0].motifs[0].label}</b> · ab {DRONE_RANGES[startPkg].min} Drohnen</span>
        <button type="button" class="cfg-stepbtn" id="cfg-next" aria-label="Nächstes Bild">›</button>
        <div class="cfg-rate" role="group" aria-label="Tempo">
          {[['0.5', '0,5×'], ['1', '1×'], ['2', '2×']].map(([v, l]) => <button type="button" data-rate={v} aria-pressed={v === '1' ? 'true' : 'false'}>{l}</button>)}
        </div>
      </div>
    </div>

    <form class="cfg-panel" id="cfg">
      <Heading id="cfg-h" class="cfg-h">{heading}</Heading>

      <fieldset class="cfg-block">
        <legend>Anlass</legend>
        <div class="cfg-occasions">
          {list.map((o, i) => <label><input type="radio" name="occasion" value={o.id} checked={i === 0} /><span>{o.label}</span></label>)}
        </div>
      </fieldset>

      <fieldset class="cfg-block">
        <legend>Wie aufwendig?</legend>
        <div class="cfg-pkgs">
          {STEPS.map((s, i) => <label style={`--c: rgb(${SHOW_PACKAGES[s.pkg as keyof typeof SHOW_PACKAGES].color.join(',')})`}><input type="radio" name="pkg" value={i} checked={i === start} /><span><b>{s.pkg}</b><small>{s.label}</small></span></label>)}
        </div>
      </fieldset>

      <div class="cfg-block cfg-drones">
        <div class="cfg-drones-head"><label for="cfg-drones">Drohnen</label><output id="cfg-dronecount" for="cfg-drones">{first.base}</output></div>
        <input class="cfg-range" id="cfg-drones" type="range" min={DRONES_MIN} max={DRONES_MAX} step={DRONE_STEP} value={first.base} style={`--track: ${rangeTrack}`} />
        <div class="cfg-ticks mono" aria-hidden="true">{ticks.map((n) => <span style={`--p: ${at(n) / 100}`}>{n}</span>)}</div>
      </div>

      <!-- vierzehnte Fassung: eigener Text und eigenes Logo bei den Auswahlen, nicht mehr unter der Anfrage -->
      <fieldset class="cfg-block cfg-own">
        <legend>Euer Text, euer Logo <span class="cfg-opt">(optional)</span></legend>
        <div class="cfg-own-row">
          <input class="cfg-text" id="cfg-text" name="text" type="text" maxlength="24" autocomplete="off" placeholder="z. B. Anna & Ben" aria-label="Euer Text" />
          <label class="cfg-upload" id="cfg-upload"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0-5 5m5-5 5 5M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg><span>Logo</span><input id="cfg-file" type="file" accept="image/svg+xml,image/png,image/jpeg,image/webp" aria-describedby="cfg-legal" /></label>
          <button type="button" class="cfg-logo-off" id="cfg-logo-off" aria-label="Logo entfernen" hidden><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg></button>
        </div>
        <div class="cfg-styles" id="cfg-styles" hidden>
          {[['script', 'Schreibschrift'], ['print', 'Druckschrift'], ['initials', 'Initialen']].map(([v, l], i) => <label><input type="radio" name="textstyle" value={v} checked={i === 0} /><span>{l}</span></label>)}
        </div>
        <p class="cfg-legal" id="cfg-legal">Lade nur Logos hoch, die du verwenden darfst, zum Beispiel dein eigenes. Die Datei bleibt in deinem Browser: Wir speichern und übertragen sie nicht.</p>
        <p class="cfg-logo-status" id="cfg-logo-status" role="status"></p>
      </fieldset>


      <div class="cfg-result" aria-live="polite">
        <div class="cfg-price"><b id="cfg-pkg">{STEPS[start].pkg}</b><span id="cfg-price">{money(first.price)}</span></div>
        <p class="cfg-meta mono" id="cfg-meta">{first.base} Drohnen · {first.dur} · netto zzgl. Anfahrt</p>
      </div>
      <a class="btn primary cfg-cta" id="cfg-cta" href="/#anfrage">Mit dieser Show anfragen</a>
      <p class="cfg-note" id="cfg-placeholder">Prototyp: Die Vorschau zeigt Beispiele, den Ablauf eurer Show entwickeln wir gemeinsam. Die Zuordnung zu den Paketen ist aus den Paketbeschreibungen abgeleitet und noch nicht von FlyingStars bestätigt. Alle Preise sind netto; Drohnenbereiche und Aufpreise sind Platzhalter.</p>
    </form>

    <div class="cfg-bar" aria-hidden="true"><span><b id="cfg-bar-pkg">{STEPS[start].pkg}</b> <span id="cfg-bar-price">{money(first.price)}</span></span><a class="btn small primary" href="/#anfrage" id="cfg-bar-cta" tabindex="-1">Anfragen</a></div>
  </section>

<noscript><p class="cfg-noscript">Der Show-Konfigurator benötigt JavaScript. Die Pakete mit Preisen findest du unter <a href="/drohnenshow-preise/#pakete">Pakete</a>.</p></noscript>

<script>
  import '../../scripts/show-configurator.js';
</script>

<style>
  /* zwei Spalten wie im ursprünglichen Entwurf: Bedienung links in fester Lesebreite, die Bühne nimmt den Rest.
     Sechzehnte Fassung: eingebettet im Seitenfluss; horizontal an der globalen Inhaltsbreite (--gutter, ab 1920 px
     gedeckelt), oben Platz für die feste Navigation (--cfg-top, eine Seite kann es überschreiben) */
  .cfg { --cfg-gutter: var(--gutter, var(--pad)); display: grid; grid-template-columns: clamp(340px, 27vw, 500px) minmax(0, 1fr); gap: clamp(24px, 3.4vw, 72px); padding: var(--cfg-top, 84px) var(--cfg-gutter) var(--section); align-items: start; scroll-margin-top: 0; }
  .cfg-noscript { padding: 0 var(--gutter, var(--pad)) var(--section); color: var(--muted); }
  .cfg-stage { order: 2; position: sticky; top: 84px; height: calc(100svh - 108px); min-height: 460px; border-radius: var(--radius); background: radial-gradient(ellipse at 50% 120%, rgba(51, 237, 242, 0.06), transparent 60%), #0a0908; border: 1px solid var(--line); overflow: hidden; }
  .cfg-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cfg-caption { position: absolute; left: 20px; top: 18px; right: 20px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 14px; color: var(--muted); }
  .cfg-caption em { font: 500 11px/1 var(--mono); font-style: normal; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ground); background: var(--pkg, var(--amber)); padding: 5px 8px; border-radius: 4px; }
  /* Vorführ-Steuerung: Pause, Bild zurück/vor, Fortschritt mit einer Marke je Bild, Tempo */
  .cfg-player { position: absolute; left: 14px; right: 14px; bottom: 14px; display: flex; align-items: center; gap: 4px; padding: 3px; border: 1px solid var(--line); border-radius: 999px; background: rgba(15, 13, 12, 0.72); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .cfg-player button { flex: none; height: 36px; min-width: 36px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font: 400 18px/1 var(--body); cursor: pointer; display: inline-grid; place-items: center; padding: 0 8px; }
  .cfg-player button:hover { color: var(--text); background: rgba(246, 241, 232, 0.08); }
  .cfg-player button:focus-visible, .cfg-track:focus-visible { outline: 3px solid var(--cyan); outline-offset: -2px; }
  .cfg-play { color: var(--text) !important; }
  .cfg-play svg { width: 14px; height: 14px; fill: currentColor; }
  .cfg-play[data-paused="false"] .i-play, .cfg-play[data-paused="true"] .i-pause { display: none; }
  .cfg-track { position: relative; flex: 1 1 auto; min-width: 60px; height: 36px; cursor: pointer; touch-action: none; border-radius: 999px; }
  .cfg-marks { position: absolute; left: 6px; right: 6px; top: 50%; height: 3px; margin-top: -1.5px; display: flex; gap: 2px; }
  .cfg-marks :global(span) { flex: 1 1 0; min-width: 2px; border-radius: 2px; background: linear-gradient(90deg, var(--pkg, var(--amber)) var(--f, 0%), rgba(246, 241, 232, 0.18) var(--f, 0%)); }
  .cfg-marks :global(span.is-motif) { margin-left: 4px; }
  .cfg-rate { display: flex; flex: none; padding-left: 4px; border-left: 1px solid var(--line); }
  .cfg-rate button { font: 500 12px/1 var(--mono); letter-spacing: 0.02em; padding: 0 7px; min-width: 0; }
  .cfg-rate button[aria-pressed="true"] { color: var(--text); background: rgba(246, 241, 232, 0.1); }
  /* Drohnenregler: Spur in den Paketfarben, Lücke zwischen den Bereichen leer */
  .cfg-drones-head { display: flex; align-items: baseline; justify-content: space-between; }
  .cfg-drones-head label { font-size: 15px; color: var(--text); }
  .cfg-drones-head output { font: 600 20px/1 var(--display); color: var(--text); font-variant-numeric: tabular-nums; }
  .cfg-range { -webkit-appearance: none; appearance: none; width: 100%; height: 28px; margin: 0; background: transparent; cursor: pointer; }
  .cfg-range::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: var(--track), rgba(246, 241, 232, 0.08); opacity: 0.85; }
  .cfg-range::-moz-range-track { height: 4px; border-radius: 2px; background: var(--track), rgba(246, 241, 232, 0.08); opacity: 0.85; }
  .cfg-range::-webkit-slider-thumb { -webkit-appearance: none; width: 20px; height: 20px; margin-top: -8px; border-radius: 50%; background: var(--text); border: 4px solid var(--pkg, var(--amber)); box-shadow: 0 0 0 4px rgba(15, 13, 12, 0.9); }
  .cfg-range::-moz-range-thumb { width: 12px; height: 12px; border-radius: 50%; background: var(--text); border: 4px solid var(--pkg, var(--amber)); box-shadow: 0 0 0 4px rgba(15, 13, 12, 0.9); }
  .cfg-range:focus-visible { outline: 3px solid var(--cyan); outline-offset: 2px; border-radius: 6px; }
  .cfg-ticks { position: relative; height: 14px; margin: -4px 10px 0; font-size: 11px; color: var(--faint); }
  .cfg-ticks span { position: absolute; left: calc(var(--p) * 100%); transform: translateX(-50%); }
  /* Bühne als Pause-Knopf (vierzehnte Fassung): liegt über der Leinwand, unter Steuerung und Meldungen */
  .cfg-hit { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; margin: 0; padding: 0; border: 0; border-radius: inherit; background: transparent; cursor: pointer; }
  .cfg-hit:focus-visible { outline: 3px solid var(--cyan); outline-offset: -3px; }
  .cfg-caption, .cfg-toast, .cfg-flash, .cfg-drop { z-index: 2; }
  .cfg-caption { pointer-events: none; }
  .cfg-player, .cfg-error { z-index: 3; }
  /* kurzes Zeichen in der Mitte, was der Klick bewirkt hat (wie bei YouTube), danach weg */
  .cfg-flash { position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: rgba(15, 13, 12, 0.72); color: var(--text); opacity: 0; pointer-events: none; }
  .cfg-flash svg { width: 24px; height: 24px; fill: currentColor; }
  .cfg-flash[data-state="pause"] .i-play, .cfg-flash[data-state="play"] .i-pause, .cfg-flash:not([data-state]) svg { display: none; }
  .cfg-flash.is-on { animation: cfg-pop 0.75s ease-out; }
  @keyframes cfg-pop { from { opacity: 0.9; transform: scale(0.92); } to { opacity: 0; transform: scale(1.12); } }
  @media (prefers-reduced-motion: reduce) { .cfg-flash.is-on { animation: none; } }
  /* Dropzone fürs Logo: sichtbar, solange eine Datei über die Seite gezogen wird, und als Hinweis, wenn man auf
     „Logo“ zeigt. Fünfzehnte Fassung (Marc, Kompromiss): beim ersten Überfahren der Bühne mit der Maus einmal als
     Einladung (is-invite), danach nicht mehr. Nach dem Ablegen sofort weg, bis die Maus die Bühne verlassen hat
     (is-done). Mit data-drop-hover an der Bühne erscheint sie wie in Studie 1 bei jedem Überfahren. */
  .cfg-drop { position: absolute; inset: 14px 14px 64px; display: grid; place-content: center; justify-items: center; gap: 8px; border: 1.5px dashed rgba(246, 241, 232, 0.28); border-radius: calc(var(--radius) - 6px); color: var(--text); text-align: center; opacity: 0; transition: opacity 0.3s, border-color 0.3s, background 0.3s; pointer-events: none; }
  .cfg-drop svg { width: 30px; height: 30px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .cfg-drop span { font: 500 18px/1.2 var(--display); }
  .cfg-drop small { font-size: 13px; color: var(--muted); }
  .cfg-stage.is-target .cfg-drop, .cfg-stage.is-page-drag .cfg-drop, .cfg-stage.is-invite .cfg-drop, .cfg-stage[data-drop-hover]:hover .cfg-drop { opacity: 1; background: rgba(10, 9, 8, 0.42); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
  .cfg-stage.is-drag .cfg-drop { opacity: 1; border-color: var(--pkg, var(--amber)); background: rgba(10, 9, 8, 0.55); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); }
  .cfg-stage.is-done .cfg-drop { opacity: 0; transition: none; }
  /* Spur: beim Überfahren und mit Fokus ein kleiner Hinweis, ab wie vielen Drohnen die Sequenz möglich ist */
  .cfg-tip { position: absolute; bottom: calc(100% + 8px); left: var(--x, 50%); transform: translateX(-50%); white-space: nowrap; padding: 4px 9px; border: 1px solid var(--line); border-radius: 6px; background: rgba(15, 13, 12, 0.92); color: var(--muted); font: 400 12px/1.3 var(--body); opacity: 0; transition: opacity 0.15s ease; pointer-events: none; }
  .cfg-tip b { color: var(--text); font-weight: 500; }
  .cfg-tip.is-on { opacity: 1; }
  .cfg-tip.is-locked :global(b) { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  /* gesperrte Motive: je Motiv drei ungeleuchtete Lichtpunkte; beim Zeigen glimmen sie auf (sechzehnte Fassung). Die
     Knöpfe entstehen im Skript, darum :global (Astro begrenzt Stile sonst auf Elemente aus dem Markup) */
  .cfg-locks { display: flex; flex: none; align-items: center; gap: 0; padding-left: 2px; }
  .cfg-locks[hidden] { display: none; }
  .cfg-locks :global(.cfg-lock) { flex: none; min-width: 24px; height: 36px; padding: 0 5px; border: 0; border-radius: 999px; background: transparent; cursor: pointer; display: inline-flex; gap: 3px; align-items: center; justify-content: center; }
  .cfg-locks :global(.cfg-lock:focus-visible) { outline: 3px solid var(--cyan); outline-offset: -2px; }
  .cfg-locks :global(.cfg-lock i) { width: 3px; height: 3px; border-radius: 50%; background: rgba(246, 241, 232, 0.3); transition: background 0.2s, box-shadow 0.2s; }
  .cfg-locks :global(.cfg-lock:is(:hover, :focus-visible) i) { background: #fff; box-shadow: 0 0 4px 1px rgba(255, 158, 41, 0.7), 0 0 9px 2px rgba(51, 237, 242, 0.25); }
  .cfg-locks :global(.cfg-lock:is(:hover, :focus-visible) i:nth-child(2)) { box-shadow: 0 0 4px 1px rgba(219, 100, 232, 0.75), 0 0 9px 2px rgba(51, 237, 242, 0.25); }
  .cfg-locks :global(.cfg-lock:is(:hover, :focus-visible) i:nth-child(3)) { box-shadow: 0 0 4px 1px rgba(51, 237, 242, 0.75), 0 0 9px 2px rgba(51, 237, 242, 0.25); }
  /* eigener Text und Logo in einer Zeile */
  .cfg-own-row { display: flex; gap: 6px; align-items: stretch; }
  .cfg-own-row .cfg-text { flex: 1 1 auto; min-width: 0; }
  .cfg-upload { position: relative; flex: none; display: inline-flex; align-items: center; gap: 7px; min-height: 42px; padding: 0 14px; border: 1px solid var(--line-strong); border-radius: 10px; color: var(--text); font-size: 15px; cursor: pointer; }
  .cfg-upload:hover { background: rgba(246, 241, 232, 0.06); }
  .cfg-upload svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .cfg-upload input { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; }
  .cfg-upload:focus-within { outline: 3px solid var(--cyan); outline-offset: 2px; }
  .cfg-upload.has-logo { border-color: var(--pkg, var(--amber)); }
  .cfg-logo-off { flex: none; width: 42px; border: 1px solid var(--line); border-radius: 10px; background: transparent; color: var(--muted); cursor: pointer; display: grid; place-items: center; }
  .cfg-logo-off[hidden] { display: none; }
  .cfg-logo-off svg { width: 14px; height: 14px; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  .cfg-logo-off:hover { color: var(--text); }
  .cfg-logo-off:focus-visible { outline: 3px solid var(--cyan); outline-offset: 2px; }
  .cfg-legal { margin: 0; font-size: 12px; line-height: 1.45; color: var(--faint); }
  .cfg-logo-status { margin: 0; font-size: 13px; color: var(--muted); }
  .cfg-logo-status:empty { display: none; }

  .cfg-error { position: absolute; inset: auto 20px 76px; color: var(--muted); font-size: 14px; }
  /* Freischalt-Meldung (dreizehnte Fassung), fünfzehnte Fassung in der Sprache der Seite (Marc: die Toast-UI war „gar
