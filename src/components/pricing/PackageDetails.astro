---
import {nativeRecord as uiMarker} from '../../lib/native-editor';
import {siteRecord as readUi} from '../../lib/content';
import {localeFromPath,localeFormat,localizedHref} from '../../lib/localized-routes';
const locale = Astro.props.locale ?? Astro.props._locale ?? localeFromPath(Astro.url.pathname);
const ui = readUi('ui',locale);
import InlineText from '../InlineText.astro';
import {inlinePlain} from '../../lib/inline-text';
import {PACKAGE_NAMES, type ShowPackage} from '../../content/show-packages';
import {fillText,getPackages} from '../../lib/content';
const SHOW_PACKAGES = getPackages(locale);
import { nativeItem } from "../../lib/native-editor";
const money = (value: number) => value.toLocaleString(localeFormat(locale));
const editor = process.env.FLYINGSTARS_EDITOR === '1';
const native = (name: ShowPackage, path: Array<string | number>, derived = false, inline = false) => editor ? {
  'data-native-record': `package/${name.toLowerCase()}`,
  [derived ? 'data-native-derived' : 'data-native-path']: JSON.stringify(path),
  ...(inline?{'data-native-inline':'true'}:{}),
} : {};
const dot = (color: number[]) => '#' + color.map(value => value.toString(16).padStart(2, '0')).join('');
---

<section class="section alt" id="pakete" aria-labelledby="pakete-h">
  <div class="sec-head">
    <div><span class="kicker mono" {...uiMarker('site/ui',["packageDetails","pakete"])}>{ui.packageDetails.pakete}</span><h2 id="pakete-h" {...uiMarker('site/ui',["packageDetails","drei_pakete_die_preise_rechnen_mit"])}>{ui.packageDetails.drei_pakete_die_preise_rechnen_mit}</h2></div>
    <p {...uiMarker('site/ui',["packageDetails","die_preise_unten_gelten_fur_die_drohnenzahl_die_du"])}>{ui.packageDetails.die_preise_unten_gelten_fur_die_drohnenzahl_die_du}</p>
  </div>
  <div class="tiers-grid">
    {PACKAGE_NAMES.map(name => {
      const pkg = SHOW_PACKAGES[name];
      const record = `package/${name.toLowerCase()}`;
      return <article class:list={['tier', {'is-rec': pkg.highlight}]} data-card={name} style={`--dot:${dot(pkg.color)}`} {...nativeItem(Astro.props, {record})}>
        <canvas data-orb={pkg.orbShape} data-n={pkg.base} data-color={pkg.color.join(',')} aria-hidden="true"></canvas>
        <div class="head"><h3 {...native(name, ['displayName'],false,true)}><InlineText value={pkg.displayName} /></h3><span class="badge" {...native(name, ['badge'], true)}>{pkg.badge}</span></div>
        <p class="tag" {...native(name, ['description'])}>{pkg.description}</p>
        <div class="p" data-live {...native(name,["price"],true)}><b {...native(name, ['price'], true)}>{fillText(ui.calculator.fromPrice,{price:money(pkg.price)+" €"})}</b><span class="mono" {...native(name, ['base'], true)}>{fillText(ui.packageDetails.base,{count:pkg.base,duration:pkg.dur})}</span></div>
        {pkg.inheritsText && <span class="plus" {...native(name, ['inheritsText'])}>{pkg.inheritsText}</span>}
        {pkg.featureGroups.map((group, groupIndex) => {
          const content = <>
          <h4 {...native(name, ['featureGroups', groupIndex, 'title'])}>{group.title}</h4>
          <ul>{group.items.map((item, itemIndex) => <li {...native(name, ['featureGroups', groupIndex, 'items', itemIndex, 'text'])} {...nativeItem(Astro.props, {entryRecord: record, entry: ['featureGroups', groupIndex, 'items', itemIndex]})}>{item.text}</li>)}</ul>
        </>, entry = nativeItem(Astro.props, {record, entry: ['featureGroups', groupIndex]});
          return Object.keys(entry).length ? <div style="display:contents" {...entry}>{content}</div> : content;
        })}
        <span class="scale-note mono" {...native(name, ['add'], true)}>{fillText(ui.packageDetails.scale,{price:money(pkg.add),step:pkg.step})}{Number.isFinite(pkg.max)?fillText(ui.packageDetails.maximum,{max:pkg.max}):''}</span>
        <a class:list={['btn', {primary: pkg.highlight}]} href={localizedHref(`/?paket=${name}#anfrage`,locale)} {...native(name, ['displayName'], true)}>{fillText(ui.packageDetails.inquiry,{name:inlinePlain(pkg.displayName)})}</a>
      </article>;
    })}
  </div>
</section>
