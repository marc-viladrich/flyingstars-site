{
  "name": "astro-site-template",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "rm -f .astro/data-store.json && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test 'scripts/*.test.mjs' 'src/scripts/effects/*.test.mjs' && playwright test",
    "gates": "astro check && astro build && npm test",
    "editor": "node editor/server.mjs",
    "ci": "node editor/ci/check.mjs",
    "test:unit": "node --test 'editor/*.test.mjs' 'editor/core/*.test.mjs' 'editor/test/*.test.mjs' 'scripts/*.test.mjs' 'src/scripts/effects/*.test.mjs' 'src/scripts/*.test.mjs'",
    "test:effects": "node --test 'src/scripts/effects/*.test.mjs'",
    "audit:layout": "node scripts/layout-audit.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.66.0",
    "astro": "^7.4.3",
    "astro-frontend-editor": "npm:@marc-viladrich/astro-frontend-editor@0.3.0",
    "marked": "^18.1.2",
    "sharp": "^0.35.5",
    "vanilla-cookieconsent": "3.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "typescript": "^6.0.3"
  }
}
